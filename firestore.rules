// Firestore rules for twiggli-production: the app's rules (FlutterFlow, as
// published in the console on 29.10.26) with the website's host-account
// rules added before the final catch-all. The Firebase console is where
// these are published, by hand: this copy is what to paste there. Never
// deploy it with the CLI without checking the console first, in case the
// app's rules changed since.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /Users/{parent}/event_ratings/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /{path=**}/event_ratings/{document} {
      allow read: if request.auth != null;
    }


    match /{document=**} {
      allow read, write: if request.auth.token.email.matches("firebase@flutterflow.io");
    }

    match /APIKeys/{document} {
      allow create: if false;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /Events/{document} {
      allow create: if request.auth != null;
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if resource.data.created_by == /databases/$(database)/documents/Users/$(request.auth.uid);
    }

    match /ReportedEvents/{document} {
      allow create: if request.auth != null;
      allow read: if resource.data.reporterId == /databases/$(database)/documents/Users/$(request.auth.uid);
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /UserKeys/{document} {
      allow create: if false;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /Users/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /category/{document} {
      allow create: if false;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /chats/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if /databases/$(database)/documents/Users/$(request.auth.uid) in resource.data.users;
    }

    match /comments/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if resource.data.created_by == /databases/$(database)/documents/Users/$(request.auth.uid);
    }

    match /ff_user_push_notifications/{document} {
      allow create: if /databases/$(database)/documents/Users/$(request.auth.uid) == request.resource.data.sender;
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }

    match /chats/{parent}/messages/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if resource.data.message_sent_by == /databases/$(database)/documents/Users/$(request.auth.uid);
    }

    match /{path=**}/messages/{document} {
      allow read: if request.auth != null;
    }


    match /notifications/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /payments/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /stripeaccounts/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth.uid == resource.data.id;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /comments/{parent}/sub_comments/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if resource.data.created_by == /databases/$(database)/documents/Users/$(request.auth.uid);
    }

    match /{path=**}/sub_comments/{document} {
      allow read: if request.auth != null;
    }


    match /transactions/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    // ── Website (twiggli.com): host accounts. Added 29.10.26; see
    //    functions/README.md in the website repo. Touches nothing the app uses. ──
    function email() {
      return request.auth.token.email.lower();
    }
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function member(slug) {
      return signedIn()
        && exists(/databases/$(database)/documents/hostMembers/$(email()))
        && slug in get(/databases/$(database)/documents/hostMembers/$(email())).data.slugs;
    }
    function short(field, max) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    match /hostMembers/{memberEmail} {
      allow read: if signedIn() && memberEmail == email();
      allow write: if false;
    }

    match /hostProfiles/{id} {
      allow read: if true;
      allow write: if member(request.resource.data.slug)
        && id == request.resource.data.slug + '_' + request.resource.data.lang
        && request.resource.data.lang in ['en', 'de']
        && short('specialty', 80) && short('studio', 80) && short('blurb', 1500)
        && short('group_size', 80) && short('duration', 40) && short('place', 120)
        && short('languages', 40) && short('price_note', 120);
    }

    match /hostSlots/{id} {
      allow read: if true;
      allow create, update: if member(request.resource.data.slug)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
        && request.resource.data.weekdays is list
        && request.resource.data.weekdays.size() >= 1 && request.resource.data.weekdays.size() <= 7
        && request.resource.data.weekdays.hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'])
        && request.resource.data.time is string && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && (!('price' in request.resource.data) || request.resource.data.price == null
            || (request.resource.data.price is int && request.resource.data.price >= 0 && request.resource.data.price <= 2000));
      allow delete: if member(resource.data.slug);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
