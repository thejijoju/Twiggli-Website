# update-workshops.mjs writes this next to itself on every run: the list of
# sessions that were sold out last time and are bookable again. The workflow
# reads it to open an issue and then throws it away, so a local run of the
# scraper should not leave it behind as something to commit.
reopened-events.json
.astro/

# Comparison shots composed to show a change side by side. They are written
# to the repo root so they can be opened from the app, and are throwaway —
# the site never serves them.
/*-compare.png

# Firebase: the functions install their own packages on deploy, and the
# CLI leaves debug logs behind.
functions/node_modules/
firebase-debug.log
firestore-debug.log
.firebase/

# Firebase sign-in helper, copied in by the deploy (deploy.yml)
site/public/__/

# Written by deploy-firebase.yml from secrets; never commit
functions/.env
functions/.env.*
