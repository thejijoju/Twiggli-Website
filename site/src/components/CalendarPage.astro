---
import PageCircles from './PageCircles.astro';
import { circlesFor } from '../data/pageCircles.ts';
import Base from '../layouts/Base.astro';
import DayPicker from './DayPicker.astro';
import EventSchema from './EventSchema.astro';
import { SITE } from '../data/seo.ts';
import { ui } from '../data/i18n.ts';
import { href, type Lang } from '../lib/url.ts';
import Doodled from './Doodled.astro';

interface Props {
  lang: Lang;
  /** The filter draft D's preview address (src/pages/de/preview/
   *  kalender-filter-d), which now shows the live calendar itself: noindex,
   *  German only, and no event markup of its own. */
  preview?: boolean;
}
const { lang, preview = false } = Astro.props;
const t = ui(lang).calendarPage;
---

<Base title={t.title} description={t.description} lang={lang} pageClass="page-flush"
  {...(preview ? { noindex: true, translations: [lang] } : {})}>
  <div class="container">
    <section class="page-head">
      <PageCircles pics={circlesFor.calendar(lang)} />
      {/* One heading: the place and the selected day together. The script
          rewrites it as the visitor moves along the day strip. */}
      <Doodled variant="b">
        <h1 class="page-title" data-happening-title>{t.h1}</h1>
      </Doodled>
    </section>

    <section class="section section-flush">
      <DayPicker lang={lang} />
    </section>

  </div>
  {!preview && <EventSchema lang={lang} pageUrl={`${SITE}${href(lang, '/happening-today/')}`} />}
</Base>
