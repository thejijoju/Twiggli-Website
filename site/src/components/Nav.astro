---
import ImageSlot from './ImageSlot.astro';
import LangSwitch from './LangSwitch.astro';
import { getSiteData, appUrl } from '../data/site.ts';
import { href, type Lang } from '../lib/url.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { brand, navLinks } = getSiteData(lang);

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (link: (typeof navLinks)[number]) =>
  !link.external && (link.href.replace(/\/+$/, '') || '/') === path;

const ctaLabel = { en: 'Get started', de: 'Jetzt starten' }[lang];

/* The "Get Started" entry is promoted to the black CTA pill on the right,
   so it is dropped from the inline link list to avoid showing twice. */
const inlineLinks = navLinks.filter((link) => !link.external);
---

<nav class="nav">
  <div class="nav-brand-block">
    {/* Mark only — the wordmark is not repeated here. The link keeps an
        aria-label so it still announces as "Twiggli — home". */}
    <a href={href(lang, '/')} class="nav-logo" aria-label={`${brand.name} — home`}>
      <ImageSlot src={brand.logo} shape="rect" placeholder="Logo" alt={`${brand.name} logo`} />
    </a>
  </div>
  <div class="nav-end">
    {inlineLinks.map((link) => (
      <a
        href={link.href}
        aria-current={isCurrent(link) ? 'page' : undefined}
        class:list={{ 'nav-link-emphasis': link.emphasis }}
      >{link.label}</a>
    ))}
    <LangSwitch lang={lang} />
    <a href={appUrl} class="nav-cta" target="_blank" rel="noopener">
      {ctaLabel}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7" />
        <path d="M8 7h9v9" />
      </svg>
    </a>
  </div>
</nav>
