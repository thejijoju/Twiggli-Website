---
import ImageSlot from './ImageSlot.astro';
import SocialIcon from './SocialIcon.astro';
import LangSwitch from './LangSwitch.astro';
import { getSiteData } from '../data/site.ts';
import { href, type Lang } from '../lib/url.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { brand, navLinks, socialLinks } = getSiteData(lang);

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (link: (typeof navLinks)[number]) =>
  !link.external && (link.href.replace(/\/+$/, '') || '/') === path;
---

<nav class="nav">
  <div class="nav-brand-block">
    <a href={href(lang, '/')} class="nav-logo" aria-label={`${brand.name} — home`}>
      <ImageSlot src={brand.logo} shape="rect" placeholder="Logo" alt={`${brand.name} logo`} />
    </a>
    <a href={href(lang, '/')} class="nav-brand">{brand.name}</a>
  </div>
  <div class="nav-center">
    {navLinks.map((link) => (
      <a
        href={link.href}
        aria-current={isCurrent(link) ? 'page' : undefined}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener' : undefined}
        class:list={{ 'nav-link-emphasis': link.emphasis }}
      >{link.label}</a>
    ))}
    <div class="nav-social">
      {socialLinks.map((s) => (
        <a href={s.href} aria-label={s.label}><SocialIcon name={s.icon} /></a>
      ))}
    </div>
    <LangSwitch lang={lang} />
  </div>
</nav>
