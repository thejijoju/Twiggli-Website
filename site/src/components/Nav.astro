---
import ImageSlot from './ImageSlot.astro';
import { getSiteData } from '../data/site.ts';
import { href, type Lang } from '../lib/url.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { brand, navLinks } = getSiteData(lang);

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (link: (typeof navLinks)[number]) =>
  !link.external && (link.href.replace(/\/+$/, '') || '/') === path;

/* The external "Get Started" entry (the web app) is footer-only: the header
   has no CTA pill any more — the app is the "Get app" pill in the dark strip
   above (SocialBar.astro), and the language switcher lives in the footer and
   the phone's More sheet. */
const inlineLinks = navLinks.filter((link) => !link.external);
---

<nav class="nav">
  <div class="nav-brand-block">
    {/* Mark only — the wordmark is not repeated here. The link keeps an
        aria-label so it still announces as "Twiggli — home". */}
    <a href={href(lang, '/')} class="nav-logo" aria-label={`${brand.name} — home`}>
      <ImageSlot src={brand.logo} shape="rect" placeholder="Logo" alt={`${brand.name} logo`} />
    </a>
  </div>
  {/* Everything but the mark sits inside the page's own column, so the
      links end exactly where the heading's line below them ends. The mark
      keeps the margin to the left of that column — see .nav-inner. */}
  <div class="nav-inner">
  <div class="nav-links">
    {inlineLinks.map((link) => (
      <a
        href={link.href}
        aria-current={isCurrent(link) ? 'page' : undefined}
      >{link.label}</a>
    ))}
  </div>
  </div>
</nav>
