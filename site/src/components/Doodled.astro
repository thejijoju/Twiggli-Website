---
/**
 * A few stars drawn around a headline in thin pen lines, as if someone had
 * doodled them in the margin: a curved four-point sparkle, a five-point star
 * done in one stroke without lifting the pen, a twinkle and a small ring.
 * Each line wobbles a little and none quite closes, which is what keeps
 * them from reading as icons.
 *
 * Wrap the heading: the wrapper is as wide as the text, so the stars follow
 * its last word whatever the language or length. The variant picks which
 * stars come and where they sit, so no two pages wear the same set.
 */
interface Props {
  variant?: 'a' | 'b' | 'c';
  class?: string;
}
const { variant = 'a', class: className } = Astro.props;

const shapes = {
  sparkle:
    'M20.6 3.4C21.3 13.1 24.9 17.5 36.3 19.3C25.7 21.4 21.8 25.5 20.1 36.9C18.7 25.8 14.8 21.7 3.7 20.4C14.7 18.3 19.2 14 20.9 4.9',
  star:
    'M9.6 35.4Q14.4 19.5 20.3 4.3Q25.3 19.8 30.5 35.3Q17.3 25.9 4.1 15.9Q20.2 15.2 36.2 16.5Q22.4 26.9 7.9 36.8',
  twinkle: 'M20.3 6.2Q20.9 20 19.6 33.9M8.2 12.6Q20.1 19.3 32.3 27.2M31.8 12.3Q20.6 20.6 8.4 27.8',
  ring: 'M24.8 19.2C25.6 23.4 22 26.4 18.6 25.6C15.1 24.8 13.9 20.4 16.2 17.4C18.4 14.6 23.3 14.9 24.6 18.7',
} as const;

const sets: Record<NonNullable<Props['variant']>, (keyof typeof shapes)[]> = {
  a: ['sparkle', 'star', 'ring'],
  b: ['sparkle', 'twinkle', 'ring'],
  c: ['star', 'sparkle', 'twinkle'],
};
---

<div class:list={['doodled', `doodled-${variant}`, className]}>
  <slot />
  <span class="doodles" aria-hidden="true">
    {sets[variant].map((shape, i) => (
      <svg class={`doodle doodle-${i + 1}`} viewBox="0 0 40 40" focusable="false">
        <path d={shapes[shape]} pathLength="1" />
      </svg>
    ))}
  </span>
</div>

<script>
  /* A wrapped heading's box runs the full measure, wider than its words, so
     stars placed against the box float off into the margin. This finds
     where the first and last lines of text actually end and hands those to
     the CSS (--first-end, --last-end, --last-mid, --room), which sets the stars
     against the words instead. Without it the stars keep their places
     against the box. */
  const boxes = Array.from(document.querySelectorAll<HTMLElement>('.doodled'));
  const measure = () => {
    for (const box of boxes) {
      const text = box.firstElementChild;
      if (!text || text.classList.contains('doodles')) continue;
      const range = document.createRange();
      range.selectNodeContents(text);
      const rects = Array.from(range.getClientRects()).filter((r) => r.width > 1);
      if (!rects.length) continue;
      const origin = box.getBoundingClientRect();
      const top = Math.min(...rects.map((r) => r.top));
      const bottom = Math.max(...rects.map((r) => r.bottom));
      const first = rects.filter((r) => r.top - top < 6);
      const last = rects.filter((r) => bottom - r.bottom < 6);
      const lastTop = Math.min(...last.map((r) => r.top));
      const lastEnd = Math.max(...last.map((r) => r.right)) - origin.left;
      box.style.setProperty('--first-end', `${Math.max(...first.map((r) => r.right)) - origin.left}px`);
      box.style.setProperty('--last-end', `${lastEnd}px`);
      // Room from the heading's left edge to the screen's right edge, so a
      // star can go past the box but never off the screen.
      const room = document.documentElement.clientWidth - origin.left;
      box.style.setProperty('--last-mid', `${(lastTop + bottom) / 2 - origin.top}px`);
      box.style.setProperty('--room', `${room}px`);
      // The ring after the last word only where the heading runs to more
      // than one line (on one line the sparkle is already there) and there
      // is clear space for it.
      box.classList.toggle('has-ring', lastTop - top > 6 && room - lastEnd > 40);
      box.classList.add('is-measured');
    }
  };
  if (boxes.length) {
    measure();
    document.fonts?.ready.then(measure);
    // Width only: a phone's address bar fires resize on every scroll.
    let width = innerWidth;
    addEventListener('resize', () => {
      if (innerWidth === width) return;
      width = innerWidth;
      measure();
    });
    // The calendar rewrites its heading as the visitor picks a day.
    const watch = new MutationObserver(measure);
    for (const box of boxes) {
      if (box.firstElementChild) watch.observe(box.firstElementChild, { childList: true, characterData: true, subtree: true });
    }
  }
</script>
