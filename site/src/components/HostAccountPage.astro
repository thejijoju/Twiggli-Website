  /* On-request weekly slots: lighter, dashed, "On request" instead of a count. */
  .cal-chip.is-slot, .cal-blk.is-slot { background: #faf8ff; color: #6a3eec !important; box-shadow: none; outline: 1.5px dashed #b9a6f5; outline-offset: -1.5px; font-weight: 500; }
  .cal-chip.is-slot b, .cal-blk.is-slot b { font-weight: 600; }
