  /* What guests wrote, in the date panel and in Messages (Jirel 19.11.26). */
  .cal-gmsg { margin-top: 10px; padding: 10px 12px; border-radius: 12px; background: #f3eeff; font-size: 0.85rem; display: grid; gap: 4px; justify-items: start; }
