          if (!(ATTRS.includes(a) || a.startsWith('data-')) || a === 'data-config' || a === 'data-hosts') continue;
          const v = now.getAttribute(a) ?? '';
          if (was.getAttribute(a) !== v && live.getAttribute(a) === was.getAttribute(a)) live.setAttribute(a, v);
        }
