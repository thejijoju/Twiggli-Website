  .cal-pill:hover { border-color: rgba(106, 62, 236, 0.45); }
  .cal-pill[aria-pressed='true'] { border-color: #6a3eec; color: #6a3eec; background: #f3eeff; }
  .cal-pill-new { padding: 8px 16px; border-style: dashed; }
  .cal-pic { width: 30px; height: 30px; flex: none; border-radius: 50%; object-fit: cover; border: 2px solid #6a3eec; box-sizing: border-box; background: #f3eeff; }
