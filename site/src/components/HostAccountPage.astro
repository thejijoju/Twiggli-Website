  .cal-meta { margin: 0 0 6px; font-size: 0.85rem; color: var(--color-text-muted); }
  .cal-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #f1eef6; font-size: 0.9rem; }
  .cal-full { color: #c0392b; font-weight: 600; }
  .cal-bar { height: 6px; border-radius: 9px; background: #efeaf7; overflow: hidden; margin: 2px 0 2px; }
