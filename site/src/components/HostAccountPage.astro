  .cal-mnav button { width: 36px; height: 36px; border-radius: 50%; border: 1.5px solid var(--cal-line); background: #fff; font-size: 1.1rem; line-height: 1; display: grid; place-items: center; padding: 0; }
  .cal-mnav button:hover { border-color: #6a3eec; color: #6a3eec; }
  .cal-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 18px; align-items: start; }
  .cal-month { padding: 18px; min-width: 0; }
