  .cal-list { display: grid; gap: 8px; }
  .cal-list:empty { display: none; }
  .cal.is-week .cal-wd, .cal.is-week .cal-days, .cal.is-phone .cal-wd, .cal.is-phone .cal-days { display: none; }
  /* Week: Mon–Sun columns, hours down the side. */
  .cal-wg { display: grid; grid-template-columns: 48px repeat(7, minmax(0, 1fr)); grid-template-rows: auto calc(var(--hours) * var(--hour)); column-gap: 4px; }
  .cal-wg-corner { grid-row: 1; }
  .cal-wg-h { display: grid; justify-items: center; gap: 2px; padding-bottom: 8px; }
  .cal-wg-h small { font-size: 0.75rem; color: var(--color-text-muted); text-transform: capitalize; }
