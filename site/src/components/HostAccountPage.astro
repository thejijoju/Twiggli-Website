  .cal-blk.is-full { background: #3b2580; }
  .cal-blk.is-req { background: #fff7f2; color: #c2541f !important; box-shadow: inset 0 0 0 1.5px #fd6f31; }
  .cal-blk.is-sel { outline: 2px solid #fd6f31; outline-offset: 1px; }
  .cal-blk:hover { filter: brightness(1.08); }
