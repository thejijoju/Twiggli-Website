      function calAdd(day = '') {
        {
          const w = calWorkshops().find((x) => x.key === calSel);
          const last = [...ownEvents].reverse().find((e) => calKey(e.title) === calSel);
          const sel = day || (calSlot.split('|').find((x) => /^\d{4}-\d\d-\d\d$/.test(x)) ?? '');
          openCreate({
            slug, title: w?.title ?? '', date: sel && sel >= calToday() ? sel : '', start: last?.start ?? '', end: last?.end,
            price: last?.price ?? (Number(String(w?.price ?? '').replace(/[^\d]/g, '')) || null), seats: last?.seats ?? null, location: last?.location,
            approve: last?.approve, media: last?.media ?? (w?.image?.startsWith('/img/hosts/') ? [{ type: 'photo', url: w.image }] : undefined),
            ...(() => { const ed = (calListings.slug === slug ? calListings.items : []).find((x) => x.key === calSel)?.edit; return ed?.where ? { where: ed.where, place: ed.place } : last?.where ? { where: last.where, place: last.place } : {}; })(),
          } as Ev);
        }
      }

      /** Asks for a page (functions/index.js hostClaim): 'granted' for
       *  admins, 'pending' for everyone else until Jirel approves. */
      const claim = async (s: string, name: string, note: string, invite = ''): Promise<string> => {
        const token = await auth.currentUser?.getIdToken();
        const res = await fetch(`${cfg.functions}/hostClaim`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ slug: s, name, note, ...(invite ? { invite } : {}) }),
        });
        if (!res.ok) throw new Error(String(res.status));
        return (await res.json()).status;
      };
      const claimForm = $<HTMLFormElement>('[data-ha-claim]');
      claimForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = new FormData(claimForm);
        const btn = claimForm.querySelector<HTMLButtonElement>('button')!;
        btn.disabled = true; btn.textContent = t.saving;
        try {
          await claim(String(f.get('slug')), String(f.get('name') ?? ''), String(f.get('note') ?? ''));
          claimForm.querySelectorAll('label').forEach((l) => { l.hidden = true; });
          btn.hidden = true;
          note(claimForm, t.claimSent, true);
        } catch {
          btn.disabled = false; btn.textContent = t.claimSend;
          note(claimForm, fill(t.error, cfg.contact), false);
        }
      });

      const start = async (user: { email: string | null } | null) => {
        if (!user?.email) {
          signin.hidden = false;
          // Arrived from "Sign in": the cursor waits in the email field.
          signin.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
          return;
        }
        email = user.email.toLowerCase();
        // Two-factor on, and this session hasn't passed the app code yet:
        // ask for it before anything else shows.
        if (await tfaNeeded()) { signin.hidden = true; showTfa(); return; }
        showWelcome(auth.currentUser);
        signin.hidden = true;
        app.hidden = false;
        $('[data-ha-who]').textContent = email;
        $('[data-hs-email]').textContent = email;
        void loadStats();
        const settingsReady = loadSettings();
        void loadTfa();
        void loadPayments();
        // Say hello for "Active devices"; a device signed out elsewhere leaves here.
        void authed('accountDevices', { action: 'touch', device: deviceId }).then(async ({ j }) => {
          if (j?.signOut) { await signOut(auth); rememberSignedIn(false); location.reload(); return; }
          if (j?.unpaused) { const n = $('[data-ha-back]'); n.hidden = false; setTimeout(() => { n.hidden = true; }, 9000); }
          void loadDevices();
        }).catch(() => {});
        $('[data-ha-menu-name]').textContent = auth.currentUser?.displayName || email.split('@')[0];
        paintAvatars(); // the photo straight away, not the emoji first
        root.classList.add('is-in');
        if (subPath()) openView(subPath());
        rememberSignedIn(true);
        const invited = pendingInvite();
        if (invited) {
          try { await claim(invited.slug, '', '', invited.invite); } catch { /* bad or used link: the claim form is still there */ }
          try { localStorage.removeItem(INVITE); } catch { /* private mode */ }
          history.replaceState(null, '', location.pathname);
        }
        let slugs: string[] = [];
        // Whether this is Jirel: the server says, so no address is in the page.
        // Asked at the same time as the membership, not one after the other.
        const whoami = (async () => {
          try {
            const token = await auth.currentUser?.getIdToken();
            const r = await fetch(`${cfg.functions}/hostClaim`, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify({ whoami: true }) });
            return !!(await r.json()).admin;
          } catch { return false; }
        })();
        try {
          const m = await getDoc(doc(db, 'hostMembers', email));
          slugs = ((m.data()?.slugs as string[] | undefined) ?? []).filter((s) => hosts[s]);
          // A second page of the same host (Pia's Christmas painting) comes along.
          const LINKED: Record<string, string[]> = { pia: ['pia-christmas'] };
          slugs = [...new Set([...slugs, ...slugs.flatMap((s) => LINKED[s] ?? []).filter((s) => hosts[s])])];
          const pct = Number(m.data()?.commissionPct);
          if (Number.isFinite(pct)) feePct = Math.max(0, Math.min(30, pct));
        } catch { /* not a member: no read access */ }
        const admin = await whoami;
        isAdmin = admin;
        if (admin) {
          // Jirel: every host in the picker; opening one asks the server to
          // add it to her hostMembers first, so the rules let her save.
          const all = Object.keys(hosts).sort((a, b) => hosts[a].name.localeCompare(hosts[b].name));
          pick.replaceChildren(...all.map((s) => new Option(hostLabel(s), s)));
          $('[data-ha-pick-wrap] span').textContent = document.documentElement.lang === 'en' ? 'Open a host' : 'Host öffnen';
          $('[data-ha-pick-wrap]').dataset.admin = '1';
          $('[data-ha-invite-admin]').hidden = false;
          pick.addEventListener('change', async () => {
            try { if (!slugs.includes(pick.value) && (await claim(pick.value, '', '')) === 'granted') slugs.push(pick.value); } catch (err) { console.warn('admin claim', pick.value, err); }
            openHost(pick.value).catch(failed);
          });
          $('[data-ha-pick-wrap]').hidden = false;
          const first = slugs[0] ?? all.find((s) => s === 'test-jirel') ?? all[0];
          pick.value = first;
          try {
            if (!slugs.includes(first) && (await claim(first, '', '')) === 'granted') slugs.push(first);
          } catch (err) { console.warn('admin claim', first, err); }
          await openHost(first);
          return;
        }
        if (!slugs.length) {
          // A host we already know by email (functions/hostEmails.json) gets
          // their page straight away.
          try {
            const r = await api('hostClaim', { auto: true });
            slugs = ((r.slugs as string[] | undefined) ?? []).filter((x) => hosts[x]);
          } catch { /* not a known host */ }
        }
        if (!slugs.length) {
          $('[data-ha-notyet]').hidden = false;
          claimForm.hidden = false;
          return;
        }
        // Until the host picks a language in Präferenzen, the dashboard opens
        // in theirs: German or English, as we write to them (Jirel 19.11.26).
        void settingsReady.then(() => {
          const want = (JSON.parse(root.dataset.hostLang || '{}') as Record<string, string>)[slugs[0]];
          if (want && !(us.langAt && us.lang) && want !== root.dataset.lang) void switchLang(want);
        });
        if (slugs.length > 1) {
          pick.replaceChildren(...slugs.map((s) => new Option(hostLabel(s), s)));
          pick.addEventListener('change', () => { openHost(pick.value).catch(failed); });
          $('[data-ha-pick-wrap]').hidden = false;
        }
        await openHost(slugs[0]);
      };

      // If loading the account fails, say so (with the reason) instead of
      // leaving an empty page under the header (Jirel, 12.11.26).
      const failed = (err: unknown) => {
        console.error('host account', err);
        const box = $('[data-ha-nohost]');
        const why = err instanceof Error ? err.message : String(err);
        box.textContent = `${fill(t.error, cfg.contact)} (${why})`;
        box.hidden = false;
      };
      // ?demo=calendar: the Calendar tab with made-up dates for Pia, to look
      // at without signing in. Nothing is loaded from or saved to the server
      // (api() refuses in demo mode).
      // Jirel: copy the personal invite link (?invite=…&page=slug) for the host in the picker.
      const inviteMsg = $('[data-ha-invite-msg]');
      $('[data-ha-invite-copy]').addEventListener('click', async (e) => {
        e.stopPropagation();
        const s = pick.value || slug;
        inviteMsg.textContent = t.saving;
        try {
          const q = new URLSearchParams(location.search);
          const link: { slug: string; invite: string; claimedBy?: string } | undefined = DEMO
            ? { slug: s, invite: 'demo-signature', claimedBy: q.get('claimed') ?? '' }
            : (await api('hostInviteLinks', { slugs: [s] })).links?.[0];
          if (!link?.invite) throw new Error('no link');
          const url = `https://www.twiggli.com${pageFor(root.dataset.lang || 'en')}?invite=${encodeURIComponent(link.invite)}&page=${encodeURIComponent(link.slug)}`;
          let copied = true;
          try { await navigator.clipboard.writeText(url); } catch { copied = false; }
          inviteMsg.replaceChildren(
            el('span', link.claimedBy ? 'is-warn' : '', link.claimedBy ? say(t.cal.inviteClaimed, { who: link.claimedBy }) : say(copied ? t.cal.inviteCopied : t.cal.inviteHere, { name: hosts[s]?.name ?? s })),
            el('code', '', url),
          );
        } catch { inviteMsg.textContent = t.cal.inviteFail; }
      });
      const startDemo = () => {
        slug = hosts.pia ? 'pia' : '';
        const q = new URLSearchParams(location.search);
        if (q.get('admin')) {
          const s = hosts[q.get('host') ?? ''] ? q.get('host')! : slug;
          pick.replaceChildren(new Option(`${hosts[s]?.name ?? s} · ${hosts[s]?.en.specialty ?? ''}`, s));
          pick.value = s;
          $('[data-ha-pick-wrap]').hidden = false;
          $('[data-ha-invite-admin]').hidden = false;
          isAdmin = true;
        }
        if (q.get('demo') === 'addr') {
          slug = hosts.pia ? 'pia' : slug;
          signin.hidden = true; app.hidden = false; editor.hidden = false;
          $('[data-ha-tabs]').hidden = false;
          root.classList.add('is-in');
          $('[data-ha-hello]').textContent = `${t.hello} Pia 👋`;
          $('[data-ha-menu-name]').textContent = 'Pia';
          ownEvents = []; reqs = []; calBookings = [];
          calDemo = { workshops: null };
          // Made up for the demo (no real address in this repo).
          myStudio = { street: 'Musterstr. 12', zip: '10245', district: 'Friedrichshain', vis: q.get('vis') ?? 'district', howTo: 'Ring “Studio”, 2nd floor' };
          const view = q.get('view') ?? 'settings';
          if (view === 'settings') {
            showTab('settings');
            studioForm.hidden = false;
            sf('studio').value = '';
            putStudio(myStudio);
            const f = $<HTMLFormElement>('[data-hs-form]');
            (f.elements.namedItem('first') as HTMLInputElement).value = 'Pia';
            $('[data-hs-email]').textContent = 'pia@example.com';
          } else if (view === 'create') {
            openCreate({ slug, title: 'Vulva painting with Pia', date: '2026-11-27', start: '18:30', end: '21:00', price: 40, seats: 10, ...(q.get('where') === 'other' ? { where: 'other', place: { name: 'Café Lotte', street: 'Beispielweg 4', zip: '12045', district: 'Neukölln', vis: 'street' } } : {}) } as Ev);
          } else {
            showTab('calendar');
            const w = calWorkshops()[0];
            if (w) calEditWs(w);
          }
          root.querySelectorAll<HTMLElement>('[data-wh]').forEach((b) => whereUI(b).paint());
          return;
        }
        if (q.get('demo') === 'site') {
          // That host's real dates from the site's own data; no dashboard dates, nothing saved.
          slug = hosts[q.get('host') ?? ''] ? q.get('host')! : slug;
          signin.hidden = true; app.hidden = false; editor.hidden = false;
          $('[data-ha-tabs]').hidden = false;
          root.classList.add('is-in');
          const first = (hosts[slug]?.name ?? '').split(' ')[0];
          $('[data-ha-hello]').textContent = `${t.hello} ${first} 👋`;
          $('[data-ha-menu-name]').textContent = hosts[slug]?.name ?? '';
          $('[data-cal-demo]').hidden = false;
          ownEvents = []; reqs = []; calBookings = [];
          calDemo = { workshops: null };
          // The tips' demo: a made-up studio and Stripe for a live host, none
          // for a draft (?studio=0|1, ?stripe=0|1 to try the others).
          const draft = !!hosts[slug]?.draft;
          studioKnown = true;
          myStudio = (q.get('studio') ?? (draft ? '0' : '1')) === '1' ? { street: 'Musterstr. 12', zip: '10245', district: 'Friedrichshain', vis: 'district', howTo: '' } : null;
          stripeReady = (q.get('stripe') ?? (draft ? '0' : '1')) === '1';
          void paintDraft(slug);
          showTab(q.get('tab') === 'overview' ? 'overview' : 'calendar');
          return;
        }
        signin.hidden = true;
        app.hidden = false;
        editor.hidden = false;
        $('[data-ha-tabs]').hidden = false;
        root.classList.add('is-in');
        $('[data-ha-hello]').textContent = `${t.hello} Pia 👋`;
        $('[data-ha-menu-name]').textContent = 'Pia';
        $('[data-cal-demo]').hidden = false;
        const VULVA = 'Vulva painting';
        const base = { slug: 'pia', price: 40, seats: 10, location: 'Friedrichshain', approve: true, cancel: '7d', visibility: 'public', media: [{ type: 'photo', url: '/video/pia-vulva-poster.jpg' }] };
        ownEvents = [
          { ...base, id: 'demoTuesday01', title: VULVA, date: '2026-11-03', start: '18:30', end: '21:00', repeat: 'weekly', exceptions: ['2026-12-22'] },
          { ...base, id: 'demoFriday001', title: VULVA, date: '2026-11-06', start: '18:30', end: '21:00', repeat: 'weekly', seatsByDate: { '2026-12-18': 12 } },
          { ...base, id: 'demoSaturday1', title: VULVA, date: '2026-11-07', start: '11:00', end: '13:30', repeat: 'weekly' },
          { ...base, id: 'demoSunday001', title: VULVA, date: '2026-11-08', start: '11:00', end: '13:30', repeat: 'biweekly', until: '2027-04-30' },
          { slug: 'pia', id: 'demoOffice001', title: 'At your office', date: '2026-12-09', start: '14:00', end: '16:30', repeat: 'once', price: 45, seats: 12, location: 'Your office, Berlin', approve: true, media: [{ type: 'photo', url: '/img/hosts/pia-6.jpg' }] },
        ];
        const bk = (date: string, start: string, people: number, name: string, id = '') => ({ eventId: id, date, start, title: VULVA, people, name, amount: people * 40 });
        calBookings = [
          bk('2026-11-13', '18:30', 9, 'Lea'), bk('2026-11-14', '11:00', 6, 'Tom'), bk('2026-11-17', '18:30', 7, 'Nora'),
          bk('2026-11-20', '18:30', 4, 'Ida'), bk('2026-11-21', '11:00', 5, 'Ben'), bk('2026-11-21', '11:00', 3, 'Kim'),
          bk('2026-11-24', '18:30', 6, 'Sara'), bk('2026-11-27', '18:30', 6, 'Julia'), bk('2026-11-27', '18:30', 4, 'Paula'),
          bk('2026-11-28', '11:00', 3, 'Emma'), bk('2026-12-01', '18:30', 2, 'Clara'), bk('2026-12-04', '18:30', 5, 'Nina'),
          bk('2026-12-05', '11:00', 8, 'Marie'), bk('2026-12-11', '18:30', 4, 'Lina'), bk('2026-12-19', '11:00', 2, 'Zoe'),
        ];
        // A few lines from guests, as they come with a booking (and one answer).
        calBookings = calBookings.map((b, i) => ({ ...b, id: `demoBk${i}`, paidAt: Date.now() - i * 3600000, fee: Math.round((b.amount ?? 0) * 15) / 100, pct: 15 }));
        for (const b of calBookings) {
          if (b.name === 'Julia') b.message = 'Hi Pia! It’s my sister’s birthday, she’s one of the six. Could we sit together? 🎨';
          if (b.name === 'Marie') { b.message = 'Is there anything I should bring?'; b.thread = [{ from: 'host', message: 'Nothing at all, just come as you are! 😊', at: Date.now() - 1800000 }]; }
        }
        const rq = (id: string, name: string, workshop: string, date: string, time: string, people: number, status = 'pending') =>
          ({ id, subject: workshop, status, thread: [], createdAt: Date.now() - 5 * 3600000, fields: { Name: name, Workshop: workshop, Date: date, Time: time, People: String(people), ...(workshop === VULVA ? { Price: '40' } : {}) } });
        reqs = [
          rq('demoAnna', 'Anna', VULVA, '2026-11-27', '18:30', 1), rq('demoMia', 'Mia', VULVA, '2026-11-27', '18:30', 1),
          { ...rq('demoLena', 'Lena', VULVA, '2026-12-05', '11:00', 2), fields: { Name: 'Lena', Workshop: VULVA, Date: '2026-12-05', Time: '11:00', People: '2', Price: '40', Message: 'We’re two beginners, is that okay? We’d love to paint something for our flat.' } },
          // Paid with a Twiggli voucher and a card, held until Pia approves.
          { ...rq('demoTom', 'Tom', VULVA, '2026-12-11', '18:30', 2), fields: { Name: 'Tom', Workshop: VULVA, Date: '2026-12-11', Time: '18:30', People: '2', Price: '40', Message: 'A surprise for my girlfriend’s birthday 🎁' }, hold: { voucher: 50, card: 30, settled: '' } },
          // A group asked; Pia sent an offer (Twiggli passes it on).
          { ...rq('demoJonas', 'Jonas', 'Private group', '2026-12-12', '15:00', 8, 'offered'), fields: { Name: 'Jonas', Workshop: 'Private group', Date: '2026-12-12', Time: '15:00', People: '8', Message: 'Team event for 8, could we do it on a Saturday afternoon?' },
            thread: [{ action: 'offer', at: Date.now() - 3 * 3600000, total: 320, when: 'Sat 12 Dec 15:00', people: 8, workshop: 'Private group', message: 'Happy to! Snacks included.' } as Req['thread'][number]] },
          rq('demoSophie', 'Sophie', 'At your office', '2026-12-09', '14:00', 12, 'accepted'),
        ];
        calDemo = { workshops: [
          { title: VULVA, key: calKey(VULVA), image: '/video/pia-vulva-poster.jpg', color: CAL_COLORS[0], price: '€40' },
          { title: 'Private group', key: calKey('Private group'), image: '/img/hosts/pia-3.jpg', color: CAL_COLORS[1], price: '€40' },
          { title: 'At your office', key: calKey('At your office'), image: '/img/hosts/pia-6.jpg', color: CAL_COLORS[2], price: '€45' },
        ] };
        const variant = new URLSearchParams(location.search).get('case');
        if (variant === 'one') { calDemo.workshops = calDemo.workshops.slice(0, 1); ownEvents = ownEvents.filter((e) => e.title === VULVA); reqs = reqs.filter((r) => r.fields.Workshop === VULVA); }
        if (variant === 'empty') { calDemo.workshops = []; ownEvents = []; reqs = []; calBookings = []; }
        calSel = calKey(VULVA);
        showTab('calendar');
        openFromMail();
      };
      if (DEMO) startDemo();
      else finishSignIn().finally(() => {
        let once = false;
        // Sessions end on their own after SESSION_HOURS (lib/auth.ts), also
        // in a tab left open: then the page signs out and reloads.
        const expire = async () => {
          await signOut(auth);
          rememberSignedIn(false);
          try { sessionStorage.setItem('twiggli-host-timedout', '1'); } catch { /* private mode */ }
          location.reload();
        };
        onAuthStateChanged(auth, (user) => {
          if (once) return;
          once = true;
          if (user && sessionLeft(user) <= 0) { expire().catch(failed); return; }
          if (user) setTimeout(() => { expire().catch(failed); }, Math.min(sessionLeft(user), 2 ** 31 - 1));
          else {
            let out = false;
            try { out = sessionStorage.getItem('twiggli-host-timedout') === '1'; sessionStorage.removeItem('twiggli-host-timedout'); } catch { /* private mode */ }
            if (out) note(signin, signin.dataset.timedout ?? '', true);
          }
          start(user).catch(failed);
        });
      });
    }
  }
</script>

