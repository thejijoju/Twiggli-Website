  .ha-vid-bar::-moz-progress-bar { background: var(--color-accent); border-radius: 99px; }
  .hd-thumb { position: relative; }
  .hd-thumb .hd-thumb-v { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5); }
  .hd-thumb-busy, .cal-ws-busy { display: grid; place-items: center; width: 100%; height: 100%; padding: 4px; font-size: 0.62rem; line-height: 1.15; text-align: center; color: var(--color-text-muted); background: repeating-linear-gradient(-45deg, #f4efe6 0 8px, #ebe3d6 8px 16px); background-size: 200% 200%; animation: ha-busy 2.4s linear infinite; }
  .hd-thumb-busy + .hd-thumb-v, .cal-ws-busy + .cal-ws-vid { display: none; }
