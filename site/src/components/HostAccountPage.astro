                <select name="district"><option value="">–</option>{berlinDistricts.map((d) => <option>{d}</option>)}</select>
                <small class="hs-auto" data-hs-auto hidden>{L('Aus der PLZ ergänzt', 'Filled in from the postcode', 'Complété depuis le code postal')}</small>
              </label>
            </div>
            <div class="hs-vis" data-hs-vis
              data-see={L('Gäste sehen:', 'Guests see:', 'On voit :')}
              data-after={L('ganze Adresse nach der Buchung', 'full address after booking', 'adresse complète après la réservation')}>
              <span class="hd-set-lbl">{L('Was Gäste vor der Buchung sehen', 'What guests see before booking', 'Ce que l’on voit avant de réserver')}</span>
