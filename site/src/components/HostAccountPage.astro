---
/**
 * The host account (/host/account/, /de/host/account/), step 1: a host signs
 * in with an email link (Firebase Authentication, no password), then edits
 * their page text in English and German and their weekly schedule. Saves go
 * to Firestore (hostProfiles, hostSlots; who may edit which page is
 * hostMembers, see firestore.rules at the repo root). The
 * site is static: the next deploy fetches the edits and lays them over the
 * copy (hostEdits.ts), at the latest with the daily morning build.
 *
 * Vouchers and requests are announced as tabs and come next.
 */
import Base from '../layouts/Base.astro';
import { getHosts } from '../data/content.ts';
import { hostAccountCopy } from '../data/hostAccount.ts';
import { firebaseConfig, firebaseReady, functionsBase } from '../data/firebase.ts';
import { contactEmail, requestEmail } from '../data/site.ts';
import liveData from '../data/live-workshops.json';
import { href, type Lang } from '../lib/url.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = hostAccountCopy(lang);

/* What the site shows today for every host, so the form opens with it
   when the host has not saved anything yet. Public data anyway. */
const pick = (h: Record<string, unknown>) => ({
  specialty: h.specialty ?? '', studio: h.studio ?? '', blurb: h.blurb ?? '', group_size: h.group ?? '',
  duration: h.duration ?? '', place: h.place ?? '', languages: h.languages ?? '', price_note: h.priceNote ?? '',
});
const de = new Map(getHosts('de', { withPreview: true }).map((h) => [h.slug, h]));
const recurring = (liveData as { recurring?: { slug: string; title: string; weekdays: string[]; time: string; duration?: string; price?: string }[] }).recurring ?? [];
const hosts = Object.fromEntries(
  getHosts('en', { withPreview: true }).map((h) => [h.slug, {
    name: h.name,
    page: href(lang, `/workshops/${h.activity}/${h.slug}/`),
    en: pick(h as unknown as Record<string, unknown>),
    de: pick((de.get(h.slug) ?? h) as unknown as Record<string, unknown>),
    slots: recurring.filter((r) => r.slug === h.slug).map((r) => ({
      title: r.title, weekdays: r.weekdays, time: r.time, duration: r.duration ?? '',
      price: Number((r.price ?? '').match(/\d+/)?.[0] ?? '') || null,
    })),
  }]),
);
/** Every page a host could claim, by name (the test page included). */
const claimList = getHosts('en', { withPreview: true })
  .map((h) => ({ slug: h.slug, label: `${h.name} · ${h.specialty}` }))
  .sort((a, b) => a.label.localeCompare(b.label));
const config = {
  firebase: firebaseConfig,
  ready: firebaseReady,
  contact: contactEmail,
  inbox: requestEmail,
  functions: functionsBase,
  // May open every host (functions/index.js ADMINS checks it again).
  admins: ['jirel.kuenen@gmail.com', 'jirelkuenen@gmail.com', 'hello@twiggli.com'],
};
const fields = [
  ['specialty', t.fSpecialty, t.fSpecialtyHint, 'input', 80],
  ['studio', t.fStudio, '', 'input', 80],
  ['blurb', t.fBlurb, t.fBlurbHint, 'textarea', 1500],
  ['group_size', t.fGroup, t.fGroupHint, 'input', 80],
  ['duration', t.fDuration, '', 'input', 40],
  ['place', t.fPlace, '', 'input', 120],
  ['languages', t.fLanguages, '', 'input', 40],
  ['price_note', t.fPriceNote, '', 'input', 120],
] as const;
---

<Base title={t.pageTitle} description={t.lede} lang={lang} pageClass="ha-page" noindex translations={['en', 'de']}>
  <section
    class="ha container"
    data-ha
    data-lang={lang}
    data-config={JSON.stringify(config)}
    data-hosts={JSON.stringify(hosts)}
    data-copy={JSON.stringify(t)}
  >
    <header class="ha-head">
      <h1>{t.title}</h1>
      <p class="ha-lede">{t.lede}</p>
    </header>

    <!-- Before Firebase is set up (data/firebase.ts). -->
    <p class="ha-card ha-note" data-ha-soon hidden></p>

    <!-- Signed out: one field, one button. -->
    <form class="ha-card ha-signin" data-ha-signin hidden>
      <p class="ha-invite" data-ha-invite-note hidden></p>
      <label>
        <span>{t.email}</span>
        <input type="email" name="email" required autocomplete="email" placeholder={t.emailPh} />
      </label>
      <button type="submit" class="ha-btn">{t.sendLink}</button>
      <p class="ha-note" data-ha-signin-note role="status"></p>
      <hr class="ha-sep" />
      <button type="button" class="ha-btn ha-google" data-ha-google>
        <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        {t.google}
      </button>
    </form>

    <!-- Signed in. -->
    <div class="ha-app" data-ha-app hidden>
      <div class="ha-bar">
        <span data-ha-who></span>
        <label class="ha-pick" data-ha-pick-wrap hidden>
          <span>{t.hostPick}</span>
          <select data-ha-pick></select>
        </label>
        <a class="ha-link" data-ha-view target="_blank" rel="noopener">{t.viewPage} ↗</a>
        <button type="button" class="ha-link" data-ha-signout>{t.signOut}</button>
      </div>
      <p class="ha-card ha-note" data-ha-nohost hidden></p>

      <!-- No page yet: ask for one. Jirel approves by email (functions/index.js hostClaim). -->
      <form class="ha-card ha-claim" data-ha-claim hidden>
        <h2>{t.claimTitle}</h2>
        <p class="ha-lede">{t.claimLede}</p>
        <label>
          <span>{t.claimPage}</span>
          <select name="slug" required>
            <option value="">{t.claimPagePh}</option>
            {claimList.map((h) => <option value={h.slug}>{h.label}</option>)}
          </select>
        </label>
        <label><span>{t.claimName}</span><input name="name" required autocomplete="name" /></label>
        <label><span>{t.claimNote}</span><textarea name="note" rows="2" placeholder={t.claimNotePh}></textarea></label>
        <div class="ha-save"><button type="submit" class="ha-btn">{t.claimSend}</button><p class="ha-note" role="status"></p></div>
      </form>

      <div data-ha-editor hidden>
        <nav class="ha-tabs" role="tablist">
          <button type="button" role="tab" aria-selected="false" data-ha-tab="today"><span aria-hidden="true">📖</span>{t.tabToday}</button>
          <button type="button" role="tab" aria-selected="false" data-ha-tab="calendar"><span aria-hidden="true">📅</span>{t.tabCalendar}</button>
          <button type="button" role="tab" aria-selected="false" data-ha-tab="listings"><span aria-hidden="true">🏷️</span>{t.tabListings}</button>
          <button type="button" role="tab" aria-selected="true" data-ha-tab="messages"><span aria-hidden="true">💬</span>{t.tabMessages}<i class="ha-dot" data-ha-dot hidden></i></button>
          <button type="button" role="tab" aria-selected="false" data-ha-tab="invites" data-ha-admin-only hidden><span aria-hidden="true">✉️</span>{t.tabInvites}</button>
        </nav>

        <!-- Messages: every request for this host, newest first (functions hostInbox). -->
        <section data-ha-panel="messages">
          <h2 class="ha-h">{t.tabMessages}</h2>
          <div class="ha-pills" data-ha-filter>
            <button type="button" aria-pressed="true" data-f="all">{t.fAll}</button>
            <button type="button" aria-pressed="false" data-f="pending">{t.fPending}</button>
            <button type="button" aria-pressed="false" data-f="accepted">{t.fConfirmed}</button>
          </div>
          <ul class="ha-msgs" data-ha-msgs></ul>
          <p class="ha-empty" data-ha-msgs-empty hidden>{t.msgsEmpty}</p>
          <div class="ha-card ha-detail" data-ha-detail hidden></div>
        </section>

        <!-- Today: what happens today and next. -->
        <section data-ha-panel="today" hidden>
          <div class="ha-pills" data-ha-when>
            <button type="button" aria-pressed="true" data-w="today">{t.wToday}</button>
            <button type="button" aria-pressed="false" data-w="upcoming">{t.wUpcoming}</button>
          </div>
          <ul class="ha-msgs" data-ha-today></ul>
          <div class="ha-empty-big" data-ha-today-empty hidden><span aria-hidden="true">📖</span><h2>{t.todayEmpty}</h2></div>
        </section>

        <!-- Admin: personal invite links to email to the hosts. -->
        <section data-ha-panel="invites" hidden>
          <h2 class="ha-h">{t.tabInvites}</h2>
          <p class="ha-lede">{t.invitesLede}</p>
          <button type="button" class="ha-btn" data-ha-invites-load>{t.invitesLoad}</button>
          <table class="ha-invites" data-ha-invites></table>
        </section>

        <form class="ha-card" data-ha-panel="listings" hidden>
          <div class="ha-langs" role="radiogroup" aria-label={t.textIn}>
            <span>{t.textIn}</span>
            <label><input type="radio" name="textlang" value="en" checked /> English</label>
            <label><input type="radio" name="textlang" value="de" /> Deutsch</label>
          </div>
          {fields.map(([name, label, hint, kind, max]) => (
            <label class="ha-field">
              <span>{label}</span>
              {kind === 'textarea'
                ? <textarea name={name} rows="8" maxlength={max}></textarea>
                : <input name={name} maxlength={max} />}
              {hint && <small>{hint}</small>}
            </label>
          ))}
          <div class="ha-save">
            <button type="submit" class="ha-btn">{t.save}</button>
            <p class="ha-note" role="status"></p>
          </div>
        </form>

        <form class="ha-card" data-ha-panel="calendar" hidden>
          <p class="ha-lede">{t.scheduleLede}</p>
          <div data-ha-slots></div>
          <p class="ha-note" data-ha-noslots hidden>{t.noSlots}</p>
          <button type="button" class="ha-link" data-ha-addslot>{t.addSlot}</button>
          <div class="ha-save">
            <button type="submit" class="ha-btn">{t.save}</button>
            <p class="ha-note" role="status"></p>
          </div>
        </form>

      </div>
    </div>

    <template data-ha-slot-tpl>
      <fieldset class="ha-slot">
        <label class="ha-field"><span>{t.slotTitle}</span><input name="title" required maxlength="120" /></label>
        <div class="ha-field">
          <span>{t.slotDays}</span>
          <div class="ha-days">
            {['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'].map((d, i) => (
              <label><input type="checkbox" name="day" value={d} /> {t.days[i]}</label>
            ))}
          </div>
        </div>
        <div class="ha-row">
          <label class="ha-field"><span>{t.slotTime}</span><input type="time" name="time" required /></label>
          <label class="ha-field"><span>{t.slotDuration}</span><input name="duration" maxlength="40" placeholder="2.5 h" /></label>
          <label class="ha-field"><span>{t.slotPrice}</span><input type="number" name="price" min="0" max="2000" step="1" /></label>
        </div>
        <button type="button" class="ha-link ha-remove" data-ha-remove>{t.removeSlot}</button>
      </fieldset>
    </template>
  </section>
</Base>

<script>
  import { formEndpoint } from '../data/firebase.ts';
  import { initializeApp } from 'firebase/app';
  import {
    getAuth, isSignInWithEmailLink, onAuthStateChanged, sendSignInLinkToEmail, signInWithEmailLink, signOut,
  } from 'firebase/auth';
  import {
    collection, doc, getDoc, getDocs, getFirestore, query, setDoc, where, writeBatch,
  } from 'firebase/firestore';

  type Profile = Record<string, string>;
  type Slot = { title: string; weekdays: string[]; time: string; duration?: string | null; price?: number | null };
  type HostData = { name: string; page: string; en: Profile; de: Profile; slots: Slot[] };

  const root = document.querySelector<HTMLElement>('[data-ha]');
  if (root) {
    const cfg = JSON.parse(root.dataset.config || '{}');
    const hosts: Record<string, HostData> = JSON.parse(root.dataset.hosts || '{}');
    const t: Record<string, string> = JSON.parse(root.dataset.copy || '{}');
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const fill = (s: string, email: string) => s.replace('{email}', email);
    const signin = $<HTMLFormElement>('[data-ha-signin]');

    if (!cfg.ready) {
      // Accounts open once Firebase is set up; until then, say so.
      const p = $('[data-ha-soon]');
      p.textContent = fill(t.soon, cfg.contact);
      p.hidden = false;
    } else {
      const app0 = initializeApp(cfg.firebase);
      const auth = getAuth(app0);
      const db = getFirestore(app0);
      const STORE = 'twiggli-host-signin-email';

      const app = $('[data-ha-app]');
      const editor = $('[data-ha-editor]');
      const pick = $<HTMLSelectElement>('[data-ha-pick]');
      const pageForm = $<HTMLFormElement>('[data-ha-panel="listings"]');
      const slotForm = $<HTMLFormElement>('[data-ha-panel="calendar"]');
      const slotsBox = $('[data-ha-slots]');
      const tpl = $<HTMLTemplateElement>('[data-ha-slot-tpl]');
      let email = '';
      let slug = '';
      // Saved texts per language for the current host (from Firestore, else the site).
      let texts: Record<'en' | 'de', Profile> = { en: {}, de: {} };
      let textLang: 'en' | 'de' = 'en';

      const note = (form: HTMLElement, msg: string, ok = true) => {
        const p = form.querySelector<HTMLElement>('.ha-save .ha-note, [data-ha-signin-note]');
        if (p) { p.textContent = msg; p.dataset.ok = String(ok); }
      };
      const remember = (v: string) => { try { localStorage.setItem(STORE, v); } catch { /* private mode */ } };
      const recall = () => { try { return localStorage.getItem(STORE) ?? ''; } catch { return ''; } };

      // ── Signing in: an email link, no password ──
      signin.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = signin.querySelector('button')!;
        const addr = (signin.elements.namedItem('email') as HTMLInputElement).value.trim();
        btn.disabled = true; btn.textContent = t.sending;
        try {
          await sendSignInLinkToEmail(auth, addr, { url: location.origin + location.pathname, handleCodeInApp: true });
          remember(addr);
          note(signin, t.linkSent, true);
        } catch {
          note(signin, fill(t.error, cfg.contact), false);
        }
        btn.disabled = false; btn.textContent = t.sendLink;
      });
      $('[data-ha-signout]').addEventListener('click', async () => {
        await signOut(auth);
        location.reload();
      });

      // Coming back from the link in the email.
      const finishSignIn = async () => {
        if (!isSignInWithEmailLink(auth, location.href)) return;
        // Opened on another device: ask which email the link went to.
        const addr = recall() || window.prompt(t.email) || '';
        try {
          await signInWithEmailLink(auth, addr, location.href);
          try { localStorage.removeItem(STORE); } catch { /* private mode */ }
        } catch {
          signin.hidden = false;
          note(signin, fill(t.error, cfg.contact), false);
        }
        history.replaceState(null, '', location.pathname);
      };

      // ── Tabs ──
      root.querySelectorAll<HTMLButtonElement>('[data-ha-tab]').forEach((tab) => {
        tab.addEventListener('click', () => {
          root.querySelectorAll<HTMLButtonElement>('[data-ha-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === tab)));
          root.querySelectorAll<HTMLElement>('[data-ha-panel]').forEach((p) => { p.hidden = p.dataset.haPanel !== tab.dataset.haTab; });
        });
      });

      // ── Page text ──
      const showText = () => {
        for (const [k, v] of Object.entries(texts[textLang])) {
          const el = pageForm.elements.namedItem(k) as HTMLInputElement | HTMLTextAreaElement | null;
          if (el) el.value = v ?? '';
        }
      };
      const readText = (): Profile => {
        const out: Profile = {};
        for (const k of Object.keys(hosts[slug].en)) {
          out[k] = ((pageForm.elements.namedItem(k) as HTMLInputElement | null)?.value ?? '').trim();
        }
        return out;
      };
      pageForm.querySelectorAll<HTMLInputElement>('input[name="textlang"]').forEach((r) => {
        r.addEventListener('change', () => {
          texts[textLang] = readText(); // keep what was typed when switching
          textLang = r.value as 'en' | 'de';
          showText();
        });
      });
      pageForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        texts[textLang] = readText();
        const btn = pageForm.querySelector<HTMLButtonElement>('.ha-save button')!;
        btn.disabled = true; btn.textContent = t.saving;
        let ok = true;
        try {
          await setDoc(doc(db, 'hostProfiles', `${slug}_${textLang}`), {
            slug, lang: textLang, ...texts[textLang], updated_at: new Date().toISOString(), updated_by: email,
          });
        } catch { ok = false; }
        btn.disabled = false; btn.textContent = t.save;
        note(pageForm, ok ? t.saved : fill(t.error, cfg.contact), ok);
        if (ok) tellUs(`page text (${textLang})`);
      });

      // ── Weekly schedule ──
      const addSlot = (s?: Slot) => {
        const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const q = <T extends HTMLInputElement>(n: string) => node.querySelector<T>(`[name="${n}"]`)!;
        if (s) {
          q('title').value = s.title;
          q('time').value = s.time;
          q('duration').value = s.duration ?? '';
          q('price').value = s.price ? String(s.price) : '';
          node.querySelectorAll<HTMLInputElement>('[name="day"]').forEach((d) => { d.checked = s.weekdays.includes(d.value); });
        } else {
          q('title').value = hosts[slug]?.en.specialty ?? '';
        }
        node.querySelector('[data-ha-remove]')!.addEventListener('click', () => { node.remove(); emptyHint(); });
        slotsBox.append(node);
        emptyHint();
      };
      const emptyHint = () => { $('[data-ha-noslots]').hidden = slotsBox.children.length > 0; };
      $('[data-ha-addslot]').addEventListener('click', () => addSlot());
      slotForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const rows = Array.from(slotsBox.querySelectorAll<HTMLElement>('.ha-slot')).map((n) => {
          const v = (k: string) => n.querySelector<HTMLInputElement>(`[name="${k}"]`)!.value.trim();
          return {
            slug,
            title: v('title'),
            weekdays: Array.from(n.querySelectorAll<HTMLInputElement>('[name="day"]:checked')).map((d) => d.value),
            time: v('time').slice(0, 5),
            duration: v('duration') || null,
            price: v('price') ? Math.round(Number(v('price'))) : null,
            active: true,
          };
        });
        const bad = rows.find((r) => !r.title || !r.weekdays.length || !/^\d\d:\d\d$/.test(r.time));
        if (bad) { note(slotForm, fill(t.error, cfg.contact), false); return; }
        const btn = slotForm.querySelector<HTMLButtonElement>('.ha-save button')!;
        btn.disabled = true; btn.textContent = t.saving;
        // Replace the whole schedule in one go: delete what was there, add what is here.
        let ok = true;
        try {
          const old = await getDocs(query(collection(db, 'hostSlots'), where('slug', '==', slug)));
          const batch = writeBatch(db);
          old.forEach((d) => batch.delete(d.ref));
          for (const r of rows) batch.set(doc(collection(db, 'hostSlots')), r);
          await batch.commit();
        } catch { ok = false; }
        btn.disabled = false; btn.textContent = t.save;
        note(slotForm, ok ? t.saved : fill(t.error, cfg.contact), ok);
        if (ok) tellUs('weekly schedule');
      });

      /** A note to our inbox, so Jirel sees every change a host makes. */
      const tellUs = (what: string) => {
        fetch(formEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            Type: 'Host account edit', Host: slug, Changed: what, By: email,
            _subject: `Host account edit: ${hosts[slug]?.name ?? slug} (${what})`, _template: 'table', _captcha: 'false',
          }),
        }).catch(() => {});
      };

      // ── Loading a host ──
      const openHost = async (s: string) => {
        slug = s;
        const h = hosts[s];
        $<HTMLAnchorElement>('[data-ha-view]').href = h?.page ?? '#';
        const [prof, slotSnap] = await Promise.all([
          getDocs(query(collection(db, 'hostProfiles'), where('slug', '==', s))),
          getDocs(query(collection(db, 'hostSlots'), where('slug', '==', s))),
        ]);
        const rows = prof.docs.map((d) => d.data() as Profile);
        const saved = (l: 'en' | 'de') => {
          const row = rows.find((p) => p.lang === l);
          const base = { ...(h?.[l] ?? {}) };
          if (row) for (const k of Object.keys(base)) if (row[k]) base[k] = row[k];
          return base;
        };
        texts = { en: saved('en'), de: saved('de') };
        showText();
        slotsBox.replaceChildren();
        const slots = slotSnap.docs.map((d) => d.data() as Slot & { active?: boolean })
          .filter((x) => x.active !== false)
          .sort((a, b) => a.time.localeCompare(b.time));
        for (const sl of (slots.length ? slots : h?.slots ?? [])) addSlot(sl);
        emptyHint();
        editor.hidden = false;
      };

      /** Asks for a page (functions/index.js hostClaim): 'granted' for
       *  admins, 'pending' for everyone else until Jirel approves. */
      const claim = async (s: string, name: string, note: string): Promise<string> => {
        const token = await auth.currentUser?.getIdToken();
        const res = await fetch(`${cfg.functions}/hostClaim`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ slug: s, name, note }),
        });
        if (!res.ok) throw new Error(String(res.status));
        return (await res.json()).status;
      };
      const claimForm = $<HTMLFormElement>('[data-ha-claim]');
      claimForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = new FormData(claimForm);
        const btn = claimForm.querySelector<HTMLButtonElement>('button')!;
        btn.disabled = true; btn.textContent = t.saving;
        try {
          await claim(String(f.get('slug')), String(f.get('name') ?? ''), String(f.get('note') ?? ''));
          claimForm.querySelectorAll('label').forEach((l) => { l.hidden = true; });
          btn.hidden = true;
          note(claimForm, t.claimSent, true);
        } catch {
          btn.disabled = false; btn.textContent = t.claimSend;
          note(claimForm, fill(t.error, cfg.contact), false);
        }
      });

      const start = async (user: { email: string | null } | null) => {
        if (!user?.email) { signin.hidden = false; return; }
        email = user.email.toLowerCase();
        signin.hidden = true;
        app.hidden = false;
        $('[data-ha-who]').textContent = fill(t.signedInAs, email);
        let slugs: string[] = [];
        try {
          const m = await getDoc(doc(db, 'hostMembers', email));
          slugs = ((m.data()?.slugs as string[] | undefined) ?? []).filter((s) => hosts[s]);
        } catch { /* not a member: no read access */ }
        const admin = (cfg.admins as string[]).includes(email);
        if (admin) {
          // Jirel: every host in the picker; opening one asks the server to
          // add it to her hostMembers first, so the rules let her save.
          const all = Object.keys(hosts).sort((a, b) => hosts[a].name.localeCompare(hosts[b].name));
          pick.replaceChildren(...all.map((s) => new Option(`${hosts[s].name} · ${hosts[s].en.specialty}`, s)));
          $('[data-ha-pick-wrap] span').textContent = t.adminPick;
          pick.addEventListener('change', async () => {
            if (!slugs.includes(pick.value) && (await claim(pick.value, '', '')) === 'granted') slugs.push(pick.value);
            openHost(pick.value);
          });
          $('[data-ha-pick-wrap]').hidden = false;
          const first = slugs[0] ?? all.find((s) => s === 'test-jirel') ?? all[0];
          pick.value = first;
          if (!slugs.includes(first) && (await claim(first, '', '')) === 'granted') slugs.push(first);
          await openHost(first);
          return;
        }
        if (!slugs.length) {
          claimForm.hidden = false;
          return;
        }
        if (slugs.length > 1) {
          pick.replaceChildren(...slugs.map((s) => new Option(`${hosts[s].name} · ${hosts[s].en.specialty}`, s)));
          pick.addEventListener('change', () => openHost(pick.value));
          $('[data-ha-pick-wrap]').hidden = false;
        }
        await openHost(slugs[0]);
      };

      finishSignIn().finally(() => {
        let once = false;
        onAuthStateChanged(auth, (user) => { if (!once) { once = true; start(user); } });
      });
    }
  }
</script>

