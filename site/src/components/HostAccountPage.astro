  .cal-wg-col { grid-row: 2; position: relative; border-radius: 10px; background: repeating-linear-gradient(to bottom, #fbf9fe 0, #fbf9fe calc(var(--hour) - 1px), #f1eef6 calc(var(--hour) - 1px), #f1eef6 var(--hour)); }
  .cal-wg-col.is-today { background: repeating-linear-gradient(to bottom, #f3eeff 0, #f3eeff calc(var(--hour) - 1px), #e6dff2 calc(var(--hour) - 1px), #e6dff2 var(--hour)); }
  .cal-wg-col.is-past > .cal-blk { opacity: 0.45; }
  .cal-blk { position: absolute; display: flex; flex-direction: column; align-items: flex-start; gap: 1px; overflow: hidden; box-sizing: border-box; border: 0; border-radius: 8px; padding: 4px 7px; font-size: 12px; line-height: 1.3; text-align: left; background: #6a3eec; color: #fff !important; }
  .cal-blk b { white-space: nowrap; }
