        if (stripeReady === true || stripeBox.open) return;
        fld('price').blur();
        stripeBox.showModal();
      };
      stripeBox.addEventListener('click', (e) => { if (e.target === stripeBox) stripeBox.close(); });
      const loadStripe = async () => {
        try {
          const s = await api('hostStripe', { action: 'status' });
          stripeReady = !!s.chargesEnabled;
          renderTodo();
          if (s.connected && !s.chargesEnabled) stripeBody.textContent = t.stripePending;
        } catch { stripeReady = null; }
      };
      fld('price').addEventListener('focus', showStripe);
      fld('price').addEventListener('pointerdown', (e) => { if (stripeReady !== true) { e.preventDefault(); showStripe(); } });
      const stripeLink = $<HTMLButtonElement>('[data-ha-stripe-link]');
      stripeLink.addEventListener('click', async () => {
        stripeLink.disabled = true;
        try {
          const { url } = await api('hostStripe', { action: 'link', lang: document.documentElement.lang === 'en' ? 'en' : 'de' });
          location.href = url;
        } catch (err) {
          stripeBody.textContent = /link-not-configured/.test((err as Error).message) ? t.stripeLinkOff : `${t.stripeFail} (${(err as Error).message})`;
          stripeLink.disabled = false;
        }
      });
      stripeGo.addEventListener('click', async () => {
        stripeGo.disabled = true; stripeGo.textContent = t.stripeWait;
        try {
          const { url } = await api('hostStripe', { action: 'connect', lang: document.documentElement.lang === 'en' ? 'en' : 'de' });
          location.href = url;
        } catch (err) {
          // Stripe's own reason, small, so a host can tell us what went wrong.
          stripeBody.textContent = `${t.stripeFail} (${(err as Error).message})`;
          stripeGo.disabled = false; stripeGo.textContent = t.stripeBtn;
        }
      });
      /** The dates a date falls on within the next `days` days. */
      const occurrences = (ev: Ev, days: number): string[] => {
        const out: string[] = [];
        const today = iso(new Date());
        const last = new Date(); last.setDate(last.getDate() + days);
        const until = ev.until || iso(new Date(new Date(ev.date).getTime() + 84 * 86400000));
        for (let d = new Date(`${ev.date}T12:00:00`); iso(d) <= until && d <= last;) {
          if (iso(d) >= today) out.push(iso(d));
          if (ev.repeat === 'weekly') d.setDate(d.getDate() + 7);
          else if (ev.repeat === 'biweekly') d.setDate(d.getDate() + 14);
          else if (ev.repeat === 'monthly') d.setMonth(d.getMonth() + 1);
          else break;
        }
        return out;
      };
      const cover = $('[data-ha-cover]');
      const showMedia = () => {
        const first = media[0];
        cover.replaceChildren();
        if (!first) { cover.append(el('span', 'hd-ph', t.mediaNone)); }
        else if (first.type === 'video') {
          const v = document.createElement('video');
          Object.assign(v, { src: first.url, muted: true, autoplay: true, loop: true, playsInline: true });
          cover.append(v);
        } else {
          const i = document.createElement('img'); i.src = first.url; i.alt = ''; cover.append(i);
        }
        const thumbs = $('[data-ha-thumbs]');
        const pagePhotos = hosts[slug]?.photos ?? [];
        const all = [...media.filter((m) => !pagePhotos.includes(m.url)), ...pagePhotos.map((url) => ({ type: 'photo', url }))];
        thumbs.replaceChildren(...all.map((m) => {
          const b = el('button', 'hd-thumb') as HTMLButtonElement;
          b.type = 'button';
          const on = media.some((x) => x.url === m.url);
          b.setAttribute('aria-pressed', String(on));
          if (m.type === 'video') b.append(el('span', 'hd-thumb-v', '▶'));
          else { const i = document.createElement('img'); i.src = m.url; i.alt = ''; b.append(i); }
          b.addEventListener('click', () => {
            media = on ? media.filter((x) => x.url !== m.url) : [...media, m];
            showMedia();
          });
          return b;
        }));
      };
      const upload = async (files: FileList | null, type: string) => {
        if (!files?.length) return;
        const note = $('[data-ha-up-note]');
        note.textContent = t.uploading; note.dataset.ok = 'true';
        try {
          if (!cfg.firebase.storageBucket) throw new Error('no bucket');
          const store = getStorage(app0);
          for (const f of Array.from(files).slice(0, 8)) {
            const r = storageRef(store, `hostMedia/${slug}/${Date.now()}-${f.name.replace(/[^\w.-]/g, '_')}`);
            await uploadBytes(r, f, { contentType: f.type });
            media.push({ type, url: await getDownloadURL(r) });
          }
          note.textContent = t.uploadDone;
          showMedia();
        } catch {
          note.textContent = fill(t.uploadFail, cfg.contact); note.dataset.ok = 'false';
        }
      };
      $<HTMLInputElement>('[data-ha-up-video]').addEventListener('change', (e) => upload((e.target as HTMLInputElement).files, 'video'));
      $<HTMLInputElement>('[data-ha-up-photos]').addEventListener('change', (e) => upload((e.target as HTMLInputElement).files, 'photo'));
      createForm.querySelectorAll<HTMLInputElement>('[name="repeat"]').forEach((r) => r.addEventListener('change', () => {
        $('[data-ha-until]').hidden = fld<HTMLInputElement>('repeat') && (createForm.querySelector<HTMLInputElement>('[name="repeat"]:checked')?.value ?? 'once') === 'once';
      }));
      // ── When: Luma-style date and time chips (hidden inputs keep the values) ──
      const whenBox = $('[data-ha-whenbox]');
      const cal = $('[data-ha-cal]');
      const calGrid = $('[data-ha-cal-grid]');
      const times = $('[data-ha-times]');
      const startIn = $<HTMLInputElement>('[data-tp="start"]');
      const endIn = $<HTMLInputElement>('[data-tp="end"]');
      const mins = (hm: string) => { const m = /^(\d{1,2}):(\d{2})$/.exec(hm); return m ? Number(m[1]) * 60 + Number(m[2]) : NaN; };
      const hm = (n: number) => { const v = ((n % 1440) + 1440) % 1440; return `${String(Math.floor(v / 60)).padStart(2, '0')}:${String(v % 60).padStart(2, '0')}`; };
      const dayLabel = (v: string) => v ? new Date(`${v}T12:00:00`).toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short' }) : '–';
      const addDays = (v: string, n: number) => { const d = new Date(`${v}T12:00:00`); d.setDate(d.getDate() + n); return iso(d); };
      /** Whole and half hours as "2 Std." / "1,5 h": shown next to each end time. */
      const durLabel = (m: number) => { const h = m / 60; const n = Number.isInteger(h) ? String(h) : h.toLocaleString(locale, { maximumFractionDigits: 2 }); return m < 60 ? `${m} min` : `${n} ${locale.startsWith('de') ? 'Std.' : 'h'}`; };
      const renderWhen = () => {
        const date = fld('date').value;
        $('[data-dp="date"]').textContent = dayLabel(date);
        startIn.value = fld('start').value;
        endIn.value = fld('end').value;
        const overnight = fld('end').value && mins(fld('end').value) <= mins(fld('start').value);
        $('[data-ha-end-date]').textContent = dayLabel(date && overnight ? addDays(date, 1) : date);
        $('[data-dp="until"]').textContent = fld('until').value ? dayLabel(fld('until').value) : '–';
        // Berlin's offset on that day (summer or winter time).
        const off = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Berlin', timeZoneName: 'shortOffset' }).formatToParts(new Date(`${date || iso(new Date())}T12:00:00`)).find((x) => x.type === 'timeZoneName')?.value ?? 'GMT+1';
        const m = /GMT([+-])(\d+)/.exec(off);
        $('[data-ha-tz-off]').textContent = m ? `GMT${m[1]}${m[2].padStart(2, '0')}:00` : 'GMT+01:00';
      };
      const closePops = () => { cal.hidden = true; times.hidden = true; };
      const place = (pop: HTMLElement, anchor: HTMLElement) => {
        const b = whenBox.getBoundingClientRect(), r = anchor.getBoundingClientRect();
        pop.style.top = `${r.bottom - b.top + 8}px`;
        pop.style.left = `${Math.max(0, Math.min(r.left - b.left, b.width - pop.offsetWidth))}px`;
      };
      // Calendar
      let calField = 'date';
      let calMonth = new Date();
      const drawCal = () => {
        const y = calMonth.getFullYear(), mo = calMonth.getMonth();
        $('[data-ha-cal-title]').textContent = new Date(y, mo, 1).toLocaleDateString(locale, { month: 'long', year: y === new Date().getFullYear() ? undefined : 'numeric' });
        const first = new Date(y, mo, 1);
        const lead = (first.getDay() + 6) % 7; // Monday first
        const start = new Date(y, mo, 1 - lead);
        const today = iso(new Date());
        const chosen = fld(calField).value;
        const min = calField === 'until' ? fld('date').value : today;
        const cells: HTMLElement[] = [];
        for (let i = 0; i < 7; i++) {
          const d = new Date(2024, 0, 1 + i); // a Monday
          cells.push(el('span', 'hd-cal-wd', d.toLocaleDateString(locale, { weekday: 'narrow' })));
        }
        for (let i = 0; i < 42; i++) {
          const d = new Date(start); d.setDate(start.getDate() + i);
          const v = iso(d);
          const b = el('button', 'hd-cal-day', String(d.getDate())) as HTMLButtonElement;
          b.type = 'button';
          if (d.getMonth() !== mo) b.classList.add('is-out');
          if (v === today) b.classList.add('is-today');
          if (v === chosen) { b.classList.add('is-on'); b.setAttribute('aria-pressed', 'true'); }
          if (v < min) b.disabled = true;
          b.addEventListener('click', () => { fld(calField).value = v; closePops(); renderWhen(); });
          cells.push(b);
        }
        calGrid.replaceChildren(...cells);
      };
      const openCal = (field: string, anchor: HTMLElement) => {
        const open = !cal.hidden && calField === field;
        closePops();
        if (open) return;
        calField = field;
        const v = fld(field).value || fld('date').value || iso(new Date());
        calMonth = new Date(`${v}T12:00:00`); calMonth.setDate(1);
        drawCal();
        cal.hidden = false;
        place(cal, anchor);
        cal.querySelector<HTMLButtonElement>('.is-on, .is-today:not(:disabled)')?.focus({ preventScroll: true });
      };
      root.querySelectorAll<HTMLElement>('[data-dp]').forEach((b) => b.addEventListener('click', () => openCal(b.dataset.dp!, b)));
      cal.querySelectorAll<HTMLElement>('[data-cal-step]').forEach((b) => b.addEventListener('click', () => { calMonth.setMonth(calMonth.getMonth() + Number(b.dataset.calStep)); drawCal(); }));
      $('[data-cal-today]').addEventListener('click', () => { calMonth = new Date(); calMonth.setDate(1); drawCal(); });
      // Time lists: every half hour; the end list starts after the start and shows the length.
      let timeField: 'start' | 'end' = 'start';
      const drawTimes = () => {
        const cur = fld(timeField).value;
        const s0 = mins(fld('start').value);
        const opts: HTMLElement[] = [];
        for (let i = 0; i < 48; i++) {
          const m = timeField === 'end' && !Number.isNaN(s0) ? s0 + 30 * (i + 1) : i * 30;
          const v = hm(m);
          const o = el('button', 'hd-time', v) as HTMLButtonElement;
          o.type = 'button'; o.setAttribute('role', 'option');
          if (timeField === 'end' && !Number.isNaN(s0)) o.append(el('small', '', durLabel(m - s0)));
          if (v === cur) { o.classList.add('is-on'); o.setAttribute('aria-selected', 'true'); }
          o.addEventListener('mousedown', (e) => e.preventDefault());
          o.addEventListener('click', () => { setTime(timeField, v); closePops(); });
          opts.push(o);
        }
        times.replaceChildren(...opts);
      };
      /** A new start keeps the length; a new end keeps the start. */
      const setTime = (field: 'start' | 'end', v: string) => {
        if (field === 'start') {
          const len = mins(fld('end').value) - mins(fld('start').value);
          fld('start').value = v;
          fld('end').value = hm(mins(v) + (Number.isNaN(len) || len <= 0 ? 120 : len));
        } else fld('end').value = v;
        renderWhen();
      };
      const openTimes = (input: HTMLInputElement) => {
        cal.hidden = true;
        timeField = input.dataset.tp as 'start' | 'end';
        drawTimes();
        times.hidden = false;
        place(times, input);
        const on = times.querySelector<HTMLElement>('.is-on') ?? times.children[timeField === 'end' ? 3 : 36] as HTMLElement | undefined;
        if (on) times.scrollTop = on.offsetTop - times.clientHeight / 2 + on.offsetHeight / 2;
        input.select();
      };
      [startIn, endIn].forEach((input) => {
        input.addEventListener('focus', () => openTimes(input));
        input.addEventListener('click', () => { if (times.hidden) openTimes(input); });
        input.addEventListener('input', () => { input.value = input.value.replace(/[^\d:]/g, ''); if (/^\d{3,4}$/.test(input.value)) input.value = `${input.value.slice(0, -2)}:${input.value.slice(-2)}`; });
        // Typed times: "9", "930", "9:30" all become 09:30-style values.
        input.addEventListener('blur', () => {
          const raw = input.value.trim();
          const m = /^(\d{1,2})(?::?(\d{2}))?$/.exec(raw);
          if (m && Number(m[1]) < 24 && Number(m[2] ?? 0) < 60) setTime(input.dataset.tp as 'start' | 'end', `${m[1].padStart(2, '0')}:${m[2] ?? '00'}`);
          else renderWhen();
          times.hidden = true;
        });
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
          if (e.key === 'Escape') { renderWhen(); input.blur(); }
        });
      });
      document.addEventListener('pointerdown', (e) => { if (!whenBox.contains(e.target as Node)) closePops(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePops(); });
      createForm.querySelectorAll<HTMLInputElement>('[name="repeat"]').forEach((r) => r.addEventListener('change', () => {
        if (r.checked && r.value !== 'once' && !fld('until').value) renderWhen();
      }));
      const openCreate = (ev?: Ev) => {
        createForm.reset();
        const h = hosts[slug];
        const tomorrow = new Date(); tomorrow.setDate(tomorrow.getDate() + 1);
        fld('id').value = ev?.id ?? '';
        fld('title').value = ev?.title ?? '';
        // As on Luma: today at the next full hour (tomorrow 18:00 once it is
        // late), two hours long, so no field ever shows --:--.
        const now = new Date();
        const nextHour = now.getHours() + 1;
        fld('date').value = ev?.date ?? (nextHour <= 21 ? iso(now) : iso(tomorrow));
        fld('start').value = ev?.start ?? (nextHour <= 21 ? hm(nextHour * 60) : '18:00');
        fld('end').value = ev?.end || hm(mins(fld('start').value) + 120);
        fld('until').value = ev?.until ?? '';
        (createForm.querySelector<HTMLInputElement>(`[name="repeat"][value="${ev?.repeat ?? 'once'}"]`) ?? createForm.querySelector<HTMLInputElement>('[name="repeat"]'))!.checked = true;
        $('[data-ha-until]').hidden = (ev?.repeat ?? 'once') === 'once';
        fld('location').value = ev?.location ?? h?.en.place ?? '';
        fld<HTMLTextAreaElement>('description').value = ev?.description ?? '';
        fld('price').value = ev?.price != null ? String(ev.price) : '';
        fld('seats').value = ev?.seats != null ? String(ev.seats) : '';
        fld('minGuests').value = ev?.minGuests != null ? String(ev.minGuests) : '';
        fld('approve').checked = ev?.approve !== false;
        fld('languages').value = ev?.languages ?? h?.en.languages ?? '';
        fld<HTMLSelectElement>('cancel').value = ev?.cancel ?? '7d';
        fld<HTMLSelectElement>('visibility').value = ev?.visibility ?? 'public';
        media = ev?.media?.length ? [...ev.media] : (h?.photos?.[0] ? [{ type: 'photo', url: h.photos[0] }] : []);
        $('[data-ha-create-host]').textContent = h?.name ?? slug;
        createForm.querySelector<HTMLButtonElement>('.hd-publish')!.textContent = ev?.id ? t.saveChanges : t.publish;
        $('[data-ha-create-note]').textContent = t.publishNote;
        closePops();
        renderWhen();
        showMedia();
        showTab('create');
        fld('title').focus();
      };
      root.querySelectorAll<HTMLElement>('[data-ha-new]').forEach((b) => b.addEventListener('click', () => openCreate()));
      createForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const num = (n: string) => (fld(n).value === '' ? null : Number(fld(n).value));
        const body = {
          id: fld('id').value || undefined, slug,
          title: fld('title').value.trim(), date: fld('date').value, start: fld('start').value, end: fld('end').value,
          repeat: createForm.querySelector<HTMLInputElement>('[name="repeat"]:checked')?.value ?? 'once', until: fld('until').value,
          location: fld('location').value.trim(), description: fld<HTMLTextAreaElement>('description').value.trim(),
          price: num('price'), seats: num('seats'), minGuests: num('minGuests'), approve: fld('approve').checked,
          languages: fld('languages').value.trim(), cancel: fld<HTMLSelectElement>('cancel').value,
          visibility: fld<HTMLSelectElement>('visibility').value, media,
        };
        const note = $('[data-ha-create-note]');
        if ((body.price ?? 0) > 0 && stripeReady !== true) {
          note.textContent = t.stripeNeeded;
          showStripe();
          return;
        }
        if (!body.title || !body.date || !body.start) { note.textContent = t.titlePh; note.dataset.ok = 'false'; fld('title').focus(); return; }
        const btn = createForm.querySelector<HTMLButtonElement>('.hd-publish')!;
        btn.disabled = true;
        try {
          await api('hostEventSave', body);
          note.textContent = t.published; note.dataset.ok = 'true';
          await loadInbox();
          showTab('calendar');
        } catch {
          note.textContent = fill(t.error, cfg.contact); note.dataset.ok = 'false';
        }
        btn.disabled = false;
      });
      const repeatText: Record<string, string> = { weekly: t.repeatsWeekly, biweekly: t.repeatsBiweekly, monthly: t.repeatsMonthly };
      const renderOwnDates = () => {
        const box = $('[data-ha-own-dates]');
