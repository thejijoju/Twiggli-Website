  .hd-time { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; width: 100%; padding: 8px 12px; border: 0; border-radius: 9px; background: none; font: inherit; font-size: 0.98rem; color: var(--color-text); cursor: pointer; font-variant-numeric: tabular-nums; }
