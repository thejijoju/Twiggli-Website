  .ha .hd-create input.hd-pill-time:not([type='checkbox']) { padding: 0 6px; border: 0; background: rgba(106, 62, 236, 0.07); text-align: center; font-variant-numeric: tabular-nums; caret-color: var(--color-accent); }
