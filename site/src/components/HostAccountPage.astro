  .ib-saved-use { flex: 1; text-align: left; border: 0; background: rgba(36, 39, 46, 0.04); border-radius: 10px; padding: 8px 10px; margin-bottom: 6px; font: inherit; font-size: 0.9rem; cursor: pointer; }
  .ib-saved-del { border: 0; background: none; color: var(--color-text-muted); font-size: 1.1rem; cursor: pointer; }
  .ib-saved-add { border: 0; background: none; color: var(--color-accent); font: inherit; font-weight: 600; cursor: pointer; padding: 4px 0; }
  .ib-res { padding: 18px 0 18px 22px; position: relative; min-width: 0; }
  .ib-close { position: absolute; top: 10px; right: 0; border: 0; background: rgba(36, 39, 46, 0.06); border-radius: 50%; width: 34px; height: 34px; cursor: pointer; display: none; }

  .ib-modal { width: min(760px, calc(100vw - 32px)); max-height: calc(100vh - 48px); border: 0; border-radius: 26px; padding: 0; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25); }
  /* Twiggli's signature: popups float over a blurred page; a second popup
     (offer, decline) blurs the one below it, so it reads as stacked on top. */
  .ib-modal::backdrop { background: rgba(40, 30, 60, 0.22); backdrop-filter: blur(12px) saturate(1.1); -webkit-backdrop-filter: blur(12px) saturate(1.1); }
  .ib-offer { box-shadow: 0 30px 80px rgba(36, 20, 70, 0.28), 0 0 0 1px rgba(255, 255, 255, 0.6); }
  .ib-decline { width: min(520px, calc(100vw - 32px)); }
  .ib-modal-head { display: flex; justify-content: space-between; align-items: center; padding: 28px 32px 18px; border-bottom: 1px solid rgba(36, 39, 46, 0.1); position: sticky; top: 0; background: #fff; z-index: 1; }
  .ib-modal-head h2 { margin: 0; font-size: 1.9rem; }
  .ib-modal-x { border: 0; background: rgba(36, 39, 46, 0.06); border-radius: 50%; width: 38px; height: 38px; font-size: 1.3rem; cursor: pointer; }
  .ib-modal-body { padding: 22px 32px 30px; }
