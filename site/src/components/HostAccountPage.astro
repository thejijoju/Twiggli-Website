  .ib-form input, .ib-form select, .ib-form textarea { width: 100%; box-sizing: border-box; font: inherit; padding: 10px 12px; border: 1.5px solid rgba(36, 39, 46, 0.18); border-radius: 10px; background: #fff; }
  .ib-hint { margin: 0; font-size: 0.86rem; color: var(--color-text-muted); }
