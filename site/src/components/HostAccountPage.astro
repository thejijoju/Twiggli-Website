---
/**
 * The host account (/host/account/, /de/host/account/), step 1: a host signs
 * in with an email link (Firebase Authentication, no password), then edits
 * their page text in English and German and their weekly schedule. Saves go
 * to Firestore (hostProfiles, hostSlots; who may edit which page is
 * hostMembers, see firestore.rules at the repo root). The
 * site is static: the next deploy fetches the edits and lays them over the
 * copy (hostEdits.ts), at the latest with the daily morning build.
 *
 * Vouchers and requests are announced as tabs and come next.
 */
import Base from '../layouts/Base.astro';
import { getHosts } from '../data/content.ts';
import { hostAccountCopy } from '../data/hostAccount.ts';
import { firebaseConfig, firebaseReady, functionsBase } from '../data/firebase.ts';
import { contactEmail, requestEmail } from '../data/site.ts';
import liveData from '../data/live-workshops.json';
import { workshopsFor, onRequestFor } from '../data/seo.ts';
import { previewSessionsFor } from '../data/sessions.ts';
import { href, withBase, type Lang } from '../lib/url.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = hostAccountCopy(lang);

/* What the site shows today for every host, so the form opens with it
   when the host has not saved anything yet. Public data anyway. */
const pick = (h: Record<string, unknown>) => ({
  specialty: h.specialty ?? '', studio: h.studio ?? '', blurb: h.blurb ?? '', group_size: h.group ?? '',
  duration: h.duration ?? '', place: h.place ?? '', languages: h.languages ?? '', price_note: h.priceNote ?? '',
});
const de = new Map(getHosts('de', { withPreview: true }).map((h) => [h.slug, h]));
const recurring = (liveData as { recurring?: { slug: string; title: string; weekdays: string[]; time: string; duration?: string; price?: string }[] }).recurring ?? [];
const hosts = Object.fromEntries(
  getHosts('en', { withPreview: true }).map((h) => [h.slug, {
    name: h.name,
    page: href(lang, `/workshops/${h.activity}/${h.slug}/`),
    // Their own pictures, to pick a cover for a new date without uploading.
    photos: [...new Set([h.photo, ...(h.gallery ?? [])].filter((x): x is string => !!x))].slice(0, 8),
    // Their workshops with a picture and price, for the offer's workshop picker.
    workshops: (() => {
      const seen = new Set<string>();
      const out: { title: string; price: string; image: string; key: string; dates: number }[] = [];
      const add = (title: string, key: string, price?: string, image?: string, dates = 0) => {
        const k = title.trim().toLowerCase();
        if (!title || seen.has(k)) return;
        seen.add(k);
        out.push({ title, key, price: price ?? '', image: image || h.photo || h.poster || '', dates });
      };
      try {
        for (const w of workshopsFor(h.slug, lang)) add(w.title, w.key, w.sessions[0]?.price, w.sessions[0]?.image, w.sessions.length);
        for (const s of previewSessionsFor(h.slug, lang)) add(s.title, s.workshopKey, s.price, s.image);
        for (const o of onRequestFor(h.slug, lang)) add(o.title, o.key ?? '', o.price);
      } catch { /* a host without listings: own dates only */ }
      return out;
    })(),
    en: pick(h as unknown as Record<string, unknown>),
    de: pick((de.get(h.slug) ?? h) as unknown as Record<string, unknown>),
    slots: recurring.filter((r) => r.slug === h.slug).map((r) => ({
      title: r.title, weekdays: r.weekdays, time: r.time, duration: r.duration ?? '',
      price: Number((r.price ?? '').match(/\d+/)?.[0] ?? '') || null,
    })),
  }]),
);
/** Every page a host could claim, by name (the test page included). */
const becomeHost = `${href(lang, '/host/')}#apply`;
const claimList = getHosts('en', { withPreview: true })
  .map((h) => ({ slug: h.slug, label: `${h.name} · ${h.specialty}` }))
  .sort((a, b) => a.label.localeCompare(b.label));
const config = {
  firebase: firebaseConfig,
  ready: firebaseReady,
  contact: contactEmail,
  inbox: requestEmail,
  functions: functionsBase,
  // May open every host (functions/index.js ADMINS checks it again).
};
const fields = [
  ['specialty', t.fSpecialty, t.fSpecialtyHint, 'input', 80],
  ['studio', t.fStudio, '', 'input', 80],
  ['blurb', t.fBlurb, t.fBlurbHint, 'textarea', 1500],
  ['group_size', t.fGroup, t.fGroupHint, 'input', 80],
  ['duration', t.fDuration, '', 'input', 40],
  ['place', t.fPlace, '', 'input', 120],
  ['languages', t.fLanguages, '', 'input', 40],
  ['price_note', t.fPriceNote, '', 'input', 120],
] as const;
---

<Base title={t.pageTitle} description={t.lede} lang={lang} pageClass="ha-page" noindex translations={['en', 'de']} bare>
  <!-- Its own slim bar instead of the site menu (a full-screen app, like Luma). -->
  <a class="ha-home" href={href(lang, '/')} aria-label="Twiggli"><img src={withBase('/img/logo.png')} alt="" width="34" height="34" /></a>
  <section
    class="ha container"
    data-ha
    data-lang={lang}
    data-config={JSON.stringify(config)}
    data-hosts={JSON.stringify(hosts)}
    data-copy={JSON.stringify(t)}
  >
    <header class="ha-head">
      <h1>{t.title}</h1>
      <p class="ha-lede">{t.lede}</p>
    </header>

    <!-- Before Firebase is set up (data/firebase.ts). -->
    <p class="ha-card ha-note" data-ha-soon hidden></p>

    <!-- Signed out: one field, one button. -->
    <form class="ha-signin" data-ha-signin hidden>
      <span class="ha-ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-3"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>
      </span>
      <h2>{t.welcomeTitle}</h2>
      <p class="ha-sub">{t.welcomeLede}</p>
      <p class="ha-invite" data-ha-invite-note hidden></p>
      <label>
        <span>{t.email}</span>
        <input type="email" name="email" required autocomplete="email" placeholder={t.emailPh} />
      </label>
      <button type="submit" class="ha-btn">{t.sendLink}</button>
      <p class="ha-note" data-ha-signin-note role="status"></p>
      <hr class="ha-sep" />
      <button type="button" class="ha-btn ha-google" data-ha-google>
        <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        {t.google}
      </button>
    </form>

    <!-- Signed in. -->
    <div class="ha-app" data-ha-app hidden>
      <header class="hd-top">
        <nav class="ha-tabs" role="tablist" data-ha-tabs hidden>
          <button type="button" role="tab" aria-selected="true" data-ha-tab="overview"><svg class="hd-i" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1z"/></svg>{t.tabOverview}</button>
          <button type="button" role="tab" aria-selected="false" data-ha-tab="calendar"><svg class="hd-i" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>{t.tabCalendar}</button>
          <button type="button" role="tab" aria-selected="false" data-ha-tab="messages"><svg class="hd-i" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a7.5 7.5 0 0 1-11 6.6L4 20l1.4-4.6A7.5 7.5 0 1 1 20 12z"/></svg>{t.tabMessages}<i class="ha-count" data-ha-count hidden></i></button>
          <button type="button" role="tab" aria-selected="false" data-ha-tab="listings"><svg class="hd-i" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 12.2V4.5a1 1 0 0 1 1-1h7.7l8.3 8.3a1.5 1.5 0 0 1 0 2.1l-6.3 6.3a1.5 1.5 0 0 1-2.1 0z"/><circle cx="8" cy="8" r="1.4"/></svg>{t.tabListings}</button>
        </nav>
        <div class="hd-right">
          <button type="button" class="hd-add" data-ha-new data-ha-hostonly hidden>+ {t.addDate}</button>
          <button type="button" class="hd-bell" data-ha-go="messages" aria-label={t.notifications}><svg class="hd-i" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9a6 6 0 1 1 12 0c0 5 2 6.5 2 6.5H4S6 14 6 9z"/><path d="M10 19a2 2 0 0 0 4 0"/></svg><i data-ha-dot hidden></i></button>
          <div class="hd-me">
            <button type="button" class="hd-avatar" data-ha-avatar aria-haspopup="true" aria-label={t.profile}>🙂</button>
            <div class="hd-menu" data-ha-menu hidden>
              <p class="hd-who" data-ha-who></p>
              <p class="hd-label">{t.pickEmoji}</p>
              <div class="hd-emojis" data-ha-emojis>
                {['🏺', '🎨', '🕯️', '🧵', '🌿', '🍳', '🍺', '🥃', '📷', '🪵', '💍', '📚', '🌸', '🥁', '✨', '🙂'].map((e) => <button type="button">{e}</button>)}
              </div>
              <label class="ha-pick" data-ha-pick-wrap hidden>
                <span>{t.hostPick}</span>
                <select data-ha-pick></select>
              </label>
              <a class="hd-item" data-ha-view target="_blank" rel="noopener">{t.viewPage} ↗</a>
              <button type="button" class="hd-item" data-ha-signout>{t.signOut}</button>
            </div>
          </div>
        </div>
      </header>
      <p class="ha-card ha-note" data-ha-nohost hidden></p>

      <!-- Signed in, but not a host (yet). -->
      <div class="ha-card ha-notyet" data-ha-notyet hidden>
        <h2>{t.notYetTitle}</h2>
        <p>{t.notYetLede}</p>
        <a class="ha-btn" href={becomeHost}>{t.notYetCta} →</a>
      </div>

      <!-- No page yet: ask for one. Jirel approves by email (functions/index.js hostClaim). -->
      <form class="ha-card ha-claim" data-ha-claim hidden>
        <h2>{t.claimTitle}</h2>
        <p class="ha-lede">{t.claimLede}</p>
        <label>
          <span>{t.claimPage}</span>
          <select name="slug" required>
            <option value="">{t.claimPagePh}</option>
            {claimList.map((h) => <option value={h.slug}>{h.label}</option>)}
          </select>
        </label>
        <label><span>{t.claimName}</span><input name="name" required autocomplete="name" /></label>
        <label><span>{t.claimNote}</span><textarea name="note" rows="2" placeholder={t.claimNotePh}></textarea></label>
        <div class="ha-save"><button type="submit" class="ha-btn">{t.claimSend}</button><p class="ha-note" role="status"></p></div>
      </form>

      <div data-ha-editor hidden>

        <!-- Messages, as on Airbnb (functions hostInbox / hostReply): the list
             (needs your answer, recent), the conversation with its request card
             and countdown, and the request with Accept / Make an offer / Decline
             and what we know about the guest. -->
        <section data-ha-panel="messages" class="ib" hidden>
          <button type="button" class="ib-todo" data-ib-todo hidden>
            <span class="ib-todo-ic" aria-hidden="true">💳</span>
            <span class="ib-todo-t"><b>{t.ib.todoStripe}</b><span>{t.ib.todoStripeSub}</span></span>
            <span class="hd-pill">{t.ib.todoGo}</span>
          </button>
          <div class="ib-grid" data-ib-grid>
            <aside class="ib-list">
              <h2 class="ha-h">{t.tabMessages}</h2>
              <div class="ha-pills" data-ha-filter>
                <button type="button" aria-pressed="true" data-f="all">{t.fAll}</button>
                <button type="button" aria-pressed="false" data-f="unread">{t.ib.unread}</button>
              </div>
              <p class="ib-group" data-ib-g="prio">{t.ib.priority}</p>
              <ul class="ha-msgs" data-ib-prio></ul>
              <p class="ib-group" data-ib-g="recent">{t.ib.recent}</p>
              <ul class="ha-msgs" data-ha-msgs></ul>
              <p class="ha-empty" data-ha-msgs-empty hidden>{t.msgsEmpty}</p>
            </aside>
            <div class="ib-conv" data-ib-conv><p class="ib-pick">{t.ib.pick}</p></div>
            <aside class="ib-res" data-ib-res hidden></aside>
          </div>
          <dialog class="ib-modal" data-ib-modal aria-labelledby="ib-modal-title">
            <div class="ib-modal-head">
              <h2 id="ib-modal-title">{t.ib.details}</h2>
              <button type="button" class="ib-modal-x" aria-label={t.back} onclick="this.closest('dialog').close()">×</button>
            </div>
            <div class="ib-modal-body" data-ib-modal-body></div>
          </dialog>
          <dialog class="ib-modal ib-offer ib-decline" data-ib-decline aria-label={t.ib.decline}>
            <button type="button" class="ib-modal-x ib-offer-x" aria-label={t.back} onclick="this.closest('dialog').close()">×</button>
            <div class="ib-modal-body" data-ib-decline-body></div>
          </dialog>
          <dialog class="ib-modal ib-offer" data-ib-offer aria-label={t.ib.offer}>
            <button type="button" class="ib-modal-x ib-offer-x" aria-label={t.back} onclick="this.closest('dialog').close()">×</button>
            <div class="ib-modal-body" data-ib-offer-body></div>
          </dialog>
        </section>

        <!-- Overview: the host's week at a glance (the first thing they see). -->
        <section data-ha-panel="overview" class="hd-overview">
          <div class="hd-hi">
            <div><h1 data-ha-hello></h1><p class="ha-sub">{t.helloSub}</p></div>
            <div class="hd-seg" data-ha-when>
              <button type="button" aria-pressed="false" data-w="requests" data-ha-req-tab hidden>{t.ib.reqTab} <span class="hd-seg-n" data-ha-req-n></span></button>
              <button type="button" aria-pressed="true" data-w="upcoming">{t.wUpcoming}</button>
              <button type="button" aria-pressed="false" data-w="past">{t.wPast}</button>
            </div>
          </div>
          <button type="button" class="hd-add-big hd-add-phone" data-ha-new>+ {t.newDate}</button>
          <!-- Open requests as cards with the time left (as the Airbnb app's Today). -->
          <div class="hd-reqs" data-ha-reqs hidden>
            <div class="hd-reqs-row" data-ha-reqs-row></div>
          </div>
          <button type="button" class="hd-alert" data-ha-alert data-ha-go="messages" hidden>
            <span class="hd-alert-ic" aria-hidden="true">✉️</span>
            <span class="hd-alert-t"><b data-ha-alert-title></b><span data-ha-alert-sub></span></span>
            <span class="hd-pill">{t.review}</span>
          </button>
          <div class="hd-stats">
            <div class="hd-st"><small>{t.stOpen}</small><b data-ha-st="open">0</b><em data-ha-st-note="open"></em></div>
            <div class="hd-st"><small>{t.stBookings}</small><b data-ha-st="bookings">0</b><em data-ha-st-note="bookings"></em></div>
            <div class="hd-st"><small>{t.stEarnings}</small><b data-ha-st="earnings">€ 0</b><em>{t.stEarningsNote}</em></div>
            <div class="hd-st"><small>{t.stNext}</small><b data-ha-st="next">–</b><em data-ha-st-note="next"></em></div>
          </div>
          <h2 class="hd-h2" data-ha-list-title>{t.nextDates}</h2>
          <div data-ha-days></div>
          <div class="ha-empty-big" data-ha-today-empty hidden><span aria-hidden="true">📖</span><h2>{t.todayEmpty}</h2></div>
        </section>

        <!-- Admin: personal invite links to email to the hosts. -->

        <!-- The host's workshops: pause (off the site until put back) or delete. -->
        <section class="hl" data-ha-panel="listings" hidden>
          <h2 class="ha-h">{t.ib.lsTitle}</h2>
          <p class="ha-sub">{t.ib.lsSub}</p>
          <div class="hl-list" data-hl-list></div>
          <p class="ha-note" data-hl-note role="status"></p>
        </section>
        <dialog class="ib-modal ib-offer ib-decline" data-hl-confirm aria-label={t.ib.lsDelete}>
          <button type="button" class="ib-modal-x ib-offer-x" aria-label={t.back} onclick="this.closest('dialog').close()">×</button>
          <div class="ib-modal-body" data-hl-confirm-body></div>
        </dialog>

        <form class="ha-card" data-ha-panel="listings" hidden>
          <div class="ha-langs" role="radiogroup" aria-label={t.textIn}>
            <span>{t.textIn}</span>
            <label><input type="radio" name="textlang" value="en" checked /> English</label>
            <label><input type="radio" name="textlang" value="de" /> Deutsch</label>
          </div>
          {fields.map(([name, label, hint, kind, max]) => (
            <label class="ha-field">
              <span>{label}</span>
              {kind === 'textarea'
                ? <textarea name={name} rows="8" maxlength={max}></textarea>
                : <input name={name} maxlength={max} />}
              {hint && <small>{hint}</small>}
            </label>
          ))}
          <div class="ha-save">
            <button type="submit" class="ha-btn">{t.save}</button>
            <p class="ha-note" role="status"></p>
          </div>
        </form>


        <!-- New date ("Neuer Termin"): the quickest thing in the dashboard. -->
        <form class="hd-create" data-ha-panel="create" hidden novalidate>
          <input type="hidden" name="id" />
          <div class="hd-create-media">
            <div class="hd-cover" data-ha-cover><span class="hd-ph" data-ha-cover-ph>{t.mediaNone}</span></div>
            <p class="hd-media-tip">{t.mediaTip}</p>
            <div class="hd-media-btns">
              <label class="hd-media-btn"><svg class="hd-i" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="13" height="12" rx="2.5"/><path d="m16 10.5 5-3v9l-5-3"/></svg><span>{t.uploadVideo}</span><input type="file" accept="video/*" data-ha-up-video hidden /></label>
              <label class="hd-media-btn"><svg class="hd-i" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><circle cx="9" cy="10" r="1.8"/><path d="m4 18 5.5-5 4 3.5 3-2.5 4 4"/></svg><span>{t.uploadPhotos}</span><input type="file" accept="image/*" multiple data-ha-up-photos hidden /></label>
            </div>
            <p class="hd-media-hint">{t.mediaFromPage}</p>
            <div class="hd-thumbs" data-ha-thumbs></div>
            <p class="ha-note" data-ha-up-note role="status"></p>
          </div>
          <div class="hd-create-main">
            <div class="hd-create-chips">
              <span class="hd-chip" data-ha-create-host></span>
              <label class="hd-chip"><svg class="hd-i" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.5 2.6 3.7 5.4 3.7 8.5s-1.2 5.9-3.7 8.5c-2.5-2.6-3.7-5.4-3.7-8.5s1.2-5.9 3.7-8.5z"/></svg><select name="visibility"><option value="public">{t.vPublic}</option><option value="private">{t.vPrivate}</option></select></label>
            </div>
            <input class="hd-title" name="title" maxlength="120" placeholder={t.titlePh} required />
            {/* When, as on Luma: a start and an end row with a date chip and a
                time chip each, our own calendar and time list as popovers.
                The values live in the hidden inputs below, as before. */}
            <div class="hd-when" data-ha-whenbox>
              <div class="hd-box hd-se">
                <input type="hidden" name="date" /><input type="hidden" name="start" /><input type="hidden" name="end" /><input type="hidden" name="until" />
                <div class="hd-se-row">
                  <span class="hd-se-dot" aria-hidden="true"></span>
                  <span class="hd-se-k">{t.startLabel}</span>
                  <button type="button" class="hd-pill hd-pill-date" data-dp="date" aria-haspopup="dialog"></button>
                  <input type="text" class="hd-pill hd-pill-time" data-tp="start" inputmode="numeric" maxlength="5" autocomplete="off" aria-label={t.startLabel} />
                </div>
                <div class="hd-se-row">
                  <span class="hd-se-dot hd-se-dot-end" aria-hidden="true"></span>
                  <span class="hd-se-k">{t.endLabel}</span>
                  <span class="hd-pill hd-pill-date hd-pill-static" data-ha-end-date></span>
                  <input type="text" class="hd-pill hd-pill-time" data-tp="end" inputmode="numeric" maxlength="5" autocomplete="off" aria-label={t.endLabel} />
                </div>
                <div class="hd-repeat" role="radiogroup" aria-label={t.repeat}>
                  <span>{t.repeat}</span>
                  <label><input type="radio" name="repeat" value="once" checked /><i>{t.rOnce}</i></label>
                  <label><input type="radio" name="repeat" value="weekly" /><i>{t.rWeekly}</i></label>
                  <label><input type="radio" name="repeat" value="biweekly" /><i>{t.rBiweekly}</i></label>
                  <label><input type="radio" name="repeat" value="monthly" /><i>{t.rMonthly}</i></label>
                </div>
                <div class="hd-se-row hd-se-until" data-ha-until hidden>
                  <span class="hd-se-dot hd-se-dot-none" aria-hidden="true"></span>
                  <span class="hd-se-k">{t.untilLabel}</span>
                  <button type="button" class="hd-pill hd-pill-date" data-dp="until" aria-haspopup="dialog"></button>
                  <small>{t.untilHint}</small>
                </div>
              </div>
              <div class="hd-box hd-tz"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.5 2.6 3.7 5.4 3.7 8.5s-1.2 5.9-3.7 8.5c-2.5-2.6-3.7-5.4-3.7-8.5s1.2-5.9 3.7-8.5z"/></svg><b data-ha-tz-off>GMT+01:00</b><span>Berlin</span></div>
              <div class="hd-pop hd-cal" data-ha-cal role="dialog" hidden>
                <div class="hd-cal-head"><b data-ha-cal-title></b><span>
                  <button type="button" data-cal-step="-1" aria-label="‹">‹</button><button type="button" data-cal-today aria-label="•" class="hd-cal-dot"></button><button type="button" data-cal-step="1" aria-label="›">›</button>
                </span></div>
                <div class="hd-cal-grid" data-ha-cal-grid></div>
              </div>
              <div class="hd-pop hd-times" data-ha-times role="listbox" hidden></div>
            </div>
            <div class="hd-box">
              <label class="hd-row"><svg class="hd-i" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><input name="location" maxlength="160" placeholder={t.locationPh} /></label>
              <label class="hd-row hd-row-top"><svg class="hd-i" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6h14M5 10h14M5 14h10M5 18h7"/></svg><textarea name="description" rows="3" placeholder={t.descPh}></textarea></label>
            </div>
            <p class="hd-sec">{t.bookingSec}</p>
            <div class="hd-box">
              <label class="hd-row"><svg class="hd-i" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 6.5A6.5 6.5 0 1 0 17 17.5M4 10h9M4 14h9"/></svg><span class="hd-k">{t.priceLabel}</span><input class="hd-num" type="number" name="price" min="0" max="5000" step="1" placeholder="65" /></label>
              <label class="hd-row"><svg class="hd-i" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c.6-3.4 3-5.4 6-5.4s5.4 2 6 5.4"/><path d="M16 5.2a3 3 0 0 1 0 5.6M18 14.8c1.6.8 2.7 2.6 3 5.2"/></svg><span class="hd-k">{t.seatsLabel}</span><input class="hd-num" type="number" name="seats" min="1" max="500" step="1" placeholder="10" /></label>
              <label class="hd-row"><svg class="hd-i" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg><span class="hd-k">{t.minLabel}<small>{t.minHint}</small></span><input class="hd-num" type="number" name="minGuests" min="0" max="500" step="1" placeholder="–" /></label>
              <label class="hd-row"><svg class="hd-i" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg><span class="hd-k">{t.approveLabel}</span><input class="hd-switch" type="checkbox" name="approve" checked /></label>
              <label class="hd-row"><svg class="hd-i" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a7.5 7.5 0 0 1-11 6.6L4 20l1.4-4.6A7.5 7.5 0 1 1 20 12z"/></svg><span class="hd-k">{t.langLabel}</span><input class="hd-short" name="languages" maxlength="60" placeholder="DE · EN" /></label>
              <label class="hd-row"><svg class="hd-i" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="m8 5-4 4 4 4"/></svg><span class="hd-k">{t.cancelLabel}</span><select name="cancel"><option value="24h">{t.c24}</option><option value="7d" selected>{t.c7}</option><option value="14d">{t.c14}</option><option value="none">{t.cNone}</option><option value="move">{t.cMove}</option></select></label>
            </div>
            {/* Luma's way: touching the price, when Stripe isn't connected yet,
                opens this; Stripe's own pages make a new account or sign
                into an existing one (functions hostStripe). */}
            <dialog class="hd-pay" data-ha-stripe aria-labelledby="hd-pay-title">
              <span class="hd-pay-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a3 3 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a3 3 0 0 0 0-6z"/><path d="M12 9.2c-.6-.5-2.4-.6-2.4.7 0 1.5 2.8.9 2.8 2.4 0 1.3-1.9 1.3-2.7.6M11.2 8v1M11.2 13.6v1"/></svg></span>
              <h3 class="hd-pay-title" id="hd-pay-title">{t.stripeTitle}</h3>
              <p class="hd-pay-body" data-ha-stripe-body>{t.stripeBody}</p>
              <button type="button" class="hd-pay-btn" data-ha-stripe-go>{t.stripeBtn}</button>
              <button type="button" class="hd-pay-link" data-ha-stripe-link>{t.stripeLinkBtn}</button>
            </dialog>
            <button type="submit" class="hd-publish">{t.publish}</button>
            <p class="hd-publish-note" data-ha-create-note role="status">{t.publishNote}</p>
          </div>
        </form>

        <!-- Calendar: the host's own dates, then their weekly schedule. -->
        <section class="hd-dates" data-ha-panel="calendar" hidden>
          <div class="hd-dates-head"><h2 class="hd-h2">{t.yourDates}</h2><button type="button" class="hd-add-big" data-ha-new>+ {t.newDate}</button></div>
          <div data-ha-own-dates></div>
          <p class="ha-empty" data-ha-own-empty hidden>{t.noOwnDates}</p>
        </section>
        <form class="ha-card" data-ha-panel="calendar" hidden>
          <p class="ha-lede">{t.scheduleLede}</p>
          <div data-ha-slots></div>
          <p class="ha-note" data-ha-noslots hidden>{t.noSlots}</p>
          <button type="button" class="ha-link" data-ha-addslot>{t.addSlot}</button>
          <div class="ha-save">
            <button type="submit" class="ha-btn">{t.save}</button>
            <p class="ha-note" role="status"></p>
          </div>
        </form>

      </div>
    </div>

    <template data-ha-slot-tpl>
      <fieldset class="ha-slot">
        <label class="ha-field"><span>{t.slotTitle}</span><input name="title" required maxlength="120" /></label>
        <div class="ha-field">
          <span>{t.slotDays}</span>
          <div class="ha-days">
            {['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'].map((d, i) => (
              <label><input type="checkbox" name="day" value={d} /> {t.days[i]}</label>
            ))}
          </div>
        </div>
        <div class="ha-row">
          <label class="ha-field"><span>{t.slotTime}</span><input type="time" name="time" required /></label>
          <label class="ha-field"><span>{t.slotDuration}</span><input name="duration" maxlength="40" placeholder="2.5 h" /></label>
          <label class="ha-field"><span>{t.slotPrice}</span><input type="number" name="price" min="0" max="2000" step="1" /></label>
        </div>
        <button type="button" class="ha-link ha-remove" data-ha-remove>{t.removeSlot}</button>
      </fieldset>
    </template>
  </section>
</Base>

<script>
  import { formEndpoint } from '../data/firebase.ts';
  import { rememberSignedIn } from '../lib/auth.ts';
  import { initializeApp } from 'firebase/app';
  import {
    getAuth, GoogleAuthProvider, isSignInWithEmailLink, onAuthStateChanged, sendSignInLinkToEmail, signInWithEmailLink,
    signInWithPopup, signOut,
  } from 'firebase/auth';
  import {
    collection, doc, getDoc, getDocs, getFirestore, query, setDoc, where, writeBatch,
  } from 'firebase/firestore';
  import { getDownloadURL, getStorage, ref as storageRef, uploadBytes } from 'firebase/storage';

  type Profile = Record<string, string>;
  type Slot = { title: string; weekdays: string[]; time: string; duration?: string | null; price?: number | null };
  type HostData = { name: string; page: string; en: Profile; de: Profile; slots: Slot[]; photos: string[] };

  const root = document.querySelector<HTMLElement>('[data-ha]');
  if (root) {
    const cfg = JSON.parse(root.dataset.config || '{}');
    const hosts: Record<string, HostData> = JSON.parse(root.dataset.hosts || '{}');
    const t: Record<string, string> = JSON.parse(root.dataset.copy || '{}');
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const fill = (s: string, email: string) => s.replace('{email}', email);
    const signin = $<HTMLFormElement>('[data-ha-signin]');

    if (!cfg.ready) {
      // Accounts open once Firebase is set up; until then, say so.
      const p = $('[data-ha-soon]');
      p.textContent = fill(t.soon, cfg.contact);
      p.hidden = false;
    } else {
      const app0 = initializeApp(cfg.firebase);
      const auth = getAuth(app0);
      const db = getFirestore(app0);
      const STORE = 'twiggli-host-signin-email';

      const app = $('[data-ha-app]');
      const editor = $('[data-ha-editor]');
      const pick = $<HTMLSelectElement>('[data-ha-pick]');
      const pageForm = $<HTMLFormElement>('[data-ha-panel="listings"]');
      const slotForm = $<HTMLFormElement>('[data-ha-panel="calendar"]');
      const slotsBox = $('[data-ha-slots]');
      const tpl = $<HTMLTemplateElement>('[data-ha-slot-tpl]');
      let email = '';
      let slug = '';
      // Twiggli's service fee in percent (hostMembers.commissionPct, else 15), shown to hosts as a line.
      let feePct = 15;
      const keep = (n: number) => n * (1 - feePct / 100);
      // Saved texts per language for the current host (from Firestore, else the site).
      let texts: Record<'en' | 'de', Profile> = { en: {}, de: {} };
      let textLang: 'en' | 'de' = 'en';

      const note = (form: HTMLElement, msg: string, ok = true) => {
        const p = form.querySelector<HTMLElement>('.ha-save .ha-note, [data-ha-signin-note]');
        if (p) { p.textContent = msg; p.dataset.ok = String(ok); }
      };
      const remember = (v: string) => { try { localStorage.setItem(STORE, v); } catch { /* private mode */ } };
      const recall = () => { try { return localStorage.getItem(STORE) ?? ''; } catch { return ''; } };

      // ── Signing in: an email link, no password ──
      signin.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = signin.querySelector('button')!;
        const addr = (signin.elements.namedItem('email') as HTMLInputElement).value.trim();
        btn.disabled = true; btn.textContent = t.sending;
        try {
          await sendSignInLinkToEmail(auth, addr, { url: location.origin + location.pathname, handleCodeInApp: true });
          remember(addr);
          note(signin, t.linkSent, true);
        } catch {
          note(signin, fill(t.error, cfg.contact), false);
        }
        btn.disabled = false; btn.textContent = t.sendLink;
      });
      $('[data-ha-signout]').addEventListener('click', async () => {
        await signOut(auth);
        rememberSignedIn(false);
        location.reload();
      });
      $('[data-ha-google]').addEventListener('click', async () => {
        try { await signInWithPopup(auth, new GoogleAuthProvider()); location.reload(); }
        catch (err) { if ((err as { code?: string }).code !== 'auth/popup-closed-by-user') note(signin, fill(t.error, cfg.contact), false); }
      });

      // ── A personal invite link (?invite=…&page=slug) Jirel emailed: kept
      //    through the sign-in (the email link comes back without it).
      const INVITE = 'twiggli-host-invite';
      const params = new URLSearchParams(location.search);
      if (params.get('invite') && params.get('page')) {
        try { localStorage.setItem(INVITE, JSON.stringify({ slug: params.get('page'), invite: params.get('invite') })); } catch { /* private mode */ }
      }
      const pendingInvite = (): { slug: string; invite: string } | null => {
        try { return JSON.parse(localStorage.getItem(INVITE) || 'null'); } catch { return null; }
      };
      const inv = pendingInvite();
      if (inv && hosts[inv.slug]) {
        const p = $('[data-ha-invite-note]');
        p.textContent = t.inviteNote.replace('{name}', hosts[inv.slug].name);
        p.hidden = false;
      }

      // Coming back from the link in the email.
      const finishSignIn = async () => {
        if (!isSignInWithEmailLink(auth, location.href)) return;
        // Opened on another device: ask which email the link went to.
        const addr = recall() || window.prompt(t.email) || '';
        try {
          await signInWithEmailLink(auth, addr, location.href);
          try { localStorage.removeItem(STORE); } catch { /* private mode */ }
        } catch {
          signin.hidden = false;
          note(signin, fill(t.error, cfg.contact), false);
        }
        history.replaceState(null, '', location.pathname);
      };

      // ── Tabs ──
      // ── Listings: pause or delete a workshop (functions hostListing) ──
      const renderListings = async () => {
        const list = $('[data-hl-list]');
        const note = $('[data-hl-note]');
        if (!slug) return;
        type L = { title: string; key: string; price: string; image: string; dates: number; status: 'live' | 'paused' };
        const built: L[] = (hosts[slug]?.workshops ?? []).filter((w) => w.key).map((w) => ({ ...w, status: 'live' }));
        let state: { key: string; title: string; status: string; price: string; image: string }[] = [];
        try { state = (await api('hostListing', { slug, action: 'list' })).items ?? []; } catch { /* shown as online */ }
        const rows: L[] = [];
        for (const w of built) {
          const st = state.find((x) => x.key === w.key)?.status;
          if (st === 'deleted') continue;
          rows.push({ ...w, status: st === 'paused' ? 'paused' : 'live' });
        }
        // Paused ones are already off the built site: they come from the saved state.
        for (const x of state) if (x.status === 'paused' && !rows.some((r) => r.key === x.key)) rows.push({ title: x.title, key: x.key, price: x.price, image: x.image, dates: 0, status: 'paused' });
        if (!rows.length) { list.replaceChildren(el('p', 'hl-empty', t.ib.lsEmpty)); return; }
        const set = async (w: L, status: 'live' | 'paused' | 'deleted', btns: HTMLButtonElement[]) => {
          btns.forEach((b) => { b.disabled = true; });
          note.textContent = '';
          try {
            await api('hostListing', { slug, key: w.key, title: w.title, price: w.price, image: w.image, status });
            note.textContent = status === 'live' ? t.ib.lsDoneLive : status === 'paused' ? t.ib.lsDonePaused : t.ib.lsDoneDeleted;
          } catch { note.textContent = t.ib.lsFail; }
          await renderListings();
        };
        list.replaceChildren(...rows.map((w) => {
          const row = el('article', `hl-row${w.status === 'paused' ? ' is-paused' : ''}`);
          const pic = w.image ? Object.assign(document.createElement('img'), { src: w.image, alt: '', loading: 'lazy', className: 'hl-img' }) : el('span', 'hl-img');
          const txt = el('div', 'hl-txt');
          const pill = el('span', `hl-pill ${w.status === 'paused' ? 'is-paused' : 'is-live'}`, w.status === 'paused' ? t.ib.lsPaused : t.ib.lsLive);
          txt.append(pill, el('b', '', w.title), el('small', '', [w.price, w.dates ? say(w.dates === 1 ? t.ib.lsDate1 : t.ib.lsDates, { n: String(w.dates) }) : ''].filter(Boolean).join(' · ')));
          const acts = el('div', 'hl-acts');
          const toggle = el('button', 'hl-btn', w.status === 'paused' ? t.ib.lsResume : t.ib.lsPause) as HTMLButtonElement; toggle.type = 'button';
          const del = el('button', 'hl-btn hl-del', t.ib.lsDelete) as HTMLButtonElement; del.type = 'button';
          toggle.addEventListener('click', () => void set(w, w.status === 'paused' ? 'live' : 'paused', [toggle, del]));
          del.addEventListener('click', () => {
            // Asked on top, in its own popup; pausing is offered as the gentler way.
            const dlg = $<HTMLDialogElement>('[data-hl-confirm]');
            const body = dlg.querySelector<HTMLElement>('[data-hl-confirm-body]')!;
            const yes = el('button', 'ib-act ib-act-main ib-offer-send hl-del-yes', t.ib.lsDeleteYes) as HTMLButtonElement; yes.type = 'button';
            yes.addEventListener('click', () => { dlg.close(); void set(w, 'deleted', [toggle, del]); });
            const pause = el('button', 'ib-act', t.ib.lsPauseInstead) as HTMLButtonElement; pause.type = 'button';
            pause.addEventListener('click', () => { dlg.close(); void set(w, 'paused', [toggle, del]); });
            body.replaceChildren(el('h2', 'ib-offer-h', say(t.ib.lsDeleteQ, { title: w.title })), el('p', 'ib-hint', t.ib.lsDeleteNote), yes, ...(w.status === 'live' ? [pause] : []));
            dlg.showModal();
          });
          acts.append(toggle, del);
          row.append(pic, txt, acts);
          return row;
        }));
      };
      const showTab = (name: string) => {
        root.querySelectorAll<HTMLButtonElement>('[data-ha-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.haTab === name)));
        root.querySelectorAll<HTMLElement>('[data-ha-panel]').forEach((p) => { p.hidden = p.dataset.haPanel !== name; });
        window.scrollTo({ top: 0 });
        if (name === 'listings') void renderListings();
      };
      root.querySelectorAll<HTMLButtonElement>('[data-ha-tab]').forEach((tab) => tab.addEventListener('click', () => showTab(tab.dataset.haTab!)));
      // The bell, "+ Date" and the waiting-requests notice jump to their tab.
      root.querySelectorAll<HTMLElement>('[data-ha-go]').forEach((b) => b.addEventListener('click', () => showTab(b.dataset.haGo!)));

      // ── Profile: an emoji as the avatar, and the menu behind it ──
      const menu = $('[data-ha-menu]');
      const avatar = $<HTMLButtonElement>('[data-ha-avatar]');
      avatar.addEventListener('click', (e) => { e.stopPropagation(); menu.hidden = !menu.hidden; });
      document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) menu.hidden = true; });
      const EMOJI_KEY = 'twiggli-host-emoji';
      const hdEmoji = () => { try { return localStorage.getItem(`${EMOJI_KEY}:${email}`) || '🙂'; } catch { return '🙂'; } };
      root.querySelectorAll<HTMLButtonElement>('[data-ha-emojis] button').forEach((b) => b.addEventListener('click', () => {
        try { localStorage.setItem(`${EMOJI_KEY}:${email}`, b.textContent || '🙂'); } catch { /* private mode */ }
        avatar.textContent = b.textContent;
        menu.hidden = true;
      }));

      // ── Page text ──
      const showText = () => {
        for (const [k, v] of Object.entries(texts[textLang])) {
          const el = pageForm.elements.namedItem(k) as HTMLInputElement | HTMLTextAreaElement | null;
          if (el) el.value = v ?? '';
        }
      };
      const readText = (): Profile => {
        const out: Profile = {};
        for (const k of Object.keys(hosts[slug].en)) {
          out[k] = ((pageForm.elements.namedItem(k) as HTMLInputElement | null)?.value ?? '').trim();
        }
        return out;
      };
      pageForm.querySelectorAll<HTMLInputElement>('input[name="textlang"]').forEach((r) => {
        r.addEventListener('change', () => {
          texts[textLang] = readText(); // keep what was typed when switching
          textLang = r.value as 'en' | 'de';
          showText();
        });
      });
      pageForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        texts[textLang] = readText();
        const btn = pageForm.querySelector<HTMLButtonElement>('.ha-save button')!;
        btn.disabled = true; btn.textContent = t.saving;
        let ok = true;
        try {
          await setDoc(doc(db, 'hostProfiles', `${slug}_${textLang}`), {
            slug, lang: textLang, ...texts[textLang], updated_at: new Date().toISOString(), updated_by: email,
          });
        } catch { ok = false; }
        btn.disabled = false; btn.textContent = t.save;
        note(pageForm, ok ? t.saved : fill(t.error, cfg.contact), ok);
        if (ok) tellUs(`page text (${textLang})`);
      });

      // ── Weekly schedule ──
      const addSlot = (s?: Slot) => {
        const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const q = <T extends HTMLInputElement>(n: string) => node.querySelector<T>(`[name="${n}"]`)!;
        if (s) {
          q('title').value = s.title;
          q('time').value = s.time;
          q('duration').value = s.duration ?? '';
          q('price').value = s.price ? String(s.price) : '';
          node.querySelectorAll<HTMLInputElement>('[name="day"]').forEach((d) => { d.checked = s.weekdays.includes(d.value); });
        } else {
          q('title').value = hosts[slug]?.en.specialty ?? '';
        }
        node.querySelector('[data-ha-remove]')!.addEventListener('click', () => { node.remove(); emptyHint(); });
        slotsBox.append(node);
        emptyHint();
      };
      const emptyHint = () => { $('[data-ha-noslots]').hidden = slotsBox.children.length > 0; };
      $('[data-ha-addslot]').addEventListener('click', () => addSlot());
      slotForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const rows = Array.from(slotsBox.querySelectorAll<HTMLElement>('.ha-slot')).map((n) => {
          const v = (k: string) => n.querySelector<HTMLInputElement>(`[name="${k}"]`)!.value.trim();
          return {
            slug,
            title: v('title'),
            weekdays: Array.from(n.querySelectorAll<HTMLInputElement>('[name="day"]:checked')).map((d) => d.value),
            time: v('time').slice(0, 5),
            duration: v('duration') || null,
            price: v('price') ? Math.round(Number(v('price'))) : null,
            active: true,
          };
        });
        const bad = rows.find((r) => !r.title || !r.weekdays.length || !/^\d\d:\d\d$/.test(r.time));
        if (bad) { note(slotForm, fill(t.error, cfg.contact), false); return; }
        const btn = slotForm.querySelector<HTMLButtonElement>('.ha-save button')!;
        btn.disabled = true; btn.textContent = t.saving;
        // Replace the whole schedule in one go: delete what was there, add what is here.
        let ok = true;
        try {
          const old = await getDocs(query(collection(db, 'hostSlots'), where('slug', '==', slug)));
          const batch = writeBatch(db);
          old.forEach((d) => batch.delete(d.ref));
          for (const r of rows) batch.set(doc(collection(db, 'hostSlots')), r);
          await batch.commit();
        } catch { ok = false; }
        btn.disabled = false; btn.textContent = t.save;
        note(slotForm, ok ? t.saved : fill(t.error, cfg.contact), ok);
        if (ok) tellUs('weekly schedule');
      });

      /** A note to our inbox, so Jirel sees every change a host makes. */
      const tellUs = (what: string) => {
        fetch(formEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            Type: 'Host account edit', Host: slug, Changed: what, By: email,
            _subject: `Host account edit: ${hosts[slug]?.name ?? slug} (${what})`, _template: 'table', _captcha: 'false',
          }),
        }).catch(() => {});
      };

      // ── Loading a host ──
      const openHost = async (s: string) => {
        slug = s;
        const h = hosts[s];
        $<HTMLAnchorElement>('[data-ha-view]').href = h?.page ?? '#';
        const [prof, slotSnap] = await Promise.all([
          getDocs(query(collection(db, 'hostProfiles'), where('slug', '==', s))),
          getDocs(query(collection(db, 'hostSlots'), where('slug', '==', s))),
        ]);
        const rows = prof.docs.map((d) => d.data() as Profile);
        const saved = (l: 'en' | 'de') => {
          const row = rows.find((p) => p.lang === l);
          const base = { ...(h?.[l] ?? {}) };
          if (row) for (const k of Object.keys(base)) if (row[k]) base[k] = row[k];
          return base;
        };
        texts = { en: saved('en'), de: saved('de') };
        showText();
        slotsBox.replaceChildren();
        const slots = slotSnap.docs.map((d) => d.data() as Slot & { active?: boolean })
          .filter((x) => x.active !== false)
          .sort((a, b) => a.time.localeCompare(b.time));
        for (const sl of (slots.length ? slots : h?.slots ?? [])) addSlot(sl);
        emptyHint();
        editor.hidden = false;
        $('[data-ha-tabs]').hidden = false;
        root.querySelectorAll<HTMLElement>('[data-ha-hostonly]').forEach((x) => { x.hidden = false; });
        const first = (auth.currentUser?.displayName || '').split(' ')[0] || (h?.name ?? '').split(' ')[0];
        $('[data-ha-hello]').textContent = `${t.hello} ${first} 👋`;
        avatar.textContent = hdEmoji();
        loadInbox();
        void loadStripe().then(() => {
          // Back from Stripe's onboarding: say how it went, then tidy the address.
          const back = new URLSearchParams(location.search).get('stripe');
          if (!back) return;
          history.replaceState(null, '', location.pathname);
          if (back === 'return' || back === 'linked') alert(stripeReady ? (back === 'linked' ? `${t.stripeLinked} ${t.stripeDone}` : t.stripeDone) : t.stripePending);
          else if (back === 'failed') alert(t.stripeFail);
        });
      };

      // ── Messages and Today: the requests for this host (functions hostInbox) ──
      type Req = { id: string; subject: string; fields: Record<string, string>; status: string; thread: { action: string; when?: string; message?: string; at: number }[]; createdAt: number };
      let reqs: Req[] = [];
      let filter = 'all';
      let when = 'upcoming';
      let whenChosen = false; // until the host picks a tab, open requests come first
      const api = async (name: string, body: Record<string, unknown>) => {
        const token = await auth.currentUser?.getIdToken();
        const res = await fetch(`${cfg.functions}/${name}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify(body),
        });
        if (!res.ok) {
          const why = await res.json().catch(() => ({}));
          throw new Error(why.error ? `${res.status}: ${why.error}` : String(res.status));
        }
        return res.json();
      };
      const statusText: Record<string, string> = { pending: t.stPending, accepted: t.stAccepted, declined: t.stDeclined, suggested: t.stSuggested, offered: t.ib.offer };
      const dateOf = (r: Req) => (r.fields.Date || '').slice(0, 10);
      const el = (tag: string, cls = '', text = '') => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };
      // Read state stays on this device (no extra writes for a click).
      const SEEN = `twiggli-seen-${slug}`;
      const seen = new Set<string>((() => { try { return JSON.parse(localStorage.getItem(SEEN) ?? '[]'); } catch { return []; } })());
      const markSeen = (id: string) => { seen.add(id); try { localStorage.setItem(SEEN, JSON.stringify([...seen].slice(-300))); } catch { /* storage off */ } };
      const waiting = (r: Req) => r.status === 'pending';
      const unread = (r: Req) => !seen.has(r.id) && waiting(r);
      const firstName = (r: Req) => (r.fields.Name || r.fields.Email || t.guest).trim().split(/\s+/)[0];
      const fmtDay = (iso: string) => (iso ? new Date(`${iso}T12:00:00`).toLocaleDateString(document.documentElement.lang === 'de' ? 'de-DE' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '');
      let openId = '';
      const row = (r: Req) => {
        const li = el('li', `ha-msg${r.id === openId ? ' is-open' : ''}${unread(r) ? ' is-unread' : ''}`);
        const av = el('span', 'ha-av', firstName(r).charAt(0).toUpperCase());
        const body = el('div', 'ha-msg-body');
        const top = el('div', 'ha-msg-top');
        top.append(el('span', 'ha-msg-meta', `${t.ib.inquiry} · ${fmtDay(dateOf(r))}`), el('time', '', new Date(r.createdAt).toLocaleDateString(document.documentElement.lang || 'de', { day: 'numeric', month: 'short' })));
        const name = el('strong', '', r.fields.Name || r.fields.Email || t.guest);
        const line = el('p', 'ha-msg-line', r.fields.Workshop || r.subject);
        const meta = el('p', 'ha-msg-meta');
        meta.append(el('i', `ha-st ha-st-${r.status}`), statusText[r.status] ?? r.status);
        body.append(top, name, line, meta);
        if (waiting(r)) { const b = el('span', 'ha-pill-btn', t.review); body.append(b); }
        li.append(av, body);
        li.tabIndex = 0;
        li.addEventListener('click', () => openDetail(r));
        li.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') openDetail(r); });
        return li;
      };
      const renderMsgs = () => {
        const shown = reqs.filter((r) => filter === 'all' || unread(r));
        const prio = shown.filter(waiting);
        const rest = shown.filter((r) => !waiting(r));
        $('[data-ib-prio]').replaceChildren(...prio.map(row));
        $('[data-ha-msgs]').replaceChildren(...rest.map(row));
        root.querySelector<HTMLElement>('[data-ib-g="prio"]')!.hidden = !prio.length;
        root.querySelector<HTMLElement>('[data-ib-g="recent"]')!.hidden = !rest.length;
        $('[data-ha-msgs-empty]').hidden = shown.length > 0;
        const pending = reqs.filter(waiting);
        $('[data-ha-dot]').hidden = !pending.length;
        const count = $('[data-ha-count]');
        count.textContent = String(pending.length);
        count.hidden = !pending.length;
        renderTodo();
        renderOverview(pending);
      };
      /** One clear to-do on top, as Airbnb's banner: Stripe, while it isn't connected. */
      const renderTodo = () => { $('[data-ib-todo]').hidden = stripeReady !== false; };
      $('[data-ib-todo]').addEventListener('click', () => { showTab('create'); showStripe(); });

      // ── Overview: greeting, waiting requests, four numbers, dates by day ──
      const locale = document.documentElement.lang === 'de' ? 'de-DE' : 'en-GB';
      const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const euro = (n: number) => `€ ${Math.round(n).toLocaleString(locale)}`;
      const priceOf = (r: Req) => Number(String(r.fields.Price ?? '').replace(/[^\d.,]/g, '').replace(',', '.')) || 0;
      const peopleOf = (r: Req) => Number(r.fields.People) || 1;
      const WD = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
      // Today: one card per open request with the hours left to answer; a tap
      // opens the request details (as the Airbnb app).
      let reqTick = 0;
      const renderReqCards = (pending: Req[]) => {
        const wrap = $('[data-ha-reqs]');
        const row = $('[data-ha-reqs-row]');
        window.clearInterval(reqTick);
        // Requests have their own tab, and that tab shows only the requests:
        // no numbers, no dates, no "Neuer Termin" (one thing at a time).
        const tab = $('[data-ha-req-tab]');
        tab.hidden = !pending.length;
        $('[data-ha-req-n]').textContent = String(pending.length);
        if (!whenChosen && pending.length) when = 'requests';
        if (when === 'requests' && !pending.length) when = 'upcoming';
        root.querySelectorAll<HTMLButtonElement>('[data-ha-when] button').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.w === when)));
        $('[data-ha-panel="overview"]').classList.toggle('is-requests', when === 'requests');
        wrap.hidden = when !== 'requests';
        if (!pending.length) { row.replaceChildren(); return; }
        const sorted = [...pending].sort((a, b) => a.createdAt - b.createdAt);
        const lefts: [HTMLElement, number][] = [];
        row.replaceChildren(...sorted.map((r) => {
          const card = el('button', 'hd-req') as HTMLButtonElement; card.type = 'button';
          const left = el('span', 'hd-req-left');
          lefts.push([left, r.createdAt + 48 * 3600 * 1000]);
          const d = dateOf(r);
          const day = d ? new Date(`${d}T12:00:00`).toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short' }) : '';
          const n = peopleOf(r);
          const txt = el('span', 'hd-req-txt');
          txt.append(el('b', 'hd-req-what', day ? say(t.ib.reqFor, { date: day }) : t.ib.inquiry),
            el('span', 'hd-req-n', [n === 1 ? t.ib.guest1 : say(t.ib.guests, { n: String(n) }), r.fields.Workshop].filter(Boolean).join(' · ')));
          card.append(el('span', 'hd-req-av', firstName(r).charAt(0).toUpperCase()), txt, left);
          card.addEventListener('click', () => {
            showTab('messages');
            openDetail(r);
            root.querySelector<HTMLButtonElement>('[data-ib-conv] .ib-respond')?.click();
          });
          return card;
        }));
        const paintLeft = () => {
          for (const [node, deadline] of lefts) {
            const ms = deadline - Date.now();
            const h = Math.floor(ms / 3600000);
            node.textContent = ms <= 0 ? t.ib.timeUp : h >= 1 ? say(h === 1 ? t.ib.hLeft1 : t.ib.hLeft, { n: String(h) }) : say(t.ib.mLeft, { n: String(Math.max(1, Math.ceil(ms / 60000))) });
            node.classList.toggle('is-soon', ms < 6 * 3600000);
          }
        };
        paintLeft();
        reqTick = window.setInterval(paintLeft, 30000);
      };
      const renderOverview = (pending: Req[]) => {
        const today = iso(new Date());
        const month = today.slice(0, 7);
        const booked = reqs.filter((r) => r.status === 'accepted');
        // Waiting requests, right at the top.
        const alert = $('[data-ha-alert]');
        alert.hidden = true; // the request cards below replace the banner
        renderReqCards(pending);
        $('[data-ha-alert-title]').textContent = (pending.length === 1 ? t.alertOne : t.alertMany).replace('{n}', String(pending.length));
        $('[data-ha-alert-sub]').textContent = pending.slice(0, 2)
          .map((r) => `${(r.fields.Name || t.guest).split(' ')[0]} · ${r.fields.Date ? new Date(dateOf(r)).toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'numeric' }) : ''} · ${peopleOf(r)} ${t.people}`)
          .join('   ·   ');
        // Four numbers.
        const thisMonth = booked.filter((r) => dateOf(r).startsWith(month));
        const set = (k: string, v: string, note = '') => {
          $(`[data-ha-st="${k}"]`).textContent = v;
          const n = root.querySelector<HTMLElement>(`[data-ha-st-note="${k}"]`);
          if (n) n.textContent = note;
        };
        set('open', String(pending.length), pending.length ? t.stOpenNote : t.stOpenNone);
        set('bookings', String(thisMonth.length), t.stBookingsNote.replace('{n}', String(thisMonth.reduce((a, r) => a + peopleOf(r), 0))));
        set('earnings', euro(thisMonth.reduce((a, r) => a + keep(priceOf(r) * peopleOf(r)), 0)));
        // Dates: the weekly schedule for the next two weeks, plus confirmed bookings.
        const slots = Array.from(slotsBox.querySelectorAll('.ha-slot')).map((n) => ({
          title: (n.querySelector('[name="title"]') as HTMLInputElement).value,
          time: (n.querySelector('[name="time"]') as HTMLInputElement).value,
          duration: (n.querySelector('[name="duration"]') as HTMLInputElement).value,
          days: Array.from(n.querySelectorAll<HTMLInputElement>('[name="day"]:checked')).map((d) => d.value),
        }));
        type Item = { date: string; time: string; title: string; sub: string; people: number };
        const items: Item[] = [];
        if (when === 'upcoming') {
          for (const ev of ownEvents) for (const date of occurrences(ev, 14)) {
            const ppl = booked.filter((r) => dateOf(r) === date).reduce((a, r) => a + peopleOf(r), 0);
            items.push({ date, time: ev.start, title: ev.title, sub: [ev.end ? `${ev.start}–${ev.end}` : ev.start, ev.seats ? t.seatsN.replace('{n}', String(ev.seats)) : ''].filter(Boolean).join(' · '), people: ppl });
          }
          for (let i = 0; i < 14; i++) {
            const d = new Date(); d.setDate(d.getDate() + i);
            for (const sl of slots) if (sl.days.includes(WD[d.getDay()])) {
              const date = iso(d);
              const ppl = booked.filter((r) => dateOf(r) === date).reduce((a, r) => a + peopleOf(r), 0);
              items.push({ date, time: sl.time, title: sl.title, sub: [sl.time, sl.duration].filter(Boolean).join(' · '), people: ppl });
            }
          }
          for (const r of booked) if (dateOf(r) >= today && !items.some((x) => x.date === dateOf(r))) {
            items.push({ date: dateOf(r), time: r.fields.Time || '', title: r.fields.Workshop || r.subject, sub: [r.fields.Time, r.fields.Name].filter(Boolean).join(' · '), people: peopleOf(r) });
          }
        } else {
          for (const r of booked) if (dateOf(r) && dateOf(r) < today) {
            items.push({ date: dateOf(r), time: r.fields.Time || '', title: r.fields.Workshop || r.subject, sub: [r.fields.Time, r.fields.Name].filter(Boolean).join(' · '), people: peopleOf(r) });
          }
        }
        items.sort((a, b) => (when === 'past' ? -1 : 1) * `${a.date} ${a.time}`.localeCompare(`${b.date} ${b.time}`));
        const next = items.find(() => when === 'upcoming');
        set('next', next ? new Date(next.date).toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short' }) : '–', next ? `${next.time} · ${next.title}` : t.stNextNone);
        $('[data-ha-list-title]').textContent = when === 'past' ? t.pastDates : t.nextDates;
        const box = $('[data-ha-days]');
        box.replaceChildren();
        let last = '';
        for (const it of items) {
          if (it.date !== last) {
            last = it.date;
            const d = new Date(it.date);
            box.append(el('p', 'hd-day', `${it.date === today ? `${t.today} · ` : ''}${d.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' })}`));
          }
          const card = el('div', 'hd-ev');
          const img = document.createElement('img');
          img.src = `/img/hosts/${slug}.jpg`; img.alt = ''; img.loading = 'lazy';
          img.addEventListener('error', () => { img.replaceWith(el('span', 'hd-ph', hdEmoji())); });
          const txt = el('div', 'hd-ev-t');
          txt.append(el('b', '', it.title), el('span', '', it.sub));
          const seats = el('div', 'hd-seats', it.people ? t.bookedN.replace('{n}', String(it.people)) : t.noBookingYet);
          card.append(img, txt, seats);
          box.append(card);
        }
        $('[data-ha-today-empty]').hidden = items.length > 0;
      };
      const loadInbox = async () => {
        try { ownEvents = (await api('hostEvents', { slug })).items ?? []; } catch { ownEvents = []; }
        renderOwnDates();
        try { reqs = (await api('hostInbox', { slug })).items ?? []; } catch { reqs = []; }
        renderMsgs();
      };
      // Saved replies, kept on this device; three starters until the host saves their own.
      const SAVED = `twiggli-replies-${slug}`;
      const savedReplies = (): string[] => { try { const v = JSON.parse(localStorage.getItem(SAVED) ?? 'null'); return Array.isArray(v) ? v : [t.ib.msg1, t.ib.msg2, t.ib.msg3]; } catch { return [t.ib.msg1, t.ib.msg2, t.ib.msg3]; } };
      const keepReplies = (v: string[]) => { try { localStorage.setItem(SAVED, JSON.stringify(v.slice(0, 20))); } catch { /* storage off */ } };
      const say = (s: string, map: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, k) => map[k] ?? '');
      const send = async (r: Req, action: string, extra: Record<string, unknown>, note: HTMLElement, btns: HTMLButtonElement[]) => {
        btns.forEach((b) => { b.disabled = true; });
        try {
          await api('hostReply', { id: r.id, action, ...extra });
          note.textContent = t.ib.sent;
          const dlg = root.querySelector<HTMLDialogElement>('[data-ib-modal]');
          if (dlg?.open) dlg.close();
          reqs = (await api('hostInbox', { slug })).items ?? reqs;
          renderMsgs();
          const again = reqs.find((x) => x.id === r.id);
          if (again) openDetail(again);
        } catch {
          note.textContent = fill(t.error, cfg.contact);
          btns.forEach((b) => { b.disabled = false; });
        }
      };
      const openDetail = (r: Req) => {
        openId = r.id;
        markSeen(r.id);
        renderMsgs();
        const de = document.documentElement.lang === 'de';
        const loc = de ? 'de-DE' : 'en-GB';
        const name = firstName(r);
        const ppl = peopleOf(r);
        const each = priceOf(r);
        const deadline = r.createdAt + 48 * 3600 * 1000;
        const late = Date.now() > deadline;

        // ── Middle: the conversation ──
        const conv = $('[data-ib-conv]');
        const head = el('div', 'ib-head');
        const back = el('button', 'ib-back', '←') as HTMLButtonElement;
        back.type = 'button'; back.setAttribute('aria-label', t.back);
        back.addEventListener('click', () => { openId = ''; $('[data-ib-grid]').classList.remove('is-open'); renderMsgs(); });
        head.append(back, el('span', 'ha-av', name.charAt(0).toUpperCase()), el('strong', '', r.fields.Name || t.guest));
        const thread = el('div', 'ib-thread');
        if (r.fields.Message) {
          const b = el('div', 'ib-bubble');
          b.append(el('span', 'ib-who', name), el('p', '', r.fields.Message));
          thread.append(b);
        }
        const card = el('div', 'ib-card');
        card.append(el('small', '', t.ib.inquiry), el('b', '', [each ? `€ ${(each * ppl).toLocaleString(loc)}` : '', ppl === 1 ? t.ib.guest1 : say(t.ib.guests, { n: String(ppl) })].filter(Boolean).join(' · ')),
          el('span', '', [fmtDay(dateOf(r)), r.fields.Time, r.fields.Workshop].filter(Boolean).join(' · ')));
        const pic = document.createElement('img');
        pic.src = `/img/hosts/${slug}.jpg`; pic.alt = ''; pic.loading = 'lazy';
        pic.addEventListener('error', () => pic.remove());
        card.append(pic);
        if (waiting(r)) {
          card.append(el('p', `ib-until${late ? ' is-late' : ''}`, late ? t.ib.late : say(t.ib.until, { when: new Date(deadline).toLocaleString(loc, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) })));
          const go = el('button', 'ib-respond', t.ib.respond) as HTMLButtonElement;
          go.type = 'button';
          go.addEventListener('click', () => {
            const dlg = $<HTMLDialogElement>('[data-ib-modal]');
            const body = dlg.querySelector<HTMLElement>('[data-ib-modal-body]')!;
            buildRes(body, true);
            dlg.showModal();
            body.querySelector<HTMLButtonElement>('.ib-act')?.focus();
          });
          card.append(go);
        }
        thread.append(card);
        for (const h of r.thread) {
          const line = h.action === 'accept' ? t.ib.accepted : h.action === 'decline' ? t.ib.declined : h.action === 'suggest' ? say(t.ib.suggested, { when: h.when ?? '' })
            : h.action === 'offer' ? (() => {
              const o = h as { price?: number; total?: number; people?: number; workshop?: string };
              return say(t.ib.offered, { what: [o.workshop, h.when, o.people ? (o.people === 1 ? t.ib.guest1 : say(t.ib.guests, { n: String(o.people) })) : '',
                o.total ? `€ ${o.total.toLocaleString(loc)} ${t.ib.total}` : o.price ? `€ ${o.price} ${t.ib.perPerson}` : ''].filter(Boolean).join(', ') });
            })() : '';
          const b = el('div', 'ib-bubble ib-mine');
          b.append(el('span', 'ib-who', `${t.ib.you} · ${new Date(h.at).toLocaleString(loc, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}`));
          if (line) b.append(el('p', 'ib-sys', line));
          if (h.message) b.append(el('p', '', h.message));
          thread.append(b);
        }
        // Composer with saved replies.
        const comp = el('form', 'ib-comp') as HTMLFormElement;
        const ta = document.createElement('textarea');
        ta.rows = 2; ta.placeholder = t.ib.write; ta.setAttribute('aria-label', t.ib.write);
        const bar = el('div', 'ib-comp-bar');
        const savedBtn = el('button', 'ib-saved-btn', '💬') as HTMLButtonElement;
        savedBtn.type = 'button'; savedBtn.title = t.ib.saved; savedBtn.setAttribute('aria-label', t.ib.saved);
        const pop = el('div', 'ib-saved');
        pop.hidden = true;
        const fillPop = () => {
          pop.replaceChildren(el('p', 'ib-saved-h', t.ib.saved));
          const list = savedReplies();
          if (!list.length) pop.append(el('p', 'ha-empty', t.ib.noSaved));
          list.forEach((txt, k) => {
            const rowEl = el('div', 'ib-saved-row');
            const use = el('button', 'ib-saved-use', txt) as HTMLButtonElement;
            use.type = 'button';
            use.addEventListener('click', () => { ta.value = ta.value ? `${ta.value}\n${txt}` : txt; pop.hidden = true; ta.focus(); });
            const del = el('button', 'ib-saved-del', '×') as HTMLButtonElement;
            del.type = 'button'; del.setAttribute('aria-label', 'remove');
            del.addEventListener('click', () => { const v = savedReplies(); v.splice(k, 1); keepReplies(v); fillPop(); });
            rowEl.append(use, del);
            pop.append(rowEl);
          });
          const add = el('button', 'ib-saved-add', t.ib.saveThis) as HTMLButtonElement;
          add.type = 'button';
          add.addEventListener('click', () => { const v = ta.value.trim(); if (!v) { ta.focus(); return; } keepReplies([...savedReplies(), v]); fillPop(); });
          pop.append(add);
        };
        savedBtn.addEventListener('click', () => { fillPop(); pop.hidden = !pop.hidden; });
        const sendBtn = el('button', 'ib-send', t.ib.send) as HTMLButtonElement;
        sendBtn.type = 'submit';
        const note = el('p', 'ha-note');
        note.setAttribute('role', 'status');
        bar.append(savedBtn, sendBtn);
        comp.append(pop, ta, bar, note);
        comp.addEventListener('submit', (e) => { e.preventDefault(); const v = ta.value.trim(); if (v) void send(r, 'message', { message: v }, note, [sendBtn]); });
        conv.replaceChildren(head, thread, comp);
        thread.scrollTop = thread.scrollHeight;

        // ── The request, the three actions, the guest: in the right column and in the
        //    "Anfragedetails" popup that Antworten opens (as Airbnb's Reservation details) ──
        const buildRes = (res: HTMLElement, inModal: boolean) => {
        const closeRes = el('button', 'ib-close', '×') as HTMLButtonElement;
        closeRes.type = 'button'; closeRes.setAttribute('aria-label', t.back);
        closeRes.addEventListener('click', () => { if (inModal) (res.closest('dialog') as HTMLDialogElement | null)?.close(); else $('[data-ib-grid]').classList.remove('show-res'); });
        const what = el('div', 'ib-what');
        what.append(el('small', '', statusText[r.status] ?? t.ib.inquiry), el('h3', '', say(t.ib.asked, { name, what: r.fields.Workshop || t.ib.inquiry })),
          el('p', '', [fmtDay(dateOf(r)), r.fields.Time].filter(Boolean).join(', ')),
          el('p', '', [ppl === 1 ? t.ib.guest1 : say(t.ib.guests, { n: String(ppl) }), each ? `€ ${(each * ppl).toLocaleString(loc)} ${t.ib.total}` : ''].filter(Boolean).join(' · ')));
        if (each) {
          const earn = el('div', 'ib-earn');
          earn.append(el('span', '', t.ib.oYou), el('b', '', `€ ${keep(each * ppl).toLocaleString(loc, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`));
          what.append(earn);
        }
        res.replaceChildren(...(inModal ? [] : [closeRes]), what);
        if (inModal) {
          // As the Airbnb app: the guest's initial beside the title, and what they wrote.
          what.classList.add('has-av');
          what.prepend(el('span', 'ha-av ib-what-av', name.charAt(0).toUpperCase()));
          if (r.fields.Message) {
            const said = el('div', 'ib-said');
            const ago = (() => {
              const mins = Math.max(1, Math.round((Date.now() - r.createdAt) / 60000));
              const rtf = new Intl.RelativeTimeFormat(loc, { numeric: 'auto' });
              return mins < 60 ? rtf.format(-mins, 'minute') : mins < 2880 ? rtf.format(-Math.round(mins / 60), 'hour') : rtf.format(-Math.round(mins / 1440), 'day');
            })();
            said.append(el('b', '', say(t.ib.said, { name })), el('small', '', ago), el('p', '', r.fields.Message));
            res.append(said);
          }
        }
        if (waiting(r) || r.status === 'suggested' || r.status === 'offered') {
          const acts = el('div', 'ib-acts');
          const rnote = el('p', 'ha-note'); rnote.setAttribute('role', 'status');
          const mk = (label: string) => { const b = el('button', 'ib-act', label) as HTMLButtonElement; b.type = 'button'; return b; };
          const bAccept = mk(t.ib.accept); const bOffer = mk(t.ib.offer); const bDecline = mk(t.ib.decline);
          const all = [bAccept, bOffer, bDecline];
          bAccept.addEventListener('click', () => void send(r, 'accept', {}, rnote, all));
          bOffer.addEventListener('click', () => openOffer(r, rnote, all));
          // Declining opens its own popup on top (as the offer does), never a form below.
          bDecline.addEventListener('click', () => {
            const dlg = $<HTMLDialogElement>('[data-ib-decline]');
            const body = dlg.querySelector<HTMLElement>('[data-ib-decline-body]')!;
            const list = el('div', 'ib-reasons'); list.setAttribute('role', 'radiogroup');
            const reasons: [string, string][] = [['booked', t.ib.rBooked], ['size', t.ib.rSize], ['away', t.ib.rAway], ['fit', t.ib.rFit], ['other', t.ib.rOther]];
            reasons.forEach(([v, l], i) => {
              const lab = el('label', 'ib-reason');
              const inp = document.createElement('input'); inp.type = 'radio'; inp.name = 'ib-reason'; inp.value = v; if (i === 0) inp.checked = true;
              lab.append(inp, el('span', '', l));
              list.append(lab);
            });
            const m = document.createElement('textarea'); m.rows = 3; m.placeholder = t.ib.declinePh;
            const mbox = el('label', 'ib-box'); mbox.append(el('small', '', t.replyMsg), m);
            const go = mk(t.ib.declineSend); go.classList.add('ib-act-main', 'ib-offer-send');
            go.addEventListener('click', () => {
              const reason = list.querySelector<HTMLInputElement>('input:checked')?.value ?? 'other';
              dlg.close();
              void send(r, 'decline', { reason, message: m.value.trim() }, rnote, all);
            });
            body.replaceChildren(
              el('h2', 'ib-offer-h', say(t.ib.declineHead, { name })),
              el('h3', 'ib-offer-sec', t.ib.declineTitle), el('p', 'ib-hint', t.ib.declineNote), list,
              mbox, go,
            );
            dlg.showModal();
            list.querySelector<HTMLInputElement>('input:checked')?.focus();
          });
          acts.append(...all);
          res.append(acts, rnote);
          // A live countdown at the bottom (as the Airbnb app), with a button to write to the guest.
          if (inModal) {
            const dlg = res.closest('dialog') as HTMLDialogElement | null;
            const foot = el('div', 'ib-foot');
            const clock = el('p', 'ib-clock');
            const msgBtn = el('button', 'ib-act ib-act-main', t.ib.msgBtn) as HTMLButtonElement; msgBtn.type = 'button';
            msgBtn.addEventListener('click', () => {
              dlg?.close();
              $('[data-ib-grid]').classList.add('is-open');
              $<HTMLTextAreaElement>('[data-ib-conv] .ib-comp textarea')?.focus();
            });
            foot.append(clock, msgBtn);
            const tick = () => {
              const left = deadline - Date.now();
              if (left <= 0) { clock.textContent = t.ib.late; clock.classList.add('is-late'); return false; }
              const h = Math.floor(left / 3600000), m = Math.floor(left / 60000) % 60, sec = Math.floor(left / 1000) % 60;
              const time = `${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
              clock.replaceChildren(...say(t.ib.decide, { time: '\u0000' }).split('\u0000').flatMap((part, i) => (i ? [el('b', '', time), document.createTextNode(part)] : [document.createTextNode(part)])));
              clock.classList.toggle('is-soon', left < 6 * 3600000);
              return true;
            };
            if (tick()) {
              const iv = window.setInterval(() => { if (!tick() || !dlg?.open) window.clearInterval(iv); }, 1000);
              dlg?.addEventListener('close', () => window.clearInterval(iv), { once: true });
            }
            res.append(foot);
          }
        }
        const g = (r as Req & { guest?: { requests: number; cameFrom: string; lang: string } }).guest;
        const about = el('div', 'ib-about');
        about.append(el('h4', '', say(t.ib.about, { name })));
        const ul = el('ul', '');
        ul.append(el('li', '', g && g.requests > 1 ? say(t.ib.reqN, { n: String(g.requests) }) : t.ib.req1));
        const src = (g?.cameFrom || r.fields['Came from'] || '').replace(/^https?:\/\//, '').replace(/\/.*$/, '');
        if (src) ul.append(el('li', '', say(t.ib.came, { src })));
        const lang = g?.lang || r.fields.Language;
        if (lang) ul.append(el('li', '', say(t.ib.speaks, { lang: lang === 'de' ? (de ? 'Deutsch' : 'German') : lang === 'en' ? (de ? 'Englisch' : 'English') : lang })));
        if (r.fields.Occasion) ul.append(el('li', '', r.fields.Occasion));
        about.append(ul);
        res.append(about);
        };
        const res = $('[data-ib-res]');
        res.hidden = false;
        buildRes(res, false);
        $('[data-ib-grid]').classList.add('is-open');
      };
      /** "Angebot machen", as Airbnb's special offer: workshop, date and time,
       *  people, a price for the whole group, what the guest pays and what the
       *  host gets, and a note. Opens over the request details. */
      const openOffer = (r: Req, rnote: HTMLElement, lock: HTMLButtonElement[]) => {
        const de = document.documentElement.lang === 'de';
        const loc = de ? 'de-DE' : 'en-GB';
        const dlg = $<HTMLDialogElement>('[data-ib-offer]');
        const body = dlg.querySelector<HTMLElement>('[data-ib-offer-body]')!;
        const name = firstName(r);
        const each = priceOf(r);
        const box = (label: string, input: HTMLElement) => { const l = el('label', 'ib-box'); l.append(el('small', '', label), input); return l; };
        // Exactly the host's own listings (e.g. Jem: kimchi, sourdough, tofu), nothing more,
        // nothing less. Only a host without any listing falls back to the workshop asked for.
        type Opt = { title: string; price: string; image: string };
        const listed: Opt[] = hosts[slug]?.workshops ?? [];
        const opts: Opt[] = listed.length ? [...listed]
          : [{ title: (r.fields.Workshop || '').trim(), price: '', image: hosts[slug]?.photos?.[0] ?? '' }].filter((o) => o.title);
        const start = opts.find((o) => o.title.toLowerCase() === (r.fields.Workshop || '').trim().toLowerCase()) ?? opts[0];
        let chosen: Opt | undefined = start;
        const ws = { get value() { return chosen?.title ?? ''; } };
        const thumb = (o?: Opt) => {
          if (o?.image) { const im = document.createElement('img'); im.src = o.image; im.alt = ''; im.loading = 'lazy'; im.className = 'ib-pk-img'; im.addEventListener('error', () => im.replaceWith(el('span', 'ib-pk-img ib-pk-ph', hdEmoji()))); return im; }
          return el('span', 'ib-pk-img ib-pk-ph', hdEmoji());
        };
        const picker = el('div', 'ib-pk');
        const pkBtn = el('button', 'ib-pk-btn') as HTMLButtonElement;
        pkBtn.type = 'button'; pkBtn.setAttribute('aria-haspopup', 'listbox'); pkBtn.setAttribute('aria-expanded', 'false');
        const pkList = el('div', 'ib-pk-list'); pkList.setAttribute('role', 'listbox'); pkList.hidden = true;
        const pkShow = () => {
          pkBtn.replaceChildren(el('small', 'ib-pk-label', t.ib.oWorkshop));
          const rowEl = el('span', 'ib-pk-row');
          const txt = el('span', 'ib-pk-txt');
          txt.append(el('b', '', chosen?.title ?? '—'), ...(chosen?.price ? [el('span', '', chosen.price)] : []));
          rowEl.append(thumb(chosen), txt, el('span', 'ib-pk-chev', '⌄'));
          pkBtn.append(rowEl);
          pkList.replaceChildren(...opts.map((o) => {
            const it = el('button', `ib-pk-opt${o === chosen ? ' is-on' : ''}`) as HTMLButtonElement;
            it.type = 'button'; it.setAttribute('role', 'option'); it.setAttribute('aria-selected', String(o === chosen));
            const tx = el('span', 'ib-pk-txt'); tx.append(el('b', '', o.title), ...(o.price ? [el('span', '', o.price)] : []));
            it.append(thumb(o), tx, el('span', 'ib-pk-check', o === chosen ? '✓' : ''));
            it.addEventListener('click', () => {
              chosen = o; pkList.hidden = true; pkBtn.setAttribute('aria-expanded', 'false'); pkShow();
              // A different workshop: its usual price becomes the starting point.
              const p = Number(String(o.price).replace(/[^\d.,]/g, '').replace(',', '.')) || 0;
              if (p) { sub.value = String(Math.round(p * (Number(gs.value) || 1))); usual.textContent = say(t.ib.oUsual, { each: eur(p) }); paint(); }
              pkBtn.focus();
            });
            return it;
          }));
        };
        pkBtn.addEventListener('click', () => { pkList.hidden = !pkList.hidden; pkBtn.setAttribute('aria-expanded', String(!pkList.hidden)); if (!pkList.hidden) pkList.querySelector<HTMLButtonElement>('.is-on, .ib-pk-opt')?.focus(); });
        picker.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Escape' && !pkList.hidden) { e.stopPropagation(); e.preventDefault(); pkList.hidden = true; pkBtn.focus(); } });
        picker.append(pkBtn, pkList);
        // Date: a calendar that opens under the field (as Airbnb), so the host can
        // propose another day. The guest's wished-for day keeps a dot.
        const asked = dateOf(r);
        const todayIso = iso(new Date());
        const dt = { value: asked && asked >= todayIso ? asked : '' };
        const dBtn = el('button', 'ib-date-btn') as HTMLButtonElement; dBtn.type = 'button'; dBtn.setAttribute('aria-expanded', 'false');
        const dLab = el('span', '');
        dBtn.append(dLab, el('span', 'ib-date-chev', '⌄'));
        const dLabel = () => { dLab.textContent = dt.value ? new Date(`${dt.value}T12:00:00`).toLocaleDateString(loc, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) : t.ib.oDatePick; dLab.classList.toggle('is-empty', !dt.value); };
        dLabel();
        const dBox = el('div', 'ib-box ib-date-box'); dBox.append(el('small', '', t.ib.oDate), dBtn);
        const calPop = el('div', 'ib-cal hd-cal'); calPop.hidden = true;
        let calM = new Date(`${dt.value || asked || todayIso}T12:00:00`); calM.setDate(1);
        const drawOfferCal = () => {
          const y = calM.getFullYear(), mo = calM.getMonth();
          const head = el('div', 'hd-cal-head');
          const nav = el('span', '');
          const prev = el('button', '', '‹') as HTMLButtonElement; prev.type = 'button'; prev.setAttribute('aria-label', '‹');
          const next = el('button', '', '›') as HTMLButtonElement; next.type = 'button'; next.setAttribute('aria-label', '›');
          const thisMonth = new Date(); thisMonth.setDate(1);
          prev.disabled = y < thisMonth.getFullYear() || (y === thisMonth.getFullYear() && mo <= thisMonth.getMonth());
          prev.addEventListener('click', () => { calM.setMonth(mo - 1); drawOfferCal(); });
          next.addEventListener('click', () => { calM.setMonth(mo + 1); drawOfferCal(); });
          nav.append(prev, next);
          head.append(el('b', '', new Date(y, mo, 1).toLocaleDateString(loc, { month: 'long', year: 'numeric' })), nav);
          const grid = el('div', 'hd-cal-grid');
          for (let i = 0; i < 7; i++) grid.append(el('span', 'hd-cal-wd', new Date(2024, 0, 1 + i).toLocaleDateString(loc, { weekday: 'narrow' })));
          const lead = (new Date(y, mo, 1).getDay() + 6) % 7; // Monday first
          for (let i = 0; i < lead; i++) grid.append(el('span', ''));
          const days = new Date(y, mo + 1, 0).getDate();
          for (let d = 1; d <= days; d++) {
            const v = iso(new Date(y, mo, d));
            const b = el('button', 'hd-cal-day', String(d)) as HTMLButtonElement; b.type = 'button';
            if (v === todayIso) b.classList.add('is-today');
            if (v === asked) { b.classList.add('is-asked'); b.title = t.ib.oAsked; }
            if (v === dt.value) { b.classList.add('is-on'); b.setAttribute('aria-pressed', 'true'); }
            if (v < todayIso) b.disabled = true;
            b.addEventListener('click', () => { dt.value = v; dLabel(); calPop.hidden = true; dBtn.setAttribute('aria-expanded', 'false'); dBtn.focus(); });
            grid.append(b);
          }
          const parts: HTMLElement[] = [head, grid];
          if (asked) { const lg = el('p', 'ib-cal-legend'); lg.append(el('i', ''), document.createTextNode(`${t.ib.oAsked}: ${new Date(`${asked}T12:00:00`).toLocaleDateString(loc, { weekday: 'short', day: 'numeric', month: 'short' })}`)); parts.push(lg); }
          calPop.replaceChildren(...parts);
        };
        dBtn.addEventListener('click', () => {
          calPop.hidden = !calPop.hidden; dBtn.setAttribute('aria-expanded', String(!calPop.hidden));
          if (!calPop.hidden) { calM = new Date(`${dt.value || asked || todayIso}T12:00:00`); calM.setDate(1); drawOfferCal(); calPop.querySelector<HTMLButtonElement>('.is-on, .is-today')?.focus({ preventScroll: true }); }
        });
        calPop.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Escape') { e.stopPropagation(); e.preventDefault(); calPop.hidden = true; dBtn.setAttribute('aria-expanded', 'false'); dBtn.focus(); } });
        const tm = document.createElement('input'); tm.type = 'time'; tm.value = (r.fields.Time || '').slice(0, 5);
        const when = el('div', 'ib-two ib-when'); when.append(dBox, box(t.ib.oTime, tm), calPop);
        const gs = document.createElement('select');
        const want = peopleOf(r);
        for (let n = 1; n <= Math.max(40, want); n++) { const o = document.createElement('option'); o.value = String(n); o.textContent = String(n); if (n === want) o.selected = true; gs.append(o); }
        const sub = document.createElement('input'); sub.type = 'number'; sub.min = '0'; sub.step = '1'; sub.inputMode = 'decimal';
        if (each) sub.value = String(Math.round(each * want));
        const sum = el('div', 'ib-sum');
        // Extras for groups, each its own line: snacks, an extra hour, travel …
        const extrasBox = el('div', 'ib-extras');
        const extras: { name: HTMLInputElement; amt: HTMLInputElement }[] = [];
        const addExtra = () => {
          const rowEl = el('div', 'ib-extra');
          const nm = document.createElement('input'); nm.type = 'text'; nm.placeholder = t.ib.oExtraPh; nm.setAttribute('aria-label', t.ib.oExtraName);
          const am = document.createElement('input'); am.type = 'number'; am.min = '0'; am.step = '1'; am.placeholder = '€'; am.setAttribute('aria-label', t.ib.oExtraAmt);
          const rm = el('button', 'ib-saved-del', '×') as HTMLButtonElement; rm.type = 'button'; rm.setAttribute('aria-label', 'remove');
          const item = { name: nm, amt: am };
          rm.addEventListener('click', () => { extras.splice(extras.indexOf(item), 1); rowEl.remove(); paint(); });
          nm.addEventListener('input', paint); am.addEventListener('input', paint);
          rowEl.append(nm, am, rm);
          extrasBox.append(rowEl);
          extras.push(item);
          nm.focus();
        };
        const addBtn = el('button', 'ib-saved-add', t.ib.oExtraAdd) as HTMLButtonElement; addBtn.type = 'button';
        addBtn.addEventListener('click', addExtra);
        const msg = document.createElement('textarea'); msg.rows = 3; msg.placeholder = t.replyMsgPh;
        const note = el('p', 'ha-note'); note.setAttribute('role', 'status');
        const eur = (n: number) => `€${n.toLocaleString(loc, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        const usual = el('p', 'ib-hint', each ? say(t.ib.oUsual, { each: eur(each) }) : t.ib.oUsualNone);
        const paint = () => {
          const base = Number(sub.value) || 0;
          const n = Number(gs.value) || 1;
          const extraLines = extras.map((x) => ({ name: x.name.value.trim(), amt: Number(x.amt.value) || 0 })).filter((x) => x.amt > 0);
          const total = base + extraLines.reduce((a, x) => a + x.amt, 0);
          sum.replaceChildren();
          if (!total) return;
          // As Airbnb: the calculation and the guest's price in one box, and
          // what the host earns in its own box below (Jirel 06.11: hosts must
          // always see their earning potential).
          const calc = el('div', 'ib-sum-box');
          if (base) { const l1 = el('div', 'ib-sum-row'); l1.append(el('span', '', say(t.ib.oLine, { n: String(n), each: eur(base / n) })), el('span', '', eur(base))); calc.append(l1); }
          for (const x of extraLines) { const lx = el('div', 'ib-sum-row'); lx.append(el('span', '', x.name || t.ib.oExtraName), el('span', '', eur(x.amt))); calc.append(lx); }
          const l2 = el('div', 'ib-sum-row ib-sum-strong'); l2.append(el('span', '', t.ib.oGuestPays), el('span', '', eur(total)));
          calc.append(l2);
          const you = el('div', 'ib-sum-box ib-sum-you');
          // As Airbnb, and so hosts see what the platform takes: subtotal, service fee, earnings.
          const fee = Math.round(total * feePct) / 100;
          const l0 = el('div', 'ib-sum-row'); l0.append(el('span', '', t.ib.oSubtotalLine), el('span', '', eur(total)));
          const lf = el('div', 'ib-sum-row'); lf.append(el('span', '', say(t.ib.oFee, { pct: String(feePct) })), el('span', '', `-${eur(fee)}`));
          const l3 = el('div', 'ib-sum-row ib-sum-strong'); l3.append(el('span', '', t.ib.oYou), el('span', '', eur(total - fee)));
          you.append(l0, lf, l3);
          sum.append(calc, you);
        };
        sub.addEventListener('input', paint); gs.addEventListener('change', paint);
        const go = el('button', 'ib-act ib-act-main ib-offer-send', t.ib.offerSend) as HTMLButtonElement; go.type = 'button';
        go.addEventListener('click', () => {
          const n = Number(gs.value) || 1;
          const extraLines = extras.map((x) => ({ name: x.name.value.trim(), amt: Number(x.amt.value) || 0 })).filter((x) => x.amt > 0);
          const total = (Number(sub.value) || 0) + extraLines.reduce((a, x) => a + x.amt, 0);
          if (!dt.value && !total) { note.textContent = t.ib.offerNeed; return; }
          const whenTxt = [dt.value ? new Date(`${dt.value}T12:00:00`).toLocaleDateString(loc, { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' }) : '', tm.value].filter(Boolean).join(', ');
          dlg.close();
          void send(r, 'offer', { when: whenTxt, date: dt.value, time: tm.value, workshop: ws.value, people: n, total, extras: extraLines, price: total ? Math.round((total / n) * 100) / 100 : 0, message: msg.value.trim() }, rnote, lock);
        });
        body.replaceChildren(
          el('h2', 'ib-offer-h', say(t.ib.oTitle, { name })),
          el('p', 'ib-hint', say(t.ib.oSub, { name })),
          el('h3', 'ib-offer-sec', t.ib.oTrip), picker, when, box(t.ib.oGuests, gs),
          el('h3', 'ib-offer-sec', t.ib.oPricing), usual,
          box(t.ib.oSubtotal, sub), el('p', 'ib-hint ib-small', t.ib.oSubNote), extrasBox, addBtn, sum,
          box(t.replyMsg, msg), note, go,
        );
        pkShow();
        paint();
        dlg.showModal();
      };
      const labelled = (label: string, input: HTMLElement) => { const l = el('label', 'ha-field'); l.append(el('span', '', label), input); return l; };
      root.querySelectorAll<HTMLButtonElement>('[data-ha-filter] button').forEach((b) => b.addEventListener('click', () => {
        filter = b.dataset.f!;
        root.querySelectorAll('[data-ha-filter] button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        renderMsgs();
      }));
      root.querySelectorAll<HTMLButtonElement>('[data-ha-when] button').forEach((b) => b.addEventListener('click', () => {
        when = b.dataset.w!;
        whenChosen = true;
        root.querySelectorAll('[data-ha-when] button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        renderMsgs();
      }));


      // ── New date ("Neuer Termin") and the host's own dates ──
      type Ev = {
        id?: string; slug: string; title: string; date: string; start: string; end?: string; repeat?: string; until?: string;
        price?: number | null; seats?: number | null; minGuests?: number | null; approve?: boolean; languages?: string;
        cancel?: string; location?: string; description?: string; visibility?: string; media?: { type: string; url: string }[];
      };
      let ownEvents: Ev[] = [];
      let media: { type: string; url: string }[] = [];
      const createForm = $<HTMLFormElement>('[data-ha-panel="create"]');
      const fld = <T extends HTMLElement = HTMLInputElement>(n: string) => createForm.elements.namedItem(n) as unknown as T;
      // Payouts, as on Luma: touching the price without a connected Stripe
      // account opens the "accept payments" dialog (functions hostStripe).
      let stripeReady: boolean | null = null;
      const stripeBox = $<HTMLDialogElement>('[data-ha-stripe]');
      const stripeBody = $('[data-ha-stripe-body]');
      const stripeGo = $<HTMLButtonElement>('[data-ha-stripe-go]');
