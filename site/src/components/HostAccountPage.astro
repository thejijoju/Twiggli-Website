      <section class="hd-set" data-ha-panel="settings" hidden>
        <h1>{L('Einstellungen', 'Settings', 'Réglages')}</h1>
        <nav class="hd-set-tabs" role="tablist">
          <button type="button" role="tab" aria-selected="true" data-hs-tab="account">{L('Konto', 'Account', 'Compte')}</button>
          <button type="button" role="tab" aria-selected="false" data-hs-tab="prefs">{L('Präferenzen', 'Preferences', 'Préférences')}</button>
          <button type="button" role="tab" aria-selected="false" data-hs-tab="pay">{L('Zahlungen', 'Payment', 'Paiement')}</button>
        </nav>

        <div class="hd-set-pane" data-hs-pane="account">
          <form class="hd-set-form" data-hs-form novalidate>
            <h2>{L('Dein Profil', 'Your profile', 'Ton profil')}</h2>
            <div class="hd-set-two">
              <label><span>{L('Vorname', 'First name', 'Prénom')}</span><input name="first" autocomplete="given-name" maxlength="40" /></label>
              <label><span>{L('Nachname', 'Last name', 'Nom')}</span><input name="last" autocomplete="family-name" maxlength="40" /></label>
            </div>
            <label class="hd-set-phone"><span>{L('Telefon', 'Phone', 'Téléphone')}</span><input name="phone" type="tel" autocomplete="tel" maxlength="30" placeholder="+49 170 1234567" /><small>{L('Sieht nur Twiggli, damit wir dich bei kurzfristigen Anfragen erreichen.', 'Only Twiggli sees this, so we can reach you about last-minute requests.', 'Visible uniquement par Twiggli, pour te joindre en cas de demande de dernière minute.')}</small></label>
            <label class="hd-set-bio"><span>{L('Kurzbio', 'Bio', 'Bio')}</span><textarea name="bio" rows="2" maxlength="200" data-hs-bio placeholder={L('Erzähl kurz etwas über dich und dein Handwerk.', 'Share a little about you and your craft.', 'Parle un peu de toi et de ton savoir-faire.')}></textarea><small class="hd-set-count" data-hs-bio-count aria-live="polite">0/200</small></label>
            <span class="hd-set-lbl">{L('Social Links', 'Social links', 'Réseaux sociaux')}</span>
            <div class="hd-set-social">
              <label><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".9" fill="currentColor"/></svg><span class="hd-set-pre">instagram.com/</span><input name="instagram" placeholder="username" /></label>
              <label><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4c.4 2.6 2.2 4.3 5 4.5"/></svg><span class="hd-set-pre">tiktok.com/@</span><input name="tiktok" placeholder="username" /></label>
              <label><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10.2 9.4v5.2l4.4-2.6z" fill="currentColor"/></svg><span class="hd-set-pre">youtube.com/@</span><input name="youtube" placeholder="username" /></label>
              <label><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4"/><path d="M8 10.5V16M8 7.8v.1M11.5 16v-3.2c0-1.4 1-2.3 2.2-2.3s2 .9 2 2.3V16M11.5 10.5V16"/></svg><span class="hd-set-pre">linkedin.com/</span><input name="linkedin" placeholder="in/name" /></label>
            </div>
            <div class="hd-set-actions">
              <button type="submit" class="hd-set-save"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.2 2.4 2.3 4.6-4.8"/></svg>{L('Änderungen speichern', 'Save changes', 'Enregistrer')}</button>
              <small class="hd-set-note" data-hs-note role="status"></small>
            </div>
          </form>
          <form class="hd-set-block hd-set-form" data-hs-studio hidden novalidate>
            <h2>{L('Dein Studio', 'Your studio', 'Ton studio')}</h2>
            <p class="hd-set-sub">{L('So steht es auf deiner Seite. Wir prüfen Änderungen kurz, bevor sie online gehen.', "This is how it shows on your page. We check changes briefly before they go live.", 'C’est ce qui apparaît sur ta page. On vérifie rapidement les changements avant leur mise en ligne.')}</p>
            <label><span>{L('Name des Studios', 'Studio name', 'Nom du studio')}</span><input name="studio" maxlength="80" /></label>
            {/* The full address stays private (functions hostAddress); guests see only what the host picks (Jirel 18.11.26). */}
            <label><span>{L('Straße und Hausnummer', 'Street and number', 'Rue et numéro')}</span><input name="street" maxlength="120" autocomplete="address-line1" /></label>
            <div class="hd-set-two hs-two">
              <label><span>{L('PLZ', 'Postcode', 'Code postal')}</span><input name="zip" maxlength="5" inputmode="numeric" autocomplete="postal-code" /></label>
