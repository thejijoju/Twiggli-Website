  .cal .msg-acts button, .msg .msg-acts button { font-family: inherit; }
  .msg-list { display: grid; gap: 12px; max-width: 760px; }
  .msg-card { background: #fff; border: 1px solid #e6dff2; border-radius: 18px; padding: 16px; display: grid; gap: 8px; }
  .msg-card.is-focus { border-color: #6a3eec; box-shadow: 0 0 0 3px rgba(106, 62, 236, 0.12); }
  .msg-head { display: flex; gap: 10px; align-items: center; }
  .msg-av { width: 36px; height: 36px; flex: none; border-radius: 50%; display: grid; place-items: center; background: #f3eeff; color: #6a3eec; font-weight: 700; }
  .msg-who { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 8px; min-width: 0; }
  .msg-who small { flex-basis: 100%; color: var(--color-text-muted); font-size: 0.8rem; }
  .msg-kind { font-size: 0.72rem; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: #fff7f2; color: #c2541f; }
  .msg-kind.is-paid { background: #e8f6f3; color: #157a6b; }
