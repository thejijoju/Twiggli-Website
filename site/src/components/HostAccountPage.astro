  .cal-empty { color: var(--color-text-muted); font-size: 0.92rem; padding: 18px 4px; margin: 0; }
  .cal-saved { margin: 8px 0 0; min-height: 1em; font-size: 0.82rem; color: #1f9d8a; }
  .cal-side { padding: 20px; position: sticky; top: 16px; }
  .cal-pick { margin: 0; padding: 40px 8px; text-align: center; color: var(--color-text-muted); font-size: 0.92rem; }
  .cal-side-head { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--color-text-muted); }
  .cal-side-head > span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cal-x { width: 30px; height: 30px; border-radius: 50%; border: 0; background: rgba(36, 39, 46, 0.06); font-size: 1.1rem; line-height: 1; display: grid; place-items: center; padding: 0; }
