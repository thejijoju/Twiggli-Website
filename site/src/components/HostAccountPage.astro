  .cal-plus { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 30px; height: 30px; border-radius: 50%; border: 1.5px dashed #d9d4e3; background: transparent; color: #b9b2c7 !important; font-size: 1.1rem; line-height: 1; padding: 0; display: grid; place-items: center; opacity: 0.7; transition: opacity .15s ease, border-color .15s ease, color .15s ease; }
  .cal-plus:hover, .cal-plus:focus-visible { opacity: 1; border-color: #6a3eec; color: #6a3eec !important; }
  /* Week on a phone: one row per day. */
  .cal-ag { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 10px; align-items: start; padding: 8px 0; border-bottom: 1px solid #f1eef6; }
  .cal-ag:last-child { border-bottom: 0; }
