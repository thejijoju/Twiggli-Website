  .tp-adm-l { display: grid; gap: 4px; font-size: 0.85rem; font-weight: 600; }
  .tp-adm-l textarea { font: inherit; font-size: 0.86rem; font-weight: 400; width: 100%; box-sizing: border-box; padding: 8px 10px; border: 1px solid rgba(0, 0, 0, 0.16); border-radius: 10px; resize: vertical; }
  .tp-adm-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 0.82rem; }
  .tp-adm-list li { display: flex; justify-content: space-between; gap: 6px; align-items: start; padding: 6px 8px; border-radius: 8px; background: color-mix(in srgb, #2f6fed 8%, #fff); }
  .hd-hi { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 20px; }
  .hd-hi h1 { margin: 0; font-size: clamp(1.7rem, 4vw, 2.2rem); }
