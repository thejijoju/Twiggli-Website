  .ib-what.has-av { position: relative; }
  .ib-hold { margin: 10px 0 0 !important; padding: 10px 14px; border-radius: 12px; background: linear-gradient(135deg, rgba(106, 62, 236, 0.08), rgba(230, 74, 180, 0.07)); font-size: 0.92rem; }
  .ib-what.has-av h3 { padding-right: 64px; }
  .ib-what .ib-what-av { position: absolute; top: 0; right: 0; width: 52px; height: 52px; font-size: 1.3rem; border-radius: 50%; }
  .ib-said { margin: 18px 0 4px; padding-top: 18px; border-top: 1px solid rgba(36, 39, 46, 0.1); }
  .ib-said b { display: block; }
  .ib-said small { color: var(--color-text-muted); }
  .ib-said p { margin: 8px 0 0; white-space: pre-line; line-height: 1.5; }
  /* Countdown footer: frosted glass, stuck to the bottom of the popup. */
  .ib-foot { position: sticky; bottom: -30px; margin: 18px -32px -30px; padding: 16px 32px 22px; display: grid; gap: 12px; text-align: center;
    background: rgba(255, 255, 255, 0.86); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2); border-top: 1px solid rgba(36, 39, 46, 0.08); }
  .ib-clock { margin: 0; font-size: 0.98rem; }
