  .cal-slot { margin-top: 12px; padding: 12px 14px; border-radius: 12px; border: 1.5px dashed #b9a6f5; background: #faf8ff; font-size: 0.85rem; display: grid; gap: 4px; }
  .cal-slot b { color: #6a3eec; }
