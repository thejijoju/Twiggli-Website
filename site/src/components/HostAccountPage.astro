  .ib-saved { position: absolute; left: 0; right: 0; bottom: calc(100% + 8px); max-height: 300px; overflow: auto; background: #fff; border-radius: 16px; box-shadow: 0 10px 30px rgba(36, 39, 46, 0.18); padding: 12px; z-index: 5; }
