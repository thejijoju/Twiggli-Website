  /* Global, not scoped: the messages, days and cards are built in the
     script, and scoped styles would miss them. Every class starts ha-/hd-. */
  .ha [hidden], .ha-home[hidden] { display: none !important; }
  .ha { max-width: 760px; margin: 0 auto; padding-block: 40px 80px; }
  .ha-head h1 { margin: 0 0 8px; }
  .ha-lede { color: var(--color-text-muted); margin: 0 0 24px; }
  .ha-card {
    background: #fff; border-radius: 20px; padding: 24px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05), 0 8px 24px rgba(0, 0, 0, 0.06);
    margin-bottom: 20px;
  }
  /* Signed out (Jirel 12.11.26): a soft lilac, cream and pink wash over the
     whole screen, the card exactly in the middle, nothing else around it. */
  .ha-head { display: none; }
  .ha:not(.is-in) { position: relative; min-height: 100svh; display: grid; place-items: center; padding-block: 64px; box-sizing: border-box; }
  .ha:not(.is-in)::before {
    content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(60% 55% at 15% 20%, #e6dbff 0%, transparent 70%), radial-gradient(55% 50% at 85% 85%, #ffe2f0 0%, transparent 70%), linear-gradient(135deg, #f1eaff 0%, #fff4e3 55%, #ffe8f2 100%);
  }
  .ha-signin {
    position: relative; z-index: 1; width: 100%; max-width: 360px; box-sizing: border-box;
    display: grid; gap: 12px; padding: 34px 30px; border-radius: 28px; text-align: center;
    background: rgba(255, 255, 255, 0.82); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 30px 80px rgba(60, 30, 120, 0.16), 0 0 0 1px rgba(255, 255, 255, 0.9);
  }
  .ha-wave { width: 62px; height: 62px; margin: 0 auto 4px; border-radius: 19px; display: flex; align-items: center; justify-content: center; font-size: 40px; line-height: 1; background: linear-gradient(135deg, #6a3eec, #e64ab4); box-shadow: 0 12px 30px rgba(106, 62, 236, 0.35); }
  .ha-signin h2 { margin: 0; font-size: 1.5rem; letter-spacing: -0.02em; }
  .ha-sub { margin: -6px 0 8px; color: var(--color-text-muted); font-size: 0.88rem; }
  @media (max-width: 560px) {
    .ha:not(.is-in) { padding-inline: 28px; }
    .ha-signin { padding: 28px 22px; gap: 11px; border-radius: 24px; }
    .ha-signin h2 { font-size: 1.3rem; }
    .ha-wave { width: 54px; height: 54px; font-size: 34px; border-radius: 16px; }
    .ha-sub { font-size: 0.85rem; }
    .ha-signin .ha-btn, .ha-signin .ha-google { min-height: 42px; }
  }
  .ha-invite { margin: 0; padding: 10px 12px; border-radius: 12px; background: color-mix(in srgb, #ffc94d 35%, #fff); font-size: 0.88rem; }
  .ha-signin label { display: grid; gap: 6px; text-align: left; }
  .ha-apply { margin: 4px 0 0; font-size: 0.85rem; color: var(--color-text-muted); }
  .ha-apply a { color: #6a3eec; font-weight: 600; text-decoration: none; }
  .ha-apply a:hover { text-decoration: underline; }
  /* Hover (Jirel 12.11.26): every button says it can be clicked, the logo grows a little. */
  .ha-home img { transition: transform .2s ease; }
  /* The homepage's sign-in pill as it is (styles/site.css .social-bar-signin),
     with the dark bar it sits on there painted under its lavender wash. */
  .ha-top-signin { position: absolute; top: 16px; right: 24px; z-index: 30; background: linear-gradient(135deg, rgba(178, 172, 252, 0.2), rgba(106, 62, 236, 0.34)), #202020; }
  .ha-top-signin:hover { background: linear-gradient(135deg, rgba(178, 172, 252, 0.3), rgba(106, 62, 236, 0.48)), #202020; }
  .ha.is-in ~ .ha-top-signin, body:has(.ha.is-in) .ha-top-signin { display: none; }
  @media (max-width: 640px) { .ha-top-signin { right: 16px; } }
  /* The waving hand: a small wave every few seconds, still for reduced motion. */
  .ha-wave { display: flex; }
  .ha-wave-hand { display: inline-block; transform-origin: 70% 75%; animation: ha-wave 3.2s ease-in-out 0.2s infinite; }
  @keyframes ha-wave { 0%, 60%, 100% { transform: rotate(0); } 10% { transform: rotate(14deg); } 20% { transform: rotate(-6deg); } 30% { transform: rotate(12deg); } 40% { transform: rotate(-3deg); } 50% { transform: rotate(6deg); } }
  /* Reduced motion: one soft wave on arrival, then still (Jirel 13.11.26). */
  @keyframes ha-wave-soft { 0%, 100% { transform: rotate(0); } 30% { transform: rotate(8deg); } 60% { transform: rotate(-3deg); } }
  @media (prefers-reduced-motion: reduce) { .ha-wave-hand { animation: ha-wave-soft 1.2s ease-in-out 0.3s 1; } }
  .ha-home:hover img, .ha-home:focus-visible img { transform: scale(1.12); }
  .ha .ha-btn, .ha .ha-google, .ha [data-ha-tab], .ha .hd-add, .ha .hd-bell, .ha [data-ha-avatar] { transition: transform .15s ease, filter .15s ease, box-shadow .15s ease, background-color .15s ease; }
  .ha .ha-btn:not(:disabled):hover { transform: translateY(-1px); filter: brightness(1.08); box-shadow: 0 8px 20px rgba(106, 62, 236, 0.28); }
  .ha .ha-btn:not(:disabled):active { transform: translateY(0); filter: brightness(.97); }
  .ha-signin .ha-btn.ha-google:not(:disabled):hover { background: #f6f3ff; border-color: rgba(106, 62, 236, 0.35); transform: translateY(-1px); box-shadow: 0 6px 16px rgba(36, 39, 46, 0.08); filter: none; }
  /* Hover like Luma (Jirel 14.11.26): no grey box, the text just turns near-black. */
  .ha [data-ha-tab], .ha .hd-bell { transition: color .15s ease; }
  .ha [data-ha-tab]:hover, .ha .hd-bell:hover { background: none; color: #16181d; text-shadow: 0 0 .45px currentColor, 0 0 .45px currentColor; }
  .ha .hd-add:hover, .ha [data-ha-avatar]:hover { transform: scale(1.05); }
  /* The field's border turns the same lilac as the Google button's on hover
     (the inside stays white); the generic .ha input rule is more specific,
     so this one repeats its selector. */
  .ha .ha-signin input:not([type='checkbox']):not([type='radio']) { transition: border-color .15s ease; }
  .ha .ha-signin input:not([type='checkbox']):not([type='radio']):hover { border-color: rgba(106, 62, 236, 0.35); }
  /* Rounder field; on focus one lilac 2px line, no second browser ring. */
  .ha .ha-signin input:not([type='checkbox']):not([type='radio']) { border-radius: 16px; }
  .ha .ha-signin input:not([type='checkbox']):not([type='radio']):focus,
  .ha .ha-signin input:not([type='checkbox']):not([type='radio']):focus-visible { outline: none; border: 2px solid rgba(106, 62, 236, 0.55); padding: 9px 11px; box-shadow: none; }
  /* "Your email" fades to 70% while the mouse is on the words. */
  .ha-signin label > span { transition: opacity .15s ease; }
  .ha-signin label > span:hover { opacity: 0.7; }
  /* The heading fades like "Your email"; the line under it darkens. */
  .ha-signin h2 { transition: opacity .15s ease; }
  .ha-signin h2:hover { opacity: 0.7; }
  .ha-sub { transition: color .15s ease; }
  .ha-sub:hover { color: var(--color-text); }
  .ha-signin .ha-btn { width: 100%; min-height: 44px; font-size: 0.92rem; border-radius: 18px; background: linear-gradient(90deg, #6a3eec, #e64ab4); }
  /* The code step (Jirel 13.11.26, like Luma): same card, six boxes. */
  .ha-code { position: relative; }
