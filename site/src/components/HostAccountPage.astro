  .cal-stepb { width: 30px; height: 30px; border-radius: 50%; border: 1.5px solid var(--cal-line); background: #fff; padding: 0; font-size: 1rem; line-height: 1; display: grid; place-items: center; }
  .cal-stepb:hover { border-color: #6a3eec; color: #6a3eec; }
  .cal-toggle { appearance: none; -webkit-appearance: none; flex: none; width: 40px; height: 24px; margin: 0; border-radius: 99px; background: #d9d4e3; position: relative; cursor: pointer; transition: background-color .15s ease; }
  .cal-toggle::after { content: ''; position: absolute; left: 3px; top: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: transform .15s ease; }
  .cal-toggle:checked { background: #6a3eec; }
  .cal-toggle:checked::after { transform: translateX(16px); }
  .cal-req { display: block; width: 100%; box-sizing: border-box; background: #fff7f2; border: 0; border-radius: 12px; padding: 10px 12px; margin-top: 10px; font-size: 0.85rem; text-align: left; }
