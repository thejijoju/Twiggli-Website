            slug, title: r.title, titleEn: r.titleEn, start: r.time ?? '', end: calEnd(r.time ?? '', r.duration), price: calNum(r.price), seats: r.spots ?? null,
            location: r.district ?? '', approve: true, visibility: 'public', cancel: '7d', media: [] as { type: string; url: string }[],
