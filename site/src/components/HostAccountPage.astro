      </dialog>

      <div data-ha-editor hidden>

        <!-- Calendar, messages and listings are being rebuilt from scratch
             (Jirel 15.11.26): the old panels stay in the code, hidden
             (data-ha-old), until the new ones replace them. -->
        <!-- Calendar: one calendar per workshop (Jirel 18.11.26). -->
        <section class="cal" data-ha-panel="calendar" data-cal-panel hidden>
          <h2 class="cal-h">{t.tabCalendar}</h2>
          <p class="ha-sub cal-lede">{t.cal.sub}</p>
          <p class="cal-demo" data-cal-demo hidden>{t.cal.demo}</p>
          <div class="cal-pills" data-cal-pills></div>
          <div class="cal-card cal-first" data-cal-first hidden>
            <span class="cal-first-ic" aria-hidden="true">🗓️</span>
            <h3>{t.cal.firstTitle}</h3>
            <p>{t.cal.firstSub}</p>
            <button type="button" class="cal-btn">{t.cal.firstBtn}</button>
          </div>
          <div class="cal-grid">
            <div class="cal-card cal-month">
              <div class="cal-mh">
                <b data-cal-mname></b>
                <span class="cal-mnav"><button type="button" data-cal-mprev data-cal-f="m-" aria-label={t.cal.prev}>‹</button><button type="button" data-cal-mnext data-cal-f="m+" aria-label={t.cal.next}>›</button></span>
