                <span class="cal-seg"><button type="button" data-cal-view="week" aria-pressed="false">{t.cal.week}</button><button type="button" data-cal-view="month" aria-pressed="true">{t.cal.month}</button></span>
                <button type="button" class="cal-btn" data-cal-add>{t.cal.addDate}</button>
              </div>
              <div class="cal-wd" data-cal-wd></div>
              <div class="cal-days" data-cal-days></div>
              <div class="cal-wkv" data-cal-wkv></div>
              <div class="cal-list" data-cal-list></div>
              <p class="cal-legend" data-cal-legend hidden><i aria-hidden="true"></i>{t.cal.onReqLegend}</p>
              <p class="cal-saved" data-cal-note role="status"></p>
            </div>
            <aside class="cal-card cal-side" data-cal-side aria-label={t.cal.panel}></aside>
          </div>
          <div class="cal-scrim" data-cal-scrim hidden></div>
          <!-- The whole workshop (listing), for the host and for Jirel acting as them (functions hostListing edit). -->
          <dialog class="cal-ws" data-cal-ws aria-labelledby="cal-ws-title">
            <form method="dialog" class="cal-ws-form" data-cal-ws-form novalidate>
              <header class="cal-ws-head">
                <h2 id="cal-ws-title">{t.cal.wsTitle}</h2>
                <button type="button" class="cal-x" data-cal-ws-close aria-label={t.cal.close}>×</button>
              </header>
              <p class="cal-ws-sub">{t.cal.wsSub}</p>
              <label class="cal-f"><span>{t.cal.wsName}</span><input name="title" maxlength="120" required /></label>
              <label class="cal-f"><span>{t.cal.wsDesc}</span><textarea name="description" rows="6" maxlength="3000" placeholder={t.cal.wsDescPh}></textarea></label>
              <div class="cal-f-row">
                <label class="cal-f"><span>{t.cal.wsDuration}</span><input name="duration" maxlength="12" placeholder="2.5 h" inputmode="decimal" /></label>
                <label class="cal-f"><span>{t.cal.wsPrice}</span><input name="price" type="number" min="1" max="5000" step="1" placeholder="40" /></label>
                <label class="cal-f"><span>{t.cal.wsSeats}</span><input name="seats" type="number" min="1" max="500" step="1" placeholder="10" /></label>
              </div>
              <label class="cal-f"><span>{t.cal.wsNote}</span><input name="note" maxlength="220" placeholder={t.cal.wsNotePh} /></label>
              <WhereFields lang={lang} kind="ws" />
              <fieldset class="cal-f">
                <legend>{t.cal.wsMedia}</legend>
                <p class="cal-ws-hint">{t.cal.wsMediaHint}</p>
                <div class="cal-ws-media" data-cal-ws-media></div>
                <div class="cal-ws-up">
                  <label class="cal-btn2">{t.cal.wsUpPhotos}<input type="file" accept="image/*" multiple data-cal-ws-up="photo" hidden /></label>
                  <label class="cal-btn2">{t.cal.wsUpVideo}<input type="file" accept="video/*" data-cal-ws-up="video" hidden /></label>
                </div>
                <p class="cal-ws-hint" data-cal-ws-up-note role="status"></p>
              </fieldset>
              <fieldset class="cal-f">
                <legend>{t.cal.wsBooking}</legend>
                <label class="cal-radio"><input type="radio" name="booking" value="request" /><span><b>{t.cal.wsReq}</b><small>{t.cal.wsReqHint}</small></span></label>
                <label class="cal-radio"><input type="radio" name="booking" value="instant" /><span><b>{t.cal.wsInstant}</b><small>{t.cal.wsInstantHint}</small></span></label>
              </fieldset>
              <p class="cal-msg" data-cal-ws-note role="status" hidden></p>
              <footer class="cal-ws-foot">
                <button type="button" class="cal-btn2" data-cal-ws-close>{t.cal.wsCancel}</button>
                <button type="submit" class="cal-btn" data-cal-ws-save>{t.cal.wsSave}</button>
              </footer>
            </form>
          </dialog>
        </section>
        {/* Messages (Jirel 19.11.26): what guests wrote with a paid booking or a request, and the host's replies. */}
        <section class="msg" data-ha-panel="messages" hidden>
          <h2 class="cal-h">{t.tabMessages}</h2>
          <p class="ha-sub msg-lede">{t.cal.msgLede}</p>
          {/* Twiggli Support, pinned (Jirel 20.11.26): problems, missing things, questions (functions hostSupport). */}
          <div class="sp" data-sp>
            <button type="button" class="sp-head" data-sp-toggle aria-expanded="false">
              <span class="sp-av" aria-hidden="true">✦</span>
              <span class="sp-t"><small>📌 {L('Angeheftet', 'Pinned', 'Épinglé')}</small><b>Twiggli Support</b><span>{L('Problem melden oder Frage stellen', 'Report a problem or ask a question', 'Signaler un problème ou poser une question')}</span></span>
              <i class="sp-dot" data-sp-dot hidden></i>
            </button>
            <div class="sp-body" data-sp-body hidden>
              <p class="sp-sub">{L('Jirel antwortet meist am selben Tag', 'Jirel usually replies the same day', 'Jirel répond en général le jour même')}</p>
              <div class="sp-msgs" data-sp-msgs>
                <div class="sp-b sp-them">{L('Hier kannst du uns jederzeit schreiben, wenn etwas nicht funktioniert oder fehlt. Ein Screenshot hilft uns sehr. 💛', 'Write to us here any time something doesn’t work or is missing. A screenshot helps a lot. 💛', 'Écris-nous ici dès que quelque chose ne marche pas ou manque. Une capture d’écran aide beaucoup. 💛')}</div>
              </div>
              <div class="sp-chips">
                <button type="button" data-sp-kind="bug" aria-pressed="false">🐞 {L('Etwas funktioniert nicht', 'Something doesn’t work', 'Quelque chose ne marche pas')}</button>
                <button type="button" data-sp-kind="idea" aria-pressed="false">💡 {L('Mir fehlt etwas', 'Something is missing', 'Il me manque quelque chose')}</button>
                <button type="button" data-sp-kind="question" aria-pressed="false">❓ {L('Ich habe eine Frage', 'I have a question', 'J’ai une question')}</button>
              </div>
              <form class="sp-comp" data-sp-form>
                <label class="sp-att" title={L('Screenshot oder Dokument anhängen', 'Attach a screenshot or document', 'Joindre une capture ou un document')}>📎<input type="file" accept="image/*,application/pdf,.pdf,.doc,.docx,.xls,.xlsx,.txt,.csv" multiple data-sp-file hidden /></label>
                <textarea name="text" rows="2" maxlength="2000" placeholder={L('Beschreib kurz, was passiert ist…', 'Briefly describe what happened…', 'Décris brièvement ce qui s’est passé…')}></textarea>
                <button type="submit" class="sp-send">{L('Senden', 'Send', 'Envoyer')}</button>
              </form>
              <p class="sp-note" data-sp-note role="status"></p>
            </div>
          </div>
          <div class="msg-list" data-msg-list></div>
        </section>
        {/* Angebote (Jirel 20.11.26): every workshop as a card; Bearbeiten opens the same editor as the Calendar. */}
        <section class="lst" data-ha-panel="listings" hidden>
          <div class="lst-top">
            <div><h2 class="cal-h">{t.tabListings}</h2><p class="ha-sub">{L('Deine Workshops, so wie Gäste sie auf Twiggli sehen. Tippe auf „Bearbeiten“, um alles zu ändern.', 'Your workshops as guests see them on Twiggli. Tap “Edit” to change anything.', 'Tes ateliers tels que les invités les voient sur Twiggli. Touche « Modifier » pour tout changer.')}</p></div>
            <button type="button" class="lst-new" data-lst-new>{t.cal.newWorkshop}</button>
          </div>
          <p class="lst-note" data-lst-note aria-live="polite"></p>
          <div class="lst-list" data-lst-list></div>
          {/* Partner workshops (Jirel 23.11.26): hotels and companies in our network book workshops at their own place. */}
          <section class="pw" data-pw>
            <h3 class="lst-sec">{L('Partner-Workshops: bei Hotels und Firmen vor Ort', 'Partner workshops: on site at hotels and companies', 'Ateliers partenaires : sur place chez des hôtels et entreprises')}</h3>
            <p class="pw-intro">{L('Hotels und Firmen aus unserem Partner-Netzwerk buchen Workshops direkt bei sich. Trag hier ein, welche Workshops du dort anbietest. Du kannst dafür auch ein neues Konzept anlegen. Wir nehmen dich in unsere Anbieterliste auf und schicken dir passende Anfragen, zum Beispiel: Hotel in Charlottenburg, 12. Dezember, 18 Uhr, 15 Personen. Du nimmst sie an oder lehnst sie ab. Von deinem Preis gehen 15 % Twiggli-Provision ab.', 'Hotels and companies in our partner network book workshops at their own place. Enter the workshops you offer there. You can also create a new concept for it. We add you to our list of providers and send you matching requests, for example: hotel in Charlottenburg, 12 December, 6 pm, 15 people. You accept or decline them. Twiggli’s 15% commission is taken from your price.', 'Des hôtels et entreprises de notre réseau réservent des ateliers chez eux. Indique ici les ateliers que tu y proposes. Tu peux aussi créer un nouveau concept pour ça. On t’ajoute à notre liste et on t’envoie des demandes adaptées, par exemple : hôtel à Charlottenburg, 12 décembre, 18 h, 15 personnes. Tu les acceptes ou les refuses. La commission Twiggli de 15 % est déduite de ton prix.')}</p>
            <div class="pw-list" data-pw-list></div>
            <button type="button" class="lst-new" data-pw-add>{L('+ Partner-Workshop eingeben', '+ Enter a partner workshop', '+ Ajouter un atelier partenaire')}</button>
          </section>
          {/* A room to rent (Jirel 23.11.26): shown on the "Raum mieten" page as the host enters it. */}
          <section class="pw rm" data-rm>
            <h3 class="lst-sec">{L('Raum vermieten', 'Rent out your space', 'Louer ton espace')}</h3>
            <p class="pw-intro">{L('Vermietest du deinen Raum, wenn du selbst keinen Workshop gibst? Dann trag ihn hier ein: Er erscheint auf unserer Seite „Raum mieten“ mit deinen Fotos, deinem Preis und allem, was dazugehört. Anfragen kommen per E-Mail und in deine Nachrichten. Twiggli nimmt auf Raumvermietungen keine Provision.', 'Do you rent out your space when you are not teaching? Enter it here: it appears on our "Rent a space" page with your photos, your price and everything that comes with it. Requests come by email and to your messages. Twiggli takes no commission on room rentals.', 'Tu loues ton espace quand tu n’animes pas d’atelier ? Indique-le ici : il apparaît sur notre page « Louer un espace » avec tes photos, ton prix et tout ce qui va avec. Les demandes arrivent par e-mail et dans tes messages. Twiggli ne prend aucune commission sur les locations d’espace.')}</p>
            <div class="pw-list" data-rm-card></div>
            <button type="button" class="lst-new" data-rm-add>{L('+ Raum zum Vermieten eintragen', '+ Enter a space to rent out', '+ Ajouter un espace à louer')}</button>
          </section>
          <dialog class="cal-ws pw-dlg rm-dlg" data-rm-dlg>
            <form class="cal-ws-form" data-rm-form>
              <h2>{L('Raum vermieten', 'Rent out your space', 'Louer ton espace')}</h2>
              <div class="cal-partner">
                <div class="cal-partner-row rm-row2">
                  <label class="cal-f-lbl"><span>{L('Name des Raums', 'Name of the space', 'Nom de l’espace')}</span><input name="name" maxlength="80" required /></label>
                  <label class="cal-f-lbl"><span>{L('Bezirk', 'District', 'Quartier')}</span><select name="district"><option value="">–</option>{berlinDistricts.map((d) => <option>{d}</option>)}</select></label>
                </div>
                <div class="cal-partner-row">
                  <label class="cal-f-lbl"><span>{L('Personen (max.)', 'People (max.)', 'Personnes (max.)')}</span><input type="number" name="capacity" min="1" max="500" placeholder="20" /></label>
                  <label class="cal-f-lbl"><span>{L('Größe', 'Size', 'Surface')}</span><input name="size" maxlength="40" placeholder="60 m²" /></label>
                  <label class="cal-f-lbl"><span>{L('Preis pro Stunde (€)', 'Price per hour (€)', 'Prix par heure (€)')}</span><input type="number" name="price" min="1" max="5000" placeholder="25" /></label>
                </div>
                <label class="cal-f-lbl"><span>{L('Zum Preis (optional)', 'About the price (optional)', 'À propos du prix (facultatif)')}</span><input name="priceNote" maxlength="80" placeholder={L('zzgl. MwSt., mind. 3 Stunden', '+ VAT, at least 3 hours', 'HT, 3 heures minimum')} /></label>
                <p class="pw-fee" data-rm-fee></p>
                <label class="cal-f-lbl"><span>{L('Wofür eignet sich der Raum?', 'What does the space suit?', 'Pour quoi convient l’espace ?')}</span><input name="suits" maxlength="300" placeholder={L('Workshops, Teamevents, Fotoshootings', 'Workshops, team events, photo shoots', 'Ateliers, événements d’équipe, shootings')} /></label>
                <label class="cal-f-lbl"><span>{L('Beschreibung', 'Description', 'Description')}</span><textarea name="about" rows="4" maxlength="1500"></textarea></label>
                <label class="cal-f-lbl"><span>{L('Was ist inklusive?', 'What is included?', 'Qu’est-ce qui est inclus ?')}</span><input name="included" maxlength="400" placeholder={L('Tische, Stühle, Küche, WLAN, Beamer', 'Tables, chairs, kitchen, Wi-Fi, projector', 'Tables, chaises, cuisine, Wi-Fi, projecteur')} /></label>
                <label class="cal-f-lbl"><span>{L('Anfahrt und Zugang (optional)', 'Getting there and access (optional)', 'Accès (facultatif)')}</span><input name="access" maxlength="300" placeholder={L('U7 Eisenacher Str., barrierefrei', 'U7 Eisenacher Str., step-free', 'U7 Eisenacher Str., accessible')} /></label>
                <span class="cal-f-lbl"><span>{L('Fotos vom Raum', 'Photos of the space', 'Photos de l’espace')}</span></span>
                <div class="rm-photos" data-rm-photos></div>
                <label class="cal-btn2 rm-up">{L('Fotos hochladen', 'Upload photos', 'Ajouter des photos')}<input type="file" accept="image/*" multiple data-rm-up hidden /></label>
                <p class="cal-ws-hint" data-rm-up-note role="status"></p>
                <p class="cal-ws-hint">{L('Die genaue Adresse steht nicht auf der Seite, nur der Bezirk. Wer anfragt, bekommt sie von dir.', 'The exact address isn’t shown on the page, only the district. You give it to whoever asks.', 'L’adresse exacte n’apparaît pas sur la page, seulement le quartier. Tu la donnes à qui te contacte.')}</p>
              </div>
              <p class="cal-msg" data-rm-note role="status" hidden></p>
              <footer class="cal-ws-foot">
                <button type="button" class="cal-btn2" data-rm-close>{L('Abbrechen', 'Cancel', 'Annuler')}</button>
                <button type="submit" class="cal-btn">{L('Speichern', 'Save', 'Enregistrer')}</button>
              </footer>
            </form>
          </dialog>
          <dialog class="cal-ws pw-dlg" data-pw-dlg>
            <form class="cal-ws-form" data-pw-form>
              <h2>{L('Partner-Workshop', 'Partner workshop', 'Atelier partenaire')}</h2>
              <div class="cal-partner">
                <label class="cal-f-lbl"><span>{L('Welcher Workshop?', 'Which workshop?', 'Quel atelier ?')}</span><select name="pKey" data-pw-key></select></label>
                <div class="pw-concept" data-pw-concept hidden>
                  <label class="cal-f-lbl"><span>{L('Name des Konzepts', 'Name of the concept', 'Nom du concept')}</span><input name="pTitle" maxlength="120" placeholder={L('z. B. Mini-Keramik für Hotelgäste', 'e.g. mini ceramics for hotel guests', 'p. ex. mini céramique pour clients d’hôtel')} /></label>
                  <label class="cal-f-lbl"><span>{L('Was passiert im Workshop?', 'What happens in the workshop?', 'Que se passe-t-il pendant l’atelier ?')}</span><textarea name="pAbout" rows="3" maxlength="1500"></textarea></label>
                </div>
                <div class="cal-partner-row">
                  <label class="cal-f-lbl"><span>{L('Preis pro Person (€)', 'Price per person (€)', 'Prix par personne (€)')}</span><input type="number" name="pPrice" min="0" max="2000" step="1" placeholder="55" required /><small>{L('inkl. Anreise, Material und allem, was du mitbringst', 'incl. travel, materials and everything you bring', 'déplacement, matériel et tout ce que tu apportes compris')}</small></label>
                  <label class="cal-f-lbl"><span>{L('Gruppengröße', 'Group size', 'Taille du groupe')}</span><span class="cal-partner-pair"><input type="number" name="pMin" min="1" max="500" placeholder={L('von', 'from', 'de')} /><input type="number" name="pMax" min="1" max="500" placeholder={L('bis', 'to', 'à')} /></span><small>{L('von – bis Personen', 'from – to people', 'de – à personnes')}</small></label>
                  <label class="cal-f-lbl"><span>{L('Dauer', 'Length', 'Durée')}</span><input name="pDuration" maxlength="30" placeholder="1.5 h" /></label>
                </div>
                <p class="pw-fee" data-pw-fee>{L('Von diesem Preis gehen 15 % Twiggli-Provision ab.', 'Twiggli’s 15% commission is taken from this price.', 'La commission Twiggli de 15 % est déduite de ce prix.')}</p>
                <label class="cal-f-lbl"><span>{L('Was brauchst du vor Ort?', 'What do you need on site?', 'De quoi as-tu besoin sur place ?')}</span><textarea name="pNeeds" rows="2" maxlength="500" placeholder={L('z. B. Tische, Strom, Wasser, etwa 1 Stunde Aufbau', 'e.g. tables, power, water, about 1 hour to set up', 'p. ex. tables, électricité, eau, environ 1 h d’installation')}></textarea></label>
              </div>
              <p class="cal-msg" data-pw-note role="status" hidden></p>
              <footer class="cal-ws-foot">
                <button type="button" class="cal-btn2" data-pw-close>{L('Abbrechen', 'Cancel', 'Annuler')}</button>
                <button type="submit" class="cal-btn">{L('Speichern', 'Save', 'Enregistrer')}</button>
              </footer>
            </form>
          </dialog>
          <dialog class="cal-ws pw-dlg" data-pr-dlg>
            <form class="cal-ws-form" data-pr-form>
              <h2>{L('Partner-Anfrage senden', 'Send a partner request', 'Envoyer une demande partenaire')}</h2>
              <p class="pw-intro" data-pr-title></p>
              <div class="cal-partner">
                <div class="cal-partner-row">
                  <label class="cal-f-lbl"><span>{L('Partner', 'Partner', 'Partenaire')}</span><input name="partner" maxlength="120" placeholder={L('z. B. Hotel in Charlottenburg', 'e.g. hotel in Charlottenburg', 'p. ex. hôtel à Charlottenburg')} required /></label>
                  <label class="cal-f-lbl"><span>{L('Wo', 'Where', 'Où')}</span><input name="where" maxlength="160" placeholder="Charlottenburg" /></label>
                  <label class="cal-f-lbl"><span>{L('Personen', 'People', 'Personnes')}</span><input type="number" name="people" min="1" max="500" required /></label>
                </div>
                <div class="cal-partner-row">
                  <label class="cal-f-lbl"><span>{L('Datum', 'Date', 'Date')}</span><input type="date" name="date" required /></label>
                  <label class="cal-f-lbl"><span>{L('Uhrzeit', 'Time', 'Heure')}</span><input type="time" name="time" required /></label>
                  <label class="cal-f-lbl"><span>{L('Preis pro Person (€)', 'Price per person (€)', 'Prix par personne (€)')}</span><input type="number" name="price" min="0" max="2000" /></label>
                </div>
                <label class="cal-f-lbl"><span>{L('Nachricht an den Host (optional)', 'Message to the host (optional)', 'Message à l’hôte (facultatif)')}</span><textarea name="message" rows="3" maxlength="1500"></textarea></label>
              </div>
              <p class="cal-msg" data-pr-note role="status" hidden></p>
              <footer class="cal-ws-foot">
                <button type="button" class="cal-btn2" data-pr-close>{L('Abbrechen', 'Cancel', 'Annuler')}</button>
                <button type="submit" class="cal-btn">{L('Senden', 'Send', 'Envoyer')}</button>
              </footer>
            </form>
          </dialog>
        </section>

        <!-- Messages, as on Airbnb (functions hostInbox / hostReply): the list
             (needs your answer, recent), the conversation with its request card
             and countdown, and the request with Accept / Make an offer / Decline
             and what we know about the guest. -->
        <section data-ha-panel="messages" class="ib" data-ha-old hidden>
          <button type="button" class="ib-todo" data-ib-todo hidden>
            <span class="ib-todo-ic" aria-hidden="true">💳</span>
            <span class="ib-todo-t"><b>{t.ib.todoStripe}</b><span>{t.ib.todoStripeSub}</span></span>
            <span class="hd-pill">{t.ib.todoGo}</span>
          </button>
          <div class="ib-grid" data-ib-grid>
            <aside class="ib-list">
              <h2 class="ha-h">{t.tabMessages}</h2>
              <div class="ha-pills" data-ha-filter>
                <button type="button" aria-pressed="true" data-f="all">{t.fAll}</button>
                <button type="button" aria-pressed="false" data-f="unread">{t.ib.unread}</button>
              </div>
              <p class="ib-group" data-ib-g="prio">{t.ib.priority}</p>
              <ul class="ha-msgs" data-ib-prio></ul>
              <p class="ib-group" data-ib-g="recent">{t.ib.recent}</p>
              <ul class="ha-msgs" data-ha-msgs></ul>
              <p class="ha-empty" data-ha-msgs-empty hidden>{t.msgsEmpty}</p>
            </aside>
            <div class="ib-conv" data-ib-conv><p class="ib-pick">{t.ib.pick}</p></div>
            <aside class="ib-res" data-ib-res hidden></aside>
          </div>
        </section>
        {/* Accept, decline, suggest and offer pop-ups, used by the Messages tab, the Calendar and the Overview. */}
          <dialog class="ib-modal" data-ib-modal aria-labelledby="ib-modal-title">
