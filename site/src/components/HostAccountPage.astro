  .ib-earn b { color: #1a7f45; font-size: 1.1rem; }
  .ib-extras { display: grid; gap: 8px; }
  .ib-extra { display: grid; grid-template-columns: minmax(0, 1fr) 110px auto; gap: 8px; align-items: center; }
  .ib-extra input { font: inherit; padding: 10px 12px; border: 1.5px solid rgba(36, 39, 46, 0.25); border-radius: 10px; min-width: 0; }
  .ib-pk { position: relative; }
  .ib-pk-btn { width: 100%; text-align: left; border: 1.5px solid rgba(36, 39, 46, 0.18); border-radius: 16px; background: #fff; padding: 10px 14px; font: inherit; cursor: pointer; display: grid; gap: 6px; transition: border-color .15s, box-shadow .15s; }
  .ib-pk-btn:hover, .ib-pk-btn[aria-expanded='true'] { border-color: var(--color-accent); box-shadow: 0 0 0 4px rgba(106, 62, 236, 0.12); }
  .ib-pk-label { color: var(--color-text-muted); font-size: 0.8rem; }
  .ib-pk-row { display: flex; align-items: center; gap: 12px; }
  .ib-pk-img { flex: none; width: 52px; height: 52px; border-radius: 12px; object-fit: cover; }
  .ib-pk-ph { display: grid; place-items: center; font-size: 24px; background: rgba(106, 62, 236, 0.08); }
  .ib-pk-txt { flex: 1; min-width: 0; display: grid; }
  .ib-pk-txt b { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ib-pk-txt span { color: var(--color-text-muted); font-size: 0.86rem; }
  .ib-pk-chev { color: var(--color-text-muted); font-size: 1.2rem; line-height: 1; }
  .ib-pk-list { position: absolute; left: 0; right: 0; top: calc(100% + 8px); z-index: 10; max-height: 340px; overflow-y: auto; background: #fff; border-radius: 18px; padding: 8px; box-shadow: 0 18px 50px rgba(36, 39, 46, 0.18), 0 0 0 1px rgba(36, 39, 46, 0.06); display: grid; gap: 2px; }
  .ib-pk-opt { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; border: 0; background: none; border-radius: 12px; padding: 8px 10px; font: inherit; cursor: pointer; }
  .ib-pk-opt:hover, .ib-pk-opt:focus-visible { background: rgba(106, 62, 236, 0.07); outline: none; }
  .ib-pk-opt.is-on { background: rgba(106, 62, 236, 0.1); }
