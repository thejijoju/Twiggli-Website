  .cal-sync a { text-decoration: none; font-size: 0.82rem; padding: 6px 14px; }
  .cal-from { margin: 10px 0 0; padding: 8px 12px; border-radius: 10px; background: #f6f4fa; color: var(--color-text-muted); font-size: 0.8rem; line-height: 1.4; }
  .cal-pill-edit { padding: 8px 16px; color: #6a3eec; }
  /* The whole workshop: a dialog on a computer, a full sheet on a phone. */
  .cal-ws { width: min(640px, calc(100vw - 32px)); max-height: calc(100vh - 48px); border: 0; border-radius: 24px; padding: 0; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25); color: var(--color-text); }
  .cal-ws::backdrop { background: rgba(22, 24, 29, 0.4); }
  .cal-ws-form { display: grid; gap: 14px; padding: 22px 24px 18px; font-family: inherit; }
