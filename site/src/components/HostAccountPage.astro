          });
        }
        // Stripe: only once the server said it isn't connected.
        if (stripeReady === false) {
          out.push({ id: 'stripe', level: 1, title: TL('Gäste können noch nicht direkt bezahlen', 'Guests can’t pay straight away yet', 'Les invités ne peuvent pas encore payer directement'),
            body: TL('Ohne Stripe können Gäste dir nur Anfragen schicken. Verbinde Stripe unter Einstellungen → Zahlungen, dann buchen und bezahlen sie sofort.', 'Without Stripe, guests can only send you requests. Connect Stripe in Settings → Payment and they can book and pay at once.', 'Sans Stripe, les invités peuvent seulement t’envoyer des demandes. Connecte Stripe dans Réglages → Paiement et ils réservent et paient tout de suite.'),
            fix: { label: TT.fixStripe, run: () => { openView('settings/payments'); setPath(); } } });
        }
        // No studio address.
        if (studioKnown && !myStudio) {
          out.push({ id: 'studio', level: 1, title: TL('Deine Studio-Adresse fehlt', 'Your studio address is missing', 'L’adresse de ton studio manque'),
            body: TL('Gäste bekommen sie mit der Buchungsbestätigung, auf deiner Seite steht nur der Bezirk. Trag sie unter Einstellungen → Dein Studio ein.', 'Guests get it with their booking confirmation; your page only shows the district. Add it in Settings → Your studio.', 'Les invités la reçoivent avec la confirmation ; ta page n’affiche que le quartier. Ajoute-la dans Réglages → Ton studio.'),
            fix: { label: TT.fixStudio, run: goStudio } });
        }
        // Workshops and their dates (the calendar's own data).
        const ws = calWorkshops();
        const state = calListings.slug === slug ? calListings.items : [];
        const built = (h as unknown as { workshops?: { key: string; title: string; duration?: string; desc?: boolean; request?: boolean; price?: string }[] }).workshops ?? [];
        const info = (w: Ws) => built.find((b) => b.key === w.key || calKey(b.title) === w.key || w.alias?.includes(calKey(b.title)));
        const editOf = (w: Ws) => state.find((x) => x.key === w.key)?.edit ?? null;
        const live = ws.filter((w) => state.find((x) => x.key === w.key)?.status !== 'paused');
        const today = calToday();
        const until = iso(new Date(calNoon(today).getTime() + 365 * 86400000));
        const evs = [...ownEvents.filter((e) => !['deleted', 'declined'].includes((e as { status?: string }).status ?? '')), ...calSiteEvents()];
        const evsOf = (w: Ws) => evs.filter((e) => e.wkey === w.key || calKey(e.title) === w.key || w.alias?.includes(calKey(e.title)));
        // A weekly slot guests ask for (onRequest) counts: it has dates they can pick.
        const upcoming = (list: Ev[]) => list.some((e) => calOcc(e, today, until).length);
        if (!upcoming(evs)) {
          out.push({ id: 'dates', level: 1, title: TL('Du hast noch keine kommenden Termine', 'You have no upcoming dates', 'Tu n’as pas de dates à venir'),
            body: TL('Ohne Termin können Gäste nur anfragen. Leg im Kalender einen Termin an, dann können sie direkt buchen.', 'Without a date, guests can only send requests. Add one in the Calendar and they can book straight away.', 'Sans date, les invités peuvent seulement faire une demande. Ajoute une date dans le Calendrier et ils peuvent réserver directement.'),
            fix: { label: TT.fixDates, run: () => { showTab('calendar'); calAdd(); } } });
        } else {
          const dry = live.filter((w) => !info(w)?.request && !upcoming(evsOf(w)));
          if (dry.length) out.push({ id: 'wsdates', level: dry.length, title: TL('Workshops ohne kommende Termine', 'Workshops without upcoming dates', 'Ateliers sans dates à venir'),
            body: TL(`${listOf(dry.map((w) => w.title))}: keine Termine mehr. Leg neue an oder stell den Workshop im Editor auf „auf Anfrage“.`, `${listOf(dry.map((w) => w.title))}: no more dates. Add new ones, or set the workshop to “on request” in the editor.`, `${listOf(dry.map((w) => w.title))} : plus de dates. Ajoutes-en ou passe l’atelier « sur demande » dans l’éditeur.`),
            fix: { label: TT.fixDates, run: () => { calSel = dry[0].key; showTab('calendar'); } } });
        }
        // Small photos: the page's pictures (not the square card) and the workshops' own.
        const shots: { url: string; ws?: Ws }[] = [];
        for (const url of h.photos ?? []) if (url !== h.card) shots.push({ url });
        for (const w of live) {
          const e = editOf(w);
          for (const m of e?.media ?? []) if (m.type === 'photo') shots.push({ url: m.url, ws: w });
          if (!e?.media?.length && w.image && w.image !== h.card && !(h.photos ?? []).includes(w.image)) shots.push({ url: w.image, ws: w });
        }
        for (const e of ownEvents) for (const m of e.media ?? []) if (m.type === 'photo') shots.push({ url: m.url, ws: ws.find((w) => w.key === (e.wkey || calKey(e.title))) });
        const mine = shots.filter((x) => ownPicture(x.url));
        mine.forEach((x) => measure(x.url));
        const tiny = [...new Map(mine.filter((x) => small(x.url)).map((x) => [x.url, x])).values()];
        if (tiny.length) {
          const z = small(tiny[0].url)!;
          const onPage = tiny.filter((x) => !x.ws).length;
          const names = [...new Set(tiny.filter((x) => x.ws).map((x) => x.ws!.title))];
          const where = [
            onPage ? TL(`${onPage} ${onPage === 1 ? 'Foto' : 'Fotos'} auf deiner Seite`, `${onPage} ${onPage === 1 ? 'photo' : 'photos'} on your page`, `${onPage} photo${onPage === 1 ? '' : 's'} sur ta page`) : '',
            names.length ? TL(`die Fotos von ${listOf(names)}`, `the photos of ${listOf(names)}`, `les photos de ${listOf(names)}`) : '',
          ].filter(Boolean).join(TL(' und ', ' and ', ' et '));
          out.push({ id: 'photos', level: tiny.length, title: TL(`Einige deiner Fotos sind klein (${z[0]} × ${z[1]})`, `Some of your photos are small (${z[0]} × ${z[1]})`, `Certaines de tes photos sont petites (${z[0]} × ${z[1]})`),
            body: TL(`Betrifft ${where}. Auf großen Bildschirmen wirken sie dadurch unscharf. Lade die Originalfotos von deinem Handy oder deiner Kamera hoch (mindestens 1200 px breit), im Workshop-Editor unter Fotos & Video.`, `That’s ${where}. On big screens they look blurry. Upload the original photos from your phone or camera (at least 1200 px wide) in the workshop editor, under Photos & video.`, `Cela concerne ${where}. Sur grand écran, elles paraissent floues. Ajoute les photos originales de ton téléphone ou appareil photo (au moins 1200 px de large) dans l’éditeur d’atelier, sous Photos & vidéo.`),
            fix: { label: TT.fixPhotos, run: () => goWs(tiny.find((x) => x.ws)?.ws ?? live[0]) } });
        }
        // Price and length: a bookable workshop needs a price; every workshop a length.
        const gaps = live.map((w) => {
          const e = editOf(w); const b = info(w); const mine2 = evsOf(w);
          const price = !b?.request && !(e?.price || calNum(w.price) || mine2.some((x) => (x.price ?? 0) > 0));
          const dur = !(e?.duration || b?.duration || mine2.some((x) => x.start && x.end));
          return { w, price, dur };
        }).filter((g) => g.price || g.dur);
        if (gaps.length) {
          const line = gaps.slice(0, 3).map((g) => `${quoted(g.w.title)}: ${[g.price ? TL('Preis', 'price', 'prix') : '', g.dur ? TL('Dauer', 'length', 'durée') : ''].filter(Boolean).join(', ')}`).join(' · ');
          out.push({ id: 'price', level: gaps.length, title: TL('Preis oder Dauer fehlen', 'Price or length missing', 'Prix ou durée manquants'),
            body: TL(`Es fehlt: ${line}. Gäste wollen beides wissen, bevor sie anfragen. Trag es im Workshop-Editor ein.`, `Missing: ${line}. Guests want to know both before they ask. Add it in the workshop editor.`, `Il manque : ${line}. Les invités veulent les connaître avant de demander. Ajoute-les dans l’éditeur d’atelier.`),
            fix: { label: TT.fixEdit, run: () => goWs(gaps[0].w) } });
        }
        // An own description: without one the workshop page shows a general text.
        const bare = live.filter((w) => !(editOf(w)?.description || info(w)?.desc));
        if (bare.length) out.push({ id: 'desc', level: bare.length, title: TL('Workshops ohne eigene Beschreibung', 'Workshops without their own description', 'Ateliers sans description propre'),
          body: TL(`${listOf(bare.map((w) => w.title))}: Dort steht bisher ein allgemeiner Text. Ein paar Sätze dazu, was passiert und was Gäste mitnehmen, helfen bei der Entscheidung.`, `${listOf(bare.map((w) => w.title))}: guests see a general text there so far. A few lines on what happens and what they take home help them decide.`, `${listOf(bare.map((w) => w.title))} : un texte général s’affiche pour l’instant. Quelques lignes sur ce qui se passe et ce qu’on emporte aident à se décider.`),
          fix: { label: TT.fixEdit, run: () => goWs(bare[0]) } });
        // A video (optional, said softly).
        const hasVideo = h.video || state.some((x) => x.edit?.media?.some((m) => m.type === 'video')) || ownEvents.some((e) => e.media?.some((m) => m.type === 'video'));
        if (!hasVideo && live.length) out.push({ id: 'video', level: 1, soft: true, title: TL('Ein kurzes Video? (optional)', 'A short video? (optional)', 'Une petite vidéo ? (facultatif)'),
          body: TL('Workshops mit Video werden am häufigsten gebucht. 20–60 Sekunden vom Handy reichen, im Workshop-Editor unter Fotos & Video.', 'Workshops with a video get the most bookings. 20–60 seconds from your phone is enough, in the workshop editor under Photos & video.', 'Les ateliers avec vidéo sont les plus réservés. 20 à 60 secondes au téléphone suffisent, dans l’éditeur d’atelier sous Photos & vidéo.'),
          fix: { label: TT.fixVideo, run: () => goWs(live[0]) } });
        // For now only Stripe is shown (Jirel 20.11.26: "the only notification
        // for now should be stripe, everything else second"), plus the draft
        // (it carries the Publish button) and Jirel's own notes.
        return out.filter((x) => x.note || x.id === 'stripe' || x.id === 'draft');
      };
      const tipIcon = (x: Tip) => (x.note ? '✉' : x.id === 'draft' ? '✎' : x.soft ? '✦' : 'i');
      const dismissTip = (x: Tip) => {
        tipSeen[x.id] = x.level;
        saveLocalSeen();
        if (!DEMO) void api('hostTips', { slug, action: 'dismiss', id: x.id, level: x.level }).catch(() => {});
        renderTips();
      };
      let forgetting = '';
      const renderTips = () => {
        if (!slug || tipsFor !== slug) return;
        const all = checks();
        // Fixed since they were dismissed: forget them, so they can come back.
        const gone = Object.keys(tipSeen).filter((id) => !all.some((x) => x.id === id) && (id !== 'studio' || studioKnown) && (id !== 'stripe' || stripeReady !== null) && (id !== 'photos' || [...photoSize.values()].every(Boolean)));
        if (gone.length && forgetting !== gone.join()) {
          forgetting = gone.join();
          for (const id of gone) delete tipSeen[id];
          saveLocalSeen();
          if (!DEMO) void api('hostTips', { slug, action: 'forget', ids: gone }).catch(() => {});
        }
        tipsNow = all.filter((x) => !(x.id in tipSeen) || x.level > tipSeen[x.id]);
        const box = $('[data-tp]');
        box.hidden = !tipsNow.length;
        const shown = tipsOpen ? tipsNow : tipsNow.slice(0, 3);
        const more = $<HTMLButtonElement>('[data-tp-all]');
        more.hidden = tipsNow.length <= 3;
        more.textContent = tipsOpen ? more.dataset.less! : say(more.dataset.more!, { n: String(tipsNow.length) });
        $('[data-tp-list]').replaceChildren(...shown.map((x) => {
          const li = el('li', `tp-item${x.soft ? ' is-soft' : ''}${x.note ? ' is-note' : ''}`);
          const txt = el('div', 'tp-txt');
          txt.append(el('b', '', x.title), el('p', '', x.body));
          const act = el('div', 'tp-act');
          if (x.fix) { const b = el('button', 'tp-fix', x.fix.label) as HTMLButtonElement; b.type = 'button'; b.addEventListener('click', x.fix.run); act.append(b); }
          if (x.link) { const a = el('a', 'tp-link', x.link.label) as HTMLAnchorElement; a.href = x.link.href; a.target = '_blank'; a.rel = 'noopener'; act.append(a); }
          if (act.childElementCount) txt.append(act);
          const xb = el('button', 'tp-x', '×') as HTMLButtonElement; xb.type = 'button'; xb.setAttribute('aria-label', `${TT.dismiss}: ${x.title}`); xb.title = TT.dismiss;
          xb.addEventListener('click', () => dismissTip(x));
          li.append(el('span', 'tp-ic', tipIcon(x)), txt, xb);
          return li;
        }));
        paintDot();
        if (!ntBox.hidden) ntPaint();
      };
      let tipsTimer = 0;
      const scheduleTips = () => { window.clearTimeout(tipsTimer); tipsTimer = window.setTimeout(renderTips, 60); };
      $('[data-tp-all]').addEventListener('click', () => { tipsOpen = !tipsOpen; renderTips(); });
      // The draft's "Publish my page" (functions hostPublish).
      const publishPage = async () => {
        if (!confirm(PUB.ask)) return;
        try {
          draftStatus = DEMO ? 'pending' : (await api('hostPublish', { slug, name: auth.currentUser?.displayName || hosts[slug]?.name || '', page: new URL(hosts[slug]?.page ?? '/', location.origin).pathname })).status;
        } catch { alert(PUB.fail); }
        renderTips();
      };
      const paintDraft = async (s: string) => {
        draftStatus = new URLSearchParams(location.search).get('publish') ?? 'draft';
        void loadTips(s);
        if (DEMO || !hosts[s]?.draft) return;
        try { draftStatus = (await api('hostPublish', { slug: s, check: true })).status; } catch { /* stays a draft */ }
        scheduleTips();
      };
      // Jirel: notes for the host she has open (shown to them as a tip).
      const paintAdminNotes = () => {
        $('[data-tp-adm]').hidden = !isAdmin;
        $('[data-vc-adm]').hidden = !isAdmin;
        if (!isAdmin) return;
        $('[data-tp-note-list]').replaceChildren(...tipNotes.map((n) => {
          const li = el('li', '', n.text);
          const x = el('button', 'tp-x', '×') as HTMLButtonElement; x.type = 'button'; x.title = TT.dismiss;
          x.addEventListener('click', async (e) => {
            e.stopPropagation();
            try { if (!DEMO) tipNotes = (await api('hostTips', { slug, action: 'unnote', id: n.id })).notes ?? []; else tipNotes = tipNotes.filter((y) => y.id !== n.id); } catch { /* stays */ }
            paintAdminNotes(); renderTips();
          });
          li.append(x);
          return li;
        }));
      };
      $('[data-tp-note-add]').addEventListener('click', async (e) => {
        e.stopPropagation();
        const box = $<HTMLTextAreaElement>('[data-tp-note]');
        const text = box.value.trim();
        if (!text) { box.focus(); return; }
        try {
          if (DEMO) tipNotes = [...tipNotes, { id: `demo${Date.now()}`, text, at: Date.now() }];
          else tipNotes = (await api('hostTips', { slug, action: 'note', text })).notes ?? tipNotes;
          box.value = '';
        } catch { alert(PUB.fail); }
        paintAdminNotes(); renderTips();
      });

      // ── Messages and Today: the requests for this host (functions hostInbox) ──
      type Req = { id: string; subject: string; fields: Record<string, string>; status: string; thread: { action: string; when?: string; message?: string; at: number }[]; createdAt: number };
      /** The thread to open in Messages (from the Calendar, the Overview or after an answer). */
      let msgFocus = '';
      let reqs: Req[] = [];
      let filter = 'all';
      let when = 'upcoming';
      let whenChosen = false; // until the host picks a tab, open requests come first
      const api = async (name: string, body: Record<string, unknown>) => {
        if (DEMO) throw new Error('demo');
        const token = await auth.currentUser?.getIdToken();
        const res = await fetch(`${cfg.functions}/${name}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify(body),
        });
        if (!res.ok) {
          const why = await res.json().catch(() => ({}));
          throw new Error(why.error ? `${res.status}: ${why.error}` : String(res.status));
        }
        return res.json();
      };
      const statusText: Record<string, string> = { pending: t.stPending, accepted: t.stAccepted, declined: t.stDeclined, suggested: t.stSuggested, offered: t.ib.offer };
      const dateOf = (r: Req) => (r.fields.Date || '').slice(0, 10);
      const el = (tag: string, cls = '', text = '') => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };
      // ── Videos go to Bunny Stream (functions hostVideo, Jirel 18.11.26): the
      //    function creates the video and signs one upload, the file goes from
      //    the browser straight to Bunny over TUS (tus-js-client), then Bunny
      //    encodes it ("processing") until it plays. Photos stay on Firebase
      //    Storage. In demo mode (?demo=…) all of it is made up, nothing is
      //    sent; &videofail=upload or &videofail=encode shows a failure. ──
      type Media = { type: string; url: string; thumb?: string };
      type VidState = 'prep' | 'up' | 'proc' | 'done' | 'fail';
      /** Playback addresses Bunny is still encoding: their tiles say so. */
      const encoding = new Set<string>();
      const DEMO_HLS = 'https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8';
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      /** The upload's state in a status line, with a bar while it moves. */
      const vidSay = (note: HTMLElement, st: VidState, pct = 0) => {
        const msg = { prep: t.vidPrep, up: t.vidUp, proc: t.vidProc, done: t.vidDone, fail: fill(t.vidFail, cfg.contact) }[st].replace('{pct}', String(Math.round(pct)));
        note.dataset.ok = String(st !== 'fail');
        note.dataset.vid = st;
        if (st === 'up' || st === 'proc') {
          const bar = document.createElement('progress');
          bar.className = 'ha-vid-bar'; bar.max = 100; bar.value = pct;
          note.replaceChildren(document.createTextNode(msg), bar);
        } else note.textContent = msg;
      };
      /** One video file to Bunny. `added` gets the media item as soon as the
       *  file is up (it can be saved while Bunny still encodes); resolves
       *  once it plays, throws when the upload or the encoding failed. */
      const videoUp = async (f: File, say: (st: VidState, pct?: number) => void, added: (m: Media) => void) => {
        say('prep');
        const failAt = new URLSearchParams(location.search).get('videofail') ?? '';
        const title = f.name.replace(/\.[^.]+$/, '').slice(0, 120);
        let c: { videoId: string; libraryId: string | number; expires: number; signature: string; tusEndpoint?: string; url: string; thumb: string };
        if (DEMO) {
          await sleep(500);
          c = { videoId: `demo-${Date.now()}`, libraryId: '0', expires: 0, signature: '', url: DEMO_HLS, thumb: '/video/pia-vulva-poster.jpg' };
          for (let p = 0; p <= 100; p += 10) {
            say('up', p); await sleep(260);
            if (failAt === 'upload' && p >= 60) throw new Error('demo upload failed');
          }
        } else {
          c = await api('hostVideo', { action: 'create', ...(slug ? { slug } : {}), title });
          const { Upload } = await import('tus-js-client');
          await new Promise<void>((ok, bad) => {
            const up = new Upload(f, {
              endpoint: c.tusEndpoint || 'https://video.bunnycdn.com/tusupload',
              retryDelays: [0, 3000, 5000, 10000, 20000, 60000],
              storeFingerprintForResuming: false,
              headers: { AuthorizationSignature: c.signature, AuthorizationExpire: String(c.expires), VideoId: c.videoId, LibraryId: String(c.libraryId) },
              metadata: { filetype: f.type || 'video/mp4', title },
              onProgress: (sent, total) => say('up', total ? (sent / total) * 100 : 0),
              onSuccess: () => ok(),
              onError: (err) => bad(err),
            });
            up.start();
          });
        }
        const m: Media = { type: 'video', url: c.url, thumb: c.thumb };
        encoding.add(m.url);
        added(m);
        say('proc', 0);
        try {
          // Bunny encodes a phone clip in a minute or two; after half an hour
          // stop asking (it keeps going, and the saved address plays once done).
          for (let i = 0; i < 360; i++) {
            await sleep(DEMO ? 400 : 5000);
            const st = DEMO
              ? { ready: i >= 9 && failAt !== 'encode', failed: failAt === 'encode' && i >= 5, percent: Math.min(100, i * 11) }
              : await api('hostVideo', { action: 'status', videoId: c.videoId }).catch(() => ({ ready: false, failed: false, percent: 0 }));
            if (st.failed) throw Object.assign(new Error('encoding failed'), { media: m });
            if (st.ready) { encoding.delete(m.url); say('done'); return m; }
            say('proc', st.percent ?? 0);
          }
          encoding.delete(m.url);
          return m;
        } catch (err) { encoding.delete(m.url); throw err; }
      };
      // ── The page's general video (Profile tab, Jirel 23.11.26): see it,
      //    replace it with an upload, or remove it (functions hostListing pageVideo). ──
      let pvNow: { video: string; poster: string } | null | undefined;
      pvDraw = async () => {
        const box = $('[data-ha-pv-box]');
        const sec = $('[data-ha-pv]');
        if (!slug) { sec.hidden = true; return; }
        sec.hidden = false;
        if (pvNow === undefined) {
          const built = (hosts[slug] as unknown as { pageVideo?: { video: string; poster: string } | null }).pageVideo ?? null;
          pvNow = built;
          if (!DEMO) {
            try {
              const r = await api('hostListing', { slug, action: 'pageVideoGet' });
              if (r.set) pvNow = r.video ? { video: r.video, poster: r.poster ?? '' } : null;
            } catch { /* the built page's video */ }
          }
        }
        $<HTMLButtonElement>('[data-ha-pv-remove]').hidden = !pvNow;
        if (!pvNow) { box.replaceChildren(el('p', 'hd-pv-none', TL('Kein Video auf deiner Seite.', 'No video on your page.', 'Pas de vidéo sur ta page.'))); return; }
        const v = document.createElement('video');
        Object.assign(v, { muted: true, loop: true, playsInline: true, controls: true, preload: 'metadata' });
        v.poster = pvNow.poster || '';
        if (encoding.has(pvNow.video)) box.replaceChildren(el('p', 'hd-pv-none', t.vidBusy));
        else { playHls(v, pvNow.video); box.replaceChildren(v); }
      };
      const pvSave = async (video: { url: string; thumb?: string } | null) => {
        if (DEMO) { await sleep(300); return; }
        await api('hostListing', { slug, action: 'pageVideo', video });
      };
      $<HTMLInputElement>('[data-ha-pv-file]').addEventListener('change', async (ev) => {
        const inp = ev.target as HTMLInputElement;
        const f = inp.files?.[0];
        inp.value = '';
        if (!f) return;
        const note = $('[data-ha-pv-note]');
        try {
          await videoUp(f, (st, pct) => vidSay(note, st, pct), (m) => {
            pvNow = { video: m.url, poster: m.thumb ?? '' };
            void pvSave({ url: m.url, thumb: m.thumb }).catch(() => vidSay(note, 'fail'));
            void pvDraw();
          });
          void pvDraw();
          note.textContent = TL('Gespeichert. Deine Seite zeigt das neue Video innerhalb einer Stunde.', 'Saved. Your page shows the new video within the hour.', 'Enregistré. Ta page montre la nouvelle vidéo dans l’heure.');
        } catch { vidSay(note, 'fail'); void pvDraw(); }
      });
      $<HTMLButtonElement>('[data-ha-pv-remove]').addEventListener('click', async () => {
        if (!confirm(TL('Das Video von deiner Seite entfernen? Workshops ohne eigenes Video zeigen dann ein Foto.', 'Remove the video from your page? Workshops without a video of their own then show a photo.', 'Retirer la vidéo de ta page ? Les ateliers sans vidéo à eux montrent alors une photo.'))) return;
        const note = $('[data-ha-pv-note]');
        note.textContent = t.saving;
        try {
          await pvSave(null);
          pvNow = null;
          void pvDraw();
          note.textContent = TL('Entfernt. Deine Seite folgt innerhalb einer Stunde.', 'Removed. Your page follows within the hour.', 'Retirée. Ta page suit dans l’heure.');
        } catch { note.textContent = fill(t.error, cfg.contact); }
      });
      /** A video tile for the previews: Bunny's thumbnail, or "Preparing" while it encodes. */
      const vidThumb = (m: Media, cls: string) => {
        if (encoding.has(m.url)) return [el('span', `${cls} is-busy`, t.vidBusy)];
        if (m.thumb) { const i = document.createElement('img'); i.src = m.thumb; i.alt = ''; i.loading = 'lazy'; return [i]; }
        return [];
      };
      // Read state stays on this device (no extra writes for a click).
      const SEEN = `twiggli-seen-${slug}`;
      const seen = new Set<string>((() => { try { return JSON.parse(localStorage.getItem(SEEN) ?? '[]'); } catch { return []; } })());
      const markSeen = (id: string) => { seen.add(id); try { localStorage.setItem(SEEN, JSON.stringify([...seen].slice(-300))); } catch { /* storage off */ } };
      const waiting = (r: Req) => r.status === 'pending';
      const unread = (r: Req) => !seen.has(r.id) && waiting(r);
      // A partner request names a hotel or company: kept whole ("Hotel in Charlottenburg", not "Hotel").
      const firstName = (r: Req) => (r.fields.Type === 'Partner request' && r.fields.Name ? r.fields.Name.trim() : (r.fields.Name || r.fields.Email || t.guest).trim().split(/\s+/)[0]);
      const fmtDay = (iso: string) => (iso ? new Date(`${iso}T12:00:00`).toLocaleDateString(({ de: 'de-DE', fr: 'fr-FR' } as Record<string, string>)[document.documentElement.lang] ?? 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '');
      let openId = '';
      const row = (r: Req) => {
        const li = el('li', `ha-msg${r.id === openId ? ' is-open' : ''}${unread(r) ? ' is-unread' : ''}`);
        const av = el('span', 'ha-av', firstName(r).charAt(0).toUpperCase());
        const body = el('div', 'ha-msg-body');
        const top = el('div', 'ha-msg-top');
        top.append(el('span', 'ha-msg-meta', `${t.ib.inquiry} · ${fmtDay(dateOf(r))}`), el('time', '', new Date(r.createdAt).toLocaleDateString(document.documentElement.lang || 'de', { day: 'numeric', month: 'short' })));
        const name = el('strong', '', r.fields.Name || r.fields.Email || t.guest);
        const line = el('p', 'ha-msg-line', r.fields.Workshop || r.subject);
        const meta = el('p', 'ha-msg-meta');
        meta.append(el('i', `ha-st ha-st-${r.status}`), statusText[r.status] ?? r.status);
        body.append(top, name, line, meta);
        if (waiting(r)) { const b = el('span', 'ha-pill-btn', t.review); body.append(b); }
        li.append(av, body);
        li.tabIndex = 0;
        li.addEventListener('click', () => openDetail(r));
        li.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') openDetail(r); });
        return li;
      };
      const renderMsgs = () => {
        const shown = reqs.filter((r) => filter === 'all' || unread(r));
        const prio = shown.filter(waiting);
        const rest = shown.filter((r) => !waiting(r));
        $('[data-ib-prio]').replaceChildren(...prio.map(row));
        $('[data-ha-msgs]').replaceChildren(...rest.map(row));
        root.querySelector<HTMLElement>('[data-ib-g="prio"]')!.hidden = !prio.length;
        root.querySelector<HTMLElement>('[data-ib-g="recent"]')!.hidden = !rest.length;
        $('[data-ha-msgs-empty]').hidden = shown.length > 0;
        const pending = reqs.filter(waiting);
        hasPending = pending.length > 0; paintDot();
        const count = $('[data-ha-count]');
        count.textContent = String(pending.length);
        count.hidden = !pending.length;
        renderTodo();
        renderOverview(pending);
      };
      /** One clear to-do on top, as Airbnb's banner: Stripe, while it isn't connected. */
      const renderTodo = () => { $('[data-ib-todo]').hidden = stripeReady !== false; };
      $('[data-ib-todo]').addEventListener('click', () => { showTab('create'); showStripe(); });

      // ── Overview: greeting, waiting requests, four numbers, dates by day ──
      const locale = ({ de: 'de-DE', fr: 'fr-FR' } as Record<string, string>)[document.documentElement.lang] ?? 'en-GB';
      const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const euro = (n: number) => `€ ${Math.round(n).toLocaleString(locale)}`;
      const priceOf = (r: Req) => Number(String(r.fields.Price ?? '').replace(/[^\d.,]/g, '').replace(',', '.')) || 0;
      const peopleOf = (r: Req) => Number(r.fields.People) || 1;
      const WD = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
      // Today: one card per open request with the hours left to answer; a tap
      // opens the request details (as the Airbnb app).
      let reqTick = 0;
      const renderReqCards = (pending: Req[]) => {
        const wrap = $('[data-ha-reqs]');
        const row = $('[data-ha-reqs-row]');
        window.clearInterval(reqTick);
        // Requests have their own tab, and that tab shows only the requests:
        // no numbers, no dates, no "Neuer Termin" (one thing at a time).
        const tab = $('[data-ha-req-tab]');
        tab.hidden = !pending.length;
        $('[data-ha-req-n]').textContent = String(pending.length);
        if (!whenChosen && pending.length) when = 'requests';
        if (when === 'requests' && !pending.length) when = 'upcoming';
        root.querySelectorAll<HTMLButtonElement>('[data-ha-when] button').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.w === when)));
        $('[data-ha-panel="overview"]').classList.toggle('is-requests', when === 'requests');
        wrap.hidden = when !== 'requests';
        if (!pending.length) { row.replaceChildren(); return; }
        const sorted = [...pending].sort((a, b) => a.createdAt - b.createdAt);
        const lefts: [HTMLElement, number][] = [];
        row.replaceChildren(...sorted.map((r) => {
          const card = el('div', 'hd-req');
          card.setAttribute('role', 'button'); card.tabIndex = 0;
          card.addEventListener('keydown', (ev) => { if ((ev as KeyboardEvent).key === 'Enter' && ev.target === card) card.click(); });
          const left = el('span', 'hd-req-left');
          lefts.push([left, r.createdAt + 48 * 3600 * 1000]);
          const d = dateOf(r);
          const day = d ? new Date(`${d}T12:00:00`).toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short' }) : '';
          const n = peopleOf(r);
          const txt = el('span', 'hd-req-txt');
          // A partner request (a hotel or company of our network, sent by Twiggli): said plainly.
          if (r.fields.Type === 'Partner request') txt.append(el('span', 'hd-req-pt', `🤝 ${TL('Partner-Anfrage', 'Partner request', 'Demande partenaire')}${r.fields.Name ? `: ${r.fields.Name}` : ''}${r.fields.Where ? ` · ${r.fields.Where}` : ''}`));
          txt.append(el('b', 'hd-req-what', day ? say(t.ib.reqFor, { date: day }) : t.ib.inquiry),
            el('span', 'hd-req-n', [n === 1 ? t.ib.guest1 : say(t.ib.guests, { n: String(n) }), r.fields.Time, r.fields.Workshop].filter(Boolean).join(' · ')));
          // Accept or decline right here (Jirel 23.11.26): the same popups as in Messages.
          const acts = el('span', 'hd-req-acts');
          const yes = el('button', 'hd-req-yes', TL('Annehmen', 'Accept', 'Accepter')) as HTMLButtonElement; yes.type = 'button';
          const no = el('button', 'hd-req-no', TL('Ablehnen', 'Decline', 'Refuser')) as HTMLButtonElement; no.type = 'button';
          yes.addEventListener('click', (ev) => { ev.stopPropagation(); openReq(r, 'accept'); });
          no.addEventListener('click', (ev) => { ev.stopPropagation(); openReq(r, 'decline'); });
          acts.append(yes, no);
          card.append(el('span', 'hd-req-av', firstName(r).charAt(0).toUpperCase()), txt, left, acts);
          card.addEventListener('click', () => {
            // The request with its money and buttons (Messages).
            msgFocus = `r:${r.id}`;
            showTab('messages');
          });
          return card;
        }));
        const paintLeft = () => {
          for (const [node, deadline] of lefts) {
            const ms = deadline - Date.now();
            const h = Math.floor(ms / 3600000);
            node.textContent = ms <= 0 ? t.ib.timeUp : h >= 1 ? say(h === 1 ? t.ib.hLeft1 : t.ib.hLeft, { n: String(h) }) : say(t.ib.mLeft, { n: String(Math.max(1, Math.ceil(ms / 60000))) });
            node.classList.toggle('is-soon', ms < 6 * 3600000);
          }
        };
        paintLeft();
        reqTick = window.setInterval(paintLeft, 30000);
      };
      const renderOverview = (pending: Req[]) => {
        const today = iso(new Date());
        const month = today.slice(0, 7);
        const booked = reqs.filter((r) => r.status === 'accepted');
        // Waiting requests, right at the top.
        const alert = $('[data-ha-alert]');
        alert.hidden = true; // the request cards below replace the banner
        renderReqCards(pending);
        $('[data-ha-alert-title]').textContent = (pending.length === 1 ? t.alertOne : t.alertMany).replace('{n}', String(pending.length));
        $('[data-ha-alert-sub]').textContent = pending.slice(0, 2)
          .map((r) => `${(r.fields.Name || t.guest).split(' ')[0]} · ${r.fields.Date ? new Date(dateOf(r)).toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'numeric' }) : ''} · ${peopleOf(r)} ${t.people}`)
          .join('   ·   ');
        // Four numbers.
        const thisMonth = booked.filter((r) => dateOf(r).startsWith(month));
        const set = (k: string, v: string, note = '') => {
          $(`[data-ha-st="${k}"]`).textContent = v;
          const n = root.querySelector<HTMLElement>(`[data-ha-st-note="${k}"]`);
          if (n) n.textContent = note;
        };
        set('open', String(pending.length), pending.length ? t.stOpenNote : t.stOpenNone);
        set('bookings', String(thisMonth.length), t.stBookingsNote.replace('{n}', String(thisMonth.reduce((a, r) => a + peopleOf(r), 0))));
        set('earnings', euro(thisMonth.reduce((a, r) => a + keep(priceOf(r) * peopleOf(r)), 0)));
        // Dates: the weekly schedule for the next two weeks, plus confirmed bookings.
        const slots = Array.from(slotsBox.querySelectorAll('.ha-slot')).map((n) => ({
          title: (n.querySelector('[name="title"]') as HTMLInputElement).value,
          time: (n.querySelector('[name="time"]') as HTMLInputElement).value,
          duration: (n.querySelector('[name="duration"]') as HTMLInputElement).value,
          days: Array.from(n.querySelectorAll<HTMLInputElement>('[name="day"]:checked')).map((d) => d.value),
        }));
        type Item = { date: string; time: string; title: string; sub: string; people: number };
        const items: Item[] = [];
        if (when === 'upcoming') {
          for (const ev of ownEvents) for (const date of occurrences(ev, 14)) {
            const ppl = booked.filter((r) => dateOf(r) === date).reduce((a, r) => a + peopleOf(r), 0);
            items.push({ date, time: ev.start, title: ev.title, sub: [ev.end ? `${ev.start}–${ev.end}` : ev.start, ev.seats ? t.seatsN.replace('{n}', String(ev.seats)) : ''].filter(Boolean).join(' · '), people: ppl });
          }
          for (let i = 0; i < 14; i++) {
            const d = new Date(); d.setDate(d.getDate() + i);
            for (const sl of slots) if (sl.days.includes(WD[d.getDay()])) {
              const date = iso(d);
              const ppl = booked.filter((r) => dateOf(r) === date).reduce((a, r) => a + peopleOf(r), 0);
              items.push({ date, time: sl.time, title: sl.title, sub: [sl.time, sl.duration].filter(Boolean).join(' · '), people: ppl });
            }
          }
          for (const r of booked) if (dateOf(r) >= today && !items.some((x) => x.date === dateOf(r))) {
            items.push({ date: dateOf(r), time: r.fields.Time || '', title: r.fields.Workshop || r.subject, sub: [r.fields.Time, r.fields.Name].filter(Boolean).join(' · '), people: peopleOf(r) });
          }
        } else {
          for (const r of booked) if (dateOf(r) && dateOf(r) < today) {
            items.push({ date: dateOf(r), time: r.fields.Time || '', title: r.fields.Workshop || r.subject, sub: [r.fields.Time, r.fields.Name].filter(Boolean).join(' · '), people: peopleOf(r) });
          }
        }
        items.sort((a, b) => (when === 'past' ? -1 : 1) * `${a.date} ${a.time}`.localeCompare(`${b.date} ${b.time}`));
        const next = items.find(() => when === 'upcoming');
        set('next', next ? new Date(next.date).toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short' }) : '–', next ? `${next.time} · ${next.title}` : t.stNextNone);
        $('[data-ha-list-title]').textContent = when === 'past' ? t.pastDates : t.nextDates;
        const box = $('[data-ha-days]');
        box.replaceChildren();
        let last = '';
        for (const it of items) {
          if (it.date !== last) {
            last = it.date;
            const d = new Date(it.date);
            box.append(el('p', 'hd-day', `${it.date === today ? `${t.today} · ` : ''}${d.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' })}`));
          }
          const card = el('div', 'hd-ev');
          const img = document.createElement('img');
          img.src = `/img/hosts/${slug}.jpg`; img.alt = ''; img.loading = 'lazy';
          img.addEventListener('error', () => { img.replaceWith(el('span', 'hd-ph', hdEmoji())); });
          const txt = el('div', 'hd-ev-t');
          txt.append(el('b', '', it.title), el('span', '', it.sub));
          const seats = el('div', 'hd-seats', it.people ? t.bookedN.replace('{n}', String(it.people)) : t.noBookingYet);
          card.append(img, txt, seats);
          box.append(card);
        }
        $('[data-ha-today-empty]').hidden = items.length > 0;
      };
      const loadInbox = async () => {
        try { const r = await api('hostEvents', { slug }); ownEvents = r.items ?? []; calBookings = r.bookings ?? []; calReplaced = new Set(r.replaced ?? []); } catch { ownEvents = []; calBookings = []; }
        renderOwnDates();
        try { reqs = (await api('hostInbox', { slug })).items ?? []; } catch { reqs = []; }
        renderMsgs();
        renderCal();
        openFromMail();
      };
      // The Accept / Decline buttons in the "New booking request" email
      // (functions notifyHostRequest, Jirel 22.11.26) land here with
      // ?req=<id>&act=accept|decline: open that request in Messages and its
      // accept or decline popup, so the host only confirms.
      let mailDone = false;
      const openFromMail = () => {
        if (mailDone) return;
        const q = new URLSearchParams(location.search);
        const id = q.get('req');
        const act = q.get('act');
        if (!id) return;
        const r = reqs.find((x) => x.id === id);
        if (!r) return;
        mailDone = true;
        q.delete('req'); q.delete('act');
        history.replaceState(history.state, '', location.pathname + (q.toString() ? `?${q}` : '') + location.hash);
        openReq(r, act);
      };
      /** A request with its accept or decline popup open (from the email buttons, or the Overview's cards). */
      const openReq = (r: Req, act: string | null) => {
        showTab('messages');
        openDetail(r);
        // The "Respond" button openDetail puts on the request card opens the popup.
        $('[data-ib-conv]').querySelector<HTMLButtonElement>('.ib-respond')?.click();
        const body = $<HTMLDialogElement>('[data-ib-modal]').querySelector<HTMLElement>('[data-ib-modal-body]')!;
        const acts = body.querySelectorAll<HTMLButtonElement>('.ib-acts .ib-act');
        const btn = act === 'accept' ? acts[0] : act === 'decline' ? acts[acts.length - 1] : null;
        if (btn) btn.click(); else acts[0]?.focus();
      };
      // Saved replies, kept on this device; three starters until the host saves their own.
      const SAVED = `twiggli-replies-${slug}`;
      const savedReplies = (): string[] => { try { const v = JSON.parse(localStorage.getItem(SAVED) ?? 'null'); return Array.isArray(v) ? v : [t.ib.msg1, t.ib.msg2, t.ib.msg3]; } catch { return [t.ib.msg1, t.ib.msg2, t.ib.msg3]; } };
      const keepReplies = (v: string[]) => { try { localStorage.setItem(SAVED, JSON.stringify(v.slice(0, 20))); } catch { /* storage off */ } };
      const say = (s: string, map: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, k) => map[k] ?? '');
      const send = async (r: Req, action: string, extra: Record<string, unknown>, note: HTMLElement, btns: HTMLButtonElement[]) => {
        btns.forEach((b) => { b.disabled = true; });
        try {
          if (DEMO) {
            // Demo: as the server would (hostReply), nothing sent.
            await new Promise((ok) => setTimeout(ok, 300));
            if (new URLSearchParams(location.search).has('fail')) throw new Error('demo fail');
            const STATUS: Record<string, string> = { accept: 'accepted', decline: 'declined', suggest: 'suggested', offer: 'offered' };
            r.thread = [...(r.thread ?? []), { action, ...extra, at: Date.now() } as Req['thread'][number]];
            if (STATUS[action]) r.status = STATUS[action];
            const hold = (r as Req & { hold?: { settled?: string } }).hold;
            if (hold && (action === 'accept' || action === 'decline')) hold.settled = action === 'accept' ? 'taken' : 'released';
          } else {
            await api('hostReply', { id: r.id, action, ...extra });
            reqs = (await api('hostInbox', { slug })).items ?? reqs;
          }
          note.textContent = t.ib.sent;
          const dlg = root.querySelector<HTMLDialogElement>('[data-ib-modal]');
          if (dlg?.open) dlg.close();
          renderMsgs();
          msgFocus = `r:${r.id}`;
          renderMsgPanel();
          renderCal();
          const again = reqs.find((x) => x.id === r.id);
          if (again && openId === r.id) openDetail(again);
        } catch (err) {
          // A voucher request whose card hold lapsed (7 days): say so plainly.
          note.textContent = /payment/.test(String((err as Error)?.message)) ? t.ib.holdLapsed : fill(t.error, cfg.contact);
          btns.forEach((b) => { b.disabled = false; });
        }
      };
      const openDetail = (r: Req) => {
        openId = r.id;
        markSeen(r.id);
        renderMsgs();
        const de = document.documentElement.lang === 'de';
        const loc = de ? 'de-DE' : 'en-GB';
        const name = firstName(r);
        const ppl = peopleOf(r);
        const each = priceOf(r);
        const deadline = r.createdAt + 48 * 3600 * 1000;
        const late = Date.now() > deadline;

        // ── Middle: the conversation ──
        const conv = $('[data-ib-conv]');
        const head = el('div', 'ib-head');
        const back = el('button', 'ib-back', '←') as HTMLButtonElement;
        back.type = 'button'; back.setAttribute('aria-label', t.back);
        back.addEventListener('click', () => { openId = ''; $('[data-ib-grid]').classList.remove('is-open'); renderMsgs(); });
        head.append(back, el('span', 'ha-av', name.charAt(0).toUpperCase()), el('strong', '', r.fields.Name || t.guest));
        const thread = el('div', 'ib-thread');
        if (r.fields.Message) {
          const b = el('div', 'ib-bubble');
          b.append(el('span', 'ib-who', name), el('p', '', r.fields.Message));
          thread.append(b);
        }
        const card = el('div', 'ib-card');
        card.append(el('small', '', t.ib.inquiry), el('b', '', [each ? `€ ${(each * ppl).toLocaleString(loc)}` : '', ppl === 1 ? t.ib.guest1 : say(t.ib.guests, { n: String(ppl) })].filter(Boolean).join(' · ')),
          el('span', '', [fmtDay(dateOf(r)), r.fields.Time, r.fields.Workshop].filter(Boolean).join(' · ')));
        const pic = document.createElement('img');
        pic.src = `/img/hosts/${slug}.jpg`; pic.alt = ''; pic.loading = 'lazy';
        pic.addEventListener('error', () => pic.remove());
        card.append(pic);
        if (waiting(r)) {
          card.append(el('p', `ib-until${late ? ' is-late' : ''}`, late ? t.ib.late : say(t.ib.until, { when: new Date(deadline).toLocaleString(loc, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) })));
          const go = el('button', 'ib-respond', t.ib.respond) as HTMLButtonElement;
          go.type = 'button';
          go.addEventListener('click', () => {
            const dlg = $<HTMLDialogElement>('[data-ib-modal]');
            const body = dlg.querySelector<HTMLElement>('[data-ib-modal-body]')!;
            buildRes(body, true);
            dlg.showModal();
            body.querySelector<HTMLButtonElement>('.ib-act')?.focus();
          });
          card.append(go);
        }
        thread.append(card);
        for (const h of r.thread) {
          const line = h.action === 'accept' ? t.ib.accepted : h.action === 'decline' ? t.ib.declined : h.action === 'suggest' ? say(t.ib.suggested, { when: h.when ?? '' })
            : h.action === 'offer' ? (() => {
              const o = h as { price?: number; total?: number; people?: number; workshop?: string };
              return say(t.ib.offered, { what: [o.workshop, h.when, o.people ? (o.people === 1 ? t.ib.guest1 : say(t.ib.guests, { n: String(o.people) })) : '',
                o.total ? `€ ${o.total.toLocaleString(loc)} ${t.ib.total}` : o.price ? `€ ${o.price} ${t.ib.perPerson}` : ''].filter(Boolean).join(', ') });
            })() : '';
          const b = el('div', 'ib-bubble ib-mine');
          b.append(el('span', 'ib-who', `${t.ib.you} · ${new Date(h.at).toLocaleString(loc, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}`));
          if (line) b.append(el('p', 'ib-sys', line));
          if (h.message) b.append(el('p', '', h.message));
          thread.append(b);
        }
        // Composer with saved replies.
        const comp = el('form', 'ib-comp') as HTMLFormElement;
        const ta = document.createElement('textarea');
        ta.rows = 2; ta.placeholder = t.ib.write; ta.setAttribute('aria-label', t.ib.write);
        const bar = el('div', 'ib-comp-bar');
        const savedBtn = el('button', 'ib-saved-btn', '💬') as HTMLButtonElement;
        savedBtn.type = 'button'; savedBtn.title = t.ib.saved; savedBtn.setAttribute('aria-label', t.ib.saved);
        const pop = el('div', 'ib-saved');
        pop.hidden = true;
        const fillPop = () => {
          pop.replaceChildren(el('p', 'ib-saved-h', t.ib.saved));
          const list = savedReplies();
          if (!list.length) pop.append(el('p', 'ha-empty', t.ib.noSaved));
          list.forEach((txt, k) => {
            const rowEl = el('div', 'ib-saved-row');
            const use = el('button', 'ib-saved-use', txt) as HTMLButtonElement;
