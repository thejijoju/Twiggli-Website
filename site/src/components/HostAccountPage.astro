  .ha-st-pending { background: #e0457b; } .ha-st-accepted { background: #1f9d55; } .ha-st-suggested { background: #f2a516; }
  .ha-pill-btn { margin-top: 8px; font: inherit; font-size: 0.86rem; font-weight: 600; border: 0; border-radius: 10px; padding: 7px 14px; background: rgba(36, 39, 46, 0.07); cursor: pointer; }
