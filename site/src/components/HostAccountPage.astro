  @media (max-width: 1100px) {
    .ib-grid { grid-template-columns: minmax(220px, 300px) minmax(0, 1fr); }
    .ib-res { position: fixed; inset: 0 0 0 auto; width: min(380px, 100%); background: #fff; box-shadow: -10px 0 30px rgba(0, 0, 0, 0.12); padding: 20px; overflow: auto; z-index: 30; transform: translateX(100%); transition: transform .2s ease; }
    .ib-grid.show-res .ib-res { transform: none; }
