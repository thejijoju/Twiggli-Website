          if (had) { had.alias = [...new Set([...(had.alias ?? []), calKey(title), ...more.map(calKey)])]; return; }
          out.push({ title, key: k, image, price, alias: [calKey(title), ...more.map(calKey)], color: CAL_COLORS[out.length % CAL_COLORS.length] });
        };
        const state = calListings.slug === slug ? calListings.items : [];
        for (const w of hosts[slug]?.workshops ?? []) {
          const st = state.find((x) => x.key && x.key === (w.key || calKey(w.title)));
          if (st?.status === 'deleted') continue;
          add(st?.edit?.title || w.title, (st?.edit?.media ?? []).find((m) => m.type === 'photo')?.url || w.image, w.price, w.key, [w.title]);
