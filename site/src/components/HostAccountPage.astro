  /* ── The dashboard: a full-screen app (bare layout), Luma's structure in
     Twiggli colours. A soft purple-to-light-yellow wash at the top, cards
     with a shadow underneath only. ── */
  body.is-bare { background: #fdf9f3; }
  /* Desktop: flat cream, the purple-to-yellow wash only across the top (as
     in the mockup). Phones keep the softer all-over tint. */
  @media (min-width: 761px) {
    html:has(body.is-bare) { background: linear-gradient(180deg, rgba(106, 62, 236, 0.16), rgba(255, 201, 77, 0.09) 150px, #fdf8f2 260px) no-repeat, #fdf8f2 !important; }
    body.is-bare, body.is-bare .page { background: transparent !important; background-image: none !important; }
    body.is-bare::before { display: none; }
  }
  body.is-bare::before {
    content: ''; position: fixed; inset: 0 0 auto 0; height: 300px; z-index: -1; pointer-events: none;
    background: linear-gradient(180deg, rgba(106, 62, 236, 0.13), rgba(255, 214, 120, 0.07) 60%, rgba(253, 249, 243, 0));
  }
  .ha-home { position: absolute; top: 16px; left: 24px; z-index: 30; }
  .ha-home img { display: block; border-radius: 10px; }
  .ha { max-width: 860px; }
  .ha.is-in { padding-top: 84px; }
  /* Across the whole page, on the logo's line. */
  .hd-top { position: absolute; top: 0; left: 0; right: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 66px; padding: 0 24px 0 84px; }
  .ha-tabs { display: flex; gap: 22px; margin: 0; }
  .ha-tabs button { display: flex; align-items: center; gap: 7px; font: inherit; font-size: 0.95rem; color: var(--color-text-muted); background: none; border: 0; padding: 6px 0; cursor: pointer; }
  .hd-i { flex: none; opacity: 0.85; }
  .ha-tabs button[aria-selected='true'] { color: var(--color-text); font-weight: 600; }
  .ha-count { font-style: normal; font-size: 0.7rem; font-weight: 600; color: #fff; background: #e0457b; border-radius: 999px; padding: 1px 7px; }
  .hd-right { display: flex; align-items: center; gap: 16px; margin-left: auto; }
  .hd-add { font: inherit; font-weight: 600; font-size: 0.9rem; color: #fff; background: var(--color-accent); border: 0; border-radius: 999px; padding: 9px 16px; cursor: pointer; white-space: nowrap; }
  .hd-bell { position: relative; display: grid; color: var(--color-text-muted); background: none; border: 0; cursor: pointer; padding: 4px; }
  .hd-bell i { position: absolute; top: 2px; right: 0; width: 8px; height: 8px; border-radius: 50%; background: #e0457b; }
  .hd-me { position: relative; }
  .hd-avatar { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-size: 1.3rem; background: #ffeec2; border: 2px solid #fff; cursor: pointer; box-shadow: 0 5px 6px -4px rgba(0, 0, 0, 0.2); }
  .hd-menu { position: absolute; right: 0; top: 46px; z-index: 40; width: 260px; padding: 14px; border-radius: 16px; background: #fff; box-shadow: 0 14px 18px -10px rgba(36, 39, 46, 0.28); display: grid; gap: 8px; }
  .hd-who { margin: 0; font-size: 0.82rem; color: var(--color-text-muted); word-break: break-all; }
  .hd-label { margin: 4px 0 0; font-size: 0.82rem; font-weight: 600; }
  .hd-emojis { display: grid; grid-template-columns: repeat(8, 1fr); gap: 2px; }
  .hd-emojis button { font-size: 1.15rem; background: none; border: 0; border-radius: 8px; padding: 4px 0; cursor: pointer; }
  .hd-emojis button:hover { background: rgba(36, 39, 46, 0.06); }
  .hd-item { font: inherit; font-size: 0.92rem; text-align: left; background: none; border: 0; padding: 6px 0; color: var(--color-text); cursor: pointer; text-decoration: none; }
  .hd-menu .ha-pick { display: grid; gap: 4px; font-size: 0.82rem; }
  .hd-hi { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 20px; }
  .hd-hi h1 { margin: 0; font-size: clamp(1.7rem, 4vw, 2.2rem); }
  .hd-hi .ha-sub { margin: 4px 0 0; }
  .hd-seg { display: flex; background: rgba(36, 39, 46, 0.06); border-radius: 12px; padding: 4px; }
  .hd-seg button { font: inherit; font-size: 0.88rem; border: 0; background: none; border-radius: 9px; padding: 7px 16px; color: var(--color-text-muted); cursor: pointer; }
  .hd-seg button[aria-pressed='true'] { background: #fff; color: var(--color-text); font-weight: 600; box-shadow: 0 3px 4px -3px rgba(0, 0, 0, 0.2); }
  /* The app sits in a grid column: let it shrink so the card row scrolls instead of widening the page. */
  .ha.container { grid-template-columns: minmax(0, 1fr); }
  .ha-app { min-width: 0; width: 100%; justify-self: stretch; }
  .hd-stats > * { min-width: 0; }
  .hl { margin-bottom: 26px; }
  .hl-list { display: grid; gap: 12px; margin-top: 14px; }
  .hl-row { display: flex; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 20px; background: #fff; box-shadow: 0 10px 24px -16px rgba(60, 30, 120, 0.35), 0 0 0 1px rgba(36, 39, 46, 0.05); }
  .hl-row.is-paused .hl-img { filter: grayscale(1); opacity: .55; }
  .hl-row.is-paused .hl-txt b { color: var(--color-text-muted); }
  .hl-img { flex: none; width: 64px; height: 64px; border-radius: 14px; object-fit: cover; background: rgba(106, 62, 236, 0.08); }
  .hl-txt { flex: 1; min-width: 0; display: grid; gap: 2px; justify-items: start; }
  .hl-txt b { font-size: 1rem; line-height: 1.25; }
  .hl-txt small { color: var(--color-text-muted); font-size: 0.85rem; }
  .hl-pill { font-size: 0.72rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
  .hl-pill.is-live { background: #e6f6ec; color: #1f7a45; }
  .hl-pill.is-paused { background: rgba(36, 39, 46, 0.07); color: var(--color-text-muted); }
  .hl-acts { flex: none; display: flex; gap: 8px; }
  .hl-btn { border: 0; border-radius: 999px; padding: 8px 14px; font: inherit; font-size: 0.86rem; font-weight: 600; background: rgba(36, 39, 46, 0.06); color: var(--color-text); cursor: pointer; }
  .hl-btn:hover { background: rgba(36, 39, 46, 0.1); }
  .hl-del { color: #c4314b; background: rgba(212, 56, 74, 0.08); }
  .hl-del:hover { background: rgba(212, 56, 74, 0.14); }
  .hl-del-yes { background: #c4314b !important; }
  .hl-empty { color: var(--color-text-muted); }
  @media (max-width: 640px) {
    .hl-row { display: grid; grid-template-columns: 64px minmax(0, 1fr); grid-template-areas: 'img txt' 'acts acts'; row-gap: 12px; }
    .hl-img { grid-area: img; } .hl-txt { grid-area: txt; }
    .hl-acts { grid-area: acts; } .hl-acts .hl-btn { flex: 1; }
  }
  .hd-reqs { margin: 4px 0 26px; min-width: 0; max-width: 100%; }
  /* Requests tab: only the requests. */
  .hd-overview.is-requests :is(.hd-add-phone, .hd-alert, .hd-stats, [data-ha-list-title], [data-ha-days], [data-ha-today-empty]) { display: none !important; }
  .hd-seg-n { display: inline-grid; place-items: center; min-width: 20px; height: 20px; padding: 0 6px; margin-left: 4px; border-radius: 10px; background: var(--color-accent); color: #fff; font-size: 0.72rem; font-weight: 700; }
  .hd-reqs-row { display: grid; gap: 12px; max-width: 620px; }
  .hd-req { display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px 18px; border: 0; border-radius: 20px; background: #fff; font: inherit; color: inherit; text-align: left; cursor: pointer;
    box-shadow: 0 10px 24px -16px rgba(60, 30, 120, 0.35), 0 0 0 1px rgba(36, 39, 46, 0.05); transition: transform .15s ease, box-shadow .15s ease; }
  .hd-req:hover { transform: translateY(-2px); box-shadow: 0 16px 30px -16px rgba(60, 30, 120, 0.4), 0 0 0 1px rgba(36, 39, 46, 0.06); }
  .hd-req-av { flex: none; display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; background: rgba(106, 62, 236, 0.1); color: var(--color-accent); font-weight: 700; font-size: 1.15rem; }
  .hd-req-txt { flex: 1; min-width: 0; display: grid; gap: 2px; }
  .hd-req-what { font-size: 1rem; }
  .hd-req-n { color: var(--color-text-muted); font-size: 0.88rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hd-req-left { flex: none; font-size: 0.82rem; font-weight: 600; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .hd-req-left.is-soon { color: #d4384a; }
  .hd-seg button[data-w='requests'] { white-space: nowrap; }
  @media (max-width: 640px) {
    .hd-req { display: grid; grid-template-columns: 46px minmax(0, 1fr); grid-template-areas: 'av left' 'av txt'; column-gap: 14px; row-gap: 2px; align-items: center; }
    .hd-req-av { grid-area: av; }
    .hd-req-left { grid-area: left; font-size: 0.78rem; }
    .hd-req-txt { grid-area: txt; }
  }
  .hd-alert { display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; font: inherit; color: inherit; background: #fff; border: 0; border-radius: 16px; padding: 14px 16px; margin-bottom: 20px; cursor: pointer; box-shadow: 0 8px 10px -8px rgba(224, 69, 123, 0.3); }
  .hd-alert-ic { flex: none; width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; font-size: 1.2rem; background: #ffe3ec; }
  .hd-alert-t { flex: 1; min-width: 0; display: grid; }
  .hd-alert-t span { color: var(--color-text-muted); font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hd-pill { flex: none; font-size: 0.82rem; font-weight: 600; color: #fff; background: var(--color-text); border-radius: 999px; padding: 8px 14px; }
  .hd-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 24px; }
  .hd-st { display: grid; gap: 2px; background: rgba(255, 255, 255, 0.8); border-radius: 16px; padding: 14px 16px; box-shadow: 0 8px 10px -8px rgba(60, 30, 120, 0.22); }
  .hd-st small { font-size: 0.75rem; color: var(--color-text-muted); }
  .hd-st b { font-size: 1.35rem; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hd-st em { font-style: normal; font-size: 0.75rem; color: #1f9d55; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hd-h2 { font-size: 1.05rem; margin: 4px 0 6px; }
  .hd-day { margin: 16px 0 6px; font-size: 0.82rem; color: var(--color-text-muted); }
  .hd-ev { display: flex; align-items: center; gap: 14px; background: #fff; border-radius: 16px; padding: 12px; margin-bottom: 10px; box-shadow: 0 8px 10px -8px rgba(0, 0, 0, 0.18); }
  .hd-ev img, .hd-ph { flex: none; width: 60px; height: 60px; border-radius: 12px; object-fit: cover; display: grid; place-items: center; font-size: 1.6rem; background: #f4efe6; }
  .hd-ev-t { flex: 1; min-width: 0; display: grid; }
  .hd-ev-t span { color: var(--color-text-muted); font-size: 0.86rem; }
  .hd-seats { flex: none; font-size: 0.82rem; font-weight: 600; text-align: right; color: var(--color-text-muted); }
  /* Phones: the tabs become a bar at the bottom, like an app (this page has
     no site menu, so nothing else sits there). */
  @media (max-width: 760px) {
    .ha-home { left: 16px; }
    .hd-top { justify-content: flex-end; padding: 0 16px; }
    .ha.is-in { padding-top: 74px; }
    .hd-add { display: none; }
    .ha-tabs {
      position: fixed; z-index: 50; left: 0; right: 0; bottom: 0; margin: 0; gap: 0; justify-content: space-around;
      padding: 8px 4px calc(10px + env(safe-area-inset-bottom));
      background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(14px); border-top: 1px solid rgba(36, 39, 46, 0.08);
    }
    .ha-tabs button { flex-direction: column; gap: 2px; font-size: 0.68rem; padding: 2px 4px; position: relative; }
    .ha-tabs .hd-i { width: 22px; height: 22px; }
    .ha-tabs button[aria-selected='true'] { color: var(--color-accent); }
    .ha-count { position: absolute; top: -2px; right: -4px; }
    .ha.is-in { padding-bottom: 100px; }
    .hd-hi { flex-direction: column; align-items: flex-start; }
    .hd-stats { grid-template-columns: 1fr 1fr; }
  }

  /* ── New date ("Neuer Termin") ── */
  .hd-create { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 32px; align-items: start; }
  .hd-cover { aspect-ratio: 1; border-radius: 20px; overflow: hidden; display: grid; place-items: center; background: #f1ebe2; box-shadow: 0 10px 12px -10px rgba(0, 0, 0, 0.35); }
  .hd-cover img, .hd-cover video { width: 100%; height: 100%; object-fit: cover; }
  .hd-cover .hd-ph { width: auto; height: auto; background: none; font-size: 0.9rem; color: var(--color-text-muted); }
  .hd-media-tip { margin: 12px 0 10px; font-size: 0.82rem; color: var(--color-text-muted); }
  .hd-media-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .hd-media-btn { display: flex; align-items: center; justify-content: center; gap: 7px; padding: 10px; border-radius: 12px; background: #fff; font-size: 0.85rem; font-weight: 600; cursor: pointer; box-shadow: 0 6px 8px -6px rgba(0, 0, 0, 0.2); }
  .hd-media-hint { margin: 14px 0 6px; font-size: 0.78rem; color: var(--color-text-muted); }
  .hd-thumbs { display: flex; flex-wrap: wrap; gap: 8px; }
  .hd-thumb { width: 56px; height: 56px; padding: 0; border: 0; border-radius: 12px; overflow: hidden; cursor: pointer; background: #f1ebe2; opacity: 0.75; display: grid; place-items: center; }
  .hd-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .hd-thumb[aria-pressed='true'] { opacity: 1; outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .hd-create-chips { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
  .hd-chip { display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 10px; background: rgba(255, 255, 255, 0.8); font-size: 0.88rem; color: #454950; }
  .hd-chip select { border: 0; background: none; font: inherit; padding: 0; width: auto; }
  .ha .hd-title { font-size: clamp(1.6rem, 3.6vw, 2.3rem); font-weight: 600; border: 0; background: none; padding: 4px 0; margin: 2px 0 12px; border-radius: 0; }
  .ha .hd-title::placeholder { color: #bdb6cc; }
  .hd-when { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; margin-bottom: 10px; }
  .hd-box { background: #fff; border-radius: 14px; box-shadow: 0 8px 10px -8px rgba(0, 0, 0, 0.15); margin-bottom: 10px; }
  .hd-when .hd-box { margin: 0; }
  .hd-tz { padding: 12px 16px; font-size: 0.8rem; color: var(--color-text-muted); display: grid; align-content: center; }
  .hd-dt { display: grid; grid-template-columns: 70px minmax(0, 1fr) 96px; gap: 8px; align-items: center; padding: 8px 12px; }
  .hd-dt > span:first-child { font-size: 0.85rem; color: var(--color-text-muted); }
  .ha .hd-dt input { background: #f6f2ec; border: 0; border-radius: 9px; padding: 7px 10px; }
  .hd-dt small { grid-column: 2 / -1; font-size: 0.75rem; color: var(--color-text-muted); }
  .hd-dt-same { font-size: 0.9rem; color: var(--color-text-muted); padding-left: 10px; }
  .hd-repeat { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 10px 12px; border-top: 1px solid #f1ede6; font-size: 0.8rem; color: var(--color-text-muted); }
  .hd-repeat label { cursor: pointer; }
  .hd-repeat input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .hd-repeat i { font-style: normal; display: inline-block; border-radius: 999px; padding: 4px 11px; background: #f6f2ec; color: #454950; }
  .hd-repeat input:checked + i { background: var(--color-accent); color: #fff; }
  .hd-repeat input:focus-visible + i { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .hd-row { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-bottom: 1px solid #f1ede6; font-size: 0.95rem; }
  .hd-row:last-child { border-bottom: 0; }
  .hd-row .hd-i { color: #8a8e95; }
  .hd-row-top { align-items: flex-start; }
  .ha .hd-row input:not([type='checkbox']), .ha .hd-row textarea, .ha .hd-row select { border: 0; background: none; padding: 4px 0; border-radius: 0; }
  .hd-k { flex: 1; display: grid; }
  .hd-k small { font-size: 0.75rem; color: var(--color-text-muted); }
  .ha .hd-row .hd-num { width: 80px; text-align: right; }
  .ha .hd-row .hd-short { width: 140px; text-align: right; }
  .ha .hd-row select { width: auto; text-align: right; color: #454950; }
  .hd-switch { appearance: none; width: 42px; height: 24px; border-radius: 999px; background: #e4e0da; position: relative; cursor: pointer; flex: none; }
  .hd-switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: left 0.15s; }
  .hd-switch:checked { background: var(--color-accent); }
  .hd-switch:checked::after { left: 21px; }
  .hd-sec { margin: 16px 0 8px; font-size: 0.82rem; font-weight: 600; color: var(--color-text-muted); }
