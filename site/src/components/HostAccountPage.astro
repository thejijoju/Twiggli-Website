  .tp-item.is-note .tp-txt p { color: inherit; white-space: pre-line; }
  .tp-act { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; margin-top: 8px; }
  .tp-fix { font: inherit; font-size: 0.84rem; font-weight: 600; color: #fff; background: #6a3eec; border: 0; border-radius: 999px; padding: 6px 14px; cursor: pointer; }
  .tp-item.is-soft .tp-fix { color: #6a3eec; background: #fff; border: 1px solid color-mix(in srgb, #6a3eec 35%, transparent); }
