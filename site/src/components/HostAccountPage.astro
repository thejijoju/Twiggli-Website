  /* Tips for the page: small, friendly, lilac (not alarm red). */
  .tp { margin: 0 0 18px; padding: 14px 16px 6px; border-radius: 16px; background: color-mix(in srgb, #6a3eec 6%, #fff); border: 1px solid color-mix(in srgb, #6a3eec 18%, transparent); }
