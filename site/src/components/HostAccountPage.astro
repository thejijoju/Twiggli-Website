  .ib-respond { border: 0; border-radius: 12px; padding: 12px; font: inherit; font-weight: 700; color: #fff; background: linear-gradient(90deg, #6a3eec, #e64ab4); cursor: pointer; }
  .ib-comp { position: relative; margin: 12px 18px 18px; border: 1.5px solid rgba(36, 39, 46, 0.2); border-radius: 18px; padding: 10px 12px; }
  .ib-comp textarea { width: 100%; border: 0; resize: vertical; font: inherit; background: transparent; outline: none; }
  .ib-comp-bar { display: flex; justify-content: space-between; align-items: center; }
