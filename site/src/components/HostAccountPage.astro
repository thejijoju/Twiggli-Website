  .ib-reason { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1.5px solid rgba(36, 39, 46, 0.18); border-radius: 14px; cursor: pointer; font-size: 1rem; transition: border-color .15s, box-shadow .15s; }
  .ib-reason:hover { border-color: rgba(36, 39, 46, 0.4); }
  .ib-reason:has(input:checked) { border-color: var(--color-accent); box-shadow: 0 0 0 4px rgba(106, 62, 236, 0.12); }
  .ib-reason input { accent-color: var(--color-accent); width: 18px; height: 18px; margin: 0; }
  .ib-what small { color: var(--color-text-muted); }
  .ib-what h3 { margin: 4px 0 10px; font-size: 1.45rem; line-height: 1.2; }
  .ib-what p { margin: 2px 0; }
  .ib-acts { display: grid; gap: 10px; margin: 18px 0 10px; padding-bottom: 18px; border-bottom: 6px solid rgba(36, 39, 46, 0.06); }
  .ib-act { border: 0; border-radius: 12px; padding: 13px; font: inherit; font-weight: 600; background: rgba(36, 39, 46, 0.07); cursor: pointer; }
  .ib-act:hover { background: rgba(36, 39, 46, 0.12); }
