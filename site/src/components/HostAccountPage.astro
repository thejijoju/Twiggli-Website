  .tp-list { list-style: none; margin: 0; padding: 0; }
  .tp-item { display: grid; grid-template-columns: 26px 1fr 28px; gap: 10px; align-items: start; padding: 10px 0; border-top: 1px solid color-mix(in srgb, #6a3eec 12%, transparent); }
