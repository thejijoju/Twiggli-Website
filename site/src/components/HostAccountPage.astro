<script>
  import { formEndpoint, functionsBase } from '../data/firebase.ts';
  import { rememberSignedIn, sessionLeft } from '../lib/auth.ts';
  import { initializeApp } from 'firebase/app';
  import {
    getAuth, GoogleAuthProvider, isSignInWithEmailLink, onAuthStateChanged, signInWithEmailLink, updateProfile,
    signInWithCustomToken, signInWithPopup, signOut,
  } from 'firebase/auth';
  import {
    collection, doc, getDoc, getDocs, getFirestore, query, setDoc, where, writeBatch,
  } from 'firebase/firestore';
  import { getDownloadURL, getStorage, ref as storageRef, uploadBytes } from 'firebase/storage';
  import { postcodeDistrict } from '../data/berlinPostcodes.ts';
  import { playHls } from '../lib/hls.ts';
  import { isHls } from '../lib/videoSrc.ts';

  type Profile = Record<string, string>;
  type Slot = { title: string; weekdays: string[]; time: string; duration?: string | null; price?: number | null };
  type Sp = { on?: boolean; name?: string; district?: string; capacity?: number | null; size?: string; price?: number | null; priceNote?: string; included?: string; suits?: string; about?: string; access?: string; photos?: string[] };
  type HostData = { name: string; first?: string; voucher?: boolean; space?: Sp | null; page: string; en: Profile; de: Profile; slots: Slot[]; photos: string[]; draft?: boolean; card?: string; video?: boolean };

  const root = document.querySelector<HTMLElement>('[data-ha]');
  if (root) {
    const cfg = JSON.parse(root.dataset.config || '{}');
    const hosts: Record<string, HostData> = JSON.parse(root.dataset.hosts || '{}');
    /** "RtmiS (Diana) · Terrazzo…": the studio name, the person when it differs, and what they do. */
    const hostLabel = (s: string) => { const h = hosts[s]; const f = h?.first ?? ''; return `${h?.name ?? s}${f && !(h?.name ?? '').toLowerCase().includes(f.toLowerCase()) ? ` (${f})` : ''} · ${h?.en.specialty ?? ''}`; };
    const t: Record<string, string> = JSON.parse(root.dataset.copy || '{}');
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const fill = (s: string, email: string) => s.replace('{email}', email);
    const signin = $<HTMLFormElement>('[data-ha-signin]');
    // ?demo=calendar: the Calendar tab with made-up data, no sign-in, no saves (startDemo).
    // ?demo=site&host=<slug>: that host's real dates from the site's own data, nothing saved.
    const DEMO = ['calendar', 'site', 'addr'].includes(new URLSearchParams(location.search).get('demo') ?? '');

    if (!cfg.ready) {
      // Accounts open once Firebase is set up; until then, say so.
      const p = $('[data-ha-soon]');
      p.textContent = fill(t.soon, cfg.contact);
      p.hidden = false;
    } else {
      const app0 = initializeApp(cfg.firebase);
      const auth = getAuth(app0);
      const db = getFirestore(app0);
      const STORE = 'twiggli-host-signin-email';

      const app = $('[data-ha-app]');
      const editor = $('[data-ha-editor]');
      const pick = $<HTMLSelectElement>('[data-ha-pick]');
      const pageForm = $<HTMLFormElement>('form[data-ha-panel="listings"]');
      const slotForm = $<HTMLFormElement>('form[data-ha-panel="calendar"]');
      const slotsBox = $('[data-ha-slots]');
      const tpl = $<HTMLTemplateElement>('[data-ha-slot-tpl]');
      let email = '';
      let slug = '';
      // Twiggli's service fee in percent (hostMembers.commissionPct, else 15), shown to hosts as a line.
      let feePct = 15;
      const keep = (n: number) => n * (1 - feePct / 100);
      // Saved texts per language for the current host (from Firestore, else the site).
      let texts: Record<'en' | 'de', Profile> = { en: {}, de: {} };
      let textLang: 'en' | 'de' = 'en';

      const note = (form: HTMLElement, msg: string, ok = true) => {
        const p = form.querySelector<HTMLElement>('.ha-save .ha-note, [data-ha-signin-note]');
        if (p) { p.textContent = msg; p.dataset.ok = String(ok); }
      };
      const remember = (v: string) => { try { localStorage.setItem(STORE, v); } catch { /* private mode */ } };
      const recall = () => { try { return localStorage.getItem(STORE) ?? ''; } catch { return ''; } };

      // ── Signing in: a 6-digit code by email (functions signinCode /
      //    signinVerify), no password. The email also carries Firebase's
      //    own sign-in link, which finishSignIn below still handles. ──
      // The welcome moment shows once, on the load right after signing in.
      const WELCOME = 'twiggli-host-welcome';
      const welcomeNext = () => { try { sessionStorage.setItem(WELCOME, '1'); } catch { /* private mode */ } };
      const showWelcome = (u: { displayName?: string | null; photoURL?: string | null; email?: string | null } | null) => {
        let due = false;
        try { due = sessionStorage.getItem(WELCOME) === '1'; sessionStorage.removeItem(WELCOME); } catch { /* private mode */ }
        if (!due || !u) return;
        const box = $('[data-ha-welcome]');
        const name = (u.displayName || '').trim() || (u.email || '').split('@')[0];
        const av = $('[data-ha-welcome-avatar]');
        if (u.photoURL) { const img = document.createElement('img'); img.src = u.photoURL; img.alt = ''; img.referrerPolicy = 'no-referrer'; av.append(img); }
        else av.textContent = (name[0] || '🙂').toUpperCase();
        $('[data-ha-welcome-name]').textContent = name;
        box.hidden = false;
        setTimeout(() => { box.classList.add('is-out'); setTimeout(() => { box.hidden = true; }, 450); }, 1600); // ~2 s in all (Jirel 14.11.26)
      };
      const codeForm = $<HTMLFormElement>('[data-ha-code]');
      const boxes = [...codeForm.querySelectorAll<HTMLInputElement>('[data-ha-code-boxes] input')];
      const codeNote = $('[data-ha-code-note]');
      const resend = $<HTMLButtonElement>('[data-ha-code-resend]');
      const resendLabel = resend.textContent ?? '';
      let codeTo = '';
      let timer = 0;
