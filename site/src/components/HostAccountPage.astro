  .cal-ws-x { position: absolute; right: 4px; top: 4px; width: 22px; height: 22px; display: grid; place-items: center; border-radius: 50%; background: rgba(20, 16, 30, .72); color: #fff; font-size: .72rem; line-height: 1; cursor: pointer; }
  .cal-ws-x:hover { background: #d93025; }
  .cal-ws-n { position: absolute; left: 4px; top: 4px; padding: 1px 7px; border-radius: 999px; background: #6a3eec; color: #fff; font-size: 0.7rem; font-weight: 600; }
  .ha-vid-bar { display: block; width: 100%; max-width: 280px; height: 6px; margin-top: 6px; border: 0; border-radius: 99px; overflow: hidden; background: #ece6dc; accent-color: var(--color-accent); appearance: none; }
  .ha-vid-bar::-webkit-progress-bar { background: #ece6dc; border-radius: 99px; }
