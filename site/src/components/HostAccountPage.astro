          else card.append(el('span', 'hd-ph', m ? '▶' : hdEmoji()));
          const d = new Date(`${ev.date}T12:00:00`).toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short' });
          const txt = el('div', 'hd-ev-t');
          txt.append(el('b', '', ev.title), el('span', '', [`${d} · ${ev.start}${ev.end ? `–${ev.end}` : ''}`, repeatText[ev.repeat ?? ''] ?? '', ev.seats ? t.seatsN.replace('{n}', String(ev.seats)) : '', ev.minGuests ? t.runsFromN.replace('{n}', String(ev.minGuests)) : '', ev.price ? `€${ev.price}` : ''].filter(Boolean).join(' · ')));
          const acts = el('div', 'hd-ev-acts');
          const edit = el('button', 'ha-link', t.editDate) as HTMLButtonElement; edit.type = 'button';
          edit.addEventListener('click', () => openCreate(ev));
          const del = el('button', 'ha-link', t.deleteDate) as HTMLButtonElement; del.type = 'button';
          del.addEventListener('click', async () => {
            if (!window.confirm(t.confirmDelete)) return;
            try { await api('hostEventDelete', { id: ev.id }); await loadInbox(); } catch { /* shown on next load */ }
          });
          acts.append(edit, del);
          card.append(txt, acts);
          return card;
        }));
        $('[data-ha-own-empty]').hidden = ownEvents.length > 0;
      };

      /** Asks for a page (functions/index.js hostClaim): 'granted' for
       *  admins, 'pending' for everyone else until Jirel approves. */
      const claim = async (s: string, name: string, note: string, invite = ''): Promise<string> => {
        const token = await auth.currentUser?.getIdToken();
        const res = await fetch(`${cfg.functions}/hostClaim`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ slug: s, name, note, ...(invite ? { invite } : {}) }),
        });
        if (!res.ok) throw new Error(String(res.status));
        return (await res.json()).status;
      };
      const claimForm = $<HTMLFormElement>('[data-ha-claim]');
      claimForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = new FormData(claimForm);
        const btn = claimForm.querySelector<HTMLButtonElement>('button')!;
        btn.disabled = true; btn.textContent = t.saving;
        try {
          await claim(String(f.get('slug')), String(f.get('name') ?? ''), String(f.get('note') ?? ''));
          claimForm.querySelectorAll('label').forEach((l) => { l.hidden = true; });
          btn.hidden = true;
          note(claimForm, t.claimSent, true);
        } catch {
          btn.disabled = false; btn.textContent = t.claimSend;
          note(claimForm, fill(t.error, cfg.contact), false);
        }
      });

      const start = async (user: { email: string | null } | null) => {
        if (!user?.email) { signin.hidden = false; return; }
        email = user.email.toLowerCase();
        signin.hidden = true;
        app.hidden = false;
        $('[data-ha-who]').textContent = fill(t.signedInAs, email);
        root.classList.add('is-in');
        rememberSignedIn(true);
        const invited = pendingInvite();
        if (invited) {
          try { await claim(invited.slug, '', '', invited.invite); } catch { /* bad or used link: the claim form is still there */ }
          try { localStorage.removeItem(INVITE); } catch { /* private mode */ }
          history.replaceState(null, '', location.pathname);
        }
        let slugs: string[] = [];
        try {
          const m = await getDoc(doc(db, 'hostMembers', email));
          slugs = ((m.data()?.slugs as string[] | undefined) ?? []).filter((s) => hosts[s]);
          const pct = Number(m.data()?.commissionPct);
          if (Number.isFinite(pct)) feePct = Math.max(0, Math.min(30, pct));
        } catch { /* not a member: no read access */ }
        // Whether this is Jirel: the server says, so no address is in the page.
        let admin = false;
        try {
          const token = await auth.currentUser?.getIdToken();
          const r = await fetch(`${cfg.functions}/hostClaim`, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify({ whoami: true }) });
          admin = !!(await r.json()).admin;
        } catch { admin = false; }
        if (admin) {
          // Jirel: every host in the picker; opening one asks the server to
          // add it to her hostMembers first, so the rules let her save.
          const all = Object.keys(hosts).sort((a, b) => hosts[a].name.localeCompare(hosts[b].name));
          pick.replaceChildren(...all.map((s) => new Option(`${hosts[s].name} · ${hosts[s].en.specialty}`, s)));
          $('[data-ha-pick-wrap] span').textContent = t.adminPick;
          pick.addEventListener('change', async () => {
            if (!slugs.includes(pick.value) && (await claim(pick.value, '', '')) === 'granted') slugs.push(pick.value);
            openHost(pick.value);
          });
          $('[data-ha-pick-wrap]').hidden = false;
          const first = slugs[0] ?? all.find((s) => s === 'test-jirel') ?? all[0];
          pick.value = first;
          if (!slugs.includes(first) && (await claim(first, '', '')) === 'granted') slugs.push(first);
          await openHost(first);
          return;
        }
        if (!slugs.length) {
          // A host we already know by email (functions/hostEmails.json) gets
          // their page straight away.
          try {
            const r = await api('hostClaim', { auto: true });
            slugs = ((r.slugs as string[] | undefined) ?? []).filter((x) => hosts[x]);
          } catch { /* not a known host */ }
        }
        if (!slugs.length) {
          $('[data-ha-notyet]').hidden = false;
          claimForm.hidden = false;
          return;
        }
        if (slugs.length > 1) {
          pick.replaceChildren(...slugs.map((s) => new Option(`${hosts[s].name} · ${hosts[s].en.specialty}`, s)));
          pick.addEventListener('change', () => openHost(pick.value));
          $('[data-ha-pick-wrap]').hidden = false;
        }
        await openHost(slugs[0]);
      };

      finishSignIn().finally(() => {
        let once = false;
        onAuthStateChanged(auth, (user) => { if (!once) { once = true; start(user); } });
      });
    }
  }
</script>

