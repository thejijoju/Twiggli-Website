  .nt-when { font-size: 0.78rem; color: #9a9da6; }
  @media (max-width: 560px) { .nt { position: fixed; left: 16px; right: 16px; top: 64px; width: auto; } }
  /* ── Calendar: one calendar per workshop (Jirel 18.11.26) ── */
  /* The calendar needs room: the account is wider while it is open. */
  .ha.is-in:has([data-cal-panel]:not([hidden])) { max-width: 1240px; }
  .cal, .pw-dlg { --cal-line: #e6dff2; --cal-grad: linear-gradient(90deg, #fd6f31, #f4c424, #7f14a0); }
  .cal button { font-family: inherit; color: inherit; cursor: pointer; }
