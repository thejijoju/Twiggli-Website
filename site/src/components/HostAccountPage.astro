  /* ── The dashboard: a full-screen app (bare layout), Luma's structure in
     Twiggli colours. A soft purple-to-light-yellow wash at the top, cards
     with a shadow underneath only. ── */
  body.is-bare { background: #fdf9f3; }
  /* Desktop: flat cream, the purple-to-yellow wash only across the top (as
     in the mockup). Phones keep the softer all-over tint. */
  @media (min-width: 761px) {
    html:has(body.is-bare) { background: linear-gradient(180deg, var(--ha-w1), var(--ha-w2) 150px, var(--ha-base) 260px) no-repeat, var(--ha-base) !important; }
    body.is-bare, body.is-bare .page { background: transparent !important; background-image: none !important; }
    body.is-bare::before { display: none; }
  }
  body.is-bare::before {
    content: ''; position: fixed; inset: 0 0 auto 0; height: 300px; z-index: -1; pointer-events: none;
    background: linear-gradient(180deg, var(--ha-w1), var(--ha-w2) 60%, rgba(253, 249, 243, 0));
  }
  /* Times of day. Day is the original purple-to-yellow. */
  html { --ha-w1: rgba(106, 62, 236, 0.16); --ha-w2: rgba(255, 201, 77, 0.09); --ha-base: #fdf8f2; }
  html[data-daypart='dawn'] { --ha-w1: rgba(255, 150, 130, 0.26); --ha-w2: rgba(150, 190, 255, 0.12); --ha-base: #fdf8f4; }
  html[data-daypart='dusk'] { --ha-w1: rgba(255, 120, 80, 0.24); --ha-w2: rgba(230, 74, 180, 0.12); --ha-base: #fdf7f4; }
  html[data-daypart='night'] { --ha-w1: rgba(60, 100, 220, 0.30); --ha-w2: rgba(130, 160, 240, 0.14); --ha-base: #f6f7fc; }
  html[data-daypart='late'] { --ha-w1: rgba(14, 22, 70, 0.92); --ha-w2: rgba(40, 60, 150, 0.30); --ha-base: #f3f4fa; }
  /* Late at night: a few soft stars in the dark band, twinkling slowly. */
  html[data-daypart='late'] body.is-bare::after {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 170px; z-index: -1; pointer-events: none;
    background-image:
      radial-gradient(1.9px 1.9px at 12% 22%, #fff3c4, transparent), radial-gradient(1.6px 1.6px at 27% 58%, #fff3c4, transparent),
      radial-gradient(2.1px 2.1px at 41% 14%, #fff3c4, transparent), radial-gradient(1.6px 1.6px at 55% 46%, #fff3c4, transparent),
      radial-gradient(1.9px 1.9px at 68% 20%, #fff3c4, transparent), radial-gradient(1.6px 1.6px at 79% 62%, #fff3c4, transparent),
      radial-gradient(2.3px 2.3px at 90% 28%, #fff3c4, transparent), radial-gradient(1.6px 1.6px at 6% 70%, #fff3c4, transparent),
      radial-gradient(1.6px 1.6px at 34% 36%, #fff3c4, transparent), radial-gradient(1.9px 1.9px at 61% 72%, #fff3c4, transparent);
    -webkit-mask-image: linear-gradient(#000 40%, transparent); mask-image: linear-gradient(#000 40%, transparent);
    animation: ha-twinkle 4s ease-in-out infinite alternate;
  }
  @keyframes ha-twinkle { from { opacity: .6; } to { opacity: 1; } }
  html[data-daypart='late'] body.is-bare::after { filter: drop-shadow(0 0 2px rgba(255, 236, 170, 0.7)); }
  @media (prefers-reduced-motion: reduce) { html[data-daypart='late'] body.is-bare::after { animation: none; } }
  /* On the dark band the top bar turns light. */
  html[data-daypart='late'] .ha-tabs button, html[data-daypart='late'] .ha .hd-bell { color: rgba(255, 255, 255, 0.72); }
  html[data-daypart='late'] .ha-tabs button[aria-selected='true'], html[data-daypart='late'] .ha .ha-tabs button:hover, html[data-daypart='late'] .ha .hd-bell:hover { color: #fff; }
  html[data-daypart='late'] .ha-top-signin { color: #fff; }
