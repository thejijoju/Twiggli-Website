      const pageFor = (l: string) => `${l === 'en' ? '' : `/${l}`}/host/account/`;
      const fetchDoc = async (l: string) => new DOMParser().parseFromString(await (await fetch(pageFor(l), { cache: 'force-cache' })).text(), 'text/html');
      const ATTRS = ['placeholder', 'aria-label', 'title', 'alt'];
