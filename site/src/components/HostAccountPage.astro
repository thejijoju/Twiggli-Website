  .cal-mnav { display: flex; gap: 4px; }
  .cal-mnav button { width: 28px; height: 28px; font-size: 0.95rem; }
  .cal-sp { flex: 1; }
  .cal-seg { display: flex; gap: 6px; }
  .cal-seg button { padding: 7px 14px; border-radius: 999px; border: 1.5px solid var(--cal-line); background: #fff; font-size: 0.85rem; font-weight: 600; }
  .cal-seg button[aria-pressed='true'] { border-color: #6a3eec; color: #6a3eec; background: #f3eeff; }
  .cal-btn { padding: 8px 18px; border-radius: 999px; font-weight: 600; font-size: 0.88rem; border: 2px solid transparent; background: linear-gradient(#fff, #fff) padding-box, var(--cal-grad) border-box; white-space: nowrap; transition: transform .15s ease; }
  .cal-btn:hover { transform: translateY(-1px); }
  .cal-btn2 { padding: 8px 18px; border-radius: 999px; font-weight: 600; font-size: 0.88rem; border: 1.5px solid var(--cal-line); background: #fff; white-space: nowrap; }
  .cal-btn2:hover { border-color: #c0392b; color: #c0392b; }
  .cal-wd, .cal-days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
  .cal-wd span { font-size: 0.75rem; color: var(--color-text-muted); text-align: center; padding-bottom: 4px; text-transform: capitalize; }
  .cal-day { min-height: 86px; border-radius: 12px; background: #fbf9fe; padding: 6px; display: flex; flex-direction: column; gap: 4px; min-width: 0; box-sizing: border-box; }
