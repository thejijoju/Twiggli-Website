          const mk = (label: string) => { const b = el('button', 'ib-act', label) as HTMLButtonElement; b.type = 'button'; return b; };
          const bAccept = mk(t.ib.accept); const bOffer = mk(t.ib.offer); const bDecline = mk(t.ib.decline);
          const all = [bAccept, bOffer, bDecline];
          // Accepting asks once more, in its own popup on top, with what it means.
          bAccept.addEventListener('click', () => {
            const dlg = $<HTMLDialogElement>('[data-ib-decline]');
            const body = dlg.querySelector<HTMLElement>('[data-ib-decline-body]')!;
            const sumUp = el('div', 'ib-confirm-sum');
            sumUp.append(el('span', '', [fmtDay(dateOf(r)), r.fields.Time].filter(Boolean).join(', ')),
              el('span', '', ppl === 1 ? t.ib.guest1 : say(t.ib.guests, { n: String(ppl) })),
              ...(each ? [el('b', '', say(t.ib.acEarn, { amt: `€ ${keep(each * ppl).toLocaleString(loc, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` }))] : []));
            const yes = mk(t.ib.acYes); yes.classList.add('ib-act-main', 'ib-act-grad');
            yes.addEventListener('click', () => { dlg.close(); void send(r, 'accept', {}, rnote, all); });
            const no = mk(t.ib.acNo); no.addEventListener('click', () => dlg.close());
            const btns = el('div', 'ib-confirm-acts'); btns.append(yes, no);
            body.classList.add('is-confirm');
            dlg.addEventListener('close', () => body.classList.remove('is-confirm'), { once: true });
            body.replaceChildren(el('h2', 'ib-offer-h', say(t.ib.acTitle, { name })), el('p', 'ib-hint', say(t.ib.acNote, { name })), sumUp, btns);
            dlg.showModal();
