          : /brandenburg|potsdam|cottbus|oranienburg|bernau|falkensee|königs wusterhausen|eberswalde|frankfurt \(oder\)/i.test(place) ? 'Brandenburg'
          : place.split(',').pop()?.trim().replace(/^\d{5}\s*/, '') ?? '';
        $('[data-ha-prof-city]').textContent = city ? `${de ? 'Studio-Standort' : 'Studio location'}: ${city}` : '';
        $('[data-ha-prof-cityrow]').hidden = !city;
        $('[data-ha-prof-cam]').hidden = false;
        paintStats();
        void loadStats();
        $<HTMLAnchorElement>('[data-ha-view]').hidden = !h;
        const list = $('[data-ha-prof-list]');
        list.replaceChildren(...ws.map((w) => {
          const a = document.createElement('a');
          a.className = 'hd-prof-card'; a.href = w.url; a.target = '_blank'; a.rel = 'noopener';
          if (w.image) { const img = document.createElement('img'); img.src = w.image; img.alt = ''; img.loading = 'lazy'; a.append(img); }
          const t = document.createElement('span'); t.className = 'hd-prof-card-t'; t.textContent = w.title;
          const m = document.createElement('span'); m.className = 'hd-prof-card-m';
          m.textContent = [w.price, w.dates ? `${w.dates} ${de ? (w.dates === 1 ? 'Termin' : 'Termine') : (w.dates === 1 ? 'date' : 'dates')}` : ''].filter(Boolean).join(' · ');
          a.append(t, m);
          return a;
        }));
        $('[data-ha-prof-empty]').hidden = ws.length > 0;
      };
      // Changing the profile photo (Jirel 14.11.26): resized in the browser to
      // a small square JPEG, saved by the server (functions profilePhoto) and
      // set as the account's photo.
      const shrink = (f: File) => new Promise<string>((ok, bad) => {
        const img = new Image();
        img.onload = () => {
          const side = Math.min(img.width, img.height), out = 512;
          const c = document.createElement('canvas'); c.width = out; c.height = out;
          c.getContext('2d')!.drawImage(img, (img.width - side) / 2, (img.height - side) / 2, side, side, 0, 0, out, out);
          URL.revokeObjectURL(img.src);
          ok(c.toDataURL('image/jpeg', 0.86));
        };
        img.onerror = () => bad(new Error('image'));
        img.src = URL.createObjectURL(f);
      });
      $<HTMLInputElement>('[data-ha-prof-file]').addEventListener('change', async (e) => {
        const input = e.target as HTMLInputElement;
        const f = input.files?.[0];
        const de = document.documentElement.lang !== 'en';
        const note = $('[data-ha-prof-note]');
        if (!f || !auth.currentUser) return;
        note.textContent = de ? 'Wird hochgeladen …' : 'Uploading …';
        try {
          await api('profilePhoto', { image: await shrink(f) });
          await auth.currentUser.reload();
          note.textContent = '';
          paintAvatars(); renderProfile();
        } catch (err) {
          note.textContent = `${de ? 'Das hat nicht geklappt' : 'That didn’t work'} (${(err as Error).message})`;
        }
        input.value = '';
      });
      const hdEmoji = () => { try { return localStorage.getItem(`${EMOJI_KEY}:${email}`) || '🙂'; } catch { return '🙂'; } };
      root.querySelectorAll<HTMLButtonElement>('[data-ha-emojis] button').forEach((b) => b.addEventListener('click', () => {
        try { localStorage.setItem(`${EMOJI_KEY}:${email}`, b.textContent || '🙂'); } catch { /* private mode */ }
        paintAvatars();
        menu.hidden = true;
      }));

      // ── Page text ──
      const showText = () => {
        for (const [k, v] of Object.entries(texts[textLang])) {
          const el = pageForm.elements.namedItem(k) as HTMLInputElement | HTMLTextAreaElement | null;
          if (el) el.value = v ?? '';
        }
      };
      const readText = (): Profile => {
        const out: Profile = {};
        for (const k of Object.keys(hosts[slug].en)) {
          out[k] = ((pageForm.elements.namedItem(k) as HTMLInputElement | null)?.value ?? '').trim();
        }
        return out;
      };
      pageForm.querySelectorAll<HTMLInputElement>('input[name="textlang"]').forEach((r) => {
        r.addEventListener('change', () => {
          texts[textLang] = readText(); // keep what was typed when switching
          textLang = r.value as 'en' | 'de';
          showText();
        });
      });
      pageForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        texts[textLang] = readText();
        const btn = pageForm.querySelector<HTMLButtonElement>('.ha-save button')!;
        btn.disabled = true; btn.textContent = t.saving;
        let ok = true;
        try {
          await setDoc(doc(db, 'hostProfiles', `${slug}_${textLang}`), {
            slug, lang: textLang, ...texts[textLang], updated_at: new Date().toISOString(), updated_by: email,
          });
        } catch { ok = false; }
        btn.disabled = false; btn.textContent = t.save;
        note(pageForm, ok ? t.saved : fill(t.error, cfg.contact), ok);
        if (ok) tellUs(`page text (${textLang})`);
      });

      // ── Weekly schedule ──
      const addSlot = (s?: Slot) => {
        const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const q = <T extends HTMLInputElement>(n: string) => node.querySelector<T>(`[name="${n}"]`)!;
        if (s) {
          q('title').value = s.title;
          q('time').value = s.time;
          q('duration').value = s.duration ?? '';
          q('price').value = s.price ? String(s.price) : '';
          node.querySelectorAll<HTMLInputElement>('[name="day"]').forEach((d) => { d.checked = s.weekdays.includes(d.value); });
        } else {
          q('title').value = hosts[slug]?.en.specialty ?? '';
        }
        node.querySelector('[data-ha-remove]')!.addEventListener('click', () => { node.remove(); emptyHint(); });
        slotsBox.append(node);
        emptyHint();
      };
      const emptyHint = () => { $('[data-ha-noslots]').hidden = slotsBox.children.length > 0; };
      $('[data-ha-addslot]').addEventListener('click', () => addSlot());
      slotForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const rows = Array.from(slotsBox.querySelectorAll<HTMLElement>('.ha-slot')).map((n) => {
          const v = (k: string) => n.querySelector<HTMLInputElement>(`[name="${k}"]`)!.value.trim();
          return {
            slug,
            title: v('title'),
            weekdays: Array.from(n.querySelectorAll<HTMLInputElement>('[name="day"]:checked')).map((d) => d.value),
            time: v('time').slice(0, 5),
            duration: v('duration') || null,
            price: v('price') ? Math.round(Number(v('price'))) : null,
            active: true,
          };
        });
        const bad = rows.find((r) => !r.title || !r.weekdays.length || !/^\d\d:\d\d$/.test(r.time));
        if (bad) { note(slotForm, fill(t.error, cfg.contact), false); return; }
        const btn = slotForm.querySelector<HTMLButtonElement>('.ha-save button')!;
        btn.disabled = true; btn.textContent = t.saving;
        // Replace the whole schedule in one go: delete what was there, add what is here.
        let ok = true;
        try {
          const old = await getDocs(query(collection(db, 'hostSlots'), where('slug', '==', slug)));
          const batch = writeBatch(db);
          old.forEach((d) => batch.delete(d.ref));
          for (const r of rows) batch.set(doc(collection(db, 'hostSlots')), r);
          await batch.commit();
        } catch { ok = false; }
        btn.disabled = false; btn.textContent = t.save;
        note(slotForm, ok ? t.saved : fill(t.error, cfg.contact), ok);
        if (ok) tellUs('weekly schedule');
      });

      /** A note to our inbox, so Jirel sees every change a host makes. */
      const tellUs = (what: string) => {
        fetch(formEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            Type: 'Host account edit', Host: slug, Changed: what, By: email,
            _subject: `Host account edit: ${hosts[slug]?.name ?? slug} (${what})`, _template: 'table', _captcha: 'false',
          }),
        }).catch(() => {});
      };

      // ── Loading a host ──
      const openHost = async (s: string) => {
        slug = s;
        const h = hosts[s];
        $<HTMLAnchorElement>('[data-ha-view]').href = h?.page ?? '#';
        // Settings → "Your page": the full address to share, with a copy button.
        const full = h?.page ? new URL(h.page, location.origin).href : '';
        $<HTMLAnchorElement>('[data-hs-page-url]').href = full;
        $('[data-hs-page-url]').textContent = full.replace(/^https?:\/\//, '');
        $('[data-hs-page]').hidden = !full;
        const [prof, slotSnap] = await Promise.all([
          getDocs(query(collection(db, 'hostProfiles'), where('slug', '==', s))),
          getDocs(query(collection(db, 'hostSlots'), where('slug', '==', s))),
        ]);
        const rows = prof.docs.map((d) => d.data() as Profile);
        const saved = (l: 'en' | 'de') => {
          const row = rows.find((p) => p.lang === l);
          const base = { ...(h?.[l] ?? {}) };
          if (row) for (const k of Object.keys(base)) if (row[k]) base[k] = row[k];
          return base;
        };
        texts = { en: saved('en'), de: saved('de') };
        fillStudio();
        showText();
        slotsBox.replaceChildren();
        const slots = slotSnap.docs.map((d) => d.data() as Slot & { active?: boolean })
          .filter((x) => x.active !== false)
          .sort((a, b) => a.time.localeCompare(b.time));
        for (const sl of (slots.length ? slots : h?.slots ?? [])) addSlot(sl);
        emptyHint();
        editor.hidden = false;
        $('[data-ha-tabs]').hidden = false;
        root.querySelectorAll<HTMLElement>('[data-ha-hostonly]').forEach((x) => { x.hidden = false; });
        const first = (auth.currentUser?.displayName || '').split(' ')[0] || (h?.name ?? '').split(' ')[0];
        $('[data-ha-hello]').textContent = `${t.hello} ${first} 👋`;
        studioKnown = false;
        void paintDraft(s);
        void calLoadListings();
        paintAvatars();
        if (!auth.currentUser?.displayName && h?.name) $('[data-ha-menu-name]').textContent = h.name;
        loadInbox();
        void loadStripe().then(() => {
          // Back from Stripe's onboarding: say how it went, then tidy the address.
          const q = new URLSearchParams(location.search);
          const back = q.get('stripe');
          const why = (q.get('why') || '').slice(0, 160);
          if (!back) return;
          history.replaceState(null, '', location.pathname);
          if (back === 'return' || back === 'linked') alert(stripeReady ? (back === 'linked' ? `${t.stripeLinked} ${t.stripeDone}` : t.stripeDone) : t.stripePending);
          else if (back === 'failed') alert(why ? `${t.stripeFail}\n\nStripe: ${why}` : t.stripeFail);
        });
      };

      // ── Tips for the page (Jirel 19.11.26) ──────────────────────────────
      // What the dashboard notices about the host's page, each said where it
      // is fixed, with a button that opens that place. Only what the host can
      // change (never the commission). A dismissed tip stays away until its
      // level rises (a third small photo after two) or it comes back after
      // being fixed; fixed tips leave by themselves. Dismissed tips and
      // Jirel's notes live server-side (functions hostTips); localStorage is
      // the fallback when that can't be reached (and in the demos).
      type Tip = { id: string; level: number; title: string; body: string; soft?: boolean; note?: boolean;
        fix?: { label: string; run: () => void }; link?: { label: string; href: string } };
      type TipNote = { id: string; text: string; at: number };
      const TL = (de: string, en: string, fr: string) => (document.documentElement.lang === 'de' ? de : document.documentElement.lang === 'fr' ? fr : en);
      // ── Beta note and Twiggli Support (Jirel 20.11.26) ──────────────────
      type SpMsg = { id: string; from: string; text: string; kind?: string; shot?: string; files?: { url: string; name: string; type: string }[]; where?: string; device?: string; at: number };
      let spKind = '';
      let spFiles: { url: string; name: string; type: string }[] = [];
      const spDevice = () => { const ua = navigator.userAgent; return /iPhone|iPad/.test(ua) ? 'iPhone/iPad' : /Android/.test(ua) ? 'Android' : /Mac OS/.test(ua) ? 'Mac' : /Windows/.test(ua) ? 'Windows' : 'Browser'; };
      const SP_KIND: Record<string, string> = { bug: '🐞', idea: '💡', question: '❓' };
      const spTabName = (w: string) => ({ overview: TL('Übersicht', 'Overview', 'Aperçu'), calendar: TL('Kalender', 'Calendar', 'Calendrier'), listings: TL('Angebote', 'Listings', 'Offres'), settings: TL('Einstellungen', 'Settings', 'Réglages'), profile: TL('Profil', 'Profile', 'Profil') } as Record<string, string>)[w] || w;
      const spRender = (msgs: SpMsg[]) => {
        const box = $('[data-sp-msgs]');
        box.querySelectorAll('.sp-b:not(:first-child)').forEach((n) => n.remove());
        for (const m of msgs) {
          const b = el('div', `sp-b ${m.from === 'host' ? 'sp-me' : 'sp-them'}`);
          if (m.kind && SP_KIND[m.kind]) b.append(el('span', 'sp-kind', `${SP_KIND[m.kind]} `));
          if (m.text) b.append(el('span', '', m.text));
          const fs = m.files?.length ? m.files : m.shot ? [{ url: m.shot, name: 'Screenshot', type: 'image/' }] : [];
          for (const f of fs) {
            const a = el('a', f.type.startsWith('image/') ? 'sp-shot' : 'sp-doc') as HTMLAnchorElement; a.href = f.url; a.target = '_blank'; a.rel = 'noopener';
            if (f.type.startsWith('image/')) { const im = el('img') as HTMLImageElement; im.src = f.url; im.alt = f.name; a.append(im); } else a.textContent = `📄 ${f.name}`;
            b.append(a);
          }
          const meta = [m.from === 'host' && m.where ? `${TL('Gesendet von', 'Sent from', 'Envoyé depuis')}: ${spTabName(m.where)}` : '', m.from === 'host' ? m.device : '', new Date(m.at).toLocaleString(document.documentElement.lang || 'en', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })].filter(Boolean).join(' · ');
          b.append(el('div', 'sp-meta', meta));
          box.append(b);
        }
        box.scrollTop = box.scrollHeight;
      };
      const spLoad = async () => {
        if (!slug || DEMO) return;
        try { const r = await api('hostSupport', { slug, action: 'list' }); spRender((r.msgs ?? []) as SpMsg[]); } catch { /* the welcome stays */ }
      };
      const spOpen = (open = true) => {
        $('[data-sp-body]').hidden = !open;
        $('[data-sp-toggle]').setAttribute('aria-expanded', String(open));
        if (open) { void spLoad(); $<HTMLTextAreaElement>('[data-sp-form] textarea').focus({ preventScroll: true }); }
      };
      $('[data-sp-toggle]').addEventListener('click', () => spOpen($('[data-sp-body]').hidden));
      root.querySelectorAll<HTMLButtonElement>('[data-sp-kind]').forEach((b) => b.addEventListener('click', () => {
        spKind = spKind === b.dataset.spKind ? '' : (b.dataset.spKind || '');
        root.querySelectorAll<HTMLButtonElement>('[data-sp-kind]').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.spKind === spKind)));
        $<HTMLTextAreaElement>('[data-sp-form] textarea').focus();
      }));
      $<HTMLInputElement>('[data-sp-file]').addEventListener('change', async (e) => {
        const list = Array.from((e.target as HTMLInputElement).files ?? []).slice(0, 5 - spFiles.length);
        const note = $('[data-sp-note]');
        if (!list.length || !slug) return;
        note.textContent = t.uploading;
        try {
          for (const f of list) {
            if (f.size > 15e6) throw new Error('big');
            const r = storageRef(getStorage(app0), `hostSupport/${slug}/${Date.now()}-${f.name.replace(/[^\w.-]/g, '_')}`);
            await uploadBytes(r, f, { contentType: f.type || 'application/octet-stream' });
            spFiles.push({ url: await getDownloadURL(r), name: f.name, type: f.type || 'application/octet-stream' });
          }
          note.textContent = `${TL('Angehängt', 'Attached', 'Joint')} ✓ ${spFiles.map((x) => x.name).join(', ')}`;
        } catch { note.textContent = TL('Die Datei konnte nicht hochgeladen werden (max. 15 MB).', 'The file could not be uploaded (max 15 MB).', 'Le fichier n’a pas pu être envoyé (15 Mo max).'); }
        (e.target as HTMLInputElement).value = '';
      });
      $<HTMLFormElement>('[data-sp-form]').addEventListener('submit', async (e) => {
        e.preventDefault();
        const ta = $<HTMLTextAreaElement>('[data-sp-form] textarea');
        const note = $('[data-sp-note]');
        const text = ta.value.trim();
        if (!text && !spFiles.length) { ta.focus(); return; }
        if (DEMO) { note.textContent = TL('Demo: wird nicht gesendet.', 'Demo: not sent.', 'Démo : non envoyé.'); return; }
        note.textContent = '…';
        try {
          const r = await api('hostSupport', { slug, action: 'send', text, kind: spKind, files: spFiles, where: spWhere || 'messages', device: spDevice() });
          ta.value = ''; spFiles = []; spKind = '';
          root.querySelectorAll<HTMLButtonElement>('[data-sp-kind]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
          note.textContent = TL('Danke! Wir melden uns bald.', 'Thank you! We’ll get back to you soon.', 'Merci ! On revient vers toi vite.');
          spRender((r.msgs ?? []) as SpMsg[]);
        } catch { note.textContent = fill(t.uploadFail, cfg.contact); }
      });
      // The beta note on the Overview: until closed (per browser).
      const BT_KEY = 'twiggli-beta-note-closed';
      try { $('[data-bt]').hidden = localStorage.getItem(BT_KEY) === '1'; } catch { $('[data-bt]').hidden = false; }
      $('[data-bt-x]').addEventListener('click', () => { $('[data-bt]').hidden = true; try { localStorage.setItem(BT_KEY, '1'); } catch { /* private mode */ } });
      $('[data-bt-report]').addEventListener('click', () => {
        spWhere = 'overview';
        root.querySelector<HTMLButtonElement>('[data-ha-tab="messages"]')?.click();
        spOpen(true);
        $('[data-sp]').scrollIntoView({ block: 'start', behavior: 'smooth' });
      });
      const TT = {
        fixPhotos: TL('Fotos hochladen', 'Upload photos', 'Ajouter des photos'),
        fixEdit: TL('Workshop bearbeiten', 'Edit workshop', 'Modifier l’atelier'),
        fixStudio: TL('Adresse eintragen', 'Add address', 'Ajouter l’adresse'),
        fixStripe: TL('Stripe verbinden', 'Connect Stripe', 'Connecter Stripe'),
        fixDates: TL('Termin hinzufügen', 'Add a date', 'Ajouter une date'),
        fixVideo: TL('Video hinzufügen', 'Add a video', 'Ajouter une vidéo'),
        publish: TL('Meine Seite veröffentlichen', 'Publish my page', 'Publier ma page'),
        view: TL('Entwurf ansehen', 'View draft', 'Voir le brouillon'),
        dismiss: TL('Ausblenden', 'Dismiss', 'Masquer'),
        and: TL('und', 'and', 'et'),
      };
      const PUB = {
        pending: TL('Gesendet! Jirel schaut sich deine Seite an und gibt sie frei, meist innerhalb eines Tages. Du bekommst eine E-Mail, sobald sie live geht.', 'Sent! Jirel is having a look at your page and will approve it, usually within a day. You will get an email as soon as it goes live.', 'Envoyé ! Jirel regarde ta page et la valide, en général sous un jour. Tu reçois un e-mail dès qu’elle passe en ligne.'),
        approved: TL('Freigegeben! Deine Seite geht mit dem nächsten Update der Website live (spätestens morgen).', 'Approved! Your page goes live with the next website update (tomorrow at the latest).', 'Validée ! Ta page passe en ligne à la prochaine mise à jour du site (demain au plus tard).'),
        ask: TL('Seite jetzt zur Freigabe an Jirel schicken? Du kannst danach weiter alles bearbeiten.', 'Send your page to Jirel for approval now? You can keep editing everything afterwards.', 'Envoyer ta page à Jirel pour validation ? Tu pourras tout modifier ensuite.'),
        fail: TL('Das hat nicht geklappt. Versuch es bitte noch einmal oder schreib Jirel.', 'That did not work. Please try again or write to Jirel.', 'Ça n’a pas marché. Réessaie ou écris à Jirel.'),
      };
      const quoted = (x: string) => TL(`„${x}“`, `“${x}”`, `« ${x} »`);
      const listOf = (xs: string[]) => {
        const q = xs.slice(0, 3).map(quoted);
        const more = xs.length - q.length;
        if (more > 0) q.push(TL(`${more} weitere`, `${more} more`, `${more} autres`));
        return q.length > 1 ? `${q.slice(0, -1).join(', ')} ${TT.and} ${q[q.length - 1]}` : (q[0] ?? '');
      };
      let isAdmin = false;
      let draftStatus = 'draft'; // draft | pending | approved (functions hostPublish)
      let studioKnown = false; // the studio address was asked from the server
      let tipNotes: TipNote[] = [];
      let tipSeen: Record<string, number> = {};
      let tipsFor = '';
      let tipsOpen = false;
      const TIPS_LOCAL = (s: string) => `twiggli-tips-${s}`;
      const readLocalSeen = (s: string): Record<string, number> => { try { return JSON.parse(localStorage.getItem(TIPS_LOCAL(s)) || '{}'); } catch { return {}; } };
      const saveLocalSeen = () => { try { localStorage.setItem(TIPS_LOCAL(slug), JSON.stringify(tipSeen)); } catch { /* private window */ } };
      const loadTips = async (s: string) => {
        tipsFor = s;
        tipSeen = readLocalSeen(s);
        tipNotes = [];
        if (DEMO) {
          const n = new URLSearchParams(location.search).get('note');
          tipNotes = n ? [{ id: 'demo', text: n, at: Date.now() }] : [];
        } else {
          try {
            const r = await api('hostTips', { slug: s, action: 'get' });
            if (tipsFor !== s) return;
            tipSeen = { ...tipSeen, ...(r.dismissed ?? {}) };
            tipNotes = r.notes ?? [];
          } catch { /* the local copy stands in */ }
        }
        paintAdminNotes();
        scheduleTips();
      };
      // Photo sizes, measured in the browser (site pictures and uploads alike).
      const photoSize = new Map<string, [number, number] | null>();
      const measure = (url: string) => {
        if (photoSize.has(url)) return;
        photoSize.set(url, null);
        const img = new Image();
        img.addEventListener('load', () => { photoSize.set(url, [img.naturalWidth, img.naturalHeight]); scheduleTips(); });
        img.src = url;
      };
      const SMALL = 1000; // long side in px below which a photo looks blurry on a big screen
      const small = (url: string) => { const z = photoSize.get(url); return z && Math.max(z[0], z[1]) < SMALL ? z : null; };
      const ownPicture = (url: string) => !!url && (url.startsWith('/') || url.includes('firebasestorage') || url.includes('storage.googleapis'));
      const goStudio = () => {
        openView('settings');
        setPath();
        if (slug) studioForm.hidden = false;
        setTimeout(() => {
          studioForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
          sf('street').focus({ preventScroll: true });
        }, 60);
      };
      const goWs = (w?: Ws) => {
        showTab('calendar');
        if (w) { calSel = w.key; renderCal(); calEditWs(w); }
      };
      const checks = (): Tip[] => {
        const h = hosts[slug];
        if (!h) return [];
        const out: Tip[] = [];
        // Jirel's notes for this host.
        for (const n of tipNotes) out.push({ id: `note:${n.id}`, level: 1, note: true, title: TL('Notiz von Jirel', 'Note from Jirel', 'Note de Jirel'), body: n.text });
        // The page is still a hidden draft.
        if (h.draft && draftStatus !== 'approved') {
          out.push({
            id: 'draft', level: 1, title: TL('Deine Seite ist noch ein Entwurf', 'Your page is still a draft', 'Ta page est encore un brouillon'),
            body: draftStatus === 'pending' ? PUB.pending : TL('Nur wer den Link hat, sieht sie: Sie steht noch nicht in den Listen, in der Suche oder bei Google. Wenn Texte, Workshops, Preise und Termine passen, veröffentliche sie. Jirel schaut kurz drüber, dann geht sie live.', 'Only people with the link can see it: it is not in the listings, in search or on Google yet. When the texts, workshops, prices and dates are right, publish it. Jirel takes a quick look, then it goes live.', 'Seules les personnes qui ont le lien la voient : elle n’est pas encore dans les listes, la recherche ou sur Google. Quand textes, ateliers, prix et dates sont bons, publie-la. Jirel jette un œil, puis elle passe en ligne.'),
            ...(draftStatus === 'pending' ? {} : { fix: { label: TT.publish, run: () => { void publishPage(); } } }),
