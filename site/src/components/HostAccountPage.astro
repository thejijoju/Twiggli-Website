      let calListings: { slug: string; items: { key: string; title: string; status: string; image: string; price: string; edit: WsEdit | null }[] } = { slug: '', items: [] };
      let calDemo: { workshops: Ws[] | null } | null = null;
      // Site entries the host took over (hostEvents "replaced"), and the site's own dates as calendar dates.
      let calReplaced = new Set<string>();
