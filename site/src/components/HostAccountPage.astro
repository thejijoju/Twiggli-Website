---
/**
 * The host account (/host/account/, /de/host/account/), step 1: a host signs
 * in with an email link (Firebase Authentication, no password), then edits
 * their page text in English and German and their weekly schedule. Saves go
 * to Firestore (hostProfiles, hostSlots; who may edit which page is
 * hostMembers, see firestore.rules at the repo root). The
 * site is static: the next deploy fetches the edits and lays them over the
 * copy (hostEdits.ts), at the latest with the daily morning build.
 *
 * Vouchers and requests are announced as tabs and come next.
 */
import { hostLang } from '../data/hostLang';
import Base from '../layouts/Base.astro';
import { getHosts, isPreviewHost, getWorkshopReel } from '../data/content.ts';
import { hostAccountCopy } from '../data/hostAccount.ts';
import { berlinDistricts } from '../data/berlinPostcodes.ts';
import WhereFields from './WhereFields.astro';
import { firebaseConfig, firebaseReady, functionsBase } from '../data/firebase.ts';
import { contactEmail, requestEmail } from '../data/site.ts';
import liveData from '../data/live-workshops.json';
import { workshopsFor, onRequestFor } from '../data/seo.ts';
import { previewOnRequestFor, previewSessionsFor, slugify, DAYS_AHEAD } from '../data/sessions.ts';
import { hostDates } from '../data/hostDates.ts';
import { availabilityNotes } from '../data/availability.ts';
import { withHostSlots } from '../data/hostEdits.ts';
import { voucherHosts } from '../data/vouchers.ts';
import { writtenSpaces } from '../data/spaces.ts';
import { href, withBase, type Lang } from '../lib/url.ts';

/** view: the part of the account the address opens (settings/preferences …), see pages/host/account/[...view].astro. */
interface Props { lang: Lang; view?: string }
const { lang, view = '' } = Astro.props;
const t = hostAccountCopy(lang);
/** Notification settings (Jirel 16.11.26): per topic, by email and/or in the
 *  app, for hosting and for attending. lock: the email can't be switched off
 *  (things a booking depends on). Keys are stored in userSettings.notify. */
const NOTIFY: { group: [string, string, string]; hint: [string, string, string]; items: { key: string; t: [string, string, string]; d: [string, string, string]; lock?: boolean }[] }[] = [
  { group: ['Wenn du hostest', 'When you host', 'Quand tu organises'], hint: ['Für deine Workshops und Gäste.', 'For your workshops and guests.', 'Pour tes ateliers et tes participants.'], items: [
    { key: 'h_requests', t: ['Neue Anfragen', 'New requests', 'Nouvelles demandes'], d: ['Buchungs-, Gruppen- und Terminanfragen. Per E-Mail immer an, damit dir kein Gast verloren geht.', 'Booking, group and date requests. Email always on, so you never miss a guest.', 'Demandes de réservation, de groupe et de date. E-mail toujours activé, pour ne rater aucun participant.'], lock: true },
    { key: 'h_bookings', t: ['Buchungen & Zahlungen', 'Bookings & payments', 'Réservations & paiements'], d: ['Bezahlte Buchungen, Absagen und eingelöste Gutscheine.', 'Paid bookings, cancellations and redeemed vouchers.', 'Réservations payées, annulations et bons cadeaux utilisés.'], lock: true },
    { key: 'h_messages', t: ['Nachrichten von Gästen', 'Messages from guests', 'Messages des participants'], d: ['Wenn dir jemand eine Frage schreibt.', 'When someone sends you a question.', 'Quand quelqu’un t’envoie une question.'] },
    { key: 'h_reminders', t: ['Erinnerung an deine Termine', 'Reminders for your dates', 'Rappels de tes dates'], d: ['Am Vortag, mit der Gästeliste.', 'The day before, with the guest list.', 'La veille, avec la liste des participants.'] },
    { key: 'h_reviews', t: ['Neue Bewertungen', 'New reviews', 'Nouveaux avis'], d: ['Wenn eine Bewertung auf deiner Seite erscheint.', 'When a review appears on your page.', 'Quand un avis apparaît sur ta page.'] },
    { key: 'h_payouts', t: ['Auszahlungen', 'Payouts', 'Versements'], d: ['Wenn Geld auf dem Weg zu dir ist.', 'When money is on its way to you.', 'Quand de l’argent est en route vers toi.'] },
  ] },
  { group: ['Wenn du teilnimmst', 'When you attend', 'Quand tu participes'], hint: ['Für Workshops, die du selbst buchst.', 'For workshops you book yourself.', 'Pour les ateliers que tu réserves toi-même.'], items: [
    { key: 'g_booking', t: ['Buchungsbestätigungen', 'Booking confirmations', 'Confirmations de réservation'], d: ['Wenn ein Host deine Anfrage annimmt.', 'When a host accepts your request.', 'Quand un hôte accepte ta demande.'], lock: true },
    { key: 'g_changes', t: ['Änderungen & Absagen', 'Changes & cancellations', 'Changements & annulations'], d: ['Wenn sich Zeit oder Ort ändern oder ein Termin ausfällt.', 'When the time or place changes, or a date is cancelled.', 'Quand l’heure ou le lieu change, ou qu’une date est annulée.'], lock: true },
    { key: 'g_reminders', t: ['Erinnerungen', 'Reminders', 'Rappels'], d: ['Am Tag vor deinem Workshop.', 'The day before your workshop.', 'La veille de ton atelier.'] },
    { key: 'g_messages', t: ['Nachrichten von Hosts', 'Messages from hosts', 'Messages des hôtes'], d: ['Antworten auf deine Fragen.', 'Answers to your questions.', 'Réponses à tes questions.'] },
    { key: 'g_waitlist', t: ['Warteliste', 'Waiting list', 'Liste d’attente'], d: ['Wenn ein Platz frei wird oder ein neuer Termin dazukommt.', 'When a spot opens up or a new date is added.', 'Quand une place se libère ou qu’une nouvelle date est ajoutée.'] },
    { key: 'g_feedback', t: ['Wie war’s?', 'How was it?', 'C’était comment ?'], d: ['Eine kurze Frage nach deinem Workshop.', 'A short question after your workshop.', 'Une petite question après ton atelier.'] },
  ] },
  { group: ['Von Twiggli', 'From Twiggli', 'De Twiggli'], hint: ['Ab und zu, nie zu viel.', 'Now and then, never too much.', 'De temps en temps, jamais trop.'], items: [
    { key: 't_news', t: ['Tipps & Neuigkeiten', 'Tips & news', 'Conseils & nouveautés'], d: ['Ideen für mehr Buchungen und Neues auf Twiggli.', 'Ideas for more bookings and what’s new on Twiggli.', 'Des idées pour plus de réservations et les nouveautés de Twiggli.'] },
    { key: 't_ideas', t: ['Workshop-Ideen', 'Workshop ideas', 'Idées d’ateliers'], d: ['Neue Workshops und Gutscheine, die dir gefallen könnten.', 'New workshops and vouchers you might like.', 'De nouveaux ateliers et bons cadeaux qui pourraient te plaire.'] },
  ] },
];
const li = lang === 'de' ? 0 : lang === 'fr' ? 2 : 1;
/** German, English or French (Jirel 15.11.26: the account in the host's language). */
const L = <T,>(de: T, en: T, fr: T): T => (lang === 'de' ? de : lang === 'fr' ? fr : en);

/* What the site shows today for every host, so the form opens with it
   when the host has not saved anything yet. Public data anyway. */
const pick = (h: Record<string, unknown>) => ({
  specialty: h.specialty ?? '', studio: h.studio ?? '', blurb: h.blurb ?? '', group_size: h.group ?? '',
  duration: h.duration ?? '', place: h.place ?? '', languages: h.languages ?? '', price_note: h.priceNote ?? '',
});
const de = new Map(getHosts('de', { withPreview: true }).map((h) => [h.slug, h]));
/* The dates the public site shows for a host, from the site's own data, for
   the Calendar tab (Jirel 18.11.26): weekly classes (live-workshops.json
   "recurring") and dates they sent us (hostDates.ts) can be taken over and
   edited there (functions REPLACES); dates read from their own booking page
   (live-workshops.json "workshops", refreshed by the weekly scrape) are
   shown read-only. Places booked that we know of come from availability.ts. */
type SiteRow = { title: string; titleEn?: string; key?: string; time?: string; duration?: string; price?: string; spots?: number; district?: string; url?: string; request?: boolean };
const berlinToday = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Berlin' });
const lastDay = new Date(Date.parse(berlinToday) + (DAYS_AHEAD - 1) * 86400000).toISOString().slice(0, 10);
const feedRows = ((liveData as { workshops?: (SiteRow & { slug: string; date: string; soldOut?: boolean })[] }).workshops ?? []);
const inFeed = new Set(feedRows.map((w) => `${w.slug}|${w.date}|${w.time}`));
const pickRow = (r: SiteRow) => ({
  title: r.title, ...(r.titleEn ? { titleEn: r.titleEn } : {}), time: r.time ?? '', ...(r.duration ? { duration: r.duration } : {}),
  ...(r.price ? { price: r.price } : {}), ...(typeof r.spots === 'number' ? { spots: r.spots } : {}), ...(r.district ? { district: r.district } : {}),
  ...(r.url ? { url: r.url } : {}), ...(r.request ? { request: true } : {}),
});
const siteFor = (slug: string) => ({
  series: withHostSlots(recurring as (SiteRow & { slug: string; weekdays: string[]; time: string })[])
    .filter((r) => r.slug === slug)
    .map((r) => ({ key: `rec|${slug}|${r.key ?? slugify(r.title)}|${r.time}`, wkey: r.key ?? slugify(r.title), weekdays: r.weekdays, ...pickRow(r) })),
  dates: hostDates.filter((d) => d.slug === slug && d.date >= berlinToday && d.date <= lastDay && !inFeed.has(`${d.slug}|${d.date}|${d.time}`))
    .map((d) => ({ key: `date|${slug}|${d.date}|${d.time ?? ''}`, date: d.date, ...pickRow({ ...d, request: !d.onHostSite }) })),
  synced: feedRows.filter((w) => w.slug === slug && w.date >= berlinToday && w.date <= lastDay)
    .map((w) => ({ date: w.date, ...pickRow(w), ...(w.soldOut ? { soldOut: true } : {}) })),
  notes: Object.fromEntries(Object.entries(availabilityNotes).filter(([k]) => k.startsWith(`${slug}|`))
    .map(([k, v]) => [k.slice(slug.length + 1), v.booked ?? v.going ?? 0])),
});
const recurring = (liveData as { recurring?: { slug: string; title: string; weekdays: string[]; time: string; duration?: string; price?: string }[] }).recurring ?? [];
const hosts = Object.fromEntries(
  getHosts('en', { withPreview: true }).map((h) => [h.slug, {
    name: h.name,
    // The person behind a studio name, so Jirel finds "Diana" in the picker (RtmiS).
    first: (h as unknown as { firstName?: string }).firstName ?? '',
    // Takes Twiggli vouchers now (written yes or their own choice in Settings → Payment).
    voucher: voucherHosts.includes(h.slug),
    // The room they rent out as the "Raum mieten" page has it, to start the dashboard form from.
    space: (() => {
      const w = writtenSpaces.find((x) => x.slug === h.slug);
      if (!w) return null;
      const l = hostLang[h.slug] === 'en' ? 'en' : 'de';
      const p = Number((w.price?.en ?? '').match(/€\s?(\d+)/)?.[1]);
      return { name: w.name, district: w.district, capacity: w.capacity ?? null, size: typeof w.size === 'string' ? w.size : w.size?.[l] ?? '', price: Number.isFinite(p) && p > 0 ? p : null,
        // What their rate says beyond the hourly figure ("zzgl. MwSt."), kept when they save.
        priceNote: (w.price?.[l] ?? '').replace(/^\s*(\d+\s*€\s*pro Stunde|€\s?\d+\s*per hour)\s*/i, '').trim(), included: w.included?.[l] ?? '', suits: w.suits[l], about: w.copy[l], access: w.access?.[l] ?? '', photos: w.photos ?? [] };
    })(),
    place: (h as unknown as { place?: string }).place ?? '',
    page: href(lang, `/workshops/${h.activity}/${h.slug}/`),
    // Their own pictures, to pick a cover for a new date without uploading.
    photos: [...new Set([h.photo, ...(h.gallery ?? [])].filter((x): x is string => !!x))].slice(0, 8),
    // The square card picture (cropped small on purpose) and whether the page has a video.
    card: h.photo ?? '',
    video: !!h.video,
    // The page video itself, for the Profile tab (replace or remove it, Jirel 23.11.26).
    pageVideo: h.video ? { video: h.video, poster: h.poster ?? '' } : null,
    // Their workshops with a picture and price, for the offer's workshop picker.
    workshops: (() => {
      const seen = new Set<string>();
      // duration/desc/request: for the tips on the Overview (is a length,
      // an own description there; runs on request, without dates).
      type W = { title: string; price: string; image: string; key: string; dates: number; url: string; duration?: string; desc?: boolean; request?: boolean; text?: string; reel?: { video: string; poster: string } };
      const out: W[] = [];
      const add = (title: string, key: string, price?: string, image?: string, dates = 0, url = '', more: Partial<W> = {}) => {
        const k = title.trim().toLowerCase();
        if (!title || seen.has(k)) return;
        seen.add(k);
        // The video the site plays on this workshop: its own footage, else the
        // host's reel (sessions.ts withWorkshopReel), shown in its listing too (Jirel 23.11.26).
        const reel = getWorkshopReel(h.slug, title) ?? (h.video ? { video: h.video, poster: h.poster ?? '' } : undefined);
        out.push({ title, key, price: price ?? '', image: image || h.photo || h.poster || '', dates, url, ...(reel ? { reel } : {}), ...more });
      };
      try {
        for (const w of workshopsFor(h.slug, lang)) add(w.title, w.key, w.sessions[0]?.price, w.sessions[0]?.image, w.sessions.length, href(lang, `/workshops/${h.activity}/${h.slug}/${w.key}/`), { duration: w.sessions[0]?.duration ?? '', desc: w.sessions.some((x) => !!x.description), text: String(w.sessions.find((x) => !!x.description)?.description ?? '').slice(0, 1500) });
        for (const s of previewSessionsFor(h.slug, lang)) add(s.title, s.workshopKey, s.price, s.image, 1, '', { duration: s.duration ?? '', desc: !!s.description, text: String(s.description ?? '').slice(0, 1500) });
        // A preview host is out of the on-request lists (seo.ts), so their
        // formats come from hosts/preview.ts.
        for (const o of isPreviewHost(h.slug) ? previewOnRequestFor(h.slug, lang) : onRequestFor(h.slug, lang)) add(o.title, o.key ?? '', o.price, '', 0, '', { duration: o.duration ?? '', request: true });
      } catch { /* a host without listings: own dates only */ }
      // Every host has at least one listing (Jirel 20.11.26): a host whose page has
      // no workshop of its own yet gets one made from the page itself (what they
      // do, the page's text and group price), on request, so they can edit it.
      if (!out.length && h.specialty) {
        const gp = (h as unknown as { groupPrice?: number | [number, number] }).groupPrice;
        const price = Array.isArray(gp) ? `€${gp[0]}–${gp[1]}` : gp ? `€${gp}` : '';
        const key = h.specialty.toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60).replace(/-+$/, '');
        add(h.specialty, key, price, '', 0, href(lang, `/workshops/${h.activity}/${h.slug}/`), { duration: h.duration ?? '', request: true, desc: !!h.blurb, text: String(h.blurb ?? '').slice(0, 1500) });
      }
      return out;
    })(),
    site: siteFor(h.slug),
    // Still a hidden draft (hosts/preview.ts): the Overview offers "Publish my page".
    draft: isPreviewHost(h.slug),
    en: pick(h as unknown as Record<string, unknown>),
    de: pick((de.get(h.slug) ?? h) as unknown as Record<string, unknown>),
    slots: recurring.filter((r) => r.slug === h.slug).map((r) => ({
      title: r.title, weekdays: r.weekdays, time: r.time, duration: r.duration ?? '',
      price: Number((r.price ?? '').match(/\d+/)?.[0] ?? '') || null,
    })),
  }]),
);
/** Every page a host could claim, by name (the test page included). */
const becomeHost = `${href(lang, '/host/')}#apply`;
const claimList = getHosts('en', { withPreview: true })
  .map((h) => ({ slug: h.slug, label: `${h.name} · ${h.specialty}` }))
  .sort((a, b) => a.label.localeCompare(b.label));
const config = {
  firebase: firebaseConfig,
  ready: firebaseReady,
  contact: contactEmail,
  inbox: requestEmail,
  functions: functionsBase,
  // May open every host (functions/index.js ADMINS checks it again).
};
const fields = [
  ['specialty', t.fSpecialty, t.fSpecialtyHint, 'input', 80],
  ['studio', t.fStudio, '', 'input', 80],
  ['blurb', t.fBlurb, t.fBlurbHint, 'textarea', 1500],
  ['group_size', t.fGroup, t.fGroupHint, 'input', 80],
  ['duration', t.fDuration, '', 'input', 40],
  ['place', t.fPlace, '', 'input', 120],
  ['languages', t.fLanguages, '', 'input', 40],
  ['price_note', t.fPriceNote, '', 'input', 120],
] as const;
---

<Base title={t.pageTitle} description={t.lede} lang={lang} pageClass="ha-page" noindex translations={['en', 'de', 'fr']} bare>
  {/* The wash at the top follows the time of day (Jirel 14.11.26, like Luma):
      dawn, day (the purple-to-yellow she loves), dusk, night blue, and late
      at night a deep blue with stars. ?daypart=night etc. to preview. */}
  <script is:inline>
    (function () {
      var set = function () {
        var q = new URLSearchParams(location.search).get('daypart');
        var h = new Date().getHours();
        var p = q || (h >= 5 && h < 8 ? 'dawn' : h >= 8 && h < 17 ? 'day' : h >= 17 && h < 20 ? 'dusk' : h >= 20 && h < 23 ? 'night' : 'late');
        document.documentElement.dataset.daypart = p;
      };
      set(); setInterval(set, 10 * 60 * 1000);
    })();
  </script>
  <!-- Its own slim bar instead of the site menu (a full-screen app, like Luma). -->
  <a class="ha-home" href={href(lang, '/')} aria-label="Twiggli"><img src={withBase('/img/logo.png')} alt="" width="34" height="34" /></a>
  {/* Signed out: "Sign in" stays top right, as on every page; here it just
      puts the cursor in the email field (Jirel 13.11.26). */}
  <label class="social-bar-signin ha-top-signin" for="ha-email">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.6" /><path d="M5 20c.6-3.6 3.4-5.8 7-5.8s6.4 2.2 7 5.8" /></svg>
    <span class="social-bar-signin-label">{L('Anmelden', 'Sign in', 'Se connecter')}</span>
  </label>
  <section
    class="ha container"
    data-ha
    data-lang={lang}
    data-view={view}
    data-config={JSON.stringify(config)}
    data-hosts={JSON.stringify(hosts)}
    data-host-lang={JSON.stringify(hostLang)}
    data-copy={JSON.stringify(t)}
  >
    <header class="ha-head">
      <h1>{t.title}</h1>
      <p class="ha-lede">{t.lede}</p>
    </header>

    <!-- Before Firebase is set up (data/firebase.ts). -->
    <p class="ha-card ha-note" data-ha-soon hidden></p>

    <!-- Signed out: one field, one button. -->
    <form class="ha-signin" data-ha-signin hidden
      data-timedout={L('Du wurdest nach 7 Stunden automatisch abgemeldet. Melde dich einfach wieder an.', 'You were signed out automatically after 7 hours. Just sign in again.', 'Tu as été déconnecté·e automatiquement après 7 heures. Reconnecte-toi simplement.')}>
      <span class="ha-wave" aria-hidden="true"><span class="ha-wave-hand">👋</span></span>
      <h2>{t.welcomeTitle}</h2>
      <p class="ha-sub">{t.welcomeLede}</p>
      <p class="ha-invite" data-ha-invite-note hidden></p>
      <label>
        <span>{t.email}</span>
        <input id="ha-email" type="email" name="email" required autocomplete="email" placeholder={t.emailPh} />
      </label>
      <button type="submit" class="ha-btn">{t.sendLink}</button>
      <p class="ha-note" data-ha-signin-note role="status"></p>
      <hr class="ha-sep" />
      <button type="button" class="ha-btn ha-google" data-ha-google>
        <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        {t.google}
      </button>
      <p class="ha-apply">{L('Noch kein Host?', 'Not a host yet?', 'Pas encore hôte ?')} <a href={`${href(lang, '/host/')}#apply`}>{L('Hier bewerben', 'Apply here', 'Postule ici')} →</a></p>
    </form>

    <!-- Step 2: the 6-digit code from the email (Jirel 13.11.26, like Luma). -->
    <form class="ha-signin ha-code" data-ha-code hidden novalidate
      data-wait={L('Neuer Code in {s} s', 'Resend code in {s}s', 'Nouveau code dans {s} s')}
      data-wrong={L('Der Code stimmt nicht. Versuch es noch einmal.', "That code isn't right. Try again.", 'Ce code n’est pas bon. Réessaie.')}
      data-expired={L('Der Code ist abgelaufen. Fordere einfach einen neuen an.', 'That code has expired. Just request a new one.', 'Ce code a expiré. Demandes-en simplement un nouveau.')}
      data-resent={L('Neuer Code ist unterwegs.', 'A new code is on its way.', 'Un nouveau code est en route.')}
      data-checking={L('Wird geprüft …', 'Checking …', 'Vérification …')}>
      <button type="button" class="ha-code-back" data-ha-code-back aria-label={L('Zurück', 'Back', 'Retour')}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <span class="ha-code-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg></span>
      <h2>{L('Code eingeben', 'Enter code', 'Saisis le code')}</h2>
      <p class="ha-sub">{L('Wir haben dir einen 6-stelligen Code geschickt an', 'We sent a 6-digit code to', 'On a envoyé un code à 6 chiffres à')}<br /><b data-ha-code-to></b></p>
      <div class="ha-code-boxes" data-ha-code-boxes role="group" aria-label={L('6-stelliger Code', '6-digit code', 'Code à 6 chiffres')}>
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete={i === 0 ? 'one-time-code' : 'off'} aria-label={`${L('Ziffer', 'Digit', 'Chiffre')} ${i + 1}`} />
        ))}
      </div>
      <p class="ha-note" data-ha-code-note role="status"></p>
      <div class="ha-code-row">
        <button type="button" class="ha-code-paste" data-ha-code-paste>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="3" width="8" height="4" rx="1.5"/><path d="M16 5h1.5A1.5 1.5 0 0 1 19 6.5v13a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 19.5v-13A1.5 1.5 0 0 1 6.5 5H8"/></svg>
          {L('Code einfügen', 'Paste code', 'Coller le code')}
        </button>
        <button type="button" class="ha-code-resend" data-ha-code-resend disabled>{L('Code erneut senden', 'Resend code', 'Renvoyer le code')}</button>
      </div>
    </form>

    <!-- Step 3, only with two-factor on (Jirel 15.11.26): the code from the
         authenticator app, or one of the backup codes. -->
    <form class="ha-signin ha-code ha-tfa" data-ha-tfa hidden novalidate
      data-wrong={L('Der Code stimmt nicht. Versuch es noch einmal.', "That code isn't right. Try again.", 'Ce code n’est pas bon. Réessaie.')}
      data-locked={L('Zu viele Versuche. Warte 10 Minuten und versuch es dann noch einmal.', 'Too many tries. Wait 10 minutes, then try again.', 'Trop de tentatives. Attends 10 minutes, puis réessaie.')}
      data-checking={L('Wird geprüft …', 'Checking …', 'Vérification …')}>
      <span class="ha-code-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5.5c0 4.3 3 7.9 7 9.5 4-1.6 7-5.2 7-9.5V6z"/><path d="m9 12 2 2 4-4"/></svg></span>
      <h2>{L('Bestätigungscode', 'Verification code', 'Code de vérification')}</h2>
      <p class="ha-sub" data-ha-tfa-sub>{L('Öffne deine Authenticator-App und gib den 6-stelligen Code für Twiggli ein.', 'Open your authenticator app and enter the 6-digit code for Twiggli.', 'Ouvre ton app d’authentification et saisis le code à 6 chiffres pour Twiggli.')}</p>
      <div class="ha-code-boxes" data-ha-tfa-boxes role="group" aria-label={L('6-stelliger Code', '6-digit code', 'Code à 6 chiffres')}>
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete={i === 0 ? 'one-time-code' : 'off'} aria-label={`${L('Ziffer', 'Digit', 'Chiffre')} ${i + 1}`} />
        ))}
      </div>
      <div class="ha-tfa-backup" data-ha-tfa-backup hidden>
        <input type="text" name="backup" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="abcd-efgh" aria-label={L('Backup-Code', 'Backup code', 'Code de secours')} />
        <button type="submit" class="ha-btn">{L('Bestätigen', 'Confirm', 'Confirmer')}</button>
      </div>
      <p class="ha-note" data-ha-tfa-note role="status"></p>
      <div class="ha-code-row">
        <button type="button" class="ha-code-paste" data-ha-tfa-switch data-other={L('Code aus der App verwenden', 'Use the code from the app', 'Utiliser le code de l’app')}>{L('Backup-Code verwenden', 'Use a backup code', 'Utiliser un code de secours')}</button>
        <button type="button" class="ha-code-resend" data-ha-tfa-out>{t.signOut}</button>
      </div>
    </form>

    <!-- A second of welcome right after signing in (Jirel 14.11.26, like Luma). -->
    <div class="ha-welcome" data-ha-welcome hidden aria-live="polite">
      <div class="ha-welcome-glow" aria-hidden="true"></div>
      <div class="ha-welcome-in">
        <span class="ha-welcome-avatar" data-ha-welcome-avatar></span>
        <h2>{L('Willkommen bei Twiggli', 'Welcome to Twiggli', 'Bienvenue sur Twiggli')}</h2>
        <p data-ha-welcome-name></p>
      </div>
    </div>

    <!-- Signed in. -->
    <div class="ha-app" data-ha-app hidden>
      <p class="ha-back" data-ha-back hidden role="status">{L('Willkommen zurück! Dein Konto ist wieder aktiv. Deine Seite ist bis morgen früh wieder auf Twiggli zu sehen.', "Welcome back! Your account is active again. Your page will be back on Twiggli by tomorrow morning.", 'Bon retour ! Ton compte est de nouveau actif. Ta page sera de retour sur Twiggli d’ici demain matin.')}</p>
      <header class="hd-top">
        <span class="hd-beta" title={L('Twiggli-Konten sind neu und noch in der Testphase', 'Twiggli accounts are new and still being tested', 'Les comptes Twiggli sont nouveaux et encore en test')}>BETA</span>
        <nav class="ha-tabs" role="tablist" data-ha-tabs hidden>
          <button type="button" role="tab" aria-selected="true" data-ha-tab="overview"><svg class="hd-i" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1z"/></svg>{t.tabOverview}</button>
          <button type="button" role="tab" aria-selected="false" data-ha-tab="calendar"><svg class="hd-i" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>{t.tabCalendar}</button>
          <button type="button" role="tab" aria-selected="false" data-ha-tab="messages"><svg class="hd-i" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a7.5 7.5 0 0 1-11 6.6L4 20l1.4-4.6A7.5 7.5 0 1 1 20 12z"/></svg>{t.tabMessages}<i class="ha-count" data-ha-count hidden></i></button>
          <button type="button" role="tab" aria-selected="false" data-ha-tab="listings"><svg class="hd-i" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 12.2V4.5a1 1 0 0 1 1-1h7.7l8.3 8.3a1.5 1.5 0 0 1 0 2.1l-6.3 6.3a1.5 1.5 0 0 1-2.1 0z"/><circle cx="8" cy="8" r="1.4"/></svg>{t.tabListings}</button>
        </nav>
        <div class="hd-right">
          <button type="button" class="hd-add" data-ha-new data-ha-hostonly hidden>+ {t.addDate}</button>
          <div class="nt-wrap">
            <button type="button" class="hd-bell" data-ha-bell aria-haspopup="true" aria-expanded="false" aria-label={t.notifications}><svg class="hd-i" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9a6 6 0 1 1 12 0c0 5 2 6.5 2 6.5H4S6 14 6 9z"/><path d="M10 19a2 2 0 0 0 4 0"/></svg><i data-ha-dot hidden></i></button>
            <div class="nt" data-ha-nt hidden role="dialog" aria-label={t.notifications}>
              <div class="nt-head"><b>{t.notifications}</b><button type="button" class="nt-all" data-ha-nt-all>{L('Alle gelesen', 'Mark all read', 'Tout marquer lu')}</button></div>
              <ul class="nt-list" data-ha-nt-list></ul>
            </div>
          </div>
          <div class="hd-me">
            <button type="button" class="hd-avatar" data-ha-avatar aria-haspopup="true" aria-label={t.profile}>🙂</button>
            <div class="hd-menu" data-ha-menu hidden>
              <div class="hd-menu-head">
                <span class="hd-menu-av" data-ha-menu-av aria-hidden="true">🙂</span>
                <div class="hd-menu-id"><b data-ha-menu-name></b><p class="hd-who" data-ha-who></p></div>
              </div>
              <button type="button" class="hd-item" data-ha-go="profile">{L('Profil', 'Profile', 'Profil')}</button>
              <button type="button" class="hd-item" data-ha-go="settings">{L('Einstellungen', 'Settings', 'Réglages')}</button>
              <label class="ha-pick" data-ha-pick-wrap hidden>
                <span>{t.hostPick}</span>
                <select data-ha-pick></select>
              </label>
              {/* Jirel only: the personal invite link for the host picked above (functions hostInviteLinks). */}
              <div class="ha-adm-invite" data-ha-invite-admin hidden>
                <button type="button" class="hd-item" data-ha-invite-copy>{t.cal.inviteBtn}</button>
                <p class="ha-adm-note" data-ha-invite-msg role="status"></p>
              </div>
              {/* Jirel only: a note for the host picked above; it shows as a tip in their dashboard (functions hostTips). */}
              <div class="tp-adm" data-tp-adm hidden>
                <label class="tp-adm-l"><span>{L('Notiz für Host', 'Note for host', 'Note pour l’hôte')}</span>
                  <textarea rows="2" maxlength="600" data-tp-note placeholder={L('z. B. Bitte bestätige den Preis für den Tagesworkshop.', 'e.g. Please confirm the price for the day workshop.', 'p. ex. Merci de confirmer le prix de l’atelier.')}></textarea>
                </label>
                <button type="button" class="hd-item" data-tp-note-add>{L('Notiz speichern', 'Save note', 'Enregistrer la note')}</button>
                <ul class="tp-adm-list" data-tp-note-list></ul>
              </div>
              {/* Jirel only: a voucher sold by invoice (not via the website checkout) gets its code here (functions voucherCreate). */}
              <div class="tp-adm vc-adm" data-vc-adm hidden>
                <b class="tp-adm-l">{L('Gutschein anlegen', 'Add a voucher', 'Ajouter un bon')}</b>
                <label class="vc-f"><span>Code</span><input data-vc-code placeholder="TW-XXXX-XXXX" maxlength="20" /></label>
                <div class="vc-row">
                  <label class="vc-f"><span>{L('Betrag (€)', 'Amount (€)', 'Montant (€)')}</span><input data-vc-amount type="number" min="1" max="2000" step="1" /></label>
                  <label class="vc-f"><span>{L('Gültig bis', 'Valid until', 'Valable jusqu’au')}</span><input data-vc-until type="date" /></label>
                </div>
                <label class="vc-f"><span>{L('Nur bei Host (leer = alle Hosts)', 'Only at host (empty = all hosts)', 'Seulement chez (vide = tous)')}</span><select data-vc-host></select></label>
                <label class="vc-f"><span>{L('Bestell-/Rechnungsnr.', 'Order / invoice no.', 'N° de commande / facture')}</span><input data-vc-ref maxlength="40" placeholder="TW-2026-11-001" /></label>
                <button type="button" class="hd-item" data-vc-save>{L('Gutschein anlegen', 'Add voucher', 'Ajouter le bon')}</button>
                <p class="ha-adm-note" data-vc-msg role="status"></p>
              </div>
              <hr class="hd-menu-sep" />
              <button type="button" class="hd-item hd-out" data-ha-signout><span>{t.signOut}</span><svg class="hd-door" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 4h3a2 2 0 0 1 2 2v14"/><path d="M2 20h3"/><path d="M13 20h9"/><path d="M10 12v.01"/><path d="M13 4.56v16.16a1 1 0 0 1-1.24.97L5 20V5.56a2 2 0 0 1 1.52-1.94l4-1A2 2 0 0 1 13 4.56z"/></svg></button>
            </div>
          </div>
        </div>
      </header>
      <p class="ha-card ha-note" data-ha-nohost hidden></p>

      <!-- Signed in, but not a host (yet). -->
      <div class="ha-card ha-notyet" data-ha-notyet hidden>
        <h2>{t.notYetTitle}</h2>
        <p>{t.notYetLede}</p>
        <a class="ha-btn" href={becomeHost}>{t.notYetCta} →</a>
      </div>

      <!-- No page yet: ask for one. Jirel approves by email (functions/index.js hostClaim). -->
      <form class="ha-card ha-claim" data-ha-claim hidden>
        <h2>{t.claimTitle}</h2>
        <p class="ha-lede">{t.claimLede}</p>
        <label>
          <span>{t.claimPage}</span>
          <select name="slug" required>
            <option value="">{t.claimPagePh}</option>
            {claimList.map((h) => <option value={h.slug}>{h.label}</option>)}
          </select>
        </label>
        <label><span>{t.claimName}</span><input name="name" required autocomplete="name" /></label>
        <label><span>{t.claimNote}</span><textarea name="note" rows="2" placeholder={t.claimNotePh}></textarea></label>
        <div class="ha-save"><button type="submit" class="ha-btn">{t.claimSend}</button><p class="ha-note" role="status"></p></div>
      </form>

      {/* Profile inside the account, like Luma (Jirel 14.11.26): not the public page. */}
      <section class="hd-prof" data-ha-panel="profile" hidden>
        <header class="hd-prof-head">
          <div class="hd-prof-avwrap">
            <span class="hd-prof-av" data-ha-prof-av aria-hidden="true">🙂</span>
            <label class="hd-prof-cam" data-ha-prof-cam title={L('Profilfoto ändern', 'Change profile photo', 'Changer la photo de profil')}>
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="13" r="3.5"/></svg>
              <span class="sr-only">{L('Profilfoto ändern', 'Change profile photo', 'Changer la photo de profil')}</span>
              <input type="file" accept="image/*" data-ha-prof-file hidden />
            </label>
          </div>
          <div class="hd-prof-id">
            <div class="hd-prof-titles">
              <h1 data-ha-prof-name></h1>
              <p class="hd-prof-studio" data-ha-prof-studio hidden></p>
              <button type="button" class="hd-prof-addname" data-ha-go="settings" data-ha-prof-addname hidden>{L('+ Deinen Namen hinzufügen', '+ Add your name', '+ Ajoute ton nom')}</button>
            </div>
            <p class="hd-prof-bio" data-ha-prof-bio hidden></p>
            <ul class="hd-prof-facts">
              <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg><span data-ha-prof-since></span></li>
              <li data-ha-prof-cityrow hidden><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><span data-ha-prof-city></span></li>
            </ul>
            <div class="hd-prof-stats">
              <span><b data-ha-prof-hosted>–</b>{L('Veranstaltet', 'Hosted', 'Organisés')}</span>
              <span><b data-ha-prof-attended>–</b>{L('Besucht', 'Attended', 'Suivis')}</span>
            </div>
            <p class="hd-prof-note" data-ha-prof-note role="status"></p>
            <div class="hd-prof-social" data-ha-prof-social hidden></div>
            <div class="hd-prof-actions">
              <a class="hd-prof-pub" data-ha-view target="_blank" rel="noopener">{L('Öffentliche Seite ansehen', 'View public page', 'Voir la page publique')}</a>
            </div>
          </div>
        </header>
        <section class="hd-pv" data-ha-pv hidden>
          <h2>{L('Video auf deiner Seite', 'Video on your page', 'Vidéo sur ta page')}</h2>
          <p class="hd-pv-hint">{L('Läuft oben auf deiner Seite und bei Workshops ohne eigenes Video.', 'Plays at the top of your page and on workshops without a video of their own.', 'Passe en haut de ta page et sur les ateliers sans vidéo à eux.')}</p>
          <div class="hd-pv-box" data-ha-pv-box></div>
          <div class="hd-pv-act">
            <label class="lst-btn">{L('Neues Video hochladen', 'Upload a new video', 'Importer une nouvelle vidéo')}<input type="file" accept="video/*" data-ha-pv-file hidden /></label>
            <button type="button" class="lst-btn2" data-ha-pv-remove>{L('Entfernen', 'Remove', 'Supprimer')}</button>
          </div>
          <p class="hd-pv-note" data-ha-pv-note role="status"></p>
        </section>
        <div class="hd-prof-list" data-ha-prof-list></div>
        <p class="hd-prof-empty" data-ha-prof-empty hidden>{L('Noch keine Workshops auf deiner Seite.', 'No workshops on your page yet.', 'Pas encore d’ateliers sur ta page.')}</p>
