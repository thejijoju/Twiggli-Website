  .msg-b.is-host { justify-self: end; border-radius: 14px 14px 4px 14px; background: #6a3eec; color: #fff; }
  .msg-reply { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: end; margin-top: 4px; }
