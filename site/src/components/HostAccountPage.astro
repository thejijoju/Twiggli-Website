  .hd-del-btn { justify-self: start; display: inline-flex; align-items: center; gap: 8px; font: inherit; font-weight: 600; font-size: 0.92rem; color: #fff; background: #e5484d; border: 0; border-radius: 12px; padding: 10px 16px; cursor: pointer; transition: transform .15s ease, opacity .15s ease; }
