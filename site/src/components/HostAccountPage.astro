  .ha .wh-in { font-size: 0.9rem; padding: 8px 10px; border: 1px solid #ebe6dc; border-radius: 10px; background: #fff; width: 100%; box-sizing: border-box; color: inherit; }
  .wh-row2 { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 8px; }
  .wh-note { font-size: 0.78rem; color: var(--color-text-muted); padding-top: 6px; }
  .wh-ws .wh-pick:last-of-type { border-bottom: 0; }
  .ha-adm-invite { display: grid; gap: 4px; }
  .vc-adm { display: grid; gap: 6px; }
