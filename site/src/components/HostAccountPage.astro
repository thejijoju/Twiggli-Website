  .hl-dots:hover, .hl-dots[aria-expanded='true'] { background: rgba(36, 39, 46, 0.1); }
  .hl-menu { position: absolute; right: 0; top: calc(100% + 6px); z-index: 20; min-width: 220px; padding: 6px; border-radius: 16px; background: rgba(255, 255, 255, 0.97); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2); box-shadow: 0 18px 44px -12px rgba(60, 30, 120, 0.3), 0 0 0 1px rgba(36, 39, 46, 0.06); display: grid; }
