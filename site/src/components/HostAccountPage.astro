  .ib-clock.is-soon b, .ib-clock.is-late { color: #d4384a; }
  .ib-foot .ib-act-main { padding: 15px; font-size: 1.05rem; background: linear-gradient(135deg, #6a3eec, #e64ab4); color: #fff; }
  /* Phones: popups become full-height sheets over the blurred page; a second
     one (offer, decline) sits a little lower, so the one beneath peeks out. */
  @media (max-width: 640px) {
    .ib-modal, .ib-modal.ib-offer, .ib-modal.ib-decline { width: 100vw; max-width: 100vw; height: calc(100dvh - 10px); max-height: none; margin: 10px 0 0; border-radius: 26px 26px 0 0; animation: ib-sheet .28s cubic-bezier(.2, .8, .2, 1); }
    .ib-modal.ib-offer { height: calc(100dvh - 34px); margin-top: 34px; }
    .ib-modal-head { padding: 20px; } .ib-modal-body { padding: 16px 20px 24px; }
    .ib-modal.ib-offer .ib-modal-body { padding: 74px 20px 24px; }
    .ib-modal .ib-offer-x { top: 16px; left: 16px; right: auto; }
    .ib-foot { bottom: -24px; margin: 18px -20px -24px; padding: 14px 20px calc(18px + env(safe-area-inset-bottom)); }
  }
  @keyframes ib-sheet { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (max-width: 560px) { .ib-modal-head { padding: 20px; } .ib-modal-head h2 { font-size: 1.4rem; } .ib-modal-body { padding: 16px 20px 24px; } }

