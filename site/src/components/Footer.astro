---
import StoreButtons from './StoreButtons.astro';
import { getSiteData } from '../data/site.ts';
import { href, type Lang } from '../lib/url.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { brand, navLinks, secondaryLinks, legalLinks, copyright } = getSiteData(lang);

const columnLabels = {
  en: { product: 'Product', explore: 'Explore', legal: 'Legal' },
  de: { product: 'Produkt', explore: 'Entdecken', legal: 'Rechtliches' },
}[lang];

const cta = {
  en: { title: 'Ready to dive in? Download now on Apple Store and Google Play.' },
  de: { title: 'Bereit loszulegen? Jetzt im App Store und bei Google Play herunterladen.' },
}[lang];
---

<footer id="footer" class="footer">
  <div class="footer-inner">
    {/* The wordmark set large is the whole of the brand here — the mark and
        the photo card that used to sit beside it are gone, so the band
        closes the page on type and space rather than on artwork. */}
    <div class="footer-top">
      <div class="footer-identity">
        <a href={href(lang, '/')} class="footer-wordmark">{brand.name}</a>
        <p class="footer-tagline">{brand.tagline}</p>
      </div>
      <div class="footer-app">
        <p class="footer-app-title">{cta.title}</p>
        <StoreButtons lang={lang} tone="accent" class="footer-app-stores" />
      </div>
    </div>

    <nav class="footer-nav" aria-label={brand.name}>
      <div class="footer-col">
        <p class="footer-col-title">{columnLabels.product}</p>
        <div class="footer-links">
          {navLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener' : undefined}
            >{link.label}</a>
          ))}
        </div>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">{columnLabels.explore}</p>
        <div class="footer-links">
          {secondaryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">{columnLabels.legal}</p>
        <div class="footer-links">
          {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </div>
    </nav>

    <p class="footer-note">{copyright}</p>
  </div>
</footer>
