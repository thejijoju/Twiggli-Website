---
import ImageSlot from './ImageSlot.astro';
import StoreButtons from './StoreButtons.astro';
import { getSiteData } from '../data/site.ts';
import { href, type Lang } from '../lib/url.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { brand, navLinks, secondaryLinks, legalLinks, socialLinks, copyright } = getSiteData(lang);

const columnLabels = {
  en: { getApp: 'Get the app', product: 'Product', explore: 'Explore', follow: 'Follow', legal: 'Legal' },
  de: { getApp: 'App herunterladen', product: 'Produkt', explore: 'Entdecken', follow: 'Folgen', legal: 'Rechtliches' },
}[lang];
---

<footer id="footer" class="footer">
  <div class="footer-inner">
    <div class="footer-brand-block">
      <div class="footer-brand">
        <a href={href(lang, '/')} class="footer-logo" aria-label={`${brand.name} — home`}>
          <ImageSlot src={brand.logo} shape="rect" placeholder="Logo" alt={`${brand.name} logo`} />
        </a>
        <span class="footer-brand-name">{brand.name}</span>
      </div>
      <p class="footer-col-title footer-get-app">{columnLabels.getApp}</p>
      <StoreButtons lang={lang} tone="default" class="footer-stores" />
    </div>
    <div class="footer-cols">
      <div>
        <p class="footer-col-title">{columnLabels.product}</p>
        <div class="footer-links">
          {navLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener' : undefined}
            >{link.label}</a>
          ))}
        </div>
      </div>
      <div>
        <p class="footer-col-title">{columnLabels.explore}</p>
        <div class="footer-links">
          {secondaryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </div>
      <div>
        <p class="footer-col-title">{columnLabels.follow}</p>
        <div class="footer-links">
          {socialLinks.map((s) => <a href={s.href}>{s.label}</a>)}
        </div>
      </div>
      <div>
        <p class="footer-col-title">{columnLabels.legal}</p>
        <div class="footer-links">
          {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p class="footer-note">{copyright}</p>
  </div>
</footer>
