---
import { DEFAULT_LANG, type Lang } from '../lib/url.ts';
import { ui } from '../data/i18n.ts';

interface Props {
  lang?: Lang;
}
const { lang = DEFAULT_LANG } = Astro.props;

const copy = ui(lang).newsletter;

/* PLACEHOLDER — the form posts nowhere yet. Wire `action` to a real
   newsletter provider (Mailchimp, Brevo, a serverless function) before
   launch, same as the contact form on contact.astro. */
---

<section class="section newsletter">
  <span class="kicker kicker-tight">{copy.kicker}</span>
  <h2 class="split-title">{copy.heading}</h2>
  <p class="split-copy">{copy.lede}</p>
  <form class="newsletter-form" method="post" action="#">
    <div class="field newsletter-field">
      <label for="newsletter-email" class="sr-only">{copy.label}</label>
      <input
        class="input"
        type="email"
        id="newsletter-email"
        name="email"
        placeholder={copy.placeholder}
        required
      />
    </div>
    <button type="submit" class="btn btn-primary">{copy.button}</button>
  </form>
</section>
