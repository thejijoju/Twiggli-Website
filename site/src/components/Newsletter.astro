---
import { DEFAULT_LANG, type Lang } from '../lib/url.ts';
import { ui } from '../data/i18n.ts';
import { bookingCopy } from '../data/bookingCopy.ts';
import { requestEmail, brevoFormUrl, getSiteData } from '../data/site.ts';
import { withBase } from '../lib/url.ts';

interface Props {
  lang?: Lang;
  /** The footer's one-line version: no kicker or lede, light on dark. */
  compact?: boolean;
}
const { lang = DEFAULT_LANG, compact = false } = Astro.props;

const copy = ui(lang).newsletter;
const id = compact ? 'newsletter-email-footer' : 'newsletter-email';
const privacy = getSiteData(lang).legalLinks[1];
// Stills from scripts/mail-crops.sh, one per craft, in caption order.
const PICS = ['qian', 'ceramic-kingdom', 'galleria-lucia-dipdye', 'jem-sushi', 'techno', 'karen-rose-duftkerzen'];
// How each one is kept, in turn — so the three a phone shows are one of each.
const KINDS = ['card', 'taped', 'stamp'] as const;

/* Signups go to Brevo (brevoFormUrl), which sends the double opt-in
   confirmation and handles unsubscribes; the box then asks the visitor to
   check their inbox. Until that form is set they come to our inbox through
   FormSubmit, the booking form's route, with the language and page. */
---

{compact ? (
  <div class="newsletter-compact">
    <p class="newsletter-compact-title">{copy.heading}</p>
    <form class="newsletter-form" data-newsletter data-inbox={requestEmail} data-brevo={brevoFormUrl || undefined} data-lang={lang} novalidate>
      <label for={id} class="sr-only">{copy.label}</label>
      <input class="input" type="email" id={id} name="email" placeholder={copy.placeholder} autocomplete="email" required />
      <button type="submit" class="btn btn-primary" data-label={copy.button} data-sending={bookingCopy[lang].sending}>{copy.button}</button>
    </form>
    <p class="newsletter-note" data-newsletter-thanks hidden>{brevoFormUrl ? copy.checkInbox : copy.thanks}</p>
    <p class="newsletter-note newsletter-error" data-newsletter-error hidden>{copy.error}</p>
  </div>
) : (
  <section class="newsletter" id="newsletter">
    {/* Real workshop photos lying flat on the box, each kept a little
        differently: a plain rounded card, one taped down at two corners,
        one as a postage stamp. */}
    <div class="newsletter-pics" aria-hidden="true">
      {PICS.map((name, i) => {
        const kind = KINDS[i % KINDS.length];
        const img = <img src={withBase(`/img/mail/${name}.jpg`)} alt="" loading="lazy" decoding="async" width="560" height="420" />;
        return kind === 'card' ? (
          <figure class="newsletter-pic is-card">{img}</figure>
        ) : (
          <figure class={`newsletter-pic is-${kind}`}>
            <div class="newsletter-paper">{img}<figcaption>{copy.pics[i]}</figcaption></div>
            {kind === 'taped' && <><span class="newsletter-tape is-tl"></span><span class="newsletter-tape is-br"></span></>}
          </figure>
        );
      })}
    </div>
    <div class="newsletter-inner">
      <h2 class="newsletter-title">{copy.heading}</h2>
      <svg class="newsletter-squiggle" viewBox="0 0 220 14" aria-hidden="true">
        <defs><linearGradient id="nl-ink" x1="0" x2="1"><stop offset="0" stop-color="#ff8a5c" /><stop offset=".5" stop-color="#e64ab4" /><stop offset="1" stop-color="#6a3eec" /></linearGradient></defs>
        <path d="M3 9c18-7 32 5 50-1s31-6 48 1 33 5 51-2 33-4 65 1" fill="none" stroke="url(#nl-ink)" stroke-width="3.5" stroke-linecap="round" />
      </svg>
      <p class="newsletter-lede">{copy.lede}</p>
      <form class="newsletter-form" data-newsletter data-inbox={requestEmail} data-brevo={brevoFormUrl || undefined} data-lang={lang} novalidate>
        <label for={id} class="sr-only">{copy.label}</label>
        <input class="input" type="email" id={id} name="email" placeholder={copy.placeholder} autocomplete="email" required />
        <button type="submit" class="btn btn-primary" data-label={copy.button} data-sending={bookingCopy[lang].sending}>{copy.button}</button>
      </form>
      <p class="newsletter-note" data-newsletter-thanks hidden>{brevoFormUrl ? copy.checkInbox : copy.thanks}</p>
      <p class="newsletter-note newsletter-error" data-newsletter-error hidden>{copy.error}</p>
      <p class="newsletter-consent">{copy.consent}{' '}<a href={privacy.href}>{privacy.label}</a></p>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const box = form.parentElement;
    const thanks = box?.querySelector<HTMLElement>('[data-newsletter-thanks]');
    const error = box?.querySelector<HTMLElement>('[data-newsletter-error]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const email = String(new FormData(form).get('email') ?? '').trim();
      if (error) error.hidden = true;
      if (button) { button.disabled = true; button.textContent = button.dataset.sending ?? ''; }
      try {
        const brevo = form.dataset.brevo;
        if (brevo) {
          // Brevo's own form fields. Should the browser refuse to let us read
          // Brevo's reply (it is another site), the post goes again without
          // reading it — Brevo still receives it and sends the confirmation.
          const body = new FormData();
          body.set('EMAIL', email);
          body.set('LANGUAGE', form.dataset.lang ?? '');
          body.set('email_address_check', '');
          body.set('locale', form.dataset.lang ?? 'en');
          body.set('html_type', 'simple');
          await fetch(brevo, { method: 'POST', body }).catch(() => fetch(brevo, { method: 'POST', body, mode: 'no-cors' }));
          form.hidden = true;
          if (thanks) thanks.hidden = false;
          return;
        }
        const res = await fetch(`https://formsubmit.co/ajax/${form.dataset.inbox}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            Type: 'Newsletter signup',
            email,
            Language: form.dataset.lang ?? '',
            'Signed up on': location.href,
            _subject: `Newsletter signup: ${email}`,
            _template: 'table',
            _captcha: 'false',
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        if (thanks) thanks.hidden = false;
      } catch {
        if (error) error.hidden = false;
        if (button) { button.disabled = false; button.textContent = button.dataset.label ?? ''; }
      }
    });
  });
</script>
