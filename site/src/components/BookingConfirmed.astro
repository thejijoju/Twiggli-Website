---
/**
 * Where Stripe sends a guest after paying a host's date (functions
 * bookingCheckout → success_url). Asks bookingConfirm, which checks the
 * payment with Stripe, marks the booking paid and sends the emails once.
 * Kept out of the sitemap and search.
 */
import Base from '../layouts/Base.astro';
import { functionsBase } from '../data/firebase.ts';

interface Props { lang: 'en' | 'de' }
const { lang } = Astro.props;
const t = {
  en: { title: 'You’re booked!', checking: 'Checking your payment…', body: 'Your place is confirmed. A confirmation is on its way to your inbox.', unpaid: 'Your payment hasn’t come through yet. If you were charged, reply to our email and we’ll sort it out.', error: 'We couldn’t check your booking just now. Your confirmation email will follow; if not, write to hello@twiggli.com.', more: 'Discover more workshops', when: 'When', where: 'Where', places: 'Places', voucher: 'Voucher', paid: 'Paid', holdTitle: 'Reserved!', holdBody: 'Your request is with the host. Your voucher and card are only charged once they confirm, usually within 48 hours. If they can’t, nothing is taken.', held: 'Held on your card', people: 'People' },
  de: { title: 'Gebucht!', checking: 'Wir prüfen deine Zahlung…', body: 'Dein Platz ist sicher. Die Bestätigung ist auf dem Weg in dein Postfach.', unpaid: 'Deine Zahlung ist noch nicht angekommen. Falls schon abgebucht wurde, antworte einfach auf unsere E-Mail.', error: 'Wir konnten deine Buchung gerade nicht prüfen. Die Bestätigung kommt per E-Mail; sonst schreib an hello@twiggli.com.', more: 'Weitere Workshops entdecken', when: 'Wann', where: 'Wo', places: 'Plätze', voucher: 'Gutschein', paid: 'Bezahlt', holdTitle: 'Reserviert!', holdBody: 'Deine Anfrage ist beim Gastgeber. Gutschein und Karte werden erst belastet, wenn er bestätigt, meist innerhalb von 48 Stunden. Klappt es nicht, wird nichts abgebucht.', held: 'Auf deiner Karte vorgemerkt', people: 'Personen' },
}[lang];
---

<Base title={`${t.title} · Twiggli`} description={t.body} lang={lang} noindex translations={['en', 'de']}>
  <div class="container">
    <section class="review-page booked-page" id="booked" data-endpoint={`${functionsBase}/bookingConfirm`} data-hold-endpoint={`${functionsBase}/holdConfirm`} data-lang={lang}>
      <div class="review-done">
        <div class="review-done-stars" aria-hidden="true">🎉</div>
        <h1 class="review-title" id="booked-title">{t.checking}</h1>
        <p class="review-lede" id="booked-body"></p>
        <dl class="booked-facts" id="booked-facts" hidden></dl>
        <a class="btn btn-primary" href={lang === 'de' ? '/de/workshops/' : '/workshops/'}>{t.more}</a>
      </div>
    </section>
  </div>
</Base>

<script is:inline define:vars={{ t }}>
  const box = document.getElementById('booked');
  const q = new URLSearchParams(location.search);
  const title = document.getElementById('booked-title');
  const body = document.getElementById('booked-body');
  const facts = document.getElementById('booked-facts');
  const de = box.dataset.lang === 'de';
  const esc = (v) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  // Back from holding the rest after a voucher (functions holdConfirm).
  if (q.get('hold')) {
    fetch(box.dataset.holdEndpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ session_id: q.get('hold') }) })
      .then((r) => r.json())
      .then((b) => {
        if (b.status !== 'held') { title.textContent = t.checking.replace('…', ''); body.textContent = t.unpaid; return; }
        title.textContent = t.holdTitle;
        body.textContent = t.holdBody;
        facts.innerHTML = [['', b.workshop], [t.when, [(String(b.date).match(/\((.*)\)/) || [, b.date])[1], b.time].filter(Boolean).join(', ')], [t.people, b.people], [t.voucher, b.voucher ? `−€${b.voucher}` : ''], [t.held, b.held ? `€${b.held}` : '']]
          .filter(([, v]) => v).map(([k, v]) => (k ? `<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>` : `<div class="booked-what"><dd>${esc(v)}</dd></div>`)).join('');
        facts.hidden = false;
      })
      .catch(() => { title.textContent = t.holdTitle; body.textContent = t.error; });
  } else fetch(box.dataset.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ session_id: q.get('session_id') || q.get('b') || '' }) })
    .then((r) => r.json())
    .then((b) => {
      if (b.status !== 'paid') { title.textContent = t.checking.replace('…', ''); body.textContent = t.unpaid; return; }
      title.textContent = t.title;
      body.textContent = t.body;
      const day = new Date(`${b.date}T12:00:00Z`).toLocaleDateString(de ? 'de-DE' : 'en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
      facts.innerHTML = [['', b.title], [t.when, `${day}, ${b.start}`], [t.where, b.location], [t.places, b.people], ...(b.voucher ? [[t.voucher, `−€${b.voucher}`]] : []), [t.paid, `€${Math.round((b.amount - (b.voucher || 0)) * 100) / 100}`]]
        .filter(([, v]) => v).map(([k, v]) => (k ? `<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>` : `<div class="booked-what"><dd>${esc(v)}</dd></div>`)).join('');
      facts.hidden = false;
    })
    .catch(() => { title.textContent = t.title; body.textContent = t.error; });
</script>
