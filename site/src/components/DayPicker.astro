                        <a
                          class="session-thumb"
                          {...(s.host.video ? {} : { href: s.bookUrl, ...bookAttrs(s) })}
                          tabindex="-1"
                          aria-hidden="true"
                        >
                          {/* In grid view the day flows as one full-width
                              grid, so each card wears its start time as a
                              chip on the picture. */}
                          {s.time && <span class="session-timechip">{s.time}</span>}
                          {s.soldOut ? (
                            <span class="session-availbadge session-soldout">{fullLabel(s)}</span>
                          ) : (
                            typeof s.spots === 'number' ? <span class="session-availbadge">{spotsText(s.spots, lang, t.spots)}</span>
                            : s.almostFull && <span class="session-availbadge session-almostfull">{almostFullLabel[lang]}</span>
                          )}
                          {s.host.video ? (
                            <>
                              {/* The still the tile rests on, as a picture
                                  under the reel rather than as the video's
                                  poster attribute. Safari drops a poster
                                  the moment play() starts fetching, which
                                  left a pale tile between the still and the
                                  first frame — a white flash on every tile
                                  the walk reached. Underneath, it simply
                                  stays there until the reel fades over it. */}
                              {s.host.poster && (
                                <img class="session-still" src={s.host.poster} alt="" loading="lazy" decoding="async" />
                              )}
                              <video
                                class="session-video"
                                src={s.host.video}
                                muted
                                loop
                                playsinline
                                preload="none"
                              ></video>
                            </>
                          ) : !s.image && fadePhotos(s.host).length > 1 ? (
                            <PhotoFade photos={fadePhotos(s.host)} alt="" />
                          ) : (s.image ?? s.host.photo) ? (
                            <img src={s.image ?? s.host.photo} alt="" loading="lazy" decoding="async" />
                          ) : (
                            <HostMonogram name={s.host.name} />
                          )}
                          <Voucher kind="badge" host={s.host} lang={lang} />
                        </a>
                        <span class="session-main">
                          <span class="session-duration">
                            {s.duration ?? s.host.duration}
                            {/* Taught-in languages, one quiet pill each, so
                                nobody books a class they can't follow. */}
                            {(s.languages ?? s.host.languages ?? '').split('·').map((l) => l.trim()).filter(Boolean).map((l) => (
                              <span class="lang-pill">{l}</span>
                            ))}
                          </span>
                          <a class="session-title" href={s.bookUrl} {...bookAttrs(s)}>{s.title}</a>
                          {/* The host's name leads to their own page — every
                              date they run, in one place — where the title
                              beside it leads to the booking. */}
                          <span class="session-host"><a href={hostHref(lang, s.host)}>{s.host.name}</a> · {s.district}</span>
                          <Going n={s.going} lang={lang} />
                          {s.partner && <span class="session-code">{partnerNote[lang](s.partner.percent, s.partner.code)}</span>}
                          {/* The one thing that decides this workshop for
                              somebody — under the picture rather than on it,
                              where the time chip and the spots badge already
                              sit. Only a few workshops carry one. */}
                          {s.usp && <span class="session-usp">{s.usp}</span>}
                          {/* Where the host closes sales before the day
                              itself, so nobody arrives at a booking page
                              that has already shut. */}
                          {s.salesEnd && <span class="session-deadline">{t.salesEnd} {formatDeadline(s.salesEnd)}</span>}
                        </span>
                        {/* Price and Book share one row so every card's
                            action line sits at the same height; the spots
                            note drops underneath. */}
                        <span class="session-side">
                          {s.price && (
                            <span class="session-price">
                              {showPrice(s.price)}
                              {s.priceWas && <s class="session-price-was">{s.priceWas}</s>}
                            </span>
                          )}
                          {s.soldOut ? (
                            <button
                              class="session-book session-notify"
                              type="button"
                              {...bookAttrs(s)}
                            ><svg class="bell-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>{t.notify}</button>
                          ) : s.request ? (
                            <a class="session-book" href={s.bookUrl} {...bookAttrs(s)}>{t.request}</a>
                          ) : (
                            <a class="session-book" href={s.bookUrl} {...bookAttrs(s)}>{s.partner ? partnerBook[lang](s.partner.percent) : t.book}</a>
                          )}
                          {/* For a host who takes vouchers (data/vouchers.ts): a
                              lighter second button straight under Book. */}
                          <Voucher kind="under" host={s.host} lang={lang} title={s.title} workshopKey={s.workshopKey} />
                          {/* People send workshops to friends — the native
                              share sheet where the browser has one, copied
                              link elsewhere. */}
                          <button
                            class="session-share"
                            type="button"
                            aria-label={t.share}
                            title={t.share}
                            data-share-title={s.title}
                            data-share-host={s.host.name}
                            data-share-date={isoDate(s.dayOffset)}
                            data-share-time={s.time}
                            data-share-id={s.id}
                            data-copied-label={t.copied}
                          >
                            <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9V5l7 7-7 7v-4.1c-5 0-8.5 1.6-11 5.1 1-5 4-10 11-11z"/></svg>
                            <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                          </button>
                          {s.soldOut ? (
                            <span class="session-spots session-soldout">{fullLabel(s)}</span>
                          ) : (
                            typeof s.spots === 'number' ? <span class="session-spots">{spotsText(s.spots, lang, t.spots)}</span>
                            : s.almostFull && <span class="session-spots session-almostfull">{almostFullLabel[lang]}</span>
                          )}
                        </span>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
              <p class="daypicker-empty" data-empty hidden>{t.noMatchFilters} <button type="button" class={variant ? 'kal-reset' : 'daypicker-reset'} data-kal-reset>{variant ? k.reset : f.clear}</button></p>
            </>
          ) : (
            <p class="daypicker-empty">{t.none}</p>
          )}
        </div>
      );
    })}
    {/* Several days on show (draft 2, or all days / the weekend live) and
        none of them with anything for the filters. */}
    {variant ? (
      <div class="kal-emptyall" data-kal-empty hidden>
        <p>{k.noMatchAll}</p>
        <button type="button" class="kal-reset" data-kal-reset>{k.reset}</button>
      </div>
    ) : (
      <p class="daypicker-empty" data-kal-empty hidden>{t.noMatchFilters} <button type="button" class="daypicker-reset" data-kal-reset>{f.clear}</button></p>
    )}
    {variant === '2' && <button type="button" class="kal-more" data-kal-more hidden>{k.moreDays}</button>}
    {!variant && <button type="button" class="daypicker-more" data-kal-more hidden>{t.moreDays}</button>}
  </div>
  <DayMap lang={lang} />
  </div>

  {/* The drafts' "on request" row: the same framed tiles, on the page's own
      ground rather than in a tinted panel. */}
  {variant && onRequest.length > 0 && (
    <section class="kal-onrequest">
      <h2 class="kal-h2">{t.onRequestHead}</h2>
      <p class="kal-sub">{t.onRequestNote}</p>
      <ul class="session-list kal-grid">
        {onRequest.map((o) => (
          <li class="session kal-card" id={o.id} data-seen={`s:${o.id}`} data-activity={activitiesOf(o.host).join(' ')} {...priceAttrs(o.price)}
            data-track-card="on-request" data-track-host={o.host.name} data-track-title={o.title}>
            <span class="kal-when"><span class="kal-time">{t.onRequestHead}</span><span class="kal-dur">{o.duration ?? o.host.duration}</span></span>
            <span class="kal-frame">
              <a class="session-thumb" {...(o.host.video ? {} : { href: o.bookUrl, ...inquireAttrs(o) })} tabindex="-1" aria-hidden="true">
                {o.host.video ? (
                  <>
                    {o.host.poster && <img class="session-still" src={o.host.poster} alt="" loading="lazy" decoding="async" />}
                    <video class="session-video" src={o.host.video} muted loop playsinline preload="none"></video>
                  </>
                ) : fadePhotos(o.host).length > 1 ? (
                  <PhotoFade photos={fadePhotos(o.host)} alt="" />
                ) : o.host.photo ? (
                  <img src={o.host.photo} alt="" loading="lazy" decoding="async" />
                ) : (
                  <HostMonogram name={o.host.name} />
                )}
              </a>
            </span>
            <span class="session-main">
              <a class="session-title" href={o.bookUrl} {...inquireAttrs(o)}>{o.title}</a>
              <span class="session-host">{o.host.firstName ?? o.host.name} · {o.district}</span>
            </span>
            <span class="session-side">
              {o.price && <span class="session-price">{showPrice(o.price)}</span>}
              <a class="session-book" href={o.bookUrl} {...inquireAttrs(o)}>{t.inquire}</a>
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* Workshops without published dates sit under the day feed, whatever
      day is selected — the host schedules them around the inquiry. */}
  {!variant && onRequest.length > 0 && (
    <section class="timegroup onrequest">
      <h3 class="timegroup-head">{t.onRequestHead}</h3>
      <p class="onrequest-note">{t.onRequestNote}</p>
      <ul class="session-list">
        {onRequest.map((o) => (
          <li class="session" id={o.id} data-seen={`s:${o.id}`} data-activity={activitiesOf(o.host).join(' ')} {...priceAttrs(o.price)}
            data-track-card="on-request" data-track-host={o.host.name} data-track-title={o.title}>
            {/* Same tile as a dated card: the host's reel where footage
                exists, otherwise the stock photo. */}
            <a
              class="session-thumb"
              {...(o.host.video ? {} : { href: o.bookUrl, ...inquireAttrs(o) })}
              tabindex="-1"
              aria-hidden="true"
            >
              {/* The still underneath, as on a dated card: the reel stays
                  transparent until its first frame, so a tile resting on
                  the video's own poster showed nothing but the panel until
                  the walk (or a hover) reached it. */}
              {o.host.video ? (
                <>
                  {o.host.poster && (
                    <img class="session-still" src={o.host.poster} alt="" loading="lazy" decoding="async" />
                  )}
                  <video
                    class="session-video"
                    src={o.host.video}
                    muted
                    loop
                    playsinline
                    preload="none"
                  ></video>
                </>
              ) : fadePhotos(o.host).length > 1 ? (
                <PhotoFade photos={fadePhotos(o.host)} alt="" />
              ) : o.host.photo ? (
                <img src={o.host.photo} alt="" loading="lazy" decoding="async" />
              ) : (
                <HostMonogram name={o.host.name} />
              )}
            </a>
            <span class="session-main">
              <span class="session-duration">
                {o.duration ?? o.host.duration}
                {(o.languages ?? o.host.languages ?? '').split('·').map((l) => l.trim()).filter(Boolean).map((l) => (
                  <span class="lang-pill">{l}</span>
                ))}
              </span>
              <a class="session-title" href={o.bookUrl} {...inquireAttrs(o)}>{o.title}</a>
              <span class="session-host">{o.host.name} · {o.district}</span>
              {o.usp && <span class="session-usp">{o.usp}</span>}
                          {/* Where the host closes sales before the day
                              itself, so nobody arrives at a booking page
                              that has already shut. */}
                          {o.salesEnd && <span class="session-deadline">{t.salesEnd} {formatDeadline(o.salesEnd)}</span>}
            </span>
            <span class="session-side">
              {o.price && (
                            <span class="session-price">
                              {showPrice(o.price)}
                              {o.priceWas && <s class="session-price-was">{o.priceWas}</s>}
                            </span>
                          )}
              <a class="session-book" href={o.bookUrl} {...inquireAttrs(o)}>{t.inquire}</a>
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

</div>

<script>
  import { startReelWalk } from '../lib/reelwalk.ts';
  import { startDayMap } from '../lib/daymap.ts';

  // The build is static, so the calendar cannot know what "today" is. Every
  // chip's date is resolved here against the visitor's own clock, and the
  // groups underneath are plain show/hide — which means the schedule is in the
  // HTML for search engines and still readable if this never runs.
  /** Which days are on show: one (its offset from today), every day, or
   *  the weekend. */
  type Selection = number | 'all' | 'weekend';

  document.querySelectorAll<HTMLElement>('[data-daypicker]').forEach((root) => {
    const locale = root.dataset.locale || 'en-GB';
    const copy: Record<string, string> = JSON.parse(root.dataset.clientCopy || '{}');
    const fill = (template: string, values: Record<string, string>) =>
      template.replace(/\{(\w+)\}/g, (_, key) => values[key] ?? '');
    /* The redesign drafts (DayPicker's `variant`). Draft 2 can show every
       day at once, grouped by day, in windows of a week. */
    const variant = root.dataset.variant || '';
    const allDaysMode = root.dataset.allDays === 'true';
    // The day chips (the drafts) or pills (live), and "all days".
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-offset]'));
    const dayChips = chips.filter((c) => c.dataset.offset !== 'all');
    const groups = Array.from(root.querySelectorAll<HTMLElement>('.daygroup'));
    const monthEl = root.querySelector<HTMLElement>('[data-month]');
    const daySelects = Array.from(root.querySelectorAll<HTMLSelectElement>('select[data-day-select]'));
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const dateAt = (offset: number) => {
      const date = new Date(today);
      date.setDate(date.getDate() + offset);
      return date;
    };

    // Grid ↔ list, remembered per visitor. Grid is the baked-in default.
    // The drafts have one layout each and no toggle.
    const viewBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view-btn]'));
    const setView = (v: string) => {
      root.dataset.view = v;
      viewBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.viewBtn === v));
      try { localStorage.setItem('twiggli-view', v); } catch { /* private mode */ }
    };
    if (viewBtns.length) {
      let savedView = 'grid';
      try { savedView = localStorage.getItem('twiggli-view') || 'grid'; } catch { /* private mode */ }
      if (savedView !== 'grid') setView(savedView);
      viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.viewBtn || 'grid')));
    }

    const monthOf = (date: Date) => date.toLocaleDateString(locale, { month: 'long' });
    if (monthEl) monthEl.textContent = monthOf(today);

    // The page heading follows the selected day: "Happening today" →
    // "Happening tomorrow" → "Happening this Sunday" → "Happening next
    // Sunday" → "Happening on 12 October" (and the German equivalents).
    const happeningTitle = document.querySelector<HTMLElement>('[data-happening-title]');
    // A draft's heading keeps its own words and hand-set accent; only the
    // day in it changes.
    const happeningWhen = document.querySelector<HTMLElement>('[data-happening-when]');
    const whenFor = (offset: number, date: Date): string => {
      const weekday = date.toLocaleDateString(locale, { weekday: 'long' });
      return offset === 0 ? copy.today
        : offset === 1 ? copy.tomorrow
        : offset <= 6 ? fill(copy.thisDay, { weekday })
        : offset <= 13 ? fill(copy.nextDay, { weekday })
        : fill(copy.onDate, { date: date.toLocaleDateString(locale, { day: 'numeric', month: 'long' }) });
    };
    // One title carries both the place and the chosen day, so the page has
    // a single heading rather than a kicker repeating it.
    const setHeading = (offset: Selection) => {
      if (happeningWhen) {
        if (offset !== 'weekend') happeningWhen.textContent = offset === 'all' ? (root.dataset.whenSoon || '') : whenFor(offset, dateAt(offset));
      } else if (happeningTitle) {
        const when = offset === 'all' ? copy.soon : offset === 'weekend' ? copy.weekend : whenFor(offset, dateAt(offset));
        happeningTitle.textContent = fill(copy.heading, { when });
      }
    };

    const shortDay = (offset: number, date: Date) =>
      offset === 0 ? root.dataset.today || 'Today'
      : offset === 1 ? root.dataset.tomorrow || 'Tomorrow'
      : date.toLocaleDateString(locale, { weekday: 'short' });

    dayChips.forEach((chip) => {
      const offset = Number(chip.dataset.offset || 0);
      const date = dateAt(offset);
      const dow = chip.querySelector('.daychip-dow, .dpill-dow');
      const num = chip.querySelector('.daychip-num, .dpill-num');
      const mon = chip.querySelector('.dpill-mon');
      if (dow) dow.textContent = shortDay(offset, date).replace('.', '');
      if (mon) mon.textContent = date.toLocaleDateString(locale, { month: 'short' }).replace('.', '');
      // Just the day number — the month is spelled out once above the strip.
      if (num) num.textContent = date.toLocaleDateString(locale, { day: 'numeric' });
      chip.setAttribute(
        'aria-label',
        date.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' }),
      );
      chip.classList.toggle('is-weekend', date.getDay() === 0 || date.getDay() === 6);
      // The first of a month is where the strip says which month it is.
      if (variant && date.getDate() === 1) chip.dataset.month = date.toLocaleDateString(locale, { month: 'short' });
    });
    // The "When?" select, in the visitor's own days.
    daySelects.forEach((select) => {
      Array.from(select.options).forEach((option) => {
        const offset = Number(option.value);
        if (Number.isNaN(offset)) return;
        const date = dateAt(offset);
        option.textContent = offset < 2
          ? shortDay(offset, date)
          : date.toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short' });
      });
    });
    // Draft 2's day headings, likewise.
    root.querySelectorAll<HTMLElement>('[data-dayhead]').forEach((head) => {
      const offset = Number(head.dataset.dayhead || 0);
      const date = dateAt(offset);
      const main = head.querySelector('.kal-dayhead-main');
      const sub = head.querySelector('.kal-dayhead-sub');
      if (main) main.textContent = offset < 2 ? shortDay(offset, date) : date.toLocaleDateString(locale, { weekday: 'long' });
      if (sub) sub.textContent = date.toLocaleDateString(locale, offset < 2
        ? { weekday: 'long', day: 'numeric', month: 'long' }
        : { day: 'numeric', month: 'long' });
    });

    /* Which days are on show: a day's offset, every day, or the weekend —
       this one's, or today alone on a Sunday. */
    const defaultSelection: Selection = allDaysMode ? 'all' : 0;
    let selected: Selection = defaultSelection;
    const weekendDays = today.getDay() === 0 ? [0] : [6 - today.getDay(), 7 - today.getDay()];
    /** The offsets a selection covers; null for every day. */
    const daysOf = (sel: Selection): number[] | null =>
      sel === 'all' ? null : sel === 'weekend' ? weekendDays : [sel];
    const several = () => selected === 'all' || selected === 'weekend';
    const whenToggles = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-when]'));
    /** Draft 2 shows the days a week at a time; "more" adds a week. */
    const WINDOW = 7;
    let windowDays = WINDOW;

    const selectDay = (offset: Selection) => {
      selected = offset;
      windowDays = WINDOW;
      const key = String(offset);
      const covered = daysOf(offset);
      chips.forEach((c) => {
        const on = c.dataset.offset === 'all' ? offset === 'all' : !!covered?.includes(Number(c.dataset.offset));
        c.setAttribute('aria-selected', String(on));
        // Days before the selected one grey out, like the app's strip —
        // the eye reads position at a glance without boxes around dates.
        c.classList.toggle('is-before', typeof offset === 'number' && c.dataset.offset !== 'all' && Number(c.dataset.offset || 0) < offset);
      });
      whenToggles.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.when === (offset === 0 ? 'today' : offset))));
      daySelects.forEach((s) => { if (typeof offset === 'number') s.value = key; });
      if (typeof offset === 'number') groups.forEach((g) => { g.hidden = g.dataset.day !== key; });
      // Several days on show carry a heading each.
      root.toggleAttribute('data-several', several());
      if (monthEl) monthEl.textContent = monthOf(typeof offset === 'number' ? dateAt(offset) : today);
      setHeading(offset);
      const chip = chips.find((c) => c.dataset.offset === (covered ? String(covered[0]) : 'all'));
      if (chip?.parentElement) {
        // Only the strip itself scrolls: the page stays where it is.
        const strip = chip.parentElement;
        const left = strip.scrollLeft + chip.getBoundingClientRect().left - strip.getBoundingClientRect().left
          - (strip.clientWidth - chip.offsetWidth) / 2;
        strip.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
      }
      // The sheet counts the day on show, so a new day is a new count.
      applyFilters();
      calendar?.render();
    };
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const o = chip.dataset.offset;
        selectDay(o === 'all' ? 'all' : Number(o || 0));
      });
    });
    // Today and the weekend are toggles: on again, they go back to every day.
    whenToggles.forEach((b) => {
      b.addEventListener('click', () => {
        const want: Selection = b.dataset.when === 'weekend' ? 'weekend' : 0;
        selectDay(selected === want ? 'all' : want);
      });
    });
    daySelects.forEach((s) => s.addEventListener('change', () => selectDay(Number(s.value))));

    // Live filtering: the activity and district pill rows combine. A time
    // header disappears with its last matching session, and an empty day
    // shows the no-match line.
    const activityPills = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-activity-filter]'));
    const districtPills = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-district-filter]'));
    // The drafts choose with selects as well as with pills.
    const activitySelects = Array.from(root.querySelectorAll<HTMLSelectElement>('select[data-activity-select]'));
    const districtSelects = Array.from(root.querySelectorAll<HTMLSelectElement>('select[data-district-select]'));
    const kidsPill = root.querySelector<HTMLButtonElement>('[data-kids-filter]');
    const eveningPill = root.querySelector<HTMLButtonElement>('[data-evening-filter]');
    // "Under €50": the bands up to €50, on together.
    const under50Pill = root.querySelector<HTMLButtonElement>('[data-under50]');
    const under50 = (under50Pill?.dataset.under50 ?? '').split(',').filter(Boolean);
    // Price per person, in bands (priceFilter.ts): a band's id and its
    // (min, max] in euros. A card carries its price as data-price-min/max; a
    // span ("€40–100") is in every band it touches, and a card with no price
    // (on request) only shows while no band is picked.
    const pricePills = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-price-filter]'));
    const priceSelects = Array.from(root.querySelectorAll<HTMLSelectElement>('select[data-price-select]'));
    const priceBands = new Map<string, [number, number]>(
      (JSON.parse(root.dataset.priceBands || '[]') as [string, number, number | null][])
        .map(([id, min, max]) => [id, [min, max ?? Infinity]]));
    let activityFilter = 'all';
    let districtFilter = 'all';
    /** The bands picked; none picked is every price. */
    const priceFilter = new Set<string>();
    let kidsOnly = false;
    let eveningOnly = false;
    const inPrice = (li: HTMLElement) => {
      if (!priceFilter.size) return true;
      if (li.dataset.priceMin === undefined) return false;
      const lo = Number(li.dataset.priceMin);
      const hi = Number(li.dataset.priceMax ?? li.dataset.priceMin);
      return [...priceFilter].some((id) => {
        const band = priceBands.get(id);
        return !!band && lo <= band[1] && hi > band[0];
      });
    };
    const isUnder50 = () => under50.length > 0 && priceFilter.size === under50.length && under50.every((id) => priceFilter.has(id));
    const hasValue = (value: string, pills: HTMLButtonElement[], key: 'activityFilter' | 'districtFilter' | 'priceFilter', selects: HTMLSelectElement[]) =>
      pills.some((p) => p.dataset[key] === value) || selects.some((s) => Array.from(s.options).some((o) => o.value === value));

    /* The count, what is on, and the "More filters" sheet (live). */
    const resultForms: Record<string, string> = JSON.parse(root.dataset.results || '{}');
    const plural = new Intl.PluralRules(locale);
    const results = (n: number) => (resultForms[plural.select(n)] ?? resultForms.other ?? '{n}').replace('{n}', String(n));
    const countEls = Array.from(root.querySelectorAll<HTMLElement>('[data-count]'));
    const showBtns = Array.from(root.querySelectorAll<HTMLElement>('[data-show-count]'));
    const onChips = root.querySelector<HTMLElement>('[data-on-chips]');
    const resetLinks = Array.from(root.querySelectorAll<HTMLElement>('[data-reset-link]'));
    const sheetBadge = root.querySelector<HTMLElement>('[data-sheet-badge]');
    const emptyAll = root.querySelector<HTMLElement>('[data-kal-empty]');
    const moreBtn = root.querySelector<HTMLButtonElement>('[data-kal-more]');

    // Set once the map is running (below); the filters tell it what to show.
    let dayMap: { update: () => void } | undefined;
    let walk: { resync: () => void } | undefined;
    let calendar: { render: () => void } | undefined;

    /** Every filter but the district — what the map shows. */
    const matchesBesidesDistrict = (li: HTMLElement) =>
      (activityFilter === 'all' || (li.dataset.activity ?? '').split(' ').includes(activityFilter)) &&
      inPrice(li) &&
      (!kidsOnly || li.dataset.kids === 'true') &&
      (!eveningOnly || li.dataset.evening === 'true');
    const matches = (li: HTMLElement) =>
      matchesBesidesDistrict(li) && (districtFilter === 'all' || li.dataset.district === districtFilter);

    const applyFilters = () => {
      root.querySelectorAll<HTMLElement>('.session').forEach((li) => {
        // A draft's "on request" row is not a day's: only the activity and
        // the price apply.
        if (variant && !li.closest('.daygroup')) {
          li.hidden = !((activityFilter === 'all' || (li.dataset.activity ?? '').split(' ').includes(activityFilter)) && inPrice(li));
          return;
        }
        li.hidden = !matches(li);
      });
      // A membership tile goes with its host's cards: shown while one is.
      root.querySelectorAll<HTMLElement>('.promo').forEach((promo) => {
        promo.hidden = !promo.parentElement?.querySelector(`.session[data-host="${promo.dataset.promoHost}"]:not([hidden])`);
      });
      root.querySelectorAll<HTMLElement>('.timegroup, .kal-onrequest').forEach((group) => {
        group.hidden = !group.querySelector('.session:not([hidden])');
      });
      groups.forEach((day) => {
        const empty = day.querySelector<HTMLElement>('[data-empty]');
        if (empty) empty.hidden = !!day.querySelector('.timegroup:not([hidden])');
      });
      // Several days at once (every day, the weekend): the days with
      // something on, a week of them at a time.
      const covered = daysOf(selected);
      const inSelection = (day: HTMLElement) => !covered || covered.includes(Number(day.dataset.day));
      if (several()) {
        let n = 0;
        let more = false;
        groups.forEach((day) => {
          const any = inSelection(day) && !!day.querySelector('.session:not([hidden])');
          if (any && n < windowDays) { day.hidden = false; n++; }
          else { day.hidden = true; if (any) more = true; }
        });
        if (moreBtn) moreBtn.hidden = !more;
        if (emptyAll) emptyAll.hidden = n > 0;
      } else {
        if (moreBtn) moreBtn.hidden = true;
        if (emptyAll) emptyAll.hidden = true;
      }

      /* Only the days chosen count — every other day is in the page too,
         and counting those would promise workshops that are not there. */
      let shown = 0;
      groups.forEach((day) => {
        if (inSelection(day)) shown += day.querySelectorAll('.session:not([hidden])').length;
      });
      countEls.forEach((el) => { el.textContent = results(shown); });
      // "Show 6 workshops" on the button that shuts the sheet, so the reader
      // sees what they are about to be left with before it closes.
      showBtns.forEach((el) => { el.textContent = (el.dataset.show ?? '%s').replace('%s', results(shown)); });

      // The toggles' own state.
      eveningPill?.setAttribute('aria-pressed', String(eveningOnly));
      under50Pill?.setAttribute('aria-pressed', String(isUnder50()));

      /* What the sheet holds, named over the list with a cross each, so a
         shut sheet is never a hidden state; the toggles show their own. */
      const label = (el: Element | null) => (el?.textContent ?? '').trim();
      const on: [string, string, string][] = [];
      if (activityFilter !== 'all')
        // The name without its emoji.
        on.push(['activity', activityFilter, (root.querySelector(`.dchip[data-activity-filter="${activityFilter}"]`)?.lastChild?.textContent ?? '').trim()]);
      if (districtFilter !== 'all') on.push(['district', districtFilter, districtFilter]);
      if (!isUnder50())
        priceFilter.forEach((id) => on.push(['price', id, label(root.querySelector(`.dchip[data-price-filter="${id}"]`))]));
      if (onChips) {
        onChips.textContent = '';
        for (const [kind, value, name] of on) {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'donchip';
          chip.dataset.drop = kind;
          chip.dataset.value = value;
          chip.innerHTML = '<span></span><span aria-hidden="true">×</span>';
          chip.firstElementChild!.textContent = name;
          onChips.append(chip);
        }
      }
      if (sheetBadge) {
        sheetBadge.textContent = String(on.length);
        sheetBadge.hidden = on.length === 0;
      }
      const anything = on.length > 0 || priceFilter.size > 0 || kidsOnly || eveningOnly;
      resetLinks.forEach((el) => { el.hidden = !anything; });
      dayMap?.update();
      calendar?.render();
      walk?.resync();
      syncAddress();
    };

    /* The address follows the filters, so a filtered calendar can be
       shared as it is: ?activity=…&district=…&price=…&date=YYYY-MM-DD, the
       same names the home page's search pill sends. Only what is set goes
       in; anything else in the address (and the #card) is left alone. Off
       until the address has been read on arrival, below, so the first
       paint cannot wipe a link's filters before they are applied. */
    let addressRead = false;
    const syncAddress = () => {
      if (!addressRead) return;
      const url = new URL(location.href);
      const set = (key: string, value: string | null) => {
        if (value) url.searchParams.set(key, value); else url.searchParams.delete(key);
      };
      set('activity', activityFilter === 'all' ? null : activityFilter);
      set('district', districtFilter === 'all' ? null : districtFilter);
      set('price', [...priceBands.keys()].filter((id) => priceFilter.has(id)).join(',') || null);
      set('evening', eveningOnly ? '1' : null);
      set('kids', kidsOnly ? '1' : null);
      if (selected === defaultSelection) set('date', null);
      else if (selected === 'all' || selected === 'weekend') set('date', selected);
      else {
        const d = dateAt(selected);
        set('date', `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`);
      }
      // Several bands read better as ?price=0-30,30-50 than with %2C.
      url.search = url.search.replace(/%2C/gi, ',');
      if (url.href !== location.href) history.replaceState(history.state, '', url);
    };

    const setActivity = (value: string) => {
      activityFilter = value;
      activityPills.forEach((p) => {
        p.classList.toggle('is-active', p.dataset.activityFilter === value);
        if (p.hasAttribute('aria-pressed')) p.setAttribute('aria-pressed', String(p.dataset.activityFilter === value));
      });
      activitySelects.forEach((s) => { s.value = value; });
      applyFilters();
    };
    const districtLabels = Array.from(root.querySelectorAll<HTMLElement>('[data-district-label]'));
    const setDistrict = (value: string) => {
      districtFilter = value;
      districtPills.forEach((p) => {
        p.classList.toggle('is-active', p.dataset.districtFilter === value);
        if (p.hasAttribute('aria-pressed')) p.setAttribute('aria-pressed', String(p.dataset.districtFilter === value));
      });
      districtSelects.forEach((s) => { s.value = value; });
      districtLabels.forEach((el) => {
        el.textContent = value === 'all' ? el.dataset.any || '' : value;
        el.closest('button')?.classList.toggle('is-on', value !== 'all');
      });
      applyFilters();
    };
    const priceLabels = Array.from(root.querySelectorAll<HTMLElement>('[data-price-label]'));
    /** Sets the bands picked: one ("30-50"), several, or none ("all"). */
    const setPrice = (value: string | string[]) => {
      priceFilter.clear();
      (Array.isArray(value) ? value : [value]).forEach((id) => { if (id && id !== 'all') priceFilter.add(id); });
      const only = priceFilter.size === 1 ? [...priceFilter][0] : 'all';
      pricePills.forEach((p) => {
        const on = p.dataset.priceFilter === 'all' ? priceFilter.size === 0 : priceFilter.has(p.dataset.priceFilter || '');
        p.classList.toggle('is-active', on);
        if (p.hasAttribute('aria-pressed')) p.setAttribute('aria-pressed', String(on));
      });
      priceSelects.forEach((s) => { s.value = only; });
      priceLabels.forEach((el) => {
        const pill = pricePills.find((p) => p.dataset.priceFilter === only);
        el.textContent = only === 'all' ? el.dataset.any || '' : (pill?.textContent ?? '').trim();
        el.closest('button')?.classList.toggle('is-on', only !== 'all');
      });
      applyFilters();
    };
    const setKids = (on: boolean) => {
      kidsOnly = on;
      kidsPill?.classList.toggle('is-active', on);
      kidsPill?.setAttribute('aria-pressed', String(on));
      applyFilters();
    };
    const setEvening = (on: boolean) => {
      eveningOnly = on;
      applyFilters();
    };

    // A chosen activity or district, tapped again, is let go.
    activityPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const v = pill.dataset.activityFilter || 'all';
        setActivity(v !== 'all' && v === activityFilter ? 'all' : v);
      });
    });
    districtPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const v = pill.dataset.districtFilter || 'all';
        setDistrict(v !== 'all' && v === districtFilter ? 'all' : v);
      });
    });
    // Bands combine: each one a toggle. A draft's menu picks just one.
    pricePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const v = pill.dataset.priceFilter || 'all';
        if (variant || v === 'all') { setPrice(v); return; }
        const next = new Set(priceFilter);
        if (next.has(v)) next.delete(v); else next.add(v);
        setPrice([...next]);
      });
    });
    under50Pill?.addEventListener('click', () => setPrice(isUnder50() ? [] : under50));
    eveningPill?.addEventListener('click', () => setEvening(!eveningOnly));
    // The crosses on what is on.
    onChips?.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLElement>('[data-drop]');
      if (!chip) return;
      if (chip.dataset.drop === 'activity') setActivity('all');
      else if (chip.dataset.drop === 'district') setDistrict('all');
      else setPrice([...priceFilter].filter((id) => id !== chip.dataset.value));
    });
    priceSelects.forEach((s) => s.addEventListener('change', () => setPrice(s.value || 'all')));
    activitySelects.forEach((s) => s.addEventListener('change', () => setActivity(s.value || 'all')));
    districtSelects.forEach((s) => s.addEventListener('change', () => setDistrict(s.value || 'all')));
    kidsPill?.addEventListener('click', () => setKids(!kidsOnly));
    const clearAll = () => {
      if (kidsOnly) setKids(false);
      if (eveningOnly) setEvening(false);
      setActivity('all');
      setDistrict('all');
      setPrice('all');
    };
    root.querySelectorAll<HTMLButtonElement>('[data-kal-reset]').forEach((b) => b.addEventListener('click', clearAll));
    moreBtn?.addEventListener('click', () => {
      windowDays += WINDOW;
      applyFilters();
    });

    /* The "More filters" sheet. Choosing keeps it open; the cross, the
       scrim, Escape and the show button close it and hand focus back to
       the button that opened it. */
    const sheet = root.querySelector<HTMLElement>('[data-sheet]');
    const sheetOpen = root.querySelector<HTMLButtonElement>('[data-sheet-open]');
    const scrim = root.querySelector<HTMLElement>('.dscrim');
    if (sheet && sheetOpen) {
      const setSheet = (open: boolean) => {
        sheet.hidden = !open;
        if (scrim) scrim.hidden = !open;
        sheetOpen.setAttribute('aria-expanded', String(open));
        document.documentElement.classList.toggle('sheet-locked', open);
        if (open) sheet.querySelector<HTMLElement>('.dsheet-x')?.focus();
        else sheetOpen.focus();
      };
      sheetOpen.addEventListener('click', () => setSheet(sheet.hidden));
      root.querySelectorAll<HTMLElement>('[data-sheet-close]').forEach((el) => el.addEventListener('click', () => setSheet(false)));
      document.addEventListener('keydown', (event) => {
        if ((event as KeyboardEvent).key === 'Escape' && !sheet.hidden) setSheet(false);
      });
    }

    /* Draft 3's district and price menus: a button and the list under it. */
    root.querySelectorAll<HTMLButtonElement>('[data-kal-menu-btn]').forEach((menuBtn) => {
      const menu = menuBtn.parentElement?.querySelector<HTMLElement>('[data-kal-menu]');
      if (!menu) return;
      const setMenu = (open: boolean) => {
        menu.hidden = !open;
        menuBtn.setAttribute('aria-expanded', String(open));
      };
      menuBtn.addEventListener('click', () => setMenu(menu.hidden));
      menu.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('[data-district-filter], [data-price-filter]')) setMenu(false);
      });
      document.addEventListener('click', (event) => {
        const target = event.target as Node;
        if (!menu.hidden && !menu.contains(target) && !menuBtn.contains(target)) setMenu(false);
      });
      document.addEventListener('keydown', (event) => {
        if ((event as KeyboardEvent).key === 'Escape' && !menu.hidden) { setMenu(false); menuBtn.focus(); }
      });
    });

    /* Draft 2's month calendar: the visitor's own month, a dot under every
       day with something on for the filters in force. */
    const cal = root.querySelector<HTMLElement>('[data-minical]');
    if (cal) {
      const grid = cal.querySelector<HTMLElement>('[data-cal-grid]')!;
      const monthLabel = cal.querySelector<HTMLElement>('[data-cal-month]')!;
      const prev = cal.querySelector<HTMLButtonElement>('[data-cal-prev]')!;
      const next = cal.querySelector<HTMLButtonElement>('[data-cal-next]')!;
      const allBtn = cal.querySelector<HTMLButtonElement>('[data-cal-all]');
      const last = groups.length - 1;
      let shownMonth = new Date(today.getFullYear(), today.getMonth(), 1);
      const lastMonth = (() => { const d = dateAt(last); return new Date(d.getFullYear(), d.getMonth(), 1); })();
      // Monday first, in the visitor's language.
      const weekdays = Array.from({ length: 7 }, (_, i) =>
        new Date(2024, 0, 1 + i).toLocaleDateString(locale, { weekday: 'narrow' }));
      const render = () => {
        monthLabel.textContent = shownMonth.toLocaleDateString(locale, { month: 'long', year: 'numeric' });
        prev.disabled = shownMonth <= new Date(today.getFullYear(), today.getMonth(), 1);
        next.disabled = shownMonth >= lastMonth;
        grid.textContent = '';
        for (const w of weekdays) {
          const el = document.createElement('span');
          el.className = 'kal-cal-dow';
          el.textContent = w;
          grid.append(el);
        }
        const lead = (shownMonth.getDay() + 6) % 7;
        for (let i = 0; i < lead; i++) grid.append(document.createElement('span'));
        const days = new Date(shownMonth.getFullYear(), shownMonth.getMonth() + 1, 0).getDate();
        for (let d = 1; d <= days; d++) {
          const date = new Date(shownMonth.getFullYear(), shownMonth.getMonth(), d);
          const offset = Math.round((date.getTime() - today.getTime()) / 86400000);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'kal-cal-day';
          btn.textContent = String(d);
          const group = groups[offset];
          if (offset < 0 || offset > last || !group) {
            btn.disabled = true;
          } else {
            const any = Array.from(group.querySelectorAll<HTMLElement>('.session')).some(matches);
            if (any) btn.classList.add('has-on');
            if (offset === 0) btn.classList.add('is-today');
            if (selected === offset) btn.classList.add('is-selected');
            btn.setAttribute('aria-label', date.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' }));
            btn.addEventListener('click', () => selectDay(selected === offset ? 'all' : offset));
          }
          grid.append(btn);
        }
        allBtn?.classList.toggle('is-active', selected === 'all');
      };
      prev.addEventListener('click', () => { shownMonth = new Date(shownMonth.getFullYear(), shownMonth.getMonth() - 1, 1); render(); });
      next.addEventListener('click', () => { shownMonth = new Date(shownMonth.getFullYear(), shownMonth.getMonth() + 1, 1); render(); });
      allBtn?.addEventListener('click', () => selectDay('all'));
      calendar = {
        render: () => {
          // A chosen day in another month brings its month along.
          if (typeof selected === 'number') {
            const d = dateAt(selected);
            shownMonth = new Date(d.getFullYear(), d.getMonth(), 1);
          }
          render();
        },
      };
    }

    const visibleDays = () => groups.filter((g) => !g.hidden);
    dayMap = startDayMap(root, {
      // Every filter but the district: the map is where the district is chosen.
      sessions: () => visibleDays().flatMap((day) =>
        Array.from(day.querySelectorAll<HTMLElement>('.session')).filter(matchesBesidesDistrict)),
      district: () => districtFilter,
      pick: (name) => { if (name === 'all' || hasValue(name, districtPills, 'districtFilter', districtSelects)) setDistrict(name); },
      day: () => String(selected),
    });

    // First paint: the bar and the count start out true.
    applyFilters();
    root.toggleAttribute('data-several', several());
    if (variant) setHeading(selected);

    // Share: the native sheet where the browser offers one (phones), a
    // copied link elsewhere — the text carries workshop, host and date.
    root.querySelectorAll<HTMLButtonElement>('.session-share').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const d = btn.dataset;
        const when = d.shareDate
          ? new Date(`${d.shareDate}T00:00:00`).toLocaleDateString(locale, {
              weekday: 'long', day: 'numeric', month: 'long',
            })
          : '';
        const text = fill(copy.share, {
          title: d.shareTitle || '', host: d.shareHost || '', when,
          time: d.shareTime ? fill(copy.shareTime, { time: d.shareTime }) : '',
        });
        // Our own card, not the host's page: a friend books through us too.
        const url = `${location.origin}${location.pathname}${d.shareId ? `#${d.shareId}` : ''}`;
        try {
          if (navigator.share) {
            await navigator.share({ title: d.shareTitle, text, url });
            return;
          }
          await navigator.clipboard.writeText(`${text}\n${url}`);
          btn.classList.add('is-copied');
          btn.setAttribute('aria-label', d.copiedLabel || 'Link copied');
          setTimeout(() => {
            btn.classList.remove('is-copied');
            btn.setAttribute('aria-label', btn.title);
          }, 1600);
        } catch {
          /* share sheet dismissed */
        }
      });
    });

    // A search from elsewhere (the home page's what / when / where pill)
    // arrives as ?activity=…&date=YYYY-MM-DD&district=…&price=… and sets the same
    // filters and day a visitor would. Anything that names no filter on
    // this page is ignored, so a stale link still lands on the calendar.
    {
      const params = new URLSearchParams(location.search);
      const activity = params.get('activity');
      const district = params.get('district');
      const date = params.get('date');
      if (activity && hasValue(activity, activityPills, 'activityFilter', activitySelects)) setActivity(activity);
      if (district && hasValue(district, districtPills, 'districtFilter', districtSelects)) setDistrict(district);
      // ?price=30-50, or several bands as ?price=0-30,30-50 ("under €50");
      // the top band also as 80+ (which arrives as "80 "), 80- or a bare 80.
      const prices = (params.get('price') ?? '').split(',')
        .map((raw) => raw.trim().toLowerCase())
        .map((raw) => (/^80(\+|-|plus)?$/.test(raw) ? '80plus' : raw))
        .filter((id) => id && hasValue(id, pricePills, 'priceFilter', priceSelects));
      if (prices.length) setPrice(variant ? prices[0] : prices);
      if (params.get('evening') && eveningPill) setEvening(true);
      if (params.get('kids') && kidsPill) setKids(true);
      // ?date=YYYY-MM-DD for one day — any day in the page, the strip's or
      // later — or ?date=weekend / ?date=all.
      if (date === 'all' || (date === 'weekend' && whenToggles.length)) selectDay(date);
      else if (date && /^\d{4}-\d{2}-\d{2}$/.test(date)) {
        const [y, m, dd] = date.split('-').map(Number);
        const offset = Math.round((new Date(y, m - 1, dd).getTime() - today.getTime()) / 86400000);
        if (groups.some((g) => g.dataset.day === String(offset))) selectDay(offset);
      }
      addressRead = true;
      syncAddress();
    }

    // A notification email links straight to its card (#live-…): select
    // that card's day, scroll to it and highlight it, so the reader lands
    // on the Book button.
    if (location.hash) {
      const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (target && root.contains(target)) {
        const day = target.closest<HTMLElement>('.daygroup')?.dataset.day;
        if (day !== undefined) selectDay(Number(day));
        setTimeout(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          target.classList.add('is-highlighted');
        }, 150);
      }
    }

    /* Reels play themselves, one at a time, walking across the feed — see
       lib/reelwalk.ts, which the host directory uses too. The drafts walk
       down the grid a row at a time, one reel in each. */
    const tiles = Array.from(root.querySelectorAll<HTMLElement>('.session-thumb'));
    const reels = tiles
      .map((tile) => ({ tile, video: tile.querySelector<HTMLVideoElement>('.session-video'), card: tile.closest<HTMLElement>('.session') ?? undefined }))
      .filter((r): r is { tile: HTMLElement; video: HTMLVideoElement; card: HTMLElement | undefined } => !!r.video);
    walk = variant
      ? startReelWalk(reels, { byRow: true, step: 1, startAt: 0, playingClass: 'is-playing' })
      : startReelWalk(reels.map(({ tile, video }) => ({ tile, video })));
  });
</script>
