---
import { getSessions, getOnRequest, berlinTodayMs, DAYS_AHEAD, type Session, type OnRequestWorkshop } from '../data/sessions.ts';
import { filterCopy, type ActivityKey } from '../data/content.ts';
import { hostHref } from '../data/seo.ts';
import { requestEmail } from '../data/site.ts';
import HostMonogram from './HostMonogram.astro';
import { DEFAULT_LANG, LANG_META, type Lang } from '../lib/url.ts';
import { ui } from '../data/i18n.ts';

/** The schedule feed, styled after the app's search screen: the borderless
 *  day strip right at the top, one row of activity pills under it (the only
 *  filter), and the day's sessions grouped under bold time headers. The
 *  pills filter the list live, client-side. */
interface Props { lang?: Lang }
const { lang = DEFAULT_LANG } = Astro.props;

const sessions = getSessions(lang);
const onRequest = getOnRequest(lang);
const days = Array.from({ length: DAYS_AHEAD }, (_, i) => i);

// Only activities that actually have sessions get a pill — no dead filters.
const ACTIVITY_ORDER: ActivityKey[] = ['ceramics', 'art', 'craft', 'food', 'photography', 'wellbeing', 'music'];
const present = new Set(sessions.map((s) => s.host.activity));
const activities = ACTIVITY_ORDER.filter((a) => present.has(a));
const activityLabels = filterCopy[lang].activities;

/** A small emoji inside each activity pill — recognisable at a glance
 *  without reading, kept discreet by size and opacity in the CSS. */
const activityIcons: Record<ActivityKey, string> = {
  ceramics: '🏺', art: '🎨', craft: '🛠️', food: '🍳',
  photography: '📷', wellbeing: '🌿', music: '🥁',
};

/** A venue qualifier after the district ("Spandau St. Wilhelm") folds into
 *  its district so the filter stays a clean list of places. */
const districtOf = (s: Session): string => s.district.replace(/\s+St\.\s.*$/, '');
const districts = [...new Set(sessions.map(districtOf))].sort((a, b) => a.localeCompare(b));

// The kids pill follows the no-dead-filters rule: it only renders once the
// feed actually carries sessions designed for children.
const hasKids = sessions.some((s) => s.kids);

/** Sessions arrive sorted by time, so grouping keeps that order. */
const byTime = (list: Session[]): [string, Session[]][] => {
  const groups = new Map<string, Session[]>();
  for (const s of list) {
    const key = s.time ?? '';
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key)!.push(s);
  }
  return [...groups.entries()];
};

const t = ui(lang).calendar;

/** Request-by-mail hosts: the button opens a prefilled email to Twiggli
 *  instead of a booking page. Built at render time — the daily rebuild
 *  keeps the session's real date in the subject. */
const REQUEST_EMAIL = requestEmail;
const isoDate = (offset: number) =>
  new Date(berlinTodayMs() + offset * 86400000).toISOString().slice(0, 10);
const requestHref = (s: Session): string => {
  const when = `${isoDate(s.dayOffset)}${s.time ? ` ${s.time}` : ''}`;
  const subject = t.mailBookSubject(s.title, when);
  const body = t.mailBookBody(s.title, s.host.name, when, s.price);
  return `mailto:${REQUEST_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
};

/** Inquiry mail for undated on-request workshops — no date in the
 *  subject, the visitor proposes one in the body. */
const inquireHref = (o: OnRequestWorkshop): string => {
  const subject = t.mailInquireSubject(o.title, o.host.name);
  const body = t.mailInquireBody(o.title, o.host.name, o.price);
  return `mailto:${REQUEST_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
};

const dayLabel = (offset: number) =>
  offset === 0 ? t.today : offset === 1 ? t.tomorrow : null;

/** Wording the client script composes at run time — the page heading as
 *  the visitor moves along the day strip, the share text, the notify-me
 *  mail. Plain strings with {placeholders}, handed over as JSON, so the
 *  script itself carries no language. */
const clientCopy: Record<Lang, {
  today: string; tomorrow: string; thisDay: string; nextDay: string; onDate: string; heading: string;
  share: string; shareTime: string; notifyBody: string;
}> = {
  en: { today: 'today', tomorrow: 'tomorrow', thisDay: 'this {weekday}', nextDay: 'next {weekday}', onDate: 'on {date}', heading: 'What is on in Berlin {when}',
        share: '{title} with {host} on {when}{time} — found on twiggli.com', shareTime: ' at {time}',
        notifyBody: 'Hi Twiggli,\n\nplease notify me when this sold-out workshop is bookable again:\n\nWorkshop: {title}\nHost: {host}\nDate: {when}\nNotify this address: {address}\n\nThanks!' },
  de: { today: 'heute', tomorrow: 'morgen', thisDay: 'diesen {weekday}', nextDay: 'nächsten {weekday}', onDate: 'am {date}', heading: 'Was {when} in Berlin läuft',
        share: '{title} bei {host} am {when}{time} — gefunden auf twiggli.com', shareTime: ' um {time} Uhr',
        notifyBody: 'Hallo Twiggli,\n\nbitte benachrichtigt mich, sobald dieser ausgebuchte Workshop wieder buchbar ist:\n\nWorkshop: {title}\nGastgeber: {host}\nTermin: {when}\nBenachrichtigung an: {address}\n\nDanke!' },
  fr: { today: 'aujourd’hui', tomorrow: 'demain', thisDay: 'ce {weekday}', nextDay: '{weekday} prochain', onDate: 'le {date}', heading: 'Ce qui se passe à Berlin {when}',
        share: '{title} avec {host} le {when}{time} — trouvé sur twiggli.com', shareTime: ' à {time}',
        notifyBody: 'Bonjour Twiggli,\n\nmerci de me prévenir dès que cet atelier complet est de nouveau réservable :\n\nAtelier : {title}\nHôte : {host}\nDate : {when}\nAdresse à prévenir : {address}\n\nMerci !' },
  es: { today: 'hoy', tomorrow: 'mañana', thisDay: 'este {weekday}', nextDay: 'el próximo {weekday}', onDate: 'el {date}', heading: 'Qué hay en Berlín {when}',
        share: '{title} con {host} el {when}{time} — encontrado en twiggli.com', shareTime: ' a las {time}',
        notifyBody: 'Hola Twiggli:\n\navisadme cuando este taller agotado vuelva a estar disponible:\n\nTaller: {title}\nAnfitrión: {host}\nFecha: {when}\nAvisar a: {address}\n\n¡Gracias!' },
  it: { today: 'oggi', tomorrow: 'domani', thisDay: 'questo {weekday}', nextDay: '{weekday} prossimo', onDate: 'il {date}', heading: 'Cosa c’è a Berlino {when}',
        share: '{title} con {host} {when}{time} — trovato su twiggli.com', shareTime: ' alle {time}',
        notifyBody: 'Ciao Twiggli,\n\navvisatemi quando questo workshop esaurito sarà di nuovo prenotabile:\n\nWorkshop: {title}\nHost: {host}\nData: {when}\nAvvisare: {address}\n\nGrazie!' },
  nl: { today: 'vandaag', tomorrow: 'morgen', thisDay: 'deze {weekday}', nextDay: 'volgende week {weekday}', onDate: 'op {date}', heading: 'Wat er {when} in Berlijn te doen is',
        share: '{title} met {host} op {when}{time} — gevonden op twiggli.com', shareTime: ' om {time}',
        notifyBody: 'Hallo Twiggli,\n\nlaat me weten zodra deze uitverkochte workshop weer te boeken is:\n\nWorkshop: {title}\nHost: {host}\nDatum: {when}\nBericht naar: {address}\n\nBedankt!' },
  pl: { today: 'dziś', tomorrow: 'jutro', thisDay: 'w ten {weekday}', nextDay: 'w przyszły {weekday}', onDate: '{date}', heading: 'Co dzieje się w Berlinie {when}',
        share: '{title} — {host}, {when}{time} — znalezione na twiggli.com', shareTime: ' o {time}',
        notifyBody: 'Cześć Twiggli,\n\nproszę o powiadomienie, gdy te wyprzedane warsztaty znów będzie można zarezerwować:\n\nWarsztaty: {title}\nProwadzący: {host}\nTermin: {when}\nPowiadomić na adres: {address}\n\nDziękuję!' },
  tr: { today: 'bugün', tomorrow: 'yarın', thisDay: 'bu {weekday}', nextDay: 'gelecek {weekday}', onDate: '{date}', heading: 'Berlin’de {when} neler var',
        share: '{title} — {host}, {when}{time} — twiggli.com’da bulundu', shareTime: ' saat {time}',
        notifyBody: 'Merhaba Twiggli,\n\nbu tükenmiş atölye yeniden rezervasyona açıldığında lütfen bana haber verin:\n\nAtölye: {title}\nEğitmen: {host}\nTarih: {when}\nBildirim adresi: {address}\n\nTeşekkürler!' },
};

/* The booking deadline in the reader's own language. The stored value is an
   ISO local datetime; only the day and the hour are worth showing. */
/** A workshop that costs nothing should say so in words. "€0" is a number
 *  nobody reads as free, and leaving the price off hides the best thing about
 *  the session — but the data keeps the €0 so the price filter can still
 *  place it. */
const showPrice = (price?: string) =>
  price && /^€\s*0([.,]0+)?$/.test(price.trim()) ? t.free : price;
/** Full with a waiting list is a different answer to "can I come?" than full
 *  full, so it gets its own word. */
const fullLabel = (s: { waitingList?: boolean }) => (s.waitingList ? t.waitingList : t.soldOut);
const formatDeadline = (iso: string): string => {
  const d = new Date(iso);
  if (Number.isNaN(d.valueOf())) return iso;
  const locale = LANG_META[lang].locale;
  return `${d.toLocaleDateString(locale, { day: 'numeric', month: 'short' })}, ${d.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' })}`;
};
---

<div
  class="daypicker"
  data-daypicker
  data-view="grid"
  data-locale={LANG_META[lang].locale}
  data-client-copy={JSON.stringify(clientCopy[lang])}
  data-today={t.today}
  data-tomorrow={t.tomorrow}
  data-request-email={REQUEST_EMAIL}
>
  <span class="daystrip-month" data-month aria-hidden="true"></span>
  <div class="daystrip" role="tablist" aria-label={t.pick}>
    {days.map((offset) => (
      <button
        class="daychip"
        type="button"
        role="tab"
        data-offset={offset}
        aria-selected={offset === 0 ? 'true' : 'false'}
      >
        {/* filled in by the script — the date depends on the visitor's clock,
            not on when the site was built */}
        <span class="daychip-dow"></span>
        <span class="daychip-num"></span>
      </button>
    ))}
  </div>

  {/* Two discreet filter rows in the accent, after themakery.de's category
      pills: what to do, and where. They combine. */}
  <div class="activity-pills" role="group" aria-label={t.filter}>
    <button class="activity-pill is-active" type="button" data-activity-filter="all">{t.all}</button>
    {activities.map((a) => (
      <button class="activity-pill" type="button" data-activity-filter={a}>
        <span class="pill-icon" aria-hidden="true">{activityIcons[a]}</span>{activityLabels[a]}
      </button>
    ))}
    {/* An on/off toggle rather than one of the either-or activity pills —
        "kids + ceramics" is a sensible combination. */}
    {hasKids && (
      <button class="activity-pill kids-pill" type="button" data-kids-filter aria-pressed="false">{t.kids}</button>
    )}
  </div>
  <div class="activity-pills district-pills" role="group" aria-label={t.filterDistrict}>
    <button class="activity-pill is-active" type="button" data-district-filter="all">{t.all}</button>
    {districts.map((d) => (
      <button class="activity-pill" type="button" data-district-filter={d}>{d}</button>
    ))}
  </div>

  {/* Grid ↔ list. Grid is the default; the choice sticks per visitor. */}
  <div class="view-toggle" role="group" aria-label={`${t.viewGrid} / ${t.viewList}`}>
    <button class="view-btn is-active" type="button" data-view-btn="grid" aria-label={t.viewGrid} title={t.viewGrid}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
    </button>
    <button class="view-btn" type="button" data-view-btn="list" aria-label={t.viewList} title={t.viewList}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
    </button>
  </div>

  <div class="daysessions">
    {days.map((offset) => {
      const forDay = sessions.filter((s) => s.dayOffset === offset);
      return (
        <div class="daygroup" data-day={offset} hidden={offset !== 0}>
          {forDay.length ? (
            <>
              {byTime(forDay).map(([time, list], groupIndex) => (
                <section class="timegroup">
                  <h3 class="timegroup-head">
                    {groupIndex === 0 && dayLabel(offset)
                      ? `${dayLabel(offset)} · ${time || t.timeTba}`
                      : time || t.timeTba}
                  </h3>
                  <ul class="session-list">
                    {list.map((s) => (
                      <li class="session" id={s.id} data-activity={s.host.activity} data-district={districtOf(s)} data-kids={s.kids ? 'true' : undefined}>
                        {/* The thumbnail plays the host's reel where footage
                            exists — the card shows the session moving, per
                            the app — then prefers the workshop's own scraped
                            picture over the host's stock tile. Thumbnail
                            and title both lead where the Book button does:
                            the host's own site for real sessions. */}
                        {/* A reel tile carries no link: tapping it plays the
                            clip, and the title beside it already goes to the
                            host. A still keeps the link, as there is nothing
                            else for a tap to do. */}
                        <a
                          class="session-thumb"
                          {...(s.host.video ? {} : { href: s.bookUrl, target: '_blank', rel: 'noopener' })}
                          tabindex="-1"
                          aria-hidden="true"
                        >
                          {/* In grid view the day flows as one full-width
                              grid, so each card wears its start time as a
                              chip on the picture. */}
                          {s.time && <span class="session-timechip">{s.time}</span>}
                          {s.soldOut ? (
                            <span class="session-availbadge session-soldout">{fullLabel(s)}</span>
                          ) : (
                            typeof s.spots === 'number' && <span class="session-availbadge">{s.spots} {t.spots}</span>
                          )}
                          {s.host.video ? (
                            <video
                              class="session-video"
                              src={s.host.video}
                              poster={s.host.poster}
                              muted
                              loop
                              playsinline
                              preload="none"
                            ></video>
                          ) : (s.image ?? s.host.photo) ? (
                            <img src={s.image ?? s.host.photo} alt="" loading="lazy" decoding="async" />
                          ) : (
                            <HostMonogram name={s.host.name} />
                          )}
                        </a>
                        <span class="session-main">
                          <span class="session-duration">
                            {s.duration ?? s.host.duration}
                            {/* Taught-in languages, one quiet pill each, so
                                nobody books a class they can't follow. */}
                            {(s.languages ?? s.host.languages ?? '').split('·').map((l) => l.trim()).filter(Boolean).map((l) => (
                              <span class="lang-pill">{l}</span>
                            ))}
                          </span>
                          <a class="session-title" href={s.bookUrl} target="_blank" rel="noopener">{s.title}</a>
                          {/* The host's name leads to their own page — every
                              date they run, in one place — where the title
                              beside it leads to the booking. */}
                          <span class="session-host"><a href={hostHref(lang, s.host)}>{s.host.name}</a> · {s.district}</span>
                          {/* The one thing that decides this workshop for
                              somebody — under the picture rather than on it,
                              where the time chip and the spots badge already
                              sit. Only a few workshops carry one. */}
                          {s.usp && <span class="session-usp">{s.usp}</span>}
                          {/* Where the host closes sales before the day
                              itself, so nobody arrives at a booking page
                              that has already shut. */}
                          {s.salesEnd && <span class="session-deadline">{t.salesEnd} {formatDeadline(s.salesEnd)}</span>}
                        </span>
                        {/* Price and Book share one row so every card's
                            action line sits at the same height; the spots
                            note drops underneath. */}
                        <span class="session-side">
                          {s.price && (
                            <span class="session-price">
                              {showPrice(s.price)}
                              {s.priceWas && <s class="session-price-was">{s.priceWas}</s>}
                            </span>
                          )}
                          {s.soldOut ? (
                            <button
                              class="session-book session-notify"
                              type="button"
                              data-notify
                              data-notify-title={s.title}
                              data-notify-host={s.host.name}
                              data-notify-date={isoDate(s.dayOffset)}
                              data-notify-time={s.time}
                            ><svg class="bell-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>{t.notify}</button>
                          ) : s.request ? (
                            <a class="session-book" href={requestHref(s)}>{t.request}</a>
                          ) : (
                            <a class="session-book" href={s.bookUrl} target="_blank" rel="noopener">{t.book}</a>
                          )}
                          {/* People send workshops to friends — the native
                              share sheet where the browser has one, copied
                              link elsewhere. */}
                          <button
                            class="session-share"
                            type="button"
                            aria-label={t.share}
                            title={t.share}
                            data-share-title={s.title}
                            data-share-host={s.host.name}
                            data-share-date={isoDate(s.dayOffset)}
                            data-share-time={s.time}
                            data-share-url={s.bookUrl}
                            data-copied-label={t.copied}
                          >
                            <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9V5l7 7-7 7v-4.1c-5 0-8.5 1.6-11 5.1 1-5 4-10 11-11z"/></svg>
                            <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                          </button>
                          {s.soldOut ? (
                            <span class="session-spots session-soldout">{fullLabel(s)}</span>
                          ) : (
                            typeof s.spots === 'number' && <span class="session-spots">{s.spots} {t.spots}</span>
                          )}
                        </span>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
              <p class="daypicker-empty" data-empty hidden>{t.noMatch}</p>
            </>
          ) : (
            <p class="daypicker-empty">{t.none}</p>
          )}
        </div>
      );
    })}
  </div>

  {/* Workshops without published dates sit under the day feed, whatever
      day is selected — the host schedules them around the inquiry. */}
  {onRequest.length > 0 && (
    <section class="timegroup onrequest">
      <h3 class="timegroup-head">{t.onRequestHead}</h3>
      <p class="onrequest-note">{t.onRequestNote}</p>
      <ul class="session-list">
        {onRequest.map((o) => (
          <li class="session" id={o.id} data-activity={o.host.activity}>
            {/* Same tile as a dated card: the host's reel where footage
                exists, otherwise the stock photo. */}
            <a
              class="session-thumb"
              {...(o.host.video ? {} : { href: o.bookUrl, target: '_blank', rel: 'noopener' })}
              tabindex="-1"
              aria-hidden="true"
            >
              {o.host.video ? (
                <video
                  class="session-video"
                  src={o.host.video}
                  poster={o.host.poster}
                  muted
                  loop
                  playsinline
                  preload="none"
                ></video>
              ) : o.host.photo ? (
                <img src={o.host.photo} alt="" loading="lazy" decoding="async" />
              ) : (
                <HostMonogram name={o.host.name} />
              )}
            </a>
            <span class="session-main">
              <span class="session-duration">
                {o.duration ?? o.host.duration}
                {(o.languages ?? o.host.languages ?? '').split('·').map((l) => l.trim()).filter(Boolean).map((l) => (
                  <span class="lang-pill">{l}</span>
                ))}
              </span>
              <a class="session-title" href={o.bookUrl} target="_blank" rel="noopener">{o.title}</a>
              <span class="session-host">{o.host.name} · {o.district}</span>
              {o.usp && <span class="session-usp">{o.usp}</span>}
                          {/* Where the host closes sales before the day
                              itself, so nobody arrives at a booking page
                              that has already shut. */}
                          {o.salesEnd && <span class="session-deadline">{t.salesEnd} {formatDeadline(o.salesEnd)}</span>}
            </span>
            <span class="session-side">
              {o.price && (
                            <span class="session-price">
                              {showPrice(o.price)}
                              {o.priceWas && <s class="session-price-was">{o.priceWas}</s>}
                            </span>
                          )}
              <a class="session-book" href={o.request ? inquireHref(o) : o.bookUrl} target={o.request ? undefined : '_blank'} rel={o.request ? undefined : 'noopener'}>{t.inquire}</a>
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* One dialog serves every sold-out card: the visitor leaves the address
      to notify, hits the bell, and the request opens in their mail app —
      subject line stable per event so the weekly reopen report can point
      straight at the matching inbox thread. */}
  <dialog class="notify-dialog" data-notify-dialog>
    <form method="dialog" class="notify-form" data-notify-form>
      <h3 class="notify-title">{t.notifyTitle}</h3>
      <p class="notify-event" data-notify-event></p>
      <p class="notify-hint">{t.notifyHint}</p>
      <label class="notify-label">
        {t.notifyEmail}
        <input class="notify-input" type="email" required placeholder="anna@mail.com" data-notify-input />
      </label>
      <div class="notify-actions">
        <button class="notify-cancel" type="button" data-notify-cancel>{t.cancel}</button>
        <button class="notify-send" type="submit"><svg class="bell-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>{t.notifySend}</button>
      </div>
    </form>
  </dialog>
</div>

<script>
  // The build is static, so the calendar cannot know what "today" is. Every
  // chip's date is resolved here against the visitor's own clock, and the
  // groups underneath are plain show/hide — which means the schedule is in the
  // HTML for search engines and still readable if this never runs.
  document.querySelectorAll<HTMLElement>('[data-daypicker]').forEach((root) => {
    const locale = root.dataset.locale || 'en-GB';
    const copy: Record<string, string> = JSON.parse(root.dataset.clientCopy || '{}');
    const fill = (template: string, values: Record<string, string>) =>
      template.replace(/\{(\w+)\}/g, (_, key) => values[key] ?? '');
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.daychip'));
    const groups = Array.from(root.querySelectorAll<HTMLElement>('.daygroup'));
    const monthEl = root.querySelector<HTMLElement>('[data-month]');
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // Grid ↔ list, remembered per visitor. Grid is the baked-in default.
    const viewBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view-btn]'));
    const setView = (v: string) => {
      root.dataset.view = v;
      viewBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.viewBtn === v));
      try { localStorage.setItem('twiggli-view', v); } catch { /* private mode */ }
    };
    let savedView = 'grid';
    try { savedView = localStorage.getItem('twiggli-view') || 'grid'; } catch { /* private mode */ }
    if (savedView !== 'grid') setView(savedView);
    viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.viewBtn || 'grid')));

    const monthOf = (date: Date) => date.toLocaleDateString(locale, { month: 'long' });
    if (monthEl) monthEl.textContent = monthOf(today);

    // The page heading follows the selected day: "Happening today" →
    // "Happening tomorrow" → "Happening this Sunday" → "Happening next
    // Sunday" → "Happening on 12 October" (and the German equivalents).
    const happeningTitle = document.querySelector<HTMLElement>('[data-happening-title]');
    // One title carries both the place and the chosen day, so the page has
    // a single heading rather than a kicker repeating it.
    const headingFor = (offset: number, date: Date): string => {
      const weekday = date.toLocaleDateString(locale, { weekday: 'long' });
      const when =
        offset === 0 ? copy.today
        : offset === 1 ? copy.tomorrow
        : offset <= 6 ? fill(copy.thisDay, { weekday })
        : offset <= 13 ? fill(copy.nextDay, { weekday })
        : fill(copy.onDate, { date: date.toLocaleDateString(locale, { day: 'numeric', month: 'long' }) });
      return fill(copy.heading, { when });
    };

    chips.forEach((chip) => {
      const offset = Number(chip.dataset.offset || 0);
      const date = new Date(today);
      date.setDate(date.getDate() + offset);

      const dow = chip.querySelector('.daychip-dow');
      const num = chip.querySelector('.daychip-num');
      if (dow) {
        dow.textContent =
          offset === 0 ? root.dataset.today || 'Today'
          : offset === 1 ? root.dataset.tomorrow || 'Tomorrow'
          : date.toLocaleDateString(locale, { weekday: 'short' });
      }
      // Just the day number — the month is spelled out once above the strip.
      if (num) num.textContent = date.toLocaleDateString(locale, { day: 'numeric' });

      chip.setAttribute(
        'aria-label',
        date.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' }),
      );
      if (date.getDay() === 0 || date.getDay() === 6) chip.classList.add('is-weekend');

      chip.addEventListener('click', () => {
        chips.forEach((c) => {
          c.setAttribute('aria-selected', String(c === chip));
          // Days before the selected one grey out, like the app's strip —
          // the eye reads position at a glance without boxes around dates.
          c.classList.toggle('is-before', Number(c.dataset.offset || 0) < offset);
        });
        groups.forEach((g) => { g.hidden = g.dataset.day !== String(offset); });
        if (monthEl) monthEl.textContent = monthOf(date);
        if (happeningTitle) happeningTitle.textContent = headingFor(offset, date);
        chip.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      });
    });

    // Live filtering: the activity and district pill rows combine. A time
    // header disappears with its last matching session, and an empty day
    // shows the no-match line.
    const activityPills = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-activity-filter]'));
    const districtPills = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-district-filter]'));
    const kidsPill = root.querySelector<HTMLButtonElement>('[data-kids-filter]');
    let activityFilter = 'all';
    let districtFilter = 'all';
    let kidsOnly = false;

    const applyFilters = () => {
      root.querySelectorAll<HTMLElement>('.session').forEach((li) => {
        const matchesActivity = activityFilter === 'all' || li.dataset.activity === activityFilter;
        const matchesDistrict = districtFilter === 'all' || li.dataset.district === districtFilter;
        const matchesKids = !kidsOnly || li.dataset.kids === 'true';
        li.hidden = !(matchesActivity && matchesDistrict && matchesKids);
      });
      root.querySelectorAll<HTMLElement>('.timegroup').forEach((group) => {
        group.hidden = !group.querySelector('.session:not([hidden])');
      });
      groups.forEach((day) => {
        const empty = day.querySelector<HTMLElement>('[data-empty]');
        if (empty) empty.hidden = !!day.querySelector('.timegroup:not([hidden])');
      });
    };

    activityPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activityFilter = pill.dataset.activityFilter || 'all';
        activityPills.forEach((p) => p.classList.toggle('is-active', p === pill));
        applyFilters();
      });
    });
    districtPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        districtFilter = pill.dataset.districtFilter || 'all';
        districtPills.forEach((p) => p.classList.toggle('is-active', p === pill));
        applyFilters();
      });
    });
    kidsPill?.addEventListener('click', () => {
      kidsOnly = !kidsOnly;
      kidsPill.classList.toggle('is-active', kidsOnly);
      kidsPill.setAttribute('aria-pressed', String(kidsOnly));
      applyFilters();
    });

    // Share: the native sheet where the browser offers one (phones), a
    // copied link elsewhere — the text carries workshop, host and date.
    root.querySelectorAll<HTMLButtonElement>('.session-share').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const d = btn.dataset;
        const when = d.shareDate
          ? new Date(`${d.shareDate}T00:00:00`).toLocaleDateString(locale, {
              weekday: 'long', day: 'numeric', month: 'long',
            })
          : '';
        const text = fill(copy.share, {
          title: d.shareTitle || '', host: d.shareHost || '', when,
          time: d.shareTime ? fill(copy.shareTime, { time: d.shareTime }) : '',
        });
        const url = d.shareUrl || location.href;
        try {
          if (navigator.share) {
            await navigator.share({ title: d.shareTitle, text, url });
            return;
          }
          await navigator.clipboard.writeText(`${text}\n${url}`);
          btn.classList.add('is-copied');
          btn.setAttribute('aria-label', d.copiedLabel || 'Link copied');
          setTimeout(() => {
            btn.classList.remove('is-copied');
            btn.setAttribute('aria-label', btn.title);
          }, 1600);
        } catch {
          /* share sheet dismissed */
        }
      });
    });

    // Notify-me on sold-out cards: the dialog collects the address to
    // notify, then opens the visitor's mail app with the request. The
    // subject is stable per event ("Notify me: <title> on <date>") so the
    // weekly reopen report can quote the exact inbox search.
    const notifyDialog = root.querySelector<HTMLDialogElement>('[data-notify-dialog]');
    const notifyForm = root.querySelector<HTMLFormElement>('[data-notify-form]');
    const notifyEvent = root.querySelector<HTMLElement>('[data-notify-event]');
    const notifyInput = root.querySelector<HTMLInputElement>('[data-notify-input]');
    let notifyContext: DOMStringMap | null = null;
    root.querySelectorAll<HTMLButtonElement>('[data-notify]').forEach((btn) => {
      btn.addEventListener('click', () => {
        notifyContext = btn.dataset;
        if (notifyEvent) {
          notifyEvent.textContent = `${notifyContext.notifyTitle} · ${notifyContext.notifyHost} · ${notifyContext.notifyDate}${notifyContext.notifyTime ? ` ${notifyContext.notifyTime}` : ''}`;
        }
        notifyDialog?.showModal();
        notifyInput?.focus();
      });
    });
    root.querySelector('[data-notify-cancel]')?.addEventListener('click', () => notifyDialog?.close());
    notifyForm?.addEventListener('submit', () => {
      const d = notifyContext;
      const address = notifyInput?.value.trim();
      if (!d || !address) return;
      const when = `${d.notifyDate}${d.notifyTime ? ` ${d.notifyTime}` : ''}`;
      const subject = `Notify me: ${d.notifyTitle} on ${d.notifyDate}`;
      const body = fill(copy.notifyBody, {
        title: d.notifyTitle || '', host: d.notifyHost || '', when, address,
      });
      location.href = `mailto:${root.dataset.requestEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });

    // A notification email links straight to its card (#live-…): select
    // that card's day, scroll to it and highlight it, so the reader lands
    // on the Book button.
    if (location.hash) {
      const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (target && root.contains(target)) {
        const day = target.closest<HTMLElement>('.daygroup')?.dataset.day;
        chips.find((c) => c.dataset.offset === day)?.click();
        setTimeout(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          target.classList.add('is-highlighted');
        }, 150);
      }
    }

    // Reel thumbnails. With a mouse, a tile plays while the pointer is over
    // it and stops when the pointer leaves; a click stops it where it is,
    // and it stays stopped until the pointer leaves and comes back. Nothing
    // else on the page runs, which is what keeps a feed of a hundred reels
    // cheap — each one loads only when someone looks at it.
    //
    // Touch has no hover, so there a tile plays while it is on screen and a
    // tap toggles it, as before.
    const reels = Array.from(root.querySelectorAll<HTMLVideoElement>('.session-video'));
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hoverable = window.matchMedia('(hover: hover)').matches;
    const start = (video: HTMLVideoElement) => video.play().catch(() => {});

    if (reels.length && !hoverable && !still) {
      // A hidden day group has no box, so its clips never load or run;
      // switching day or scrolling away pauses them again.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) start(video);
            else video.pause();
          }
        },
        { threshold: 0.4 },
      );
      reels.forEach((video) => observer.observe(video));
    } else if (reels.length) {
      // Hover starts them, but nothing would stop one the pointer never
      // left — scrolling past with the cursor parked on a card, or a day
      // switch pulling the tile out from under it.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) (entry.target as HTMLVideoElement).pause();
          }
        },
        { threshold: 0.1 },
      );
      reels.forEach((video) => observer.observe(video));
    }

    for (const video of reels) {
      const tile = video.closest('.session-thumb');
      if (!tile) continue;
      if (hoverable) {
        let stopped = false;
        tile.addEventListener('mouseenter', () => { if (!stopped) start(video); });
        tile.addEventListener('mouseleave', () => { stopped = false; video.pause(); });
        tile.addEventListener('click', () => { stopped = true; video.pause(); });
      } else {
        // The tile links nowhere, so a tap has nothing else to do — and on
        // the phones whose low-power mode refuses the autoplay above, it is
        // the only way to start a reel at all.
        tile.addEventListener('click', () => {
          if (video.paused) start(video);
          else video.pause();
        });
      }
    }
  });
</script>
