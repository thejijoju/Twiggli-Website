---
import { getSessions, getOnRequest, capPerHostPerDay, spreadByHost, berlinTodayMs, DAYS_AHEAD, type Session, type OnRequestWorkshop } from '../data/sessions.ts';
import { activitiesOf, fadePhotos, filterCopy, type ActivityKey } from '../data/content.ts';
import { hostHref } from '../data/seo.ts';
import HostMonogram from './HostMonogram.astro';
import PhotoFade from './PhotoFade.astro';
import DayMap from './DayMap.astro';
import { mapCopy } from '../data/mapCopy.ts';
import { DEFAULT_LANG, LANG_META, type Lang } from '../lib/url.ts';
import { ui } from '../data/i18n.ts';
import { almostFullLabel, spotsText } from '../data/availability.ts';
import Going from './Going.astro';
import { membershipCopy, membershipPromos } from '../data/memberships.ts';
import { partnerBook, partnerCopied, partnerNote } from '../data/partners.ts';
import { bandsFor, priceAttrs, priceFilterCopy, PRICE_BANDS } from '../data/priceFilter.ts';

/** The schedule feed, styled after the app's search screen: the borderless
 *  day strip right at the top, rows of activity, district and price pills
 *  under it, and the day's sessions grouped under bold time headers. The
 *  pills filter the list live, client-side, and the address follows them
 *  (?activity, ?district, ?price, ?date). */
interface Props {
  lang?: Lang;
  /** The calendar redesign drafts (src/pages/de/preview/kalender-1…3,
   *  styled in kalender.css): 1 "Suchleiste" — the home page's search pill
   *  over a strip of soft day chips; 2 "Luma" — a sticky column with a
   *  month calendar and two selects beside the dates grouped by day; 3
   *  "Chips light" — day pills over one row of tinted category chips with
   *  a district menu and the map button. Left out, the live calendar. The
   *  data, the filters and the client logic are the same for all four. */
  variant?: '1' | '2' | '3';
}
const { lang = DEFAULT_LANG, variant } = Astro.props;

// Two a day per host at most, so one busy studio cannot fill the day.
const sessions = capPerHostPerDay(getSessions(lang));
const onRequest = getOnRequest(lang);
const days = Array.from({ length: DAYS_AHEAD }, (_, i) => i);

// Only activities that actually have sessions get a pill — no dead filters.
const ACTIVITY_ORDER: ActivityKey[] = ['ceramics', 'art', 'craft', 'food', 'photography', 'wellbeing', 'music'];
const present = new Set(sessions.flatMap((s) => activitiesOf(s.host)));
const activities = ACTIVITY_ORDER.filter((a) => present.has(a));
const activityLabels = filterCopy[lang].activities;

/** A small emoji inside each activity pill — recognisable at a glance
 *  without reading, kept discreet by size and opacity in the CSS. */
const activityIcons: Record<ActivityKey, string> = {
  ceramics: '🏺', art: '🎨', craft: '🛠️', food: '🍳',
  photography: '📷', wellbeing: '🌿', music: '🥁',
};

/** A venue qualifier after the district ("Spandau St. Wilhelm") folds into
 *  its district so the filter stays a clean list of places. */
const districtOf = (s: Session): string => s.district.replace(/\s+St\.\s.*$/, '');
const districts = [...new Set(sessions.map(districtOf))].sort((a, b) => a.localeCompare(b));

// The kids pill follows the no-dead-filters rule: it only renders once the
// feed actually carries sessions designed for children.
const hasKids = sessions.some((s) => s.kids);

// The price bands (priceFilter.ts), per person on the price the cards show.
// Same rule: a band nothing falls in gets no pill.
const priceBands = bandsFor([...sessions, ...onRequest].map((s) => s.price));
const pc = priceFilterCopy[lang];

/** Sessions arrive sorted by time, so grouping keeps that order. */
const byTime = (list: Session[]): [string, Session[]][] => {
  const groups = new Map<string, Session[]>();
  for (const s of list) {
    const key = s.time ?? '';
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key)!.push(s);
  }
  return [...groups.entries()];
};

const t = ui(lang).calendar;

/* — the filter (draft D) — */
/** The day pills: the next two weeks. Every later day is still in the page,
 *  reached through "All days" or a ?date= link. */
const STRIP_DAYS = 14;
const stripDays = days.slice(0, STRIP_DAYS);
const dayAt = (offset: number) => new Date(berlinTodayMs() + offset * 86400000);
const isWeekend = (offset: number) => [0, 6].includes(dayAt(offset).getUTCDay());
const stripDow = (offset: number) =>
  offset === 1 ? t.tomorrow : dayAt(offset).toLocaleDateString(LANG_META[lang].locale, { weekday: 'short', timeZone: 'UTC' }).replace('.', '');
const stripMonth = (offset: number) =>
  dayAt(offset).toLocaleDateString(LANG_META[lang].locale, { month: 'short', timeZone: 'UTC' }).replace('.', '');
/** "Evenings": a session that starts at 17:00 or later. */
const isEvening = (s: Session) => !!s.time && Number(s.time.slice(0, 2)) >= 17;
const hasEvening = sessions.some(isEvening);
/** "Under €50": the price bands that end at €50 or below (priceFilter.ts),
 *  of those the feed actually fills. */
const under50 = priceBands.filter((b) => b.max <= 50).map((b) => b.id);
/** "12 workshops" in each plural form the language has, so the script can
 *  word any count without carrying the language itself. */
const resultForms = (() => {
  const rules = new Intl.PluralRules(LANG_META[lang].locale);
  const forms: Record<string, string> = {};
  for (let n = 0; n < 200; n++) {
    const cat = rules.select(n);
    if (!forms[cat]) forms[cat] = t.results(n).replace(String(n), '{n}');
  }
  return forms;
})();
/** The filter bar's own words, shared with the corporate directory's so the
 *  two read the same. */
const f = filterCopy[lang];


/** A session's date as YYYY-MM-DD. Built at render time — the daily
 *  rebuild keeps it true. */
const isoDate = (offset: number) =>
  new Date(berlinTodayMs() + offset * 86400000).toISOString().slice(0, 10);

/** What a Book, Request or Notify button hands the booking form
 *  (BookingDialog.astro): the workshop, who runs it, when, the price, and
 *  the host's own booking page — which only reaches our inbox. */
const bookAttrs = (s: Session) => (s.partner && !s.soldOut
  // A partner host's own site, with our code copied on the way (partners.ts).
  ? { 'data-partner-code': s.partner.code, 'data-partner-copied': partnerCopied[lang], target: '_blank', rel: 'noopener',
      // For the "partner-booking" event (lib/track.ts).
      'data-partner-host': s.host.slug, 'data-partner-title': s.title, 'data-partner-time': s.time,
      // And what the inbox line reports: who, what it costs, how many places are left.
      'data-partner-name': s.host.name, 'data-partner-price': s.price, 'data-partner-spots': s.spots,
      'data-partner-duration': s.duration ?? s.host.duration, 'data-partner-place': s.district,
      'data-partner-date': isoDate(s.dayOffset) }
  : {
    'data-book': s.soldOut ? 'notify' : s.request ? 'request' : 'book',
    'data-book-title': s.title,
    'data-book-host': s.host.name,
    'data-book-slug': s.host.slug,
    'data-book-date': isoDate(s.dayOffset),
    'data-book-time': s.time,
    'data-book-price': showPrice(s.price),
    'data-book-link': s.bookUrl,
  });
const inquireAttrs = (o: OnRequestWorkshop) => ({
  'data-book': 'request',
  'data-book-title': o.title,
  'data-book-host': o.host.name,
  'data-book-slug': o.host.slug,
  'data-book-price': showPrice(o.price),
  'data-book-link': o.bookUrl,
});

const dayLabel = (offset: number) =>
  offset === 0 ? t.today : offset === 1 ? t.tomorrow : null;

/** Wording the client script composes at run time — the page heading as
 *  the visitor moves along the day strip, the share text, the notify-me
 *  mail. Plain strings with {placeholders}, handed over as JSON, so the
 *  script itself carries no language. */
const clientCopy: Record<Lang, {
  today: string; tomorrow: string; thisDay: string; nextDay: string; onDate: string; heading: string;
  /** The heading's day for the weekend toggle and for every day at once. */
  weekend: string; soon: string;
  share: string; shareTime: string; notifyBody: string;
}> = {
  en: { today: 'today', tomorrow: 'tomorrow', thisDay: 'this {weekday}', nextDay: 'next {weekday}', onDate: 'on {date}', heading: 'What is on in Berlin {when}',
        weekend: 'this weekend', soon: 'over the coming days',
        share: '{title} with {host} on {when}{time} — found on twiggli.com', shareTime: ' at {time}',
        notifyBody: 'Hi Twiggli,\n\nplease notify me when this sold-out workshop is bookable again:\n\nWorkshop: {title}\nHost: {host}\nDate: {when}\nNotify this address: {address}\n\nThanks!' },
  de: { today: 'heute', tomorrow: 'morgen', thisDay: 'diesen {weekday}', nextDay: 'nächsten {weekday}', onDate: 'am {date}', heading: 'Was {when} in Berlin läuft',
        weekend: 'am Wochenende', soon: 'in den nächsten Tagen',
        share: '{title} bei {host} am {when}{time} — gefunden auf twiggli.com', shareTime: ' um {time} Uhr',
        notifyBody: 'Hallo Twiggli,\n\nbitte benachrichtigt mich, sobald dieser ausgebuchte Workshop wieder buchbar ist:\n\nWorkshop: {title}\nGastgeber: {host}\nTermin: {when}\nBenachrichtigung an: {address}\n\nDanke!' },
  fr: { today: 'aujourd’hui', tomorrow: 'demain', thisDay: 'ce {weekday}', nextDay: '{weekday} prochain', onDate: 'le {date}', heading: 'Ce qui se passe à Berlin {when}',
        weekend: 'ce week-end', soon: 'dans les prochains jours',
        share: '{title} avec {host} le {when}{time} — trouvé sur twiggli.com', shareTime: ' à {time}',
        notifyBody: 'Bonjour Twiggli,\n\nmerci de me prévenir dès que cet atelier complet est de nouveau réservable :\n\nAtelier : {title}\nHôte : {host}\nDate : {when}\nAdresse à prévenir : {address}\n\nMerci !' },
  es: { today: 'hoy', tomorrow: 'mañana', thisDay: 'este {weekday}', nextDay: 'el próximo {weekday}', onDate: 'el {date}', heading: 'Qué hay en Berlín {when}',
        weekend: 'este fin de semana', soon: 'en los próximos días',
        share: '{title} con {host} el {when}{time} — encontrado en twiggli.com', shareTime: ' a las {time}',
        notifyBody: 'Hola Twiggli:\n\navisadme cuando este taller agotado vuelva a estar disponible:\n\nTaller: {title}\nAnfitrión: {host}\nFecha: {when}\nAvisar a: {address}\n\n¡Gracias!' },
  it: { today: 'oggi', tomorrow: 'domani', thisDay: 'questo {weekday}', nextDay: '{weekday} prossimo', onDate: 'il {date}', heading: 'Cosa c’è a Berlino {when}',
        weekend: 'questo fine settimana', soon: 'nei prossimi giorni',
        share: '{title} con {host} {when}{time} — trovato su twiggli.com', shareTime: ' alle {time}',
        notifyBody: 'Ciao Twiggli,\n\navvisatemi quando questo workshop esaurito sarà di nuovo prenotabile:\n\nWorkshop: {title}\nHost: {host}\nData: {when}\nAvvisare: {address}\n\nGrazie!' },
  nl: { today: 'vandaag', tomorrow: 'morgen', thisDay: 'deze {weekday}', nextDay: 'volgende week {weekday}', onDate: 'op {date}', heading: 'Wat er {when} in Berlijn te doen is',
        weekend: 'dit weekend', soon: 'de komende dagen',
        share: '{title} met {host} op {when}{time} — gevonden op twiggli.com', shareTime: ' om {time}',
        notifyBody: 'Hallo Twiggli,\n\nlaat me weten zodra deze uitverkochte workshop weer te boeken is:\n\nWorkshop: {title}\nHost: {host}\nDatum: {when}\nBericht naar: {address}\n\nBedankt!' },
  pl: { today: 'dziś', tomorrow: 'jutro', thisDay: 'w ten {weekday}', nextDay: 'w przyszły {weekday}', onDate: '{date}', heading: 'Co dzieje się w Berlinie {when}',
        weekend: 'w ten weekend', soon: 'w najbliższych dniach',
        share: '{title} — {host}, {when}{time} — znalezione na twiggli.com', shareTime: ' o {time}',
        notifyBody: 'Cześć Twiggli,\n\nproszę o powiadomienie, gdy te wyprzedane warsztaty znów będzie można zarezerwować:\n\nWarsztaty: {title}\nProwadzący: {host}\nTermin: {when}\nPowiadomić na adres: {address}\n\nDziękuję!' },
  tr: { today: 'bugün', tomorrow: 'yarın', thisDay: 'bu {weekday}', nextDay: 'gelecek {weekday}', onDate: '{date}', heading: 'Berlin’de {when} neler var',
        weekend: 'bu hafta sonu', soon: 'önümüzdeki günlerde',
        share: '{title} — {host}, {when}{time} — twiggli.com’da bulundu', shareTime: ' saat {time}',
        notifyBody: 'Merhaba Twiggli,\n\nbu tükenmiş atölye yeniden rezervasyona açıldığında lütfen bana haber verin:\n\nAtölye: {title}\nEğitmen: {host}\nTarih: {when}\nBildirim adresi: {address}\n\nTeşekkürler!' },
};

/* The booking deadline in the reader's own language. The stored value is an
   ISO local datetime; only the day and the hour are worth showing. */
/** A workshop that costs nothing should say so in words. "€0" is a number
 *  nobody reads as free, and leaving the price off hides the best thing about
 *  the session — but the data keeps the €0 so the price filter can still
 *  place it. */
const showPrice = (price?: string) =>
  price && /^€\s*0([.,]0+)?$/.test(price.trim()) ? t.free : price;
/** Full with a waiting list is a different answer to "can I come?" than full
 *  full, so it gets its own word. */
/* A studio's membership tile (memberships.ts) goes before the host's
   first card of the day, once per day. */
const promoted = new Set<string>();
const promosIn = (offset: number, list: Session[]): Session[] =>
  list.filter((s) => {
    const key = `${offset}|${s.host.slug}`;
    if (!membershipPromos[s.host.slug] || promoted.has(key)) return false;
    promoted.add(key);
    return true;
  });
const mc = membershipCopy[lang];

const fullLabel = (s: { waitingList?: boolean }) => (s.waitingList ? t.waitingList : t.soldOut);

/* — the redesign drafts only — */
/** The drafts' own words. German and English while they are drafts; the
 *  other languages fall back to English until one of them goes live. */
const kalCopyAll = {
  de: { what: 'Was?', whatAny: 'Alle Workshops', when: 'Wann?', where: 'Wo?', whereAny: 'Ganz Berlin',
        category: 'Kategorie', district: 'Bezirk', allDays: 'Alle Tage', moreDays: 'Weitere Tage zeigen',
        map: 'Karte', reset: 'Filter zurücksetzen', noMatchAll: 'Dazu läuft gerade nichts. Probier einen anderen Bezirk oder eine andere Kategorie.',
        uhr: '', prev: 'Voriger Monat', next: 'Nächster Monat', soon: 'demnächst' },
  en: { what: 'What?', whatAny: 'Any workshop', when: 'When?', where: 'Where?', whereAny: 'All of Berlin',
        category: 'Category', district: 'District', allDays: 'All days', moreDays: 'Show more days',
        map: 'Map', reset: 'Clear filters', noMatchAll: 'Nothing on for that right now. Try another district or category.',
        uhr: '', prev: 'Previous month', next: 'Next month', soon: 'soon' },
};
const k = lang === 'de' ? kalCopyAll.de : kalCopyAll.en;
/** The chips' soft grounds, the home page's tints (homeData.ts). */
const activityTints: Record<ActivityKey, string> = {
  ceramics: '#ffe1d3', art: '#e6ddff', craft: '#ffe9a8', food: '#d9f3ea',
  photography: '#dbe8ff', wellbeing: '#e4f3d6', music: '#ffd9ee',
};
/** A day's name as the build sees it; the script writes the visitor's own
 *  over it, as it does for the strip. */
const dayName = (offset: number, style: 'short' | 'long' = 'short') => {
  if (offset === 0) return t.today;
  if (offset === 1) return t.tomorrow;
  const d = new Date(berlinTodayMs() + offset * 86400000);
  return style === 'long'
    ? d.toLocaleDateString(LANG_META[lang].locale, { weekday: 'long', timeZone: 'UTC' })
    : d.toLocaleDateString(LANG_META[lang].locale, { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
};
const dayDate = (offset: number) =>
  new Date(berlinTodayMs() + offset * 86400000).toLocaleDateString(LANG_META[lang].locale, { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
const mapIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4 3 6.5v13.5l6-2.5 6 2.5 6-2.5V4l-6 2.5z"/><path d="M9 4v13.5M15 6.5V20"/></svg>';
const formatDeadline = (iso: string): string => {
  const d = new Date(iso);
  if (Number.isNaN(d.valueOf())) return iso;
  const locale = LANG_META[lang].locale;
  return `${d.toLocaleDateString(locale, { day: 'numeric', month: 'short' })}, ${d.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' })}`;
};
import Voucher from './Voucher.astro';
---

<div
  class:list={['daypicker has-sidemap', variant && `kal kal-${variant}`]}
  data-daypicker
  data-variant={variant}
  data-view={variant === '2' ? 'luma' : 'grid'}
  data-all-days={variant === '2' ? 'true' : undefined}
  data-when-soon={variant ? k.soon : undefined}
  data-uhr={variant ? k.uhr : undefined}
  data-map="closed"
  data-map-start="closed"
  data-locale={LANG_META[lang].locale}
  data-client-copy={JSON.stringify(clientCopy[lang])}
  data-price-bands={JSON.stringify(PRICE_BANDS.map((b) => [b.id, b.min, Number.isFinite(b.max) ? b.max : null]))}
  data-today={t.today}
  data-tomorrow={t.tomorrow}
  data-results={JSON.stringify(resultForms)}
>
  {/* The filter (draft D, "Datumsleiste", src/pages/de/preview/
      kalender-filter-d): the next two weeks as day pills, the weekend
      tinted; quick toggles under them; activity, district and price in a
      "More filters" sheet. A frosted panel, so the page's ground shows
      through it. */}
  {!variant && (
  <>
  <div class="dfilter">
    <div class="dfilter-strip" role="tablist" aria-label={t.pick}>
      <button class="dpill dpill-all" type="button" role="tab" data-offset="all" aria-selected="false">
        <b>{t.allDays}</b>
      </button>
      {stripDays.map((offset) => (
        <button
          class:list={['dpill', isWeekend(offset) && 'is-weekend']}
          type="button"
          role="tab"
          data-offset={offset}
          aria-selected={offset === 0 ? 'true' : 'false'}
          aria-label={dayDate(offset)}
        >
          {/* As the build sees the day; the script writes the visitor's own
              over it, as the date depends on their clock. */}
          <small class="dpill-dow">{offset === 0 ? t.today : stripDow(offset)}</small>
          <b class="dpill-num">{dayAt(offset).getUTCDate()}</b>
          <small class="dpill-mon">{stripMonth(offset)}</small>
        </button>
      ))}
    </div>
    <div class="dfilter-toggles" role="group" aria-label={f.filters}>
      <button class="dtog" type="button" data-when="today" aria-pressed="true"><span aria-hidden="true">⚡</span>{t.today}</button>
      <button class="dtog" type="button" data-when="weekend" aria-pressed="false"><span aria-hidden="true">🎉</span>{t.weekend}</button>
      {/* Toggles follow the no-dead-filters rule, as the pills did. */}
      {hasEvening && (
        <button class="dtog" type="button" data-evening-filter aria-pressed="false"><span aria-hidden="true">🌙</span>{t.evening}</button>
      )}
      {under50.length > 0 && (
        <button class="dtog" type="button" data-under50={under50.join(',')} aria-pressed="false"><span aria-hidden="true">💸</span>{f.prices.budget}</button>
      )}
      {hasKids && (
        <button class="dtog" type="button" data-kids-filter aria-pressed="false"><span aria-hidden="true">🧸</span>{t.withKids}</button>
      )}
      <span class="dfilter-sep" aria-hidden="true"></span>
      <button class="dtog dtog-more" type="button" data-sheet-open aria-expanded="false" aria-controls="day-more">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h10" /><path d="M18 7h2" /><circle cx="16" cy="7" r="2" />
          <path d="M4 17h4" /><path d="M12 17h8" /><circle cx="10" cy="17" r="2" />
        </svg>
        <span>{t.moreFilters}</span>
        <span class="dbadge" data-sheet-badge hidden></span>
      </button>
    </div>
  </div>

  {/* A centred card on a wide screen, a sheet on the bottom edge of a
      phone. Choosing keeps it open; the button at its foot says how many
      workshops it will leave and closes it. */}
  <div class="dsheet" id="day-more" role="dialog" aria-modal="true" aria-labelledby="day-more-title" data-sheet hidden>
    <div class="dsheet-head">
      <h2 id="day-more-title">{t.moreFilters}</h2>
      <button class="dsheet-x" type="button" data-sheet-close aria-label={t.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <div class="dsheet-body">
      <section class="dsheet-sec">
        <h3>{f.activityLabel}</h3>
        <div class="dchips">
          {activities.map((a) => (
            <button class="dchip" type="button" data-activity-filter={a} aria-pressed="false">
              <span aria-hidden="true">{activityIcons[a]}</span>{activityLabels[a]}
            </button>
          ))}
        </div>
      </section>
      <section class="dsheet-sec">
        <h3>{t.district}</h3>
        <div class="dchips">
          {districts.map((d) => (
            <button class="dchip" type="button" data-district-filter={d} aria-pressed="false">{d}</button>
          ))}
        </div>
      </section>
      {priceBands.length > 0 && (
        <section class="dsheet-sec">
          <h3>{f.priceLabel}</h3>
          <div class="dchips">
            {priceBands.map((b) => (
              <button class="dchip" type="button" data-price-filter={b.id} aria-pressed="false">{pc.bands[b.id]}</button>
            ))}
          </div>
        </section>
      )}
    </div>
    <div class="dsheet-foot">
      <button class="dsheet-clear" type="button" data-kal-reset>{f.clear}</button>
      <button class="btn btn-primary dsheet-show" type="button" data-sheet-close data-show-count data-show={f.show('%s')}></button>
    </div>
  </div>
  <div class="dscrim" data-sheet-close hidden></div>

  {/* How many, what is on (each one removable), and the views. */}
  <div class="daystatus">
    <p class="daystatus-count" data-count aria-live="polite"></p>
    <div class="daystatus-on" data-on-chips></div>
    <button class="daystatus-reset" type="button" data-kal-reset data-reset-link hidden>{f.clear}</button>
    {/* Grid ↔ list. Grid is the default; the choice sticks per visitor. */}
    <div class="view-toggle" role="group" aria-label={`${t.viewGrid} / ${t.viewList}`}>
      {/* The map opens beside the workshops (DayMap below); this brings it
          back once closed, and is how a phone opens it. */}
      <button class="view-btn map-btn" type="button" data-map-open aria-label={mapCopy[lang].map} title={mapCopy[lang].map}>
        <Fragment set:html={mapIcon} />
        <span>{mapCopy[lang].map}</span>
      </button>
      <button class="view-btn is-active" type="button" data-view-btn="grid" aria-label={t.viewGrid} title={t.viewGrid}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
      </button>
