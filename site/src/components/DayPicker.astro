              <span data-district-label data-any={k.district}>{k.district}</span>
              <svg class="kal-caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </button>
            <div class="kal-menu" id="kal-districts" data-kal-menu hidden role="group" aria-label={t.filterDistrict}>
              <button class="kal-menu-item is-active" type="button" data-district-filter="all">{k.whereAny}</button>
              {districts.map((d) => (
                <button class="kal-menu-item" type="button" data-district-filter={d}>{d}</button>
              ))}
            </div>
          </div>
          {priceBands.length > 0 && (
            <div class="kal-menuwrap">
              <button type="button" class="kal-ctl kal-menubtn" data-kal-menu-btn aria-expanded="false" aria-controls="kal-prices" title={f.priceLabel}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.5 6.5a6.5 6.5 0 1 0 0 11"/><path d="M5 10.5h8.5M5 13.5h8.5"/></svg>
                <span data-price-label data-any={pc.ask.replace(/\s*[?¿]\s*/g, '')}>{pc.ask.replace(/\s*[?¿]\s*/g, '')}</span>
                <svg class="kal-caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
