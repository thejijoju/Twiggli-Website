              calendar while several days are on show (all days, the
              weekend). */}
          {(variant === '2' || !variant) && (
            <h2 class:list={[variant ? 'kal-dayhead' : 'dayhead']} data-dayhead={offset}>
              <span class="kal-dayhead-main">{offset < 2 ? dayLabel(offset) : dayName(offset, 'long')}</span>
              <span class="kal-dayhead-sub">{dayDate(offset)}</span>
            </h2>
          )}
          {forDay.length ? (
            <>
              {byTime(forDay).map(([time, list], groupIndex) => (
                <section class="timegroup">
                  <h3 class="timegroup-head">
                    {groupIndex === 0 && dayLabel(offset)
                      ? `${dayLabel(offset)} · ${time || t.timeTba}`
                      : time || t.timeTba}
                  </h3>
                  <ul class="session-list">
                    {!variant && promosIn(offset, list).map((s) => {
                      const m = membershipPromos[s.host.slug];
                      const price = `${mc.from(m.from)} ${m.per === 'hour' ? mc.hour : mc.month}`;
                      return (
                        <li class="promo" data-promo-host={s.host.slug} data-seen={`m:${s.host.slug}`}>
                          <button type="button" class="promo-card" data-book="membership"
                            data-book-title={`${mc.formTitle} · ${m.studio}`} data-book-host={s.host.name} data-book-slug={s.host.slug} data-book-price={price}>
                            <span class="promo-media">
                              <img src={s.host.poster ?? m.image} alt="" loading="lazy" decoding="async" />
                              <span class="promo-kicker">{mc.kicker}</span>
                            </span>
                            <span class="promo-body">
                              <span class="promo-title">{mc.title}</span>
                              <span class="promo-host">{m.studio} · {districtOf(s)}</span>
                              <span class="promo-blurb">{mc.blurb}</span>
                              <span class="promo-foot">
                                <span class="promo-price">{mc.from(m.from)} <small>{m.per === 'hour' ? mc.hour : mc.month}</small></span>
                                <span class="promo-cta">{mc.cta}</span>
                              </span>
                            </span>
                          </button>
                        </li>
                      );
                    })}
                    {list.map((s) => variant ? (
                      /* A draft's tile, after the home page's: the picture in
                         an even white frame, then the time in hand, the
