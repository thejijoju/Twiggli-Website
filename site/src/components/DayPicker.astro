                      <li class="session kal-card" id={s.id} data-host={s.host.slug} data-seen={`s:${s.id}`} style={`--spread:${spread.get(s)}`} data-activity={activitiesOf(s.host).join(' ')} data-district={districtOf(s)} data-kids={s.kids ? 'true' : undefined} data-evening={isEvening(s) ? 'true' : undefined} {...priceAttrs(s.price)}
                        data-track-card="session" data-track-host={s.host.name} data-track-title={s.title} data-track-date={isoDate(s.dayOffset)}>
                        <span class="kal-when">
                          <span class="kal-time">{s.time ? `${s.time}${k.uhr}` : t.timeTba}</span>
                          <span class="kal-dur">{s.duration ?? s.host.duration}</span>
                        </span>
                        <span class="kal-frame">
                          <a
                            class="session-thumb"
                            {...(s.host.video ? {} : { href: s.bookUrl, ...bookAttrs(s) })}
                            tabindex="-1"
                            aria-hidden="true"
                          >
                            {s.soldOut ? (
                              <span class="session-availbadge session-soldout">{fullLabel(s)}</span>
                            ) : (
                              typeof s.spots === 'number' ? <span class="session-availbadge">{spotsText(s.spots, lang, t.spots)}</span>
                              : s.almostFull && <span class="session-availbadge session-almostfull">{almostFullLabel[lang]}</span>
                            )}
                            {s.host.video ? (
                              <>
                                {s.host.poster && <img class="session-still" src={s.host.poster} alt="" loading="lazy" decoding="async" />}
                                <video class="session-video" src={s.host.video} muted loop playsinline preload="none"></video>
                              </>
                            ) : !s.image && fadePhotos(s.host).length > 1 ? (
                              <PhotoFade photos={fadePhotos(s.host)} alt="" />
                            ) : (s.image ?? s.host.photo) ? (
                              <img src={s.image ?? s.host.photo} alt="" loading="lazy" decoding="async" />
                            ) : (
                              <HostMonogram name={s.host.name} />
                            )}
                            <Voucher kind="badge" host={s.host} lang={lang} />
                          </a>
                        </span>
                        <span class="session-main">
                          <a class="session-title" href={s.bookUrl} {...bookAttrs(s)}>{s.title}</a>
