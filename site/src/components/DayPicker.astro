  {/* The workshops and, beside them, the map. */}
  <div class="dayresults sidemap-results">
  <div class="daysessions sidemap-list">
    {days.map((offset) => {
      const forDay = sessions.filter((s) => s.dayOffset === offset);
      // The grid places tiles by this rather than by markup order, so a host's
      // two sessions never sit next to each other; the list keeps time order.
      const spread = spreadByHost(forDay);
      return (
        <div class="daygroup" data-day={offset} hidden={variant === '2' ? offset > 6 : offset !== 0}>
