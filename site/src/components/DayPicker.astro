                          {s.partner && <span class="session-code">{partnerNote[lang](s.partner.percent, s.partner.code)}</span>}
                          {s.salesEnd && <span class="session-deadline">{t.salesEnd} {formatDeadline(s.salesEnd)}</span>}
                          <Voucher kind="tile" host={s.host} lang={lang} title={s.title} workshopKey={s.workshopKey} />
                        </span>
                        <span class="session-side">
                          {s.price && (
                            <span class="session-price">
                              {showPrice(s.price)}
                              {s.priceWas && <s class="session-price-was">{s.priceWas}</s>}
                            </span>
                          )}
                          {s.soldOut ? (
                            <button class="session-book session-notify" type="button" {...bookAttrs(s)}>{t.notify}</button>
                          ) : (
                            <a class="session-book" href={s.bookUrl} {...bookAttrs(s)}>{s.request ? t.request : s.partner ? partnerBook[lang](s.partner.percent) : t.book}</a>
                          )}
                        </span>
                      </li>
                    ) : (
                      <li class="session" id={s.id} data-host={s.host.slug} data-seen={`s:${s.id}`} style={`--spread:${spread.get(s)}`} data-activity={activitiesOf(s.host).join(' ')} data-district={districtOf(s)} data-kids={s.kids ? 'true' : undefined} data-evening={isEvening(s) ? 'true' : undefined} {...priceAttrs(s.price)}
                        data-track-card="session" data-track-host={s.host.name} data-track-title={s.title} data-track-date={isoDate(s.dayOffset)}>
                        {/* The thumbnail plays the host's reel where footage
                            exists — the card shows the session moving, per
                            the app — then prefers the workshop's own scraped
