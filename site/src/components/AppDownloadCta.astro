---
import StoreButtons from './StoreButtons.astro';
import { DEFAULT_LANG, type Lang } from '../lib/url.ts';

interface Props {
  lang?: Lang;
}
const { lang = DEFAULT_LANG } = Astro.props;

const title = {
  en: '📱 Ready to dive in? Download now on Apple Store and Google Play!',
  de: '📱 Bereit loszulegen? Jetzt im App Store und bei Google Play herunterladen!',
}[lang];
---

<section class="cta-band">
  <div class="container-padded">
    <h3 class="cta-title">{title}</h3>
    <StoreButtons lang={lang} tone="accent" class="cta-actions" />
  </div>
</section>
