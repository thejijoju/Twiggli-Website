---
import { href, type Lang } from '../lib/url.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

/** Strip the deploy base and the /de/ language prefix (if any) off the
 *  current URL, leaving a bare in-site path like '/corporate/' — then
 *  rebuild it in each language. Keeps the switcher correct on every page
 *  without every page having to pass its own "same page, other language"
 *  link down. */
const base = import.meta.env.BASE_URL;
let path = Astro.url.pathname;
if (path.startsWith(base)) path = `/${path.slice(base.length)}`;
const bare = path.replace(/^\/de(\/|$)/, '/') || '/';
---

<div class="lang-switch" id="lang-switch">
  <a href={href('en', bare)} class:list={{ 'lang-active': lang === 'en' }} data-lang="en">EN</a>
  <span aria-hidden="true">/</span>
  <a href={href('de', bare)} class:list={{ 'lang-active': lang === 'de' }} data-lang="de">DE</a>
</div>

<script>
  // A manual switch is a deliberate choice — remember it so the auto-detect
  // redirect in Base.astro's <head> never overrides it on a later visit.
  document.getElementById('lang-switch')?.querySelectorAll('a[data-lang]').forEach((link) => {
    link.addEventListener('click', () => {
      const chosen = link.getAttribute('data-lang');
      if (chosen) localStorage.setItem('twiggli-lang', chosen);
    });
  });
</script>

