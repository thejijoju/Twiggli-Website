---
/** Schema.org Event markup for the happening-today feed.
 *
 *  Google's event search experience ("workshops berlin" style queries)
 *  only lists events it can read as structured data — this emits every
 *  real upcoming session as a schema.org Event inside one JSON-LD
 *  ItemList, built from the same feed the visible cards use, so the
 *  markup can never drift from the page. Sessions deep-link back to
 *  their card via the feed's #live-… anchors.
 */
import { getSessions } from '../data/sessions.ts';
import { absolute, hostHref, sessionIso } from '../data/seo.ts';
import type { Lang } from '../lib/url.ts';

interface Props {
  lang: Lang;
  /** Absolute URL of the page carrying the markup. */
  pageUrl: string;
}

const { lang, pageUrl } = Astro.props;
// Google caps how much markup it reads per page; the nearest sessions are
// the ones a searcher can still act on anyway.
const sessions = getSessions(lang).slice(0, 80);

const events = sessions.map((s) => ({
  '@type': 'Event',
  name: s.title,
  startDate: sessionIso(s),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: s.host.studio ?? s.host.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: s.place,
      addressLocality: 'Berlin',
      addressCountry: 'DE',
    },
  },
  ...(s.image || s.host.photo ? { image: [s.image ?? s.host.photo] } : {}),
  description: `${s.host.specialty} — ${s.host.name}`,
  organizer: { '@type': 'Organization', name: s.host.name },
  // The from-price: "€40–100" is 40, not the 40100 that stripping every
  // non-digit used to send.
  ...(s.price && /\d/.test(s.price)
    ? {
        offers: {
          '@type': 'Offer',
          price: s.price.match(/\d+(?:[.,]\d+)?/)![0].replace(',', '.'),
          priceCurrency: 'EUR',
          url: s.bookUrl,
          availability: s.soldOut
            ? 'https://schema.org/SoldOut'
            : 'https://schema.org/InStock',
        },
      }
    : {}),
  // The host's own page, a URL of its own — an #anchor on this page folds
  // into this page, and Google lists one event per URL.
  url: absolute(hostHref(lang, s.host)),
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: events.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: e,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
