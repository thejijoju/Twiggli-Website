---
/** The four nav glyphs, at their exported 18px size. All four are solid
 *  fills in currentColor, so they inherit white in the dark social strip and
 *  the text colour on the contact page.
 *
 *  The four marks come from different sources and none of them centres its
 *  own artwork: Facebook's 'f' hangs 1.75 units below the middle of its box,
 *  YouTube's badge is wider than it is tall, and Instagram is drawn on a
 *  32-unit grid where the rest use 24. Left alone they render at different
 *  sizes and sit at different heights, so the row reads as four unrelated
 *  stickers rather than one line.
 *
 *  So each viewBox below is not the authored one — it is a square centred on
 *  that glyph's measured ink, sized to 4/3 of the ink's longest side. That
 *  puts every mark's centre on the same line and fits each into an identical
 *  13.5px optical square inside the 18px box, whatever its own proportions.
 *  Re-measure with getBBox() if a path ever changes. */
interface Props {
  name: 'instagram' | 'facebook' | 'youtube' | 'linkedin';
  size?: number;
}
const { name, size = 18 } = Astro.props;

const viewBoxes = {
  /* ink 4,4 → 27.9,27.9 (23.9 square), already centred on its 32 grid */
  instagram: '0 0 31.867 31.867',
  /* ink 7,5 → 15.5,22.5: tall and narrow, and low in the box */
  facebook: '-0.417 2.083 23.333 23.333',
  /* ink 2,5 → 22,19: the widest mark, so width is what gets normalised */
  youtube: '-1.333 -1.333 26.667 26.667',
  /* ink 3,3 → 21,21 (18 square), already centred */
  linkedin: '0 0 24 24',
};
const viewBox = viewBoxes[name];
---

<svg width={size} height={size} viewBox={viewBox} fill="currentColor" aria-hidden="true">
  {name === 'instagram' && (
    <>
      <path d="M22.3,8.4c-0.8,0-1.4,0.6-1.4,1.4c0,0.8,0.6,1.4,1.4,1.4c0.8,0,1.4-0.6,1.4-1.4C23.7,9,23.1,8.4,22.3,8.4z" />
      <path d="M16,10.2c-3.3,0-5.9,2.7-5.9,5.9s2.7,5.9,5.9,5.9s5.9-2.7,5.9-5.9S19.3,10.2,16,10.2z M16,19.9c-2.1,0-3.8-1.7-3.8-3.8 c0-2.1,1.7-3.8,3.8-3.8c2.1,0,3.8,1.7,3.8,3.8C19.8,18.2,18.1,19.9,16,19.9z" />
      <path d="M20.8,4h-9.5C7.2,4,4,7.2,4,11.2v9.5c0,4,3.2,7.2,7.2,7.2h9.5c4,0,7.2-3.2,7.2-7.2v-9.5C28,7.2,24.8,4,20.8,4z M25.7,20.8 c0,2.7-2.2,5-5,5h-9.5c-2.7,0-5-2.2-5-5v-9.5c0-2.7,2.2-5,5-5h9.5c2.7,0,5,2.2,5,5V20.8z" />
    </>
  )}
  {name === 'facebook' && (
    <path d="M15.5 8.5h-2c-.6 0-1 .4-1 1v2h3l-.4 3h-2.6v8h-3v-8H7v-3h2.5V9c0-2.5 1.5-4 4-4h2v3z" />
  )}
  {/* One path, evenodd: the play triangle is a hole punched through the
      rounded rect, so it shows whatever is behind the icon. Filling it with a
      colour instead would make it vanish wherever that colour matched the
      body of the mark — which is exactly what happens on the black strip once
      the icons go full white. */}
  {name === 'youtube' && (
    <path
      fill-rule="evenodd"
      d="M6 5h12a4 4 0 0 1 4 4v6a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V9a4 4 0 0 1 4-4zm4 3.5v7l6-3.5z"
    />
  )}
  {name === 'linkedin' && (
    <>
      <circle cx="5" cy="5" r="2" />
      <rect x="3.5" y="9" width="3" height="12" />
      <path d="M10 9h3v1.6c.7-1.1 2-1.9 3.7-1.9 3 0 4.3 2 4.3 5.4V21h-3v-6.4c0-1.6-.5-2.7-2-2.7-1.2 0-1.9.8-2.2 1.6-.1.3-.1.7-.1 1.1V21h-3z" />
    </>
  )}
</svg>
