---
/** The four nav glyphs, at their exported 18px size. Instagram renders as
 *  the outline camera mark; Facebook/YouTube/LinkedIn render as their
 *  solid wordmarks — matching how each brand's own glyph actually looks,
 *  rather than forcing every icon through the same stroke treatment. */
interface Props {
  name: 'instagram' | 'facebook' | 'youtube' | 'linkedin';
  size?: number;
}
const { name, size = 18 } = Astro.props;
const outline = name === 'instagram';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={outline ? 'none' : 'currentColor'}
  stroke={outline ? 'currentColor' : 'none'}
  stroke-width={outline ? 2 : undefined}
  stroke-linecap={outline ? 'round' : undefined}
  stroke-linejoin={outline ? 'round' : undefined}
  aria-hidden="true"
>
  {name === 'instagram' && (
    <>
      <rect x="2" y="2" width="20" height="20" rx="5" />
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
      <path d="M17.5 6.5h.01" />
    </>
  )}
  {name === 'facebook' && (
    <path d="M15.5 8.5h-2c-.6 0-1 .4-1 1v2h3l-.4 3h-2.6v8h-3v-8H7v-3h2.5V9c0-2.5 1.5-4 4-4h2v3z" />
  )}
  {name === 'youtube' && (
    <>
      <rect x="2" y="5" width="20" height="14" rx="4" />
      <path d="M10 8.5v7l6-3.5z" fill="var(--color-bg)" />
    </>
  )}
  {name === 'linkedin' && (
    <>
      <circle cx="5" cy="5" r="2" />
      <rect x="3.5" y="9" width="3" height="12" />
      <path d="M10 9h3v1.6c.7-1.1 2-1.9 3.7-1.9 3 0 4.3 2 4.3 5.4V21h-3v-6.4c0-1.6-.5-2.7-2-2.7-1.2 0-1.9.8-2.2 1.6-.1.3-.1.7-.1 1.1V21h-3z" />
    </>
  )}
</svg>
