---
/** One host's page: the search phrase in the title and heading, the reel,
 *  the blurb and the practical facts, then every upcoming date and time
 *  they have published, and the other hosts in the same activity. */
import { priceSummary } from '../data/priceFilter.ts';
import Base from '../layouts/Base.astro';
import DateRows from './DateRows.astro';
import HostMonogram from './HostMonogram.astro';
import PhotoFade from './PhotoFade.astro';
import WorkshopSchema from './WorkshopSchema.astro';
import Voucher from './Voucher.astro';
import { getHosts, isPreviewHost, requestMin } from '../data/content.ts';
import { hostAbout, hostLogos } from '../data/hostAbout.ts';
import { followCopy } from '../data/follow.ts';
import { tagsFor } from '../data/hostTags.ts';
import { requestEmail } from '../data/site.ts';
import { isVoucherHost } from '../data/vouchers.ts';
import { getHostPriceRanges, previewOnRequestFor, previewSessionsFor } from '../data/sessions.ts';
import {
  activityCopy, activityHref, formatWhen, hostDescription, hostDurationText, hostGroupText, hostH1, hostHref, hostImage,
  hostLanguagesText, hostLede, hostTitle, hostsIn, hubExtraCopy, hubHref, nextSessionByHost, onRequestFor, pageCopy,
  sessionsFor, workshopHref, workshopsFor,
} from '../data/seo.ts';
import { href, type Lang } from '../lib/url.ts';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const host = getHosts(lang, { withPreview: true }).find((h) => h.slug === slug);
if (!host) throw new Error(`No host with slug ${slug}`);

const t = pageCopy[lang];
/** "€0" reads as a number, not as free (DayPicker.astro, showPrice). */
const showFree = (p: string) => (/^€\s*0([.,]0+)?$/.test(p.trim()) ? t.free : p);
const x = hubExtraCopy[lang];
const activity = activityCopy[lang][host.activity];
// A preview host (hosts/preview.ts) is in no listing: the page is noindex,
// its dates come only from its own entries, and a date's title books
// rather than leading to a per-workshop page that is not built for it.
const preview = isPreviewHost(host.slug);
const sessions = preview ? previewSessionsFor(host.slug, lang) : sessionsFor(host.slug, lang);
const workshops = preview ? [] : workshopsFor(host.slug, lang);
const onRequest = preview ? previewOnRequestFor(host.slug, lang) : onRequestFor(host.slug, lang);
const next = nextSessionByHost(lang);
const others = hostsIn(host.activity, lang).filter((h) => h.slug !== host.slug);
// The host's own words and logo, where they sent us some (hostAbout.ts).
const about = hostAbout[host.slug]?.[lang];
const logo = hostLogos[host.slug];
const f = followCopy[lang];
const tags = tagsFor(host.slug, lang);

// The price the host gave for groups, as the group page shows it; otherwise
// the spread of their dated workshops (which can include a multi-session
// course, so it comes second) — "on request" only where neither exists.
const priceRange = (host.groupPrice == null ? undefined
    : Array.isArray(host.groupPrice) ? host.groupPrice
    : [host.groupPrice, host.groupPrice] as [number, number])
  ?? getHostPriceRanges().get(host.slug);
const money = (n: number) => `€${Math.round(n)}`;
const priceText = !priceRange
  ? t.priceUnknown
  : priceRange[0] === 0 && priceRange[1] === 0 ? t.free
  : priceRange[0] === priceRange[1] ? `${money(priceRange[0])} · ${t.perPerson}`
  : `${money(priceRange[0])}–${money(priceRange[1])} · ${t.perPerson}`;

/** An on-request workshop's Inquire hands the booking form its name, host,
 *  price and the host's page (BookingDialog.astro). */
const inquireAttrs = (o: { title: string; price?: string; bookUrl: string }) => ({
  'data-book': 'request',
  'data-book-title': o.title,
  'data-book-host': host.name,
  'data-book-price': o.price,
  'data-book-link': o.bookUrl,
});
---

<Base
  title={hostTitle(host, lang)}
  description={hostDescription(host, sessions, lang)}
  lang={lang}
  image={hostImage(host)}
  noindex={preview}
>
  <Fragment slot="head">
    {/* The gift box's display serif, only where it shows. */}
    {isVoucherHost(host.slug) && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,800;1,9..144,500&display=swap" />}
  </Fragment>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={hubHref(lang)}>{t.crumbsRoot}</a>
      <span aria-hidden="true">›</span>
      <a href={activityHref(lang, host.activity)}>{activity.short}</a>
      <span aria-hidden="true">›</span>
      <span>{host.name}</span>
    </nav>

    <section class="page-head host-head" data-seen-visit={`h:${host.slug}`}>
      <span class="kicker kicker-tight">{t.inBerlin} · {activity.short}</span>
      <h1 class="page-title">{hostH1(host, lang)}</h1>
      <p class="page-lede">{hostLede(host, sessions, lang)}</p>
    </section>

    <hr class="rule" />

    <section class="section host-body">
      <div class="host-col">
      <div class="host-media">
        {host.video ? (
          <video
            class="host-video"
            src={host.video}
            poster={host.poster}
            muted
            loop
            playsinline
            autoplay
            preload="metadata"
            aria-label={`${host.name} — ${host.specialty}`}
          ></video>
        ) : host.gallery && host.gallery.length > 1 ? (
          /* Starts one picture on, so the frame and the slides under it do
             not open on the same photo. */
          <PhotoFade photos={[...host.gallery.slice(1), host.gallery[0]]} alt={`${host.name} — ${host.specialty}`} eager />
        ) : host.photo ? (
          <img src={host.photo} alt={`${host.name} — ${host.specialty}`} loading="lazy" decoding="async" />
        ) : (
          <HostMonogram name={host.name} />
        )}
      </div>
      {/* More of the work, where the host has sent pictures of it: a
          slideshow under the reel, swiped or stepped through with the dots,
          turning by itself every few seconds unless motion is reduced. */}
      {host.gallery && host.gallery.length > 0 && (
        <div class="host-slides" data-slides>
          <ul class="host-slides-track" data-slides-track>
            {host.gallery.map((src, i) => (
              <li><img src={src} alt={`${host.name} — ${host.specialty} (${i + 1}/${host.gallery!.length})`} loading="lazy" decoding="async" /></li>
            ))}
          </ul>
          {host.gallery.length > 1 && (
            <div class="host-slides-dots">
              {host.gallery.map((_, i) => (
                <button type="button" data-slide={i} aria-label={`${i + 1} / ${host.gallery!.length}`} aria-current={i === 0 ? 'true' : undefined}></button>
              ))}
            </div>
          )}
        </div>
      )}
      </div>
      <div class="host-facts">
        {tags.length > 0 && <ul class="host-tags">{tags.map((t) => <li>{t}</li>)}</ul>}
        {logo && <img class="host-logo" src={logo} alt={host.studio ?? host.name} width="72" height="72" loading="lazy" decoding="async" />}
        {about ? (
          <div class="host-about">
            {about.paras.map((para) => <p>{para}</p>)}
            <p class="host-about-title">{about.listTitle}</p>
            <ul>{about.list.map((item) => <li>{item}</li>)}</ul>
            <p>{about.closing}</p>
          </div>
        ) : (
          /* Three lines, fading out; a tap opens the rest (lib/fadetext.ts). */
          <div class="fade-text" data-fade><p class="host-blurb">{host.blurb}</p></div>
        )}
        {host.instagram && (
          <a class="host-insta" href={`https://www.instagram.com/${host.instagram}/`} target="_blank" rel="noopener" aria-label={`Instagram @${host.instagram}`} title={`@${host.instagram}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none" /></svg>
          </a>
        )}
        <dl class="maker-meta">
          {host.studio && <div><dt>{t.studio}</dt><dd>{host.studio}</dd></div>}
          <div><dt>{t.group}</dt><dd>{hostGroupText(host, lang)}</dd></div>
          <div><dt>{t.duration}</dt><dd>{hostDurationText(host, lang)}</dd></div>
          <div><dt>{t.place}</dt><dd>{host.place}</dd></div>
          <div><dt>{t.languages}</dt><dd>{hostLanguagesText(host, lang)}</dd></div>
          <div><dt>{t.price}</dt><dd>{priceText}{host.priceNote ? ` · ${host.priceNote}` : ''}</dd></div>
        </dl>
        <div class="host-actions">
        {/* Opens our booking form on the page as a group request, this host
            and their price filled in; without scripts, the contact form. */}
        <a
          class="maker-request"
          href={`${href(lang, '/contact/')}?host=${encodeURIComponent(host.name)}`}
          data-book="group"
          data-book-title={host.specialty}
          data-book-host={host.name}
          data-book-price={priceRange ? priceText : undefined}
          data-book-group={host.groupRange[0] <= 1 ? `≤ ${host.groupRange[1]}` : host.groupRange[0] === host.groupRange[1] ? String(host.groupRange[1]) : `${host.groupRange[0]}–${host.groupRange[1]}`}
          data-book-min={requestMin(host)}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2 11 13" /><path d="M22 2 15 22l-4-9-9-4Z" /></svg>
          {t.request}
        </a>
        {/* A · the second button, for a host who takes vouchers. */}
        <Voucher kind="pill" host={host} lang={lang} title={sessions[0]?.title} />
        </div>
        {/* B · the gift box: 1 or 2 places at the host's price. */}
        <Voucher kind="box" host={host} lang={lang} title={sessions[0]?.title} />
        {/* Follow: an email when this host adds dates (data/follow.ts). The
            field is the button's first step; a remembered email is filled in. */}
        <div class="host-follow" data-follow={host.slug} data-follow-name={host.name} hidden>
          <form class="host-follow-form" data-follow-form data-inbox={requestEmail} data-sending={f.sending} data-send={f.send} novalidate>
            <label class="host-follow-prompt" for="follow-email">{f.prompt(host.name)}</label>
            <div class="subscribe-field">
              <input id="follow-email" type="email" name="email" autocomplete="email" placeholder={f.placeholder} required />
              <button type="submit" class="subscribe-btn">{f.send}</button>
            </div>
            <p class="host-follow-note" data-follow-error hidden>{f.error}</p>
          </form>
          <p class="host-follow-done" data-follow-done hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            {f.done(host.name)}
          </p>
        </div>
      </div>
    </section>


    <hr class="rule" />

    {workshops.length > 1 && (
      <>
        <section class="section">
          <h2 class="section-title">{x.theirWorkshops}</h2>
          <ul class="activity-links">
            {workshops.map((w) => (
              <li>
                <a href={workshopHref(lang, host, w.key)}>
                  {w.title}
                  <span class="activity-links-count">{t.next}: {formatWhen(w.sessions[0], lang)}{priceSummary(w.sessions.map((s) => s.price)) && <> · <strong class="activity-links-price">{showFree(priceSummary(w.sessions.map((s) => s.price))!)}</strong></>} · {t.dates(w.sessions.length)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
        <hr class="rule" />
      </>
    )}

    <section class="section" id="dates">
      <h2 class="section-title">{t.upcoming}</h2>
      {sessions.length ? (
        <DateRows sessions={sessions} lang={lang} linkTitlesTo={preview ? 'booking' : 'workshop'} />
      ) : (
        <p class="section-lede">{t.noDates}</p>
      )}

      {onRequest.length > 0 && (
        <div class="onrequest-block">
          <h3 class="section-subtitle">{t.onRequest}</h3>
          <p class="section-lede">{t.onRequestNote}</p>
          <ul class="dates">
            {onRequest.map((o) => (
              <li class="date-row" id={o.id}>
                <span class="date-when"><span class="date-day">{t.onRequest}</span></span>
                <span class="date-main">
                  <a class="date-title" href={o.bookUrl} {...inquireAttrs(o)}>{o.title}</a>
                  <span class="date-meta">{o.duration ?? host.duration} · {o.district}</span>
                </span>
                <span class="date-side">
                  {o.price && <span class="date-price">{o.price}</span>}
                  <a class="date-book" href={o.bookUrl} {...inquireAttrs(o)}>{t.inquire}</a>
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <p class="section-more"><a href={href(lang, '/happening-today/')}>{t.calendar} →</a></p>
    </section>

    {others.length > 0 && (
      <>
        <hr class="rule" />
        <section class="section">
          <h2 class="section-title">
            <a href={activityHref(lang, host.activity)}>{t.moreIn(activity.short)}</a>
          </h2>
          <ul class="host-cards">
            {others.map((h) => {
              const n = next.get(h.slug);
              return (
                <li>
                  <a class="host-card" href={hostHref(lang, h)}>
                    <span class="host-card-media">
                      {h.poster ? (
                        <img src={h.poster} alt="" loading="lazy" decoding="async" />
                      ) : h.photo ? (
                        <img src={h.photo} alt="" loading="lazy" decoding="async" />
                      ) : (
                        <HostMonogram name={h.name} />
                      )}
                      <Voucher kind="badge" host={h} lang={lang} />
                    </span>
                    <span class="host-card-name">{h.name}</span>
                    <span class="host-card-spec">{h.specialty}</span>
                    <span class="host-card-next">
                      {n ? `${t.next}: ${formatWhen(n, lang)}${n.price ? ` · ${n.price}` : ''}` : t.onRequest}
                    </span>
                  </a>
                  <Voucher kind="tile" host={h} lang={lang} />
                </li>
              );
            })}
          </ul>
        </section>
      </>
    )}
  </div>
  {!preview && <WorkshopSchema host={host} sessions={sessions} lang={lang} />}
</Base>

<script>
  // Follow (data/follow.ts): an email field with the button inside it. A
  // follow reaches our inbox as "Follow host"; this device keeps the email
  // (filled in next time) and the hosts it follows. Storage may be blocked —
  // then it just asks again.
  const KEY = 'twiggli-follow';
  type Saved = { email?: string; hosts?: string[] };
  const load = (): Saved => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
  const save = (v: Saved) => { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch { /* private mode */ } };

  const box = document.querySelector<HTMLElement>('[data-follow]');
  const form = box?.querySelector<HTMLFormElement>('[data-follow-form]');
  if (box && form) {
    const slug = box.dataset.follow ?? '';
    const name = box.dataset.followName ?? slug;
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const error = form.querySelector<HTMLElement>('[data-follow-error]');
    const doneNote = box.querySelector<HTMLElement>('[data-follow-done]');
    const done = () => { form.hidden = true; if (doneNote) doneNote.hidden = false; };
    box.hidden = false;
    const saved = load();
    if (saved.hosts?.includes(slug)) done();
    else if (saved.email && input) input.value = saved.email;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const email = (input?.value ?? '').trim();
      if (submit) { submit.disabled = true; submit.textContent = form.dataset.sending ?? ''; }
      if (error) error.hidden = true;
      try {
        const res = await fetch(`https://formsubmit.co/ajax/${form.dataset.inbox}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            Type: 'Follow host',
            Host: name,
            email,
            Language: document.documentElement.lang || 'en',
            Page: location.href,
            _subject: `Follow: ${name} — ${email}`,
            _template: 'table',
            _captcha: 'false',
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        const before = load();
        save({ email, hosts: [...new Set([...(before.hosts ?? []), slug])] });
        import('../lib/track.ts').then(({ track }) => track('follow', { host: slug })).catch(() => {});
        done();
      } catch {
        if (error) error.hidden = false;
        if (submit) { submit.disabled = false; submit.textContent = form.dataset.send ?? ''; }
      }
    });
  }
</script>

<script>
  // The photo slideshow under the reel: the dots follow the swipe, a dot
  // jumps to its photo, and it turns every 4 s until someone touches it.
  document.querySelectorAll<HTMLElement>('[data-slides]').forEach((box) => {
    const track = box.querySelector<HTMLElement>('[data-slides-track]');
    const dots = Array.from(box.querySelectorAll<HTMLButtonElement>('[data-slide]'));
    if (!track || dots.length < 2) return;
    const go = (i: number) => track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
    const current = () => Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
    dots.forEach((d, i) => d.addEventListener('click', () => { stop(); go(i); }));
    track.addEventListener('scroll', () => {
      const n = current();
      dots.forEach((d, i) => (i === n ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    }, { passive: true });
    let timer: number | undefined;
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      timer = window.setInterval(() => go((current() + 1) % dots.length), 4000);
      ['pointerdown', 'wheel', 'touchstart'].forEach((e) => track.addEventListener(e, stop, { passive: true }));
    }
  });
</script>
