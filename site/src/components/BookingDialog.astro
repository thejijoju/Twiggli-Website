---
/**
 * The booking form every Book, Request and Notify button on the site opens
 * — on the page, without sending anyone to the host's own site. The button
 * carries the workshop: data-book ("book", "request" or "notify") and
 * data-book-title, -host, -date (ISO), -time, -price and -link (the host's
 * booking page, which only we see). The form adds who is coming and sends
 * it all to our inbox as one email, so every booking goes through Twiggli.
 *
 * Sent through FormSubmit, a form-to-email service that needs no account
 * (the site is static and cannot send mail itself). Its first message asks
 * the inbox owner, once, to confirm the address. Should the service be
 * unreachable, the visitor's own mail app opens with the same message.
 */
import { bookingCopy } from '../data/bookingCopy.ts';
import { bigEventsCopy } from '../data/bigEvents.ts';
import { contactEmail, requestEmail } from '../data/site.ts';
import { LANG_META, type Lang } from '../lib/url.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = bookingCopy[lang];
// A big event with several hosts, or something not listed at all
// (bigEvents.ts): the same form, with the hosts to pick from.
const e = bigEventsCopy[lang].dialog;
---

<dialog
  class="book-dialog"
  data-book-dialog
  data-inbox={requestEmail}
  data-contact={contactEmail}
  data-locale={LANG_META[lang].locale}
  data-lang={lang}
  data-copy={JSON.stringify({ ...c, ...e })}
>
  <button type="button" class="book-close" data-book-close aria-label={c.close}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
  </button>
  <div class="book-scroll">
  <form class="book-form" data-book-form novalidate>
    <h2 class="book-title" data-book-heading>{c.book}</h2>
    <div class="book-summary">
      <p class="book-workshop" data-book-workshop></p>
      <p class="book-when" data-book-when></p>
    </div>
    <p class="book-lede" data-book-lede>{c.lede}</p>
    <div class="book-fields">
      <label class="book-field book-field-wide">
        <span>{c.name}</span>
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label class="book-field book-field-wide">
        <span>{c.email}</span>
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label class="book-field">
        <span>{c.phone} <em>({c.optional})</em></span>
        <input name="phone" type="tel" autocomplete="tel" />
      </label>
      <label class="book-field">
        <span>{c.people}</span>
        <input name="people" type="number" min="1" max="2000" value="1" inputmode="numeric" required />
        <small class="book-hint" data-book-min-hint hidden></small>
      </label>
      {/* Only where nothing is booked for a date yet: a group, or a workshop
          that runs on request. */}
      <label class="book-field book-field-wide" data-book-when-field hidden>
        <span>{c.when} <em>({c.optional})</em></span>
        <input name="when" type="date" />
      </label>
      {/* A group request: at the host's studio or at the group's own venue. */}
      <div class="book-studio" data-book-group-place hidden>
        <fieldset class="book-field book-field-wide book-often">
          <legend>{c.where}</legend>
          <div class="book-often-chips">
            <label><input type="radio" name="place" value="host" /><span>{c.atHost}</span></label>
            <label><input type="radio" name="place" value="venue" /><span>{c.atVenue}</span></label>
          </div>
        </fieldset>
        <label class="book-field book-field-wide" data-book-venue hidden>
          <span>{c.venue} <em>({c.optional})</em></span>
          <input name="venue" type="text" autocomplete="street-address" placeholder={c.venuePh} />
        </label>
      </div>
      {/* An event with several hosts, or a special request: the hosts on
          the page to pick from, as many as wanted or none. The button
          hands the list over (data-book-hosts), so the form carries no
          host list of its own on pages that never ask for one. */}
      <fieldset class="book-field book-field-wide book-often book-hosts" data-book-hosts-box hidden>
        <legend>{e.hostsLabel} <em>({c.optional})</em></legend>
        <small class="book-hint">{e.hostsHint}</small>
        <div class="book-often-chips book-hosts-chips" data-book-hosts-list></div>
      </fieldset>
      {/* A studio request: when it starts, for how long, once or regularly. */}
      <div class="book-studio" data-book-studio hidden>
        <label class="book-field">
          <span>{c.start}</span>
          <input name="start" type="time" step="900" />
        </label>
        <label class="book-field">
          <span>{c.hours}</span>
          <input name="hours" type="number" min="0.5" max="24" step="0.5" inputmode="decimal" placeholder="4" />
        </label>
        <fieldset class="book-field book-field-wide book-often">
          <legend>{c.often}</legend>
          <div class="book-often-chips">
            <label><input type="radio" name="often" value="once" checked /><span>{c.once}</span></label>
            <label><input type="radio" name="often" value="regular" /><span>{c.regular}</span></label>
          </div>
        </fieldset>
      </div>
      <label class="book-field book-field-wide">
        <span><span data-book-message-label>{c.message}</span> <em>({c.optional})</em></span>
        <textarea name="message" rows="3" placeholder={c.messagePh} data-book-message></textarea>
      </label>
      {/* Left empty by people; a bot that fills it is ignored. */}
      <input class="book-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
    </div>
    <p class="book-error" data-book-error hidden></p>
    <button type="submit" class="btn btn-primary book-send" data-book-send>{c.send}</button>
  </form>
  <div class="book-sent" data-book-sent hidden>
    <h2 class="book-title">{c.sentTitle}</h2>
    <p class="book-lede">{c.sentBody}</p>
    <button type="button" class="btn btn-primary" data-book-close>{c.close}</button>
  </div>
  </div>
</dialog>

<script>
  import { looksLikeBot } from '../lib/honey.ts';
  import { track } from '../lib/track.ts';

  // How the visitor reached the site, taken on the first page of their
  // visit (a campaign tag, or the site that linked to us) and kept for the
  // tab, so a booking three pages later still says where it started.
  const SOURCE_KEY = 'twiggli-came-from';
  try {
    if (!sessionStorage.getItem(SOURCE_KEY)) {
      const q = new URLSearchParams(location.search);
      const tag = ['utm_source', 'utm_medium', 'utm_campaign'].map((k) => q.get(k)).filter(Boolean).join(' / ');
      const ref = document.referrer && new URL(document.referrer).host !== location.host ? new URL(document.referrer).host : '';
      sessionStorage.setItem(SOURCE_KEY, tag || ref || 'direct');
    }
  } catch { /* storage blocked: the line just says unknown */ }
  function cameFrom() {
    try { return sessionStorage.getItem(SOURCE_KEY) || 'unknown'; } catch { return 'unknown'; }
  }

  // A partner host's own booking page (partners.ts): the link opens as
  // usual, and our discount code goes to the clipboard on the way, with a
  // word saying so, so it is ready to paste at their checkout.
  document.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLElement>('[data-partner-code]');
    if (!link) return;
    navigator.clipboard?.writeText(link.dataset.partnerCode ?? '').catch(() => {});
    const toast = document.createElement('div');
    toast.className = 'code-toast';
    toast.setAttribute('role', 'status');
    toast.textContent = `${link.dataset.partnerCopied ?? ''}: ${link.dataset.partnerCode ?? ''}`;
    document.body.append(toast);
    setTimeout(() => toast.remove(), 3500);

    // And a line in our inbox, since the booking itself happens on the
    // host's site: which session, what it costs and how full it is, from
    // which page and how the visitor found us — nothing about who they are.
    // Once per session per page view, however often it is clicked.
    const d = link.dataset;
    const key = `${d.partnerHost}|${d.partnerDate}|${d.partnerTime}|${d.partnerTitle}`;
    if (partnerSent.has(key)) return;
    partnerSent.add(key);
    const inbox = document.querySelector<HTMLElement>('[data-book-dialog]')?.dataset.inbox;
    if (!inbox) return;
    const host = d.partnerHost ?? '';
    const name = d.partnerName || host.charAt(0).toUpperCase() + host.slice(1);
    fetch(`https://formsubmit.co/ajax/${inbox}`, {
      method: 'POST',
      keepalive: true,
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({
        Type: 'Partner booking click',
        Host: name,
        Workshop: d.partnerTitle ?? '',
        Date: d.partnerDate ?? '',
        Time: d.partnerTime ?? '',
        'Price per person': d.partnerPrice || 'not listed',
        'Spots left': d.partnerSpots || 'not listed',
        Duration: d.partnerDuration ?? '',
        Area: d.partnerPlace ?? '',
        Code: d.partnerCode ?? '',
        'Host booking page': (link as HTMLAnchorElement).href ?? '',
        'Clicked on': location.href,
        'Came from': cameFrom(),
        Device: matchMedia('(pointer: coarse)').matches ? 'phone or tablet' : 'computer',
        Language: document.documentElement.lang || 'en',
        _subject: `Booking click: ${name} — ${d.partnerTitle ?? ''}, ${d.partnerDate ?? ''} ${d.partnerTime ?? ''}`.trim(),
        _template: 'table',
        _captcha: 'false',
      }),
    }).catch(() => {});
  });
  const partnerSent = new Set<string>();

  const dialog = document.querySelector<HTMLDialogElement>('[data-book-dialog]');
  const form = dialog?.querySelector<HTMLFormElement>('[data-book-form]');
  if (dialog && form) {
    const copy = JSON.parse(dialog.dataset.copy || '{}');
    const inbox = dialog.dataset.inbox ?? '';
    const locale = dialog.dataset.locale || 'en-GB';
    const heading = dialog.querySelector<HTMLElement>('[data-book-heading]');
    const workshop = dialog.querySelector<HTMLElement>('[data-book-workshop]');
    const when = dialog.querySelector<HTMLElement>('[data-book-when]');
    const lede = dialog.querySelector<HTMLElement>('[data-book-lede]');
    const error = dialog.querySelector<HTMLElement>('[data-book-error]');
    const send = dialog.querySelector<HTMLButtonElement>('[data-book-send]');
    const sent = dialog.querySelector<HTMLElement>('[data-book-sent]');
    const whenField = dialog.querySelector<HTMLElement>('[data-book-when-field]');
    const people = form.querySelector<HTMLInputElement>('input[name="people"]');
    const minHint = dialog.querySelector<HTMLElement>('[data-book-min-hint]');
    const studioBox = dialog.querySelector<HTMLElement>('[data-book-studio]');
    const groupPlace = dialog.querySelector<HTMLElement>('[data-book-group-place]');
    const venueField = dialog.querySelector<HTMLElement>('[data-book-venue]');
    const placeInputs = Array.from(dialog.querySelectorAll<HTMLInputElement>('input[name="place"]'));
    placeInputs.forEach((r) => r.addEventListener('change', () => {
      if (venueField) venueField.hidden = !(r.checked && r.value === 'venue');
    }));
    const hostsBox = dialog.querySelector<HTMLElement>('[data-book-hosts-box]');
    const hostsList = dialog.querySelector<HTMLElement>('[data-book-hosts-list]');
    const messageLabel = dialog.querySelector<HTMLElement>('[data-book-message-label]');
    const message = dialog.querySelector<HTMLTextAreaElement>('[data-book-message]');
    let picked: DOMStringMap = {};

    const dateText = (iso?: string) => {
      if (!iso) return '';
      const d = new Date(`${iso}T12:00:00`);
      return Number.isNaN(d.valueOf()) ? iso : d.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    };

    const open = (el: HTMLElement) => {
      picked = { ...el.dataset };
      const kind = picked.book || 'book';
      if (heading) heading.textContent = copy[kind] ?? copy.book;
      // An event with several hosts and a special request are group
      // requests too: who, how many, when and where, plus the hosts.
      const event = kind === 'event' || kind === 'special';
      if (lede) lede.textContent = kind === 'event' ? copy.eventLede : kind === 'special' ? copy.specialLede : kind === 'notify' ? copy.notifyLede : kind === 'group' ? copy.groupLede : kind === 'studio' ? copy.studioLede : kind === 'membership' ? copy.membershipLede : kind === 'retreat' ? copy.retreatLede : copy.lede;
      if (whenField) whenField.hidden = !!picked.bookDate || kind === 'notify' || kind === 'retreat';
      // A studio request asks when it starts, how long and how often, and
      // its message box is for special notes.
      const studio = kind === 'studio';
      if (studioBox) studioBox.hidden = !studio;
      // A group chooses where; the choice is required, and their own venue
      // asks where that is.
      const group = kind === 'group';
      if (groupPlace) groupPlace.hidden = !group && !event;
      placeInputs.forEach((r) => { r.required = group; r.checked = false; });
      if (venueField) venueField.hidden = true;
      if (messageLabel) messageLabel.textContent = studio ? copy.studioNotes : event ? copy.idea : copy.message;
      if (message) message.placeholder = studio ? copy.studioNotesPh : event ? copy.ideaPh : copy.messagePh;
      // The hosts to choose from, as the button lists them.
      let names: string[] = [];
      try { names = event ? JSON.parse(picked.bookHosts || '[]') : []; } catch { names = []; }
      if (hostsBox) hostsBox.hidden = !names.length;
      if (hostsList) {
        hostsList.replaceChildren(...names.map((name) => {
          const label = document.createElement('label');
          const input = document.createElement('input');
          input.type = 'checkbox';
          input.name = 'hosts';
          input.value = name;
          const span = document.createElement('span');
          span.textContent = name;
          label.append(input, span);
          return label;
        }));
      }
      // A group says how many; the host's range is the hint.
      // A group request names at least the host's own minimum, or four where
      // they have not told us one (GROUP_MIN in content.ts).
      if (people) {
        const min = group ? Math.max(1, Number(picked.bookMin) || 4) : 1;
        people.min = String(min);
        people.value = group || event ? '' : people.value || '1';
        people.placeholder = picked.bookGroup ?? (group ? `${min}+` : event ? '60' : '');
        if (minHint) { minHint.hidden = !group; minHint.textContent = group ? String(copy.minPeople ?? '').replace('{n}', String(min)) : ''; }
      }
      if (workshop) workshop.textContent = [picked.bookTitle, picked.bookHost].filter(Boolean).join(' · ');
      if (when) {
        when.textContent = [dateText(picked.bookDate), picked.bookTime, picked.bookPrice].filter(Boolean).join(' · ');
        when.hidden = !when.textContent;
      }
      if (error) error.hidden = true;
      form.hidden = false;
      if (sent) sent.hidden = true;
      if (send) { send.disabled = false; send.textContent = copy.send; }
      // A button inside another panel (the group page's quick view) hands
      // over to the form rather than stacking it on top.
      document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => { if (d !== dialog) d.close(); });
      dialog.showModal();
      form.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    };

    // Any Book / Request / Notify button, wherever it is on the page.
    document.addEventListener('click', (event) => {
      const el = (event.target as HTMLElement).closest<HTMLElement>('[data-book]');
      if (!el) return;
      event.preventDefault();
      open(el);
    });
    dialog.querySelectorAll('[data-book-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      if (looksLikeBot(data)) return;
      const kind = picked.book || 'book';
      const label = kind === 'event' ? 'Multi-host event request' : kind === 'special' ? 'Special request' : kind === 'notify' ? 'Waiting list' : kind === 'group' ? 'Group booking request' : kind === 'studio' ? 'Studio rental request' : kind === 'membership' ? 'Membership request' : kind === 'retreat' ? 'Retreat information request' : 'Booking request';
      const wish = String(data.get('when') ?? '');
      const fields: Record<string, string> = {
        Type: label,
        [kind === 'studio' ? 'Studio' : 'Workshop']: picked.bookTitle ?? '',
        ...(picked.bookWhere ? { Address: picked.bookWhere } : {}),
        [kind === 'studio' ? 'District' : 'Host']: picked.bookHost ?? '',
        ...(picked.bookKeeper ? { 'Studio host': picked.bookKeeper } : {}),
        Date: picked.bookDate
          ? `${picked.bookDate} (${dateText(picked.bookDate)})`
          : wish ? `preferred: ${wish} (${dateText(wish)})` : 'no date yet',
        Time: picked.bookTime ?? '',
        Price: picked.bookPrice ?? '',
        ...(picked.bookGroup ? { 'Group size (host)': picked.bookGroup } : {}),
        ...(kind === 'studio' ? {
          'Start time': String(data.get('start') ?? ''),
          Hours: String(data.get('hours') ?? ''),
          'How often': data.get('often') === 'regular' ? 'Regularly' : 'One time',
        } : {}),
        ...(kind === 'event' || kind === 'special' ? {
          'Hosts wanted': data.getAll('hosts').map(String).join(', ') || 'none picked: suggest a line-up',
        } : {}),
        ...(kind === 'group' || kind === 'event' || kind === 'special' ? {
          Where: data.get('place') === 'venue' ? 'At their own venue' : data.get('place') === 'host' ? 'At the host’s studio' : 'not said yet',
          ...(data.get('place') === 'venue' && data.get('venue') ? { Venue: String(data.get('venue')) } : {}),
        } : {}),
        People: String(data.get('people') ?? ''),
        Name: String(data.get('name') ?? ''),
        Email: String(data.get('email') ?? ''),
        Phone: String(data.get('phone') ?? ''),
        [kind === 'studio' ? 'Special notes' : 'Message']: String(data.get('message') ?? ''),
        'Host booking page': picked.bookLink ?? '',
        'Sent from': location.href,
        'Came from': cameFrom(),
        Language: dialog.dataset.lang ?? '',
      };
      const studioWhen = kind === 'studio' ? [fields['Start time'], fields.Hours && `${fields.Hours} h`, fields['How often'] === 'Regularly' ? 'regularly' : ''].filter(Boolean).join(', ') : '';
      const subject = `${label}: ${picked.bookTitle ?? ''}${picked.bookHost ? ` · ${picked.bookHost}` : ''}${picked.bookDate ? ` — ${picked.bookDate}${fields.Time ? ` ${fields.Time}` : ''}` : wish ? ` — ${wish}` : ''}${studioWhen ? ` ${studioWhen}` : ''}${fields.Where && fields.Where !== 'not said yet' ? `, ${fields.Where === 'At their own venue' ? 'at their venue' : 'at the studio'}` : ''} (${fields.People})`;
      if (send) { send.disabled = true; send.textContent = copy.sending; }
      try {
        const res = await fetch(`https://formsubmit.co/ajax/${inbox}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          // "email" (lower case) is the field FormSubmit replies to; the
          // visitor's address goes in once, under that name.
          body: JSON.stringify({
            ...Object.fromEntries(Object.entries(fields).filter(([k]) => k !== 'Email')),
            email: fields.Email, _subject: subject, _template: 'table', _captcha: 'false',
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        track('request-sent', { kind, host: picked.bookHost ?? '', title: picked.bookTitle ?? '', lang: dialog.dataset.lang ?? '' });
        form.hidden = true;
        if (sent) sent.hidden = false;
        form.reset();
      } catch {
        // The service is unreachable: say so, and hand the same message to
        // the visitor's mail app so the request still reaches us.
        if (error) {
          error.textContent = copy.error.replace('{email}', dialog.dataset.contact ?? '');
          error.hidden = false;
        }
        if (send) { send.disabled = false; send.textContent = copy.send; }
        const body = Object.entries(fields).filter(([, v]) => v).map(([k, v]) => `${k}: ${v}`).join('\n');
        location.href = `mailto:${dialog.dataset.contact}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      }
    });
  }
</script>
