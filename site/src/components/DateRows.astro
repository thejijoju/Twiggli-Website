---
/** A plain list of sessions — date, time, what, how long, price, Book —
 *  for the host and activity pages. Server-rendered text, one row per
 *  date, no filters and no script: what a searcher and a crawler both want
 *  from "when does this run". The calendar keeps its richer cards. */
import type { Session } from '../data/sessions.ts';
import { formatDay, hostHref, pageCopy, workshopHref } from '../data/seo.ts';
import { berlinTodayMs } from '../data/sessions.ts';
import { almostFullLabel, spotsText } from '../data/availability.ts';
import { partnerBook, partnerCopied, partnerNote } from '../data/partners.ts';
import type { Lang } from '../lib/url.ts';
import { lqipStyle } from '../lib/lqip.ts';

interface Props {
  sessions: Session[];
  lang: Lang;
  /** Name the host on each row — on an activity page, where rows come from
   *  several hosts. A host's own page leaves it off. */
  withHost?: boolean;
  /** Where a row's title leads: the class's own page — every date of it,
   *  in one place — or, on that page itself, straight to the booking. */
  linkTitlesTo?: 'workshop' | 'booking';
  /** A small square of the host's reel at the head of each row, where rows
   *  come from several hosts; on by default wherever the host is named. */
  withThumb?: boolean;
}
const { sessions, lang, withHost = false, linkTitlesTo = 'workshop', withThumb = withHost } = Astro.props;
/* The 240px square cut of a reel's poster (scripts/poster-thumbs.mjs);
   a host with only a photo shows that. */
const thumbFor = (s: Session) =>
  s.host.poster ? s.host.poster.replace(/\/video\/([^/]+)-poster\.jpg$/, '/video/thumbs/$1.jpg') : s.host.photo;
const t = pageCopy[lang];

const showPrice = (price?: string) =>
  price && /^€\s*0([.,]0+)?$/.test(price.trim()) ? t.free : price;
/** What a row's Book (or, when full, waiting-list) button hands the booking
 *  form on the page (BookingDialog.astro) — the booking goes through us. */
const bookAttrs = (s: Session) => (s.partner && !s.soldOut
  // A partner host's own site, with our code copied on the way (partners.ts).
  ? { 'data-partner-code': s.partner.code, 'data-partner-copied': partnerCopied[lang], target: '_blank', rel: 'noopener',
      // For the "partner-booking" event (lib/track.ts).
      'data-partner-host': s.host.slug, 'data-partner-title': s.title, 'data-partner-time': s.time,
      'data-partner-date': new Date(berlinTodayMs() + s.dayOffset * 86400000).toISOString().slice(0, 10) }
  : {
    'data-book': s.soldOut ? 'notify' : s.request ? 'request' : 'book',
    'data-book-title': s.title,
    'data-book-host': s.host.name,
    'data-book-date': new Date(berlinTodayMs() + s.dayOffset * 86400000).toISOString().slice(0, 10),
    'data-book-time': s.time,
    'data-book-price': showPrice(s.price),
    'data-book-link': s.bookUrl,
  });
---

<ul class="dates">
  {sessions.map((s) => (
    <li class:list={['date-row', { 'has-thumb': withThumb }]} id={s.id}>
      {withThumb && (
        <a class="date-thumb" href={workshopHref(lang, s.host, s.workshopKey)} tabindex="-1" aria-hidden="true" style={lqipStyle(s.host.poster)}>
          {thumbFor(s) && <img src={thumbFor(s)} alt="" loading="lazy" decoding="async" />}
          {s.host.video && <video class="date-thumb-video" src={s.host.video} muted loop playsinline preload="none"></video>}
        </a>
      )}
      <span class="date-when">
        <span class="date-day">{formatDay(s.dayOffset, lang)}</span>
        <span class="date-time">{s.time ?? t.timeTba}</span>
      </span>
      <span class="date-main">
        {linkTitlesTo === 'workshop' ? (
          <a class="date-title" href={workshopHref(lang, s.host, s.workshopKey)}>{s.title}</a>
        ) : (
          <a class="date-title" href={s.bookUrl} {...bookAttrs(s)}>{s.title}</a>
        )}
        <span class="date-meta">
          {withHost && <a class="date-host" href={hostHref(lang, s.host)}>{s.host.name}</a>}
          {withHost && ' · '}
          {s.duration ?? s.host.duration} · {s.district} · {s.languages ?? s.host.languages}
        </span>
        {s.partner && <span class="date-code">{partnerNote[lang](s.partner.percent, s.partner.code)}</span>}
      </span>
      <span class="date-side">
        {s.price && <span class="date-price">{showPrice(s.price)}</span>}
        {s.soldOut ? (
          <button type="button" class="date-full" {...bookAttrs(s)}>{s.waitingList ? t.waitingList : t.soldOut}</button>
        ) : s.request ? (
          <a class="date-book" href={s.bookUrl} {...bookAttrs(s)}>{t.requestBooking}</a>
        ) : (
          <a class="date-book" href={s.bookUrl} {...bookAttrs(s)}>{s.partner ? partnerBook[lang](s.partner.percent) : t.book}</a>
        )}
        {!s.soldOut && typeof s.spots === 'number' && (
          <span class="date-spots">{spotsText(s.spots, lang, t.spots)}</span>
        )}
        {!s.soldOut && typeof s.spots !== 'number' && s.almostFull && (
          <span class="date-spots date-almostfull">{almostFullLabel[lang]}</span>
        )}
      </span>
    </li>
  ))}
</ul>

<script>
  import { startReelWalk } from '../lib/reelwalk.ts';

  // The little squares play one at a time, walking down the rows on screen
  // (lib/reelwalk.ts, as on the calendar).
  const reels = Array.from(document.querySelectorAll<HTMLElement>('.date-row.has-thumb'))
    .map((card) => ({
      card,
      tile: card.querySelector<HTMLElement>('.date-thumb'),
      video: card.querySelector<HTMLVideoElement>('.date-thumb-video'),
    }))
    .filter((r): r is { card: HTMLElement; tile: HTMLElement; video: HTMLVideoElement } => !!r.tile && !!r.video);
  if (reels.length) startReelWalk(reels, { playingClass: 'is-playing', threshold: 0.6, startAt: 0, step: 1, holdMs: 3000 });
</script>
