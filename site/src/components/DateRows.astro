---
/** A plain list of sessions — date, time, what, how long, price, Book —
 *  for the host and activity pages. Server-rendered text, one row per
 *  date, no filters and no script: what a searcher and a crawler both want
 *  from "when does this run". The calendar keeps its richer cards. */
import type { Session } from '../data/sessions.ts';
import { formatDay, hostHref, pageCopy, workshopHref } from '../data/seo.ts';
import { berlinTodayMs } from '../data/sessions.ts';
import type { Lang } from '../lib/url.ts';

interface Props {
  sessions: Session[];
  lang: Lang;
  /** Name the host on each row — on an activity page, where rows come from
   *  several hosts. A host's own page leaves it off. */
  withHost?: boolean;
  /** Where a row's title leads: the class's own page — every date of it,
   *  in one place — or, on that page itself, straight to the booking. */
  linkTitlesTo?: 'workshop' | 'booking';
}
const { sessions, lang, withHost = false, linkTitlesTo = 'workshop' } = Astro.props;
const t = pageCopy[lang];

const showPrice = (price?: string) =>
  price && /^€\s*0([.,]0+)?$/.test(price.trim()) ? t.free : price;
/** What a row's Book (or, when full, waiting-list) button hands the booking
 *  form on the page (BookingDialog.astro) — the booking goes through us. */
const bookAttrs = (s: Session) => ({
  'data-book': s.soldOut ? 'notify' : s.request ? 'request' : 'book',
  'data-book-title': s.title,
  'data-book-host': s.host.name,
  'data-book-date': new Date(berlinTodayMs() + s.dayOffset * 86400000).toISOString().slice(0, 10),
  'data-book-time': s.time,
  'data-book-price': showPrice(s.price),
  'data-book-link': s.bookUrl,
});
---

<ul class="dates">
  {sessions.map((s) => (
    <li class="date-row" id={s.id}>
      <span class="date-when">
        <span class="date-day">{formatDay(s.dayOffset, lang)}</span>
        <span class="date-time">{s.time ?? t.timeTba}</span>
      </span>
      <span class="date-main">
        {linkTitlesTo === 'workshop' ? (
          <a class="date-title" href={workshopHref(lang, s.host, s.workshopKey)}>{s.title}</a>
        ) : (
          <a class="date-title" href={s.bookUrl} {...bookAttrs(s)}>{s.title}</a>
        )}
        <span class="date-meta">
          {withHost && <a class="date-host" href={hostHref(lang, s.host)}>{s.host.name}</a>}
          {withHost && ' · '}
          {s.duration ?? s.host.duration} · {s.district} · {s.languages ?? s.host.languages}
        </span>
      </span>
      <span class="date-side">
        {s.price && <span class="date-price">{showPrice(s.price)}</span>}
        {s.soldOut ? (
          <button type="button" class="date-full" {...bookAttrs(s)}>{s.waitingList ? t.waitingList : t.soldOut}</button>
        ) : s.request ? (
          <a class="date-book" href={s.bookUrl} {...bookAttrs(s)}>{t.requestBooking}</a>
        ) : (
          <a class="date-book" href={s.bookUrl} {...bookAttrs(s)}>{t.book}</a>
        )}
        {!s.soldOut && typeof s.spots === 'number' && (
          <span class="date-spots">{s.spots} {t.spots}</span>
        )}
      </span>
    </li>
  ))}
</ul>
