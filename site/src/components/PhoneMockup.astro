---
import ImageSlot from './ImageSlot.astro';
import { getPhoneCards, getPhoneFilters } from '../data/content.ts';
import type { Lang } from '../lib/url.ts';

/** The hero's device visual. The two props mirror the export's editable
 *  props (`heroLayout`, `frontScreen`); the defaults here are the export's
 *  defaults, so the rendered result matches the design as shipped. */
interface Props {
  lang: Lang;
  /** 'overlap' shows the second, dark phone behind and to the left. */
  layout?: 'overlap' | 'single';
  /** What the front phone shows: the workshop feed, or a single photo. */
  screen?: 'listing' | 'photo';
  backPhoto?: string;
  frontPhoto?: string;
}

const {
  lang,
  layout = 'overlap',
  screen = 'listing',
  backPhoto,
  frontPhoto,
} = Astro.props;

const phoneCards = getPhoneCards(lang);
const phoneFilters = getPhoneFilters(lang);
const searchPlaceholder = { en: 'What do you want to do?', de: 'Was möchtest du machen?' }[lang];
---

<div class="hero-visual">
  {layout !== 'single' && (
    <div class="phone-back">
      <div class="phone-back-notch"></div>
      <div class="phone-back-screen grayscale">
        <ImageSlot src={backPhoto} shape="rect" placeholder="Drop a workshop photo" alt="" />
      </div>
    </div>
  )}

  <div class="phone-front">
    <div class="phone-bar">
      <div class="phone-bar-notch"></div>
      <div class="phone-time">9:41</div>
    </div>

    {screen !== 'photo' ? (
      <div class="phone-screen">
        <div class="input phone-search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          {searchPlaceholder}
        </div>
        <div class="phone-tags">
          {phoneFilters.map((filter, i) => (
            <span class:list={['tag', i === 0 ? 'tag-accent' : 'tag-outline']}>{filter}</span>
          ))}
        </div>
        <div class="phone-cards">
          {phoneCards.map((card) => (
            <div>
              {/* Keeps the mockup's existing grayscale treatment — the medium
                  changes from still to clip, the look does not. */}
              <div class="phone-card-media grayscale">
                {card.video ? (
                  <video
                    class="phone-card-video"
                    src={card.video}
                    poster={card.poster}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                  ></video>
                ) : (
                  <ImageSlot src={card.photo} shape="rect" placeholder={card.title} alt="" />
                )}
              </div>
              <p class="phone-card-title">{card.title}</p>
              <p class="phone-card-meta">{card.meta}</p>
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div class="phone-photo grayscale">
        <ImageSlot src={frontPhoto} shape="rect" placeholder="Drop a workshop photo" alt="" />
      </div>
    )}
  </div>
</div>

<script>
  /* The mockup's thumbnails are clips, so the phone shows the app doing the
     thing the page is describing rather than a frozen screenshot.

     They start only when the phone scrolls into view and stop when it leaves:
     a mockup playing three videos off-screen costs the visitor bandwidth for
     something nobody is looking at. `muted` + `playsinline` are what let a
     clip autoplay at all — iOS blocks anything with sound, and without
     playsinline it takes over the screen. preload="none" means the poster is
     all that loads until then. */
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.phone-card-video'));
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (videos.length && !still) {
    const phone = document.querySelector('.phone-front');
    const observer = new IntersectionObserver(
      ([entry]) => {
        for (const video of videos) {
          if (entry.isIntersecting) video.play().catch(() => {});
          else video.pause();
        }
      },
      { threshold: 0.25 },
    );
    if (phone) observer.observe(phone);
  }
</script>
