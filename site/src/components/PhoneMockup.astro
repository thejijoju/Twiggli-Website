---
import ImageSlot from './ImageSlot.astro';
import { getPhoneCards, getPhoneFilters } from '../data/content.ts';
import { withBase, type Lang } from '../lib/url.ts';

/** The hero's device visual, rebuilt to match the app's real home screen:
 *  rounded dark bezels, the search pill with its filter controls, the day
 *  chips, a four-card feed whose thumbnails all play reels, and the bottom
 *  nav with the purple “+” button. The back phone plays one reel full-screen
 *  (the app's video feed) — only its left edge shows past the front phone. */
interface Props {
  lang: Lang;
  /** 'overlap' shows the second phone behind and to the left. */
  layout?: 'overlap' | 'single';
  /** What the front phone shows: the workshop feed, a reel filling the
   *  whole screen bar the bottom nav (the app's video feed), or a photo. */
  screen?: 'listing' | 'video' | 'photo';
  frontPhoto?: string;
  /** The full-screen reels: `backVideo` on the back phone, `frontVideo`
   *  when screen="video". Swap in real footage here. */
  backVideo?: string;
  backPoster?: string;
  frontVideo?: string;
  frontPoster?: string;
}

const {
  lang,
  layout = 'overlap',
  screen = 'listing',
  frontPhoto,
  backVideo = withBase('/video/reel-2.mp4'),
  backPoster = withBase('/video/reel-2-poster.jpg'),
  frontVideo = withBase('/video/reel-1.mp4'),
  frontPoster = withBase('/video/reel-1-poster.jpg'),
} = Astro.props;

const cards = getPhoneCards(lang);
const [feature, infoCard, mediaA, mediaB] = cards;
const phoneFilters = getPhoneFilters(lang);
const searchPlaceholder = { en: 'What do you want to do?', de: 'Was möchtest du machen?' }[lang];
---

<div class="hero-visual">
  {layout !== 'single' && (
    <div class="phone-back">
      <div class="phone-back-screen">
        <div class="phone-back-media">
          <video
            class="phone-card-video"
            src={backVideo}
            poster={backPoster}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
          ></video>
        </div>
        {/* Same nav as the front phone — it's the same app on both devices;
            only its left portion shows past the front phone. */}
        <div class="phone-nav" aria-hidden="true">
          <svg class="phone-nav-icon" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5" /><path d="M5.5 8.8V21h13V8.8" /><path d="M9.8 21v-6.5h4.4V21" /></svg>
          <svg class="phone-nav-icon" viewBox="0 0 24 24"><path d="M4 6h7M4 10h5" /><circle cx="14.5" cy="12.5" r="4.5" /><path d="m17.8 15.8 2.7 2.7" /></svg>
          <span class="phone-nav-plus">
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
          </span>
          <span class="phone-nav-chat">
            <svg class="phone-nav-icon" viewBox="0 0 24 24"><path d="M21 12.5a7.5 7.5 0 0 1-10.9 6.7L6 20.5l1.3-4.1A7.5 7.5 0 1 1 21 12.5Z" /><path d="M8.5 11h.01M12.5 11h.01M16.5 11h.01" /></svg>
            <span class="phone-nav-badge">3</span>
          </span>
          <svg class="phone-nav-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.6" /><path d="M5 20.2a7.2 7.2 0 0 1 14 0" /></svg>
        </div>
        <div class="phone-home-bar" aria-hidden="true"></div>
      </div>
    </div>
  )}

  <div class="phone-front">
    <div class="phone-notch" aria-hidden="true"></div>
    <div class:list={['phone-status', screen === 'video' && 'phone-status-overlay']} aria-hidden="true">
      <span class="phone-time">9:41</span>
      <span class="phone-status-icons">
        <svg viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="7" width="3" height="5" rx="0.8" /><rect x="5" y="4.5" width="3" height="7.5" rx="0.8" /><rect x="10" y="2" width="3" height="10" rx="0.8" /><rect x="15" y="0" width="3" height="12" rx="0.8" /></svg>
        <svg viewBox="0 0 16 12" fill="currentColor"><path d="M8 9.6a2 2 0 0 1 2 1.9L8 12l-2-.5a2 2 0 0 1 2-1.9Z" /><path d="M2.8 7.2a7.4 7.4 0 0 1 10.4 0l-1.5 1.5a5.3 5.3 0 0 0-7.4 0Z" /><path d="M.2 4.4a11.2 11.2 0 0 1 15.6 0l-1.5 1.5a9 9 0 0 0-12.6 0Z" /></svg>
        <svg viewBox="0 0 25 12"><rect x="0.5" y="0.5" width="21" height="11" rx="3" fill="none" stroke="currentColor" opacity="0.4" /><rect x="2" y="2" width="18" height="8" rx="1.8" fill="currentColor" /><path d="M23 4v4a2 2 0 0 0 0-4Z" fill="currentColor" opacity="0.4" /></svg>
      </span>
    </div>

    {screen === 'video' ? (
      /* The app's video feed: one reel fills the screen, edge to edge, with
         only the bottom nav (and the status bar overlaid) around it. */
      <div class="phone-screen-video">
        <video
          class="phone-card-video"
          src={frontVideo}
          poster={frontPoster}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        ></video>
      </div>
    ) : screen !== 'photo' ? (
      <div class="phone-screen">
        <div class="phone-search">
          <svg class="phone-search-glass" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          <span class="phone-search-hint">{searchPlaceholder}</span>
          <svg class="phone-search-aux" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
          <svg class="phone-search-aux" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </div>
        <div class="phone-tags">
          {phoneFilters.map((filter) => (
            <span class="phone-tag">{filter}</span>
          ))}
        </div>

        {/* The app's feed is a staggered two-column grid, so each column is
            its own stack: card 1 runs tall, card 2 square, and the two
            bottom media cards crop off behind the nav at different heights. */}
        <div class="phone-feed">
          <div class="phone-feed-col">
            <div class="phone-card">
              <div class="phone-card-media phone-card-media-tall">
                {feature.video ? (
                  <video
                    class="phone-card-video"
                    src={feature.video}
                    poster={feature.poster}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                  ></video>
                ) : (
                  <ImageSlot src={feature.photo} shape="rect" placeholder={feature.title} alt="" />
                )}
              </div>
              <div class="phone-card-info">
                <div class="phone-card-head">
                  <p class="phone-card-title">{feature.title}</p>
                  <svg class="phone-card-heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.3 4.9 13a4.7 4.7 0 0 1 0-6.6 4.5 4.5 0 0 1 6.5 0l.6.7.6-.7a4.5 4.5 0 0 1 6.5 0 4.7 4.7 0 0 1 0 6.6Z" /></svg>
                </div>
                <div class="phone-card-when"><span>{feature.date}</span><span>{feature.time}</span></div>
                <span class="phone-card-distance">{feature.distance}</span>
                <hr class="phone-card-rule" />
                <p class="phone-card-host">{feature.host}</p>
                <div class="phone-card-rating">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.6 2.9 5.9 6.5.9-4.7 4.6 1.1 6.4L12 17.4l-5.8 3 1.1-6.4-4.7-4.6 6.5-.9Z" /></svg>
                  <strong>{feature.rating}</strong>
                  <span>({feature.ratingCount})</span>
                </div>
              </div>
            </div>
            <div class="phone-card">
              <div class="phone-card-media">
                {mediaA.video ? (
                  <video
                    class="phone-card-video"
                    src={mediaA.video}
                    poster={mediaA.poster}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                  ></video>
                ) : (
                  <ImageSlot src={mediaA.photo} shape="rect" placeholder={mediaA.title} alt="" />
                )}
              </div>
            </div>
          </div>

          <div class="phone-feed-col">
            <div class="phone-card">
              <div class="phone-card-media">
                {infoCard.video ? (
                  <video
                    class="phone-card-video"
                    src={infoCard.video}
                    poster={infoCard.poster}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                  ></video>
                ) : (
                  <ImageSlot src={infoCard.photo} shape="rect" placeholder={infoCard.title} alt="" />
                )}
              </div>
              <div class="phone-card-info">
                <div class="phone-card-head">
                  <p class="phone-card-title">{infoCard.title}</p>
                  <svg class="phone-card-heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.3 4.9 13a4.7 4.7 0 0 1 0-6.6 4.5 4.5 0 0 1 6.5 0l.6.7.6-.7a4.5 4.5 0 0 1 6.5 0 4.7 4.7 0 0 1 0 6.6Z" /></svg>
                </div>
                <div class="phone-card-when"><span>{infoCard.date}</span><span>{infoCard.time}</span></div>
                <span class="phone-card-distance">{infoCard.distance}</span>
                <hr class="phone-card-rule" />
                <p class="phone-card-host">{infoCard.host}</p>
                <div class="phone-card-rating">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.6 2.9 5.9 6.5.9-4.7 4.6 1.1 6.4L12 17.4l-5.8 3 1.1-6.4-4.7-4.6 6.5-.9Z" /></svg>
                  <strong>{infoCard.rating}</strong>
                  <span>({infoCard.ratingCount})</span>
                </div>
              </div>
            </div>
            <div class="phone-card">
              <div class="phone-card-media">
                {mediaB.video ? (
                  <video
                    class="phone-card-video"
                    src={mediaB.video}
                    poster={mediaB.poster}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                  ></video>
                ) : (
                  <ImageSlot src={mediaB.photo} shape="rect" placeholder={mediaB.title} alt="" />
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="phone-photo grayscale">
        <ImageSlot src={frontPhoto} shape="rect" placeholder="Drop a workshop photo" alt="" />
      </div>
    )}

    <div class="phone-nav" aria-hidden="true">
      <svg class="phone-nav-icon" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5" /><path d="M5.5 8.8V21h13V8.8" /><path d="M9.8 21v-6.5h4.4V21" /></svg>
      <svg class="phone-nav-icon" viewBox="0 0 24 24"><path d="M4 6h7M4 10h5" /><circle cx="14.5" cy="12.5" r="4.5" /><path d="m17.8 15.8 2.7 2.7" /></svg>
      <span class="phone-nav-plus">
        <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
      </span>
      <span class="phone-nav-chat">
        <svg class="phone-nav-icon" viewBox="0 0 24 24"><path d="M21 12.5a7.5 7.5 0 0 1-10.9 6.7L6 20.5l1.3-4.1A7.5 7.5 0 1 1 21 12.5Z" /><path d="M8.5 11h.01M12.5 11h.01M16.5 11h.01" /></svg>
        <span class="phone-nav-badge">3</span>
      </span>
      <svg class="phone-nav-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.6" /><path d="M5 20.2a7.2 7.2 0 0 1 14 0" /></svg>
    </div>
    <div class="phone-home-bar" aria-hidden="true"></div>
  </div>
</div>

<script>
  /* The mockup's thumbnails are clips, so the phone shows the app doing the
     thing the page is describing rather than a frozen screenshot.

     They start only when the phone scrolls into view and stop when it leaves:
     a mockup playing three videos off-screen costs the visitor bandwidth for
     something nobody is looking at. `muted` + `playsinline` are what let a
     clip autoplay at all — iOS blocks anything with sound, and without
     playsinline it takes over the screen. preload="none" means the poster is
     all that loads until then. */
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.phone-card-video'));
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phone = document.querySelector('.hero-visual');
  const playAll = () => { for (const v of videos) v.play().catch(() => {}); };

  if (videos.length && phone) {
    if (!still) {
      // Observe the whole visual, not just the front phone — the back
      // phone's full-screen reel needs to start and stop with the rest.
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) playAll();
          else for (const v of videos) v.pause();
        },
        { threshold: 0.25 },
      );
      observer.observe(phone);
    }

    // Autoplay is refused outright by reduced motion, and quietly by a
    // phone in low-power mode or a browser with data saver on — and a
    // mockup of a video app frozen on its posters is the one thing this
    // block must not be. Pointing at it or touching it starts it, whatever
    // the browser decided.
    phone.addEventListener('pointerenter', playAll);
    phone.addEventListener('touchstart', playAll, { passive: true });
  }
</script>
