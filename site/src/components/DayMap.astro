---
/**
 * The calendar's map pane (SideMap.astro), run by lib/daymap.ts from
 * DayPicker's script. Markers sit on each neighbourhood's centre, never on
 * a venue: the map says which Kiez, and the address comes with the booking.
 */
import SideMap from './SideMap.astro';
import { places } from '../data/places.ts';
import { mapCopy } from '../data/mapCopy.ts';
import type { Lang } from '../lib/url.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = mapCopy[lang];
---

<SideMap
  lang={lang}
  data-places={JSON.stringify(places)}
  data-show-one={c.showOne}
  data-show-many={c.showMany}
  data-from={c.from}
>
  {/* Online sessions have no place, so they get a chip of their own. */}
  <button type="button" class="daymap-online" data-map-online hidden>
    {c.online} <strong></strong>
  </button>
  {/* On a phone, the way back to the list once a Kiez is picked. */}
  <button type="button" class="btn btn-primary daymap-show" data-map-show hidden></button>
</SideMap>
