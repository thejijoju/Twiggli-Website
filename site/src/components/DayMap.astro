---
/**
 * The calendar's map: Berlin's districts drawn flat, with a bubble on each
 * neighbourhood that has something on the chosen day, sized and numbered by
 * how many. Picking one filters the day to it, through the same district
 * pills the filter bar has (DayPicker's script drives all of this). Beside
 * the map, the same neighbourhoods as a ranked list, which is also how the
 * map is used without a pointer.
 *
 * It places neighbourhoods, never venues: an address on a map is a studio
 * found without us. Drawn here rather than embedded from a map service, so
 * nothing is fetched from a third party and no consent is needed for it.
 */
import { districts as shapes, mapSize, places } from '../data/berlinMap.ts';
import type { Lang } from '../lib/url.ts';

interface Props {
  lang: Lang;
  /** Every neighbourhood the calendar names, in the filter bar's order. */
  districts: string[];
  /** The filter bar's word for "all". */
  all: string;
}
const { lang, districts, all } = Astro.props;

const mapCopy: Record<Lang, { map: string; title: string; hint: string; none: string }> = {
  en: { map: 'Map', title: 'Workshops by neighbourhood', hint: 'Pick a neighbourhood to see only what’s on there.', none: 'Nothing on this day with these filters.' },
  de: { map: 'Karte', title: 'Workshops nach Kiez', hint: 'Wähl einen Kiez, um nur zu sehen, was dort los ist.', none: 'An diesem Tag ist mit diesen Filtern nichts los.' },
  fr: { map: 'Carte', title: 'Ateliers par quartier', hint: 'Choisissez un quartier pour ne voir que ce qui s’y passe.', none: 'Rien ce jour-là avec ces filtres.' },
  es: { map: 'Mapa', title: 'Talleres por barrio', hint: 'Elige un barrio para ver solo lo que hay allí.', none: 'No hay nada ese día con estos filtros.' },
  it: { map: 'Mappa', title: 'Workshop per quartiere', hint: 'Scegli un quartiere per vedere solo cosa c’è lì.', none: 'Niente quel giorno con questi filtri.' },
  nl: { map: 'Kaart', title: 'Workshops per wijk', hint: 'Kies een wijk om alleen te zien wat daar te doen is.', none: 'Niets op deze dag met deze filters.' },
  pl: { map: 'Mapa', title: 'Warsztaty według dzielnic', hint: 'Wybierz dzielnicę, aby zobaczyć tylko to, co się tam dzieje.', none: 'Tego dnia nic z tymi filtrami.' },
  tr: { map: 'Harita', title: 'Semtlere göre atölyeler', hint: 'Yalnızca orada olanları görmek için bir semt seç.', none: 'Bu filtrelerle o gün bir şey yok.' },
};
const c = mapCopy[lang];

/* Which side of its bubble a name goes on. The middle of the city is
   crowded, so the neighbours there face away from each other. */
const side: Record<string, 'left' | 'right' | 'top' | 'bottom'> = {
  Wedding: 'left', Moabit: 'left', Charlottenburg: 'left', Friedenau: 'left', Spandau: 'top',
  Friedrichshain: 'top', Mitte: 'left', Gesundbrunnen: 'top', 'Berliner Wald': 'bottom',
  Potsdam: 'bottom', Zehlendorf: 'bottom', Schöneberg: 'left', Kreuzberg: 'bottom',
};
const pinned = districts.filter((d) => places[d]);
---

<section class="daymap" data-daymap aria-label={c.title}>
  <div class="daymap-canvas">
    <svg viewBox={`0 0 ${mapSize.width} ${mapSize.height}`} role="img" aria-label={c.title} data-daymap-svg>
      <g class="daymap-land" aria-hidden="true">
        {shapes.map((s) => <path d={s.d} />)}
      </g>
      <g class="daymap-pins">
        {pinned.map((name) => (
          <g
            class="daymap-pin is-empty"
            data-place={name}
            data-side={side[name] ?? 'right'}
            transform={`translate(${places[name][0]} ${places[name][1]})`}
            aria-hidden="true"
          >
            <circle r="4" />
            <text class="daymap-n" dy="0.36em"></text>
            <text class="daymap-label">{name}</text>
          </g>
        ))}
      </g>
    </svg>
  </div>
  <div class="daymap-side">
    <h2 class="daymap-title">{c.title}</h2>
    <p class="daymap-hint">{c.hint}</p>
    <ul class="daymap-list">
      <li><button type="button" class="daymap-item is-active" data-place="all">{all}<span class="daymap-count"></span></button></li>
      {districts.map((name) => (
        <li data-item={name}>
          <button type="button" class="daymap-item" data-place={name}>{name}<span class="daymap-count"></span></button>
        </li>
      ))}
    </ul>
    <p class="daymap-none" hidden>{c.none}</p>
  </div>
</section>
