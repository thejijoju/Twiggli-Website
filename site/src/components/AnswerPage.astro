---
/** A page that answers one question people ask assistants word for word
 *  ("What can I do in Berlin today?") — the answer in the first lines,
 *  built from the real dates, then the dates, then a short FAQ marked up
 *  as FAQPage. See data/answers.ts. */
import Base from '../layouts/Base.astro';
import DayList from './DayList.astro';
import {
  ANSWERS, ANSWER_LANGS, answerCopy, answerHref, answerSessions, answerShort, tomorrowEvening, type AnswerKind,
} from '../data/answers.ts';
import { absolute, byDay, hubHref, pageCopy } from '../data/seo.ts';
import { href, type Lang } from '../lib/url.ts';

interface Props {
  lang: Lang;
  kind: AnswerKind;
}
const { lang, kind } = Astro.props;
const t = pageCopy[lang];
const sessions = answerSessions(kind, lang);
const copy = answerCopy(kind, lang, sessions);
// Nothing left tonight: tomorrow evening instead, under its own heading.
const fallback = kind === 'tonight' && !sessions.length ? tomorrowEvening(lang) : [];
const days = byDay(sessions).slice(0, 14);
const shown = days.flatMap((d) => d[1]);
const pageUrl = absolute(answerHref(lang, kind));
const de = lang === 'de';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: copy.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.crumbsRoot, item: absolute(hubHref(lang)) },
        { '@type': 'ListItem', position: 2, name: copy.short, item: pageUrl },
      ],
    },
  ],
};
---

<Base title={copy.title} description={copy.description} lang={lang} translations={ANSWER_LANGS}>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={hubHref(lang)}>{t.crumbsRoot}</a>
      <span aria-hidden="true">›</span>
      <span>{copy.short}</span>
    </nav>

    <section class="page-head">
      <span class="kicker kicker-tight">Berlin · {copy.short}</span>
      <h1 class="page-title">{copy.h1}</h1>
      <p class="page-lede">{copy.answer}</p>
    </section>

    <hr class="rule" />

    <section class="section" id="dates">
      {shown.length ? (
        <DayList sessions={shown} lang={lang} />
      ) : fallback.length ? (
        <>
          <h2 class="section-title">{de ? 'Morgen Abend' : 'Tomorrow evening'}</h2>
          <DayList sessions={fallback} lang={lang} />
        </>
      ) : (
        <p class="section-lede">{copy.empty}</p>
      )}
      <p class="section-more"><a href={href(lang, '/happening-today/')}>{t.calendar} →</a></p>
    </section>

    <hr class="rule" />

    <section class="section">
      <h2 class="section-title">{de ? 'Häufige Fragen' : 'Questions people ask'}</h2>
      <div class="answer-faq">
        {copy.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <hr class="rule" />

    <section class="section">
      <h2 class="section-title">{de ? 'Mehr Ideen' : 'More ideas'}</h2>
      <ul class="activity-links">
        {ANSWERS.filter((k) => k !== kind).map((k) => (
          <li><a href={answerHref(lang, k)}>{answerShort(k, lang)}</a></li>
        ))}
        <li><a href={href(lang, '/corporatebookings/')}>{de ? 'Für Teams & Firmen' : 'For teams & companies'}</a></li>
      </ul>
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</Base>

<style>
  .answer-faq { display: grid; gap: 10px; max-width: 820px; }
  .answer-faq details { border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent); border-radius: 14px; padding: 14px 18px; }
  .answer-faq summary { cursor: pointer; font-weight: 700; }
  .answer-faq p { margin: 10px 0 0; color: var(--color-text-muted); }
</style>
