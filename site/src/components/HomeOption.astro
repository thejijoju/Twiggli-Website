            <a class="ho-btn ho-btn-light" href={teamsHref} data-book="group" data-book-title={bookingCopy[lang].anyHost}>{split.teams.cta}</a>
          </div>
          <div class="ho-b-box is-host">
            <b>Für Maker*innen</b>
            <p>{split.makers.title} {split.makers.hand}</p>
            <a class="ho-btn ho-btn-ink" href={hostCta}>{split.makers.cta}</a>
          </div>
          <div class="ho-b-box is-cats">
            <b>Nach Handwerk</b>
