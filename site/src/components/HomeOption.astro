        <article class="is-flip">
          <img src={host('petitejungle-1')} alt="" loading="lazy" decoding="async" />
          <div><span class="ho-kicker">Fürs Team</span><h2 class="hd-h2">{split.teams.title} <em>{split.teams.hand}</em></h2><p>{split.teams.copy}</p><a class="ho-btn ho-btn-ink" href={teamsHref} data-book="group" data-book-title={bookingCopy[lang].anyHost}>{split.teams.cta}</a></div>
        </article>
        <article>
          <img src={host('craftkai-7')} alt="" loading="lazy" decoding="async" />
          <div><span class="ho-kicker">Für Maker*innen</span><h2 class="hd-h2">{split.makers.title} <em>{split.makers.hand}</em></h2><p>{split.makers.copy}</p><a class="ho-btn ho-btn-ink" href={hostCta}>{split.makers.cta}</a></div>
        </article>
      </section>
      {evelyn && evelynWords && (
        <section class="container ho-section">
          <blockquote class="ho-e-quote">
            <p>„{evelynWords.paras[1]}“</p>
            <footer><img src={makerPic(evelyn)} alt="" loading="lazy" /><span><b>{evelyn.firstName ?? evelyn.name}</b>, {evelyn.studio}</span> <a href={hostHref(lang, evelyn)}>Zu ihren Workshops →</a></footer>
          </blockquote>
        </section>
      )}
      <section class="container ho-section ho-e-cats">
        <h2 class="hd-h2">{d.catsTitle} <em>{d.catsHand}</em></h2>
        <ul>{ACTIVITY_ORDER.map((a) => <li><a href={activityHref(lang, a)}>{activityCopy[lang][a].short} <small>{counts.get(a) ?? 0}</small></a></li>)}</ul>
        <a class="hd-more" href={hubHref(lang)}>{t.activitiesAll} →</a>
      </section>
    </>
  )}

  <div class="container hd-tail">
    <Newsletter lang={lang} />
  </div>
  <SiteSchema lang={lang} />
</Base>
