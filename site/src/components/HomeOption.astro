              ))}
            </div>
          </div>
        </div>
      </section>
      <section class="container ho-section">
        <div class="hd-row-head">
          <h2 class="hd-h2">{d.weekTitle} <em>{d.weekHand}</em></h2>
          <a class="hd-more" href={calendarHref}>{ui(lang).teaser.cta} →</a>
        </div>
        <ol class="ho-e-list">
          {week.slice(0, 6).map((s, i) => (
            <li><a href={workshopHref(lang, s.host, s.workshopKey)}>
              <span class="ho-e-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="ho-e-text"><span class="ho-when">{formatWhen(s, lang)}</span><span class="ho-e-title">{s.title}</span><span class="ho-meta">{s.host.firstName ?? s.host.name} · {s.district}{s.price && <> · {s.price}</>}</span></span>
              <span class="ho-e-thumb" style={lqipStyle(s.host.poster)}>{cardImage(s) && <img src={cardImage(s)} alt="" loading="lazy" decoding="async" />}</span>
            </a></li>
          ))}
        </ol>
      </section>
      <section class="container ho-e-stripes">
        <article>
          <img src={host('anna-malerlebnisse-3')} alt="" loading="lazy" decoding="async" />
          <div><span class="ho-kicker">Für dich</span><h2 class="hd-h2">{find.soloTitle}</h2><p>{find.soloCopy}</p><a class="ho-btn ho-btn-purple" href={calendarHref}>{find.soloCta}</a></div>
