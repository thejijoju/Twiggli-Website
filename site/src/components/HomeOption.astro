/** Five more directions for the home page, for Jirel to compare
 *  (src/pages/de/preview/home-a…e.astro: German only, noindex, out of the
 *  sitemap). The live home page is HomePage.astro; these reuse its data
 *  (homeData.ts), its search pill (HomeSearch.astro) and its stylesheet,
 *  and add their own sections on top (home-options.css).
 *
 *    a  PayPal soft       calm, lots of air, pastel cards, photo collage,
 *                         a row of plain facts
 *    b  Luma events       a short hero, a sticky filter bar and the week as
 *                         a dated event list
 *    c  Etsy marketplace  categories first, a grid of this week, one maker
 *                         in her own words, a warm "give time" section
 *    d  Linktree soft     one column of big pastel blocks and pill buttons
 *    e  Magazine          editorial type, one big photo with a polaroid
 *                         stack, a numbered list, alternating stripes
 *
 *  Copy is German only and lives here while these are drafts. Every date,
 *  photo, name and link is real; nothing is promised that the site does
 *  not do (no vouchers, no reviews). */
import Base from '../layouts/Base.astro';
import Newsletter from './Newsletter.astro';
import HostMonogram from './HostMonogram.astro';
import HomeSearch from './HomeSearch.astro';
import SiteSchema from './SiteSchema.astro';
import { filterCopy } from '../data/content.ts';
import { ACTIVITY_ORDER, activityCopy, activityHref, formatDay, formatWhen, hostHref, hubHref, occasionHref, workshopHref } from '../data/seo.ts';
import { ui } from '../data/i18n.ts';
import { homeDiscoverCopy } from '../data/homeDiscover.ts';
import { homeFindCopy } from '../data/homeFind.ts';
import { homeSplits } from '../data/homeSplits.ts';
import { bookingCopy } from '../data/bookingCopy.ts';
import { hostAbout } from '../data/hostAbout.ts';
import { activityThumb as thumb, cardImage, getHomeData, mailPic as mail, makerPic } from '../data/homeData.ts';
import { getSiteData } from '../data/site.ts';
import { href, withBase, type Lang } from '../lib/url.ts';
import { lqipStyle } from '../lib/lqip.ts';
import type { Session } from '../data/sessions.ts';
import '../styles/home-discover.css';
import '../styles/home-options.css';

interface Props { variant: 'a' | 'b' | 'c' | 'd' | 'e' }
const { variant: v } = Astro.props;
const lang: Lang = 'de';
const t = ui(lang).home;
const d = homeDiscoverCopy[lang];
const find = homeFindCopy[lang];
const split = homeSplits[lang];
const f = filterCopy[lang];
const { brand } = getSiteData(lang);
const { hosts, all, rows, calendarHref, chips, counts, activityFace, makers, listed, whereOptions, dayOf } = getHomeData(lang);
const week = rows[0]?.list ?? [];
const teamsHref = href(lang, '/corporatebookings/');
const hostCta = href(lang, '/host/');
const names = { a: 'PayPal soft', b: 'Luma events', c: 'Etsy marketplace', d: 'Linktree soft', e: 'Magazin' };
const host = (p: string) => withBase(`/img/hosts/${p}.jpg`);

/* The week as days, for the event list (b): up to four dates a day, one
   per host, on the first five days that have any. */
const days: [number, Session[]][] = [];
for (let off = 0; off <= 6 && days.length < 5; off++) {
  const seen = new Set<string>();
  const list = all.filter((s) => s.dayOffset === off && !seen.has(s.host.slug) && seen.add(s.host.slug)).slice(0, 4);
  if (list.length) days.push([off, list]);
}
const dayWord = (off: number) => (off <= 1 ? formatDay(off, lang) : dayOf(off).toLocaleDateString('de-DE', { weekday: 'long', timeZone: 'UTC' }));
const dayDate = (off: number) => dayOf(off).toLocaleDateString('de-DE', { day: 'numeric', month: 'short', timeZone: 'UTC' });

/* A maker in her own words (c, e): the only host who has sent us some. */
const evelyn = hosts.find((h) => h.slug === 'evelyn');
const evelynWords = hostAbout.evelyn?.[lang];
const evelynDates = all.filter((s) => s.host.slug === 'evelyn').slice(0, 3);

/* The calendar week, for the magazine's masthead. */
const isoWeek = (() => {
  const date = dayOf(0);
  const day = (date.getUTCDay() + 6) % 7;
  date.setUTCDate(date.getUTCDate() - day + 3);
  const first = new Date(Date.UTC(date.getUTCFullYear(), 0, 4));
  return 1 + Math.round(((date.getTime() - first.getTime()) / 86400000 - 3 + ((first.getUTCDay() + 6) % 7)) / 7);
})();

---

<Base title={`Entwurf ${v.toUpperCase()} · ${names[v]} | Twiggli`} description={t.description} lang={lang} pageClass={`page-home hd ho ho-${v}`} noindex translations={['de']}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,800;1,9..144,500&family=Caveat:wght@600;700&display=swap" />
  </Fragment>

  {/* ═══════════════ A · PayPal soft ═══════════════ */}
  {v === 'a' && (
    <>
      <section class="ho-a-hero">
        <div class="container ho-a-hero-grid">
          <div class="ho-a-hero-text">
            <span class="hd-eyebrow">{d.eyebrow}</span>
            <h1 class="hd-h1">{d.h1a} <span class="hd-hand">{d.h1b}</span></h1>
            <p class="hd-lede">{d.lede}</p>
            <div class="ho-actions">
              <a class="ho-btn ho-btn-purple" href={calendarHref}>Workshops entdecken</a>
              <a class="ho-btn ho-btn-soft" href={teamsHref}>Für Teams</a>
            </div>
          </div>
          <div class="ho-a-collage" aria-hidden="true">
            <span class="ho-a-blob"></span>
            <img class="is-1" src={host('anna-malerlebnisse-3')} alt="" />
            <img class="is-2" src={host('petitejungle-4')} alt="" />
            <img class="is-3" src={host('landsinn-3')} alt="" />
            <span class="ho-a-note">heute Abend frei?</span>
          </div>
        </div>
      </section>
      <div class="container">
        <div class="ho-a-searchcard"><HomeSearch lang={lang} /></div>
        <ul class="ho-a-trust">
          <li><b>{listed}</b><span>Maker*innen in Berlin</span></li>
          <li><b>{whereOptions.length}</b><span>Bezirke mit Terminen</span></li>
          <li><b>{all.filter((s) => s.dayOffset <= 6).length}</b><span>Termine in den nächsten 7 Tagen</span></li>
          <li><b>1</b><span>Rechnung für euer Team</span></li>
        </ul>
      </div>
      <section class="container ho-section">
        <div class="hd-row-head">
          <h2 class="hd-h2">{d.weekTitle} <em>{d.weekHand}</em></h2>
          <a class="hd-more" href={calendarHref}>{ui(lang).teaser.cta} →</a>
        </div>
        <ul class="ho-a-cards">
          {week.slice(0, 4).map((s, i) => (
            <li class={`tone-${i % 4}`}>
              <a href={workshopHref(lang, s.host, s.workshopKey)}>
                <span class="ho-a-media" style={lqipStyle(s.host.poster)}>{cardImage(s) ? <img src={cardImage(s)} alt="" decoding="async" /> : <HostMonogram name={s.host.name} />}</span>
                <span class="ho-when">{formatWhen(s, lang)}</span>
                <span class="ho-title">{s.title}</span>
                <span class="ho-meta">{s.host.firstName ?? s.host.name} · {s.district}{s.price && <> · <b>{s.price}</b></>}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
      <section class="container ho-section ho-a-three">
        <a href={calendarHref} class="tone-0"><span class="ho-a-icon">🙋</span><b>Für dich</b><span>{find.soloTitle}. Kleine Gruppen, alle fangen bei null an.</span><i>Termine ansehen →</i></a>
        <a href={teamsHref} class="tone-1" data-book="group" data-book-title={bookingCopy[lang].anyHost}><span class="ho-a-icon">🙌</span><b>Fürs Team</b><span>{split.teams.ticks.join(' · ')}.</span><i>{split.teams.cta} →</i></a>
        <a href={hostCta} class="tone-2"><span class="ho-a-icon">✋</span><b>Für Maker*innen</b><span>{split.makers.ticks[0]}. {split.makers.hand}</span><i>{split.makers.cta} →</i></a>
      </section>
    </>
  )}

  {/* ═══════════════ B · Luma events ═══════════════ */}
  {v === 'b' && (
    <>
