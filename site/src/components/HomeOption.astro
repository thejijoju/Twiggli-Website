        </div>
        <ul class="hd-track">
          {week.map((s) => (
            <li>
              <a class="hd-card" href={workshopHref(lang, s.host, s.workshopKey)}>
                <span class="hd-card-media" style={lqipStyle(s.host.poster)}>{cardImage(s) && <img src={cardImage(s)} alt="" decoding="async" />}</span>
                <span class="hd-card-body">
