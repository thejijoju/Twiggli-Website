---
import { filterCopy } from '../data/content.ts';
import { directoryCopy, seasonOccasion, type OccasionKey, type Season } from '../data/occasions.ts';
import { DEFAULT_LANG, type Lang } from '../lib/url.ts';

/**
 * The head of the group-bookings directory, laid out like a marketplace
 * collection page: one wide search bar, the season's headline under it, the
 * occasions a group books us for as tags, then the four filters as pills
 * that each open their own small menu.
 *
 * Everything is one form. The search narrows by text as you type, an
 * occasion tag by the hosts who suit it, and the pills by activity, group
 * size, length and price — ANDed together, and all of it is plain inputs, so
 * the keyboard, labels and the reset work without scripting them.
 *
 * Filters replaced an A–Z index of host names: a team lead knows the group
 * they have and the afternoon they can spare, not that the person they want
 * is called Maximiliana.
 */
interface Props {
  lang?: Lang;
  season: Season;
  /** The general enquiry, for a group that has not picked a host yet. */
  cta: string;
  ctaHref: string;
}
const { lang = DEFAULT_LANG, season, cta, ctaHref } = Astro.props;
const t = filterCopy[lang];
const d = directoryCopy[lang];
const head = d.seasons[season];

// The season's own occasion leads the row.
const first = seasonOccasion[season];
const occasionIds = (['teamevent', 'christmas', 'hen', 'birthday', 'outing'] as OccasionKey[])
  .sort((a, b) => (a === first ? -1 : b === first ? 1 : 0));

const groupIds = ['small', 'medium', 'large'] as const;
const durationIds = ['short', 'medium', 'long'] as const;
const activityIds = ['ceramics', 'art', 'craft', 'food', 'photography', 'wellbeing', 'music'] as const;
const priceIds = ['budget', 'mid', 'high', 'premium'] as const;

const pills = [
  { name: 'activity', label: t.activityLabel, options: activityIds.map((id) => ({ id, label: t.activities[id] })) },
  { name: 'group', label: t.groupLabel, options: groupIds.map((id) => ({ id, label: t.groups[id] })) },
  { name: 'hours', label: t.durationLabel, options: durationIds.map((id) => ({ id, label: t.durations[id] })) },
  { name: 'price', label: t.priceLabel, options: priceIds.map((id) => ({ id, label: t.prices[id] })) },
];
---

<form class="dir-filters" id="host-filters" role="search">
  <div class="dir-search">
    <input
      type="search"
      name="q"
      placeholder={d.placeholder}
      aria-label={d.placeholder}
      autocomplete="off"
      enterkeyhint="search"
    />
    <button type="submit" class="dir-search-btn" aria-label={d.search}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
    </button>
  </div>

  <header class="dir-head">
    <h1 class="dir-title">{head.title}</h1>
    <p class="dir-sub">{head.sub}</p>
  </header>

  {/* Tags rather than a menu: there are five, and they are the words a team
      lead arrives with. Radios, so picking one drops the last; picking the
      chosen one again lets it go (see the script). */}
  <div class="dir-tags" role="radiogroup" aria-label={d.occasionsLabel}>
    {occasionIds.map((id) => (
      <label class="dir-tag">
        <input type="radio" name="occasion" value={id} />
        <span>{d.occasions[id]}</span>
      </label>
    ))}
  </div>

  <div class="dir-bar">
    {pills.map((pill) => (
      <details class="dir-pill" data-pill={pill.name}>
        <summary>
          <span class="dir-pill-label" data-base={pill.label}>{pill.label}</span>
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
        </summary>
        <div class="dir-pop">
          <label class="chip">
            <input type="radio" name={pill.name} value="" checked />
            <span>{t.all}</span>
          </label>
          {pill.options.map((opt) => (
            <label class="chip">
              <input type="radio" name={pill.name} value={opt.id} />
              <span>{opt.label}</span>
            </label>
          ))}
        </div>
      </details>
    ))}
    <button type="reset" class="dir-clear" hidden>{t.clear}</button>
    <p class="dir-count" role="status" aria-live="polite" data-one={t.count(1)} data-many={t.count(0)}></p>
    <a class="dir-cta" href={ctaHref}>{cta}</a>
  </div>
</form>

<p class="filter-empty" hidden>{t.empty}</p>

<script>
  /* Bucket edges live here, next to the code that compares them, rather than
     in the labels — "Up to 10" is prose and may be reworded, [0, 10] is the
     rule. A host matches a bucket when their range OVERLAPS it: someone who
     takes 6–100 people can host a group of 8. */
  const GROUPS: Record<string, [number, number]> = { small: [0, 10], medium: [10, 30], large: [30, Infinity] };
  const HOURS: Record<string, [number, number]> = { short: [0, 2], medium: [2, 4], long: [4, Infinity] };
  /* Euros a seat. A host with no price cannot be placed in a band, so picking
     one hides them; they come back under "All". */
  const PRICES: Record<string, [number, number]> = { budget: [0, 50], mid: [50, 100], high: [100, 200], premium: [200, Infinity] };

  const form = document.querySelector<HTMLFormElement>('#host-filters');
  const empty = document.querySelector<HTMLElement>('.filter-empty');
  const count = document.querySelector<HTMLElement>('.dir-count');
  const clear = document.querySelector<HTMLButtonElement>('.dir-clear');
  const pills = Array.from(document.querySelectorAll<HTMLDetailsElement>('.dir-pill'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.maker'));

  /* Lower case and without accents, so "kochen" finds "Kochkurs" and
     "celia" finds "Cèlia". */
  const fold = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  if (form && cards.length) {
    const overlaps = (a: [number, number], b: [number, number]) => a[0] <= b[1] && a[1] >= b[0];
    const num = (el: HTMLElement, key: string) => Number(el.dataset[key]);
    const haystacks = new Map(cards.map((c) => [c, fold(c.dataset.search ?? '')]));

    const apply = () => {
      const data = new FormData(form);
      const words = fold(String(data.get('q') ?? '')).split(/\s+/).filter(Boolean);
      const occasion = String(data.get('occasion') ?? '');
      const activity = String(data.get('activity') ?? '');
      const group = String(data.get('group') ?? '');
      const hours = String(data.get('hours') ?? '');
      const price = String(data.get('price') ?? '');

      let shown = 0;
      for (const card of cards) {
        const text = haystacks.get(card) ?? '';
        const ok =
          words.every((w) => text.includes(w)) &&
          (!occasion || (card.dataset.occasions ?? '').split(' ').includes(occasion)) &&
          (!activity || card.dataset.activity === activity) &&
          (!group || overlaps([num(card, 'groupMin'), num(card, 'groupMax')], GROUPS[group])) &&
          (!hours || overlaps([num(card, 'hoursMin'), num(card, 'hoursMax')], HOURS[hours])) &&
          (!price ||
            (card.dataset.priceMin !== undefined &&
              overlaps([num(card, 'priceMin'), num(card, 'priceMax')], PRICES[price])));
        card.hidden = !ok;
        if (ok) shown++;
      }

      if (empty) empty.hidden = shown > 0;
      if (count) {
        count.textContent = shown === 1
          ? (count.dataset.one ?? '')
          : (count.dataset.many ?? '').replace('0', String(shown));
      }
      // Each pill says what it is set to, the way a shop's "Price ▾" turns
      // into "€50–100 ▾" once chosen.
      for (const pill of pills) {
        const label = pill.querySelector<HTMLElement>('.dir-pill-label');
        const on = pill.querySelector<HTMLInputElement>('input:checked');
        const set = !!on?.value;
        pill.classList.toggle('is-on', set);
        if (label) label.textContent = set ? (on?.nextElementSibling?.textContent ?? '') : (label.dataset.base ?? '');
      }
      const any = words.length || occasion || activity || group || hours || price;
      if (clear) clear.hidden = !any;
      /* Hiding cards reflows the grid, so tiles change rows; the reels pick
         their players by row, and this tells them to look again. */
      document.dispatchEvent(new CustomEvent('twiggli:filtered'));
    };

    form.addEventListener('change', (event) => {
      // A choice in a pill's menu closes that menu.
      (event.target as HTMLElement).closest('details')?.removeAttribute('open');
      apply();
    });
    form.addEventListener('input', apply);
    // Enter in the search field searches in place rather than reloading.
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      apply();
      document.querySelector('.maker-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    /* 'reset' fires before the inputs revert, so read them on the next tick. */
    form.addEventListener('reset', () => setTimeout(apply, 0));

    // A radio cannot be unticked by clicking it, but a tag should let go
    // when its own chip is clicked again.
    // The pointer lands on the label, not the hidden input, so that is where
    // the earlier state is read.
    for (const label of form.querySelectorAll<HTMLLabelElement>('.dir-tag')) {
      const input = label.querySelector<HTMLInputElement>('input');
      if (!input) continue;
      let was = false;
      label.addEventListener('pointerdown', () => { was = input.checked; });
      label.addEventListener('click', (event) => {
        if (!was) return;
        was = false;
        event.preventDefault();
        input.checked = false;
        apply();
      });
    }

    // One menu at a time, and a click elsewhere or Escape closes it.
    for (const pill of pills) {
      pill.addEventListener('toggle', () => {
        if (pill.open) for (const other of pills) if (other !== pill) other.open = false;
      });
    }
    document.addEventListener('click', (event) => {
      for (const pill of pills) if (pill.open && !pill.contains(event.target as Node)) pill.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key !== 'Escape') return;
      const open = pills.find((p) => p.open);
      if (!open) return;
      open.open = false;
      open.querySelector<HTMLElement>('summary')?.focus();
    });

    apply();
  }
</script>
