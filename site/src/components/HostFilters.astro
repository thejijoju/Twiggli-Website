---
import { filterCopy } from '../data/content.ts';
import { DEFAULT_LANG, type Lang } from '../lib/url.ts';

/**
 * Filters for the maker directory: activity, group size, session length,
 * price.
 *
 * These replace an A–Z index of host names. A team lead planning a session
 * knows the group they have and the afternoon they can spare — they do not
 * know that the person they want is called Maximiliana, so a name index only
 * helps someone who already knows the answer.
 *
 * Folded behind one button, because four rows of chips took the first screen
 * of a page whose whole argument is the reels underneath them: the videos
 * should be the first thing seen, and the filters there for whoever wants
 * them. The bar says how many hosts are showing and which filters are on, so
 * a closed panel is never a hidden state.
 *
 * It is a <details>, so the open/close, the keyboard and the focus order are
 * the browser's rather than ours; the script below only closes it on Escape,
 * on a click outside, and when the reader is done choosing.
 *
 * The four filters are ANDed. Each is a row of radio inputs rather than
 * buttons: a group of radios is exactly "pick one of these", so arrow keys,
 * labels and the reset all work without scripting them.
 */
interface Props {
  lang?: Lang;
}
const { lang = DEFAULT_LANG } = Astro.props;
const t = filterCopy[lang];

const groupIds = ['small', 'medium', 'large'] as const;
const durationIds = ['short', 'medium', 'long'] as const;
const activityIds = ['ceramics', 'art', 'craft', 'food', 'photography', 'wellbeing', 'music'] as const;
const priceIds = ['budget', 'mid', 'high', 'premium'] as const;

const rows = [
  { name: 'activity', label: t.activityLabel, options: activityIds.map((id) => ({ id, label: t.activities[id] })) },
  { name: 'group', label: t.groupLabel, options: groupIds.map((id) => ({ id, label: t.groups[id] })) },
  { name: 'hours', label: t.durationLabel, options: durationIds.map((id) => ({ id, label: t.durations[id] })) },
  { name: 'price', label: t.priceLabel, options: priceIds.map((id) => ({ id, label: t.prices[id] })) },
];
---

<form class="filters" id="host-filters" aria-label={t.activityLabel}>
  <div class="filterbar">
    <details class="filterdrop">
      <summary class="filterbtn">
        {/* The sliders mark, so the button reads as filters at a glance
            rather than as another word in the row. */}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h10" /><path d="M18 7h2" /><circle cx="16" cy="7" r="2" />
          <path d="M4 17h4" /><path d="M12 17h8" /><circle cx="10" cy="17" r="2" />
        </svg>
        <span>{t.filters}</span>
        {/* How many are on, where nothing is open to show it. */}
        <span class="filterbtn-on" hidden></span>
      </summary>

      <div class="filterdrop-panel">
        {rows.map((row) => (
          <fieldset class="filter-row">
            <legend class="filter-legend">{row.label}</legend>
            <div class="filter-chips">
              <label class="chip">
                <input type="radio" name={row.name} value="" checked />
                <span>{t.all}</span>
              </label>
              {row.options.map((opt) => (
                <label class="chip">
                  <input type="radio" name={row.name} value={opt.id} />
                  <span>{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}

        <div class="filterdrop-foot">
          <button type="reset" class="filter-clear" hidden>{t.clear}</button>
          <button type="button" class="btn btn-primary filterdrop-done" data-show={t.show('%s')}></button>
        </div>
      </div>
    </details>

    {/* Outside the panel: what the filters have left, readable with the
        panel shut. */}
    <p class="filter-count" role="status" aria-live="polite" data-one={t.count(1)} data-many={t.count(0)}></p>
  </div>
</form>

<p class="filter-empty" hidden>{t.empty}</p>

<script>
  /* Bucket edges live here, next to the code that compares them, rather than
     in the labels — "Up to 10" is prose and may be reworded, [0, 10] is the
     rule. A host matches a bucket when their range OVERLAPS it, not when it
     is contained: someone who takes 6–100 people can host a group of 8, and
     hiding them from the "up to 10" filter would be wrong. */
  const GROUPS: Record<string, [number, number]> = {
    small: [0, 10],
    medium: [10, 30],
    large: [30, Infinity],
  };
  const HOURS: Record<string, [number, number]> = {
    short: [0, 2],
    medium: [2, 4],
    long: [4, Infinity],
  };
  /* Euros a seat, read off the host's own published sessions. A host who
     publishes no price cannot be placed in a band, so picking one hides
     them — which is the honest answer to "show me what costs under 50"
     when nobody knows what they cost. They come back under "All". */
  const PRICES: Record<string, [number, number]> = {
    budget: [0, 50],
    mid: [50, 100],
    high: [100, 200],
    premium: [200, Infinity],
  };

  const form = document.querySelector<HTMLFormElement>('#host-filters');
  const empty = document.querySelector<HTMLElement>('.filter-empty');
  const count = document.querySelector<HTMLElement>('.filter-count');
  const clear = document.querySelector<HTMLButtonElement>('.filter-clear');
  const drop = document.querySelector<HTMLDetailsElement>('.filterdrop');
  const onBadge = document.querySelector<HTMLElement>('.filterbtn-on');
  const done = document.querySelector<HTMLButtonElement>('.filterdrop-done');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.maker'));

  if (form && cards.length) {
    const overlaps = (a: [number, number], b: [number, number]) => a[0] <= b[1] && a[1] >= b[0];
    const num = (el: HTMLElement, key: string) => Number(el.dataset[key]);

    const apply = () => {
      const data = new FormData(form);
      const activity = String(data.get('activity') ?? '');
      const group = String(data.get('group') ?? '');
      const hours = String(data.get('hours') ?? '');
      const price = String(data.get('price') ?? '');

      let shown = 0;
      for (const card of cards) {
        const ok =
          (!activity || card.dataset.activity === activity) &&
          (!group || overlaps([num(card, 'groupMin'), num(card, 'groupMax')], GROUPS[group])) &&
          (!hours || overlaps([num(card, 'hoursMin'), num(card, 'hoursMax')], HOURS[hours])) &&
          (!price ||
            (card.dataset.priceMin !== undefined &&
              overlaps([num(card, 'priceMin'), num(card, 'priceMax')], PRICES[price])));
        card.hidden = !ok;
        if (ok) shown++;
      }

      if (empty) empty.hidden = shown > 0;
      const label = shown === 1
        ? (count?.dataset.one ?? '')
        : (count?.dataset.many ?? '').replace('0', String(shown));
      if (count) count.textContent = label;
      // "Show 12 hosts" on the button that shuts the panel, so the reader
      // can see what they are about to be left with before closing it.
      if (done) done.textContent = (done.dataset.show ?? '%s').replace('%s', label);
      const on = [activity, group, hours, price].filter(Boolean).length;
      if (clear) clear.hidden = on === 0;
      if (onBadge) {
        onBadge.hidden = on === 0;
        onBadge.textContent = String(on);
      }
      /* Hiding cards reflows the grid, so tiles change rows. The directory's
         reels pick their players by row, and this is what tells them to look
         again rather than waiting for the next scroll. */
      document.dispatchEvent(new CustomEvent('twiggli:filtered'));
    };

    form.addEventListener('change', apply);
    /* 'reset' fires before the inputs revert, so read them on the next tick. */
    form.addEventListener('reset', () => setTimeout(apply, 0));
    apply();

    if (drop) {
      // Done choosing: shut the panel and hand focus back to the button that
      // opened it, so the keyboard does not land at the top of the page.
      done?.addEventListener('click', () => {
        drop.open = false;
        drop.querySelector<HTMLElement>('.filterbtn')?.focus();
      });
      // A click anywhere else means the reader has moved on.
      document.addEventListener('click', (event) => {
        if (drop.open && !drop.contains(event.target as Node)) drop.open = false;
      });
      document.addEventListener('keydown', (event) => {
        if ((event as KeyboardEvent).key !== 'Escape' || !drop.open) return;
        drop.open = false;
        drop.querySelector<HTMLElement>('.filterbtn')?.focus();
      });
    }
  }
</script>
