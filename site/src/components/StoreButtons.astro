---
import { getSiteData } from '../data/site.ts';
import type { Lang } from '../lib/url.ts';

/**
 * App Store / Google Play links, with the official localized badge for the
 * current language (see data/site.ts) — both stores ship separate artwork
 * per locale, so the badge image itself switches, not just its alt text.
 */
interface Props {
  lang: Lang;
  /** 'accent' sits on the red band; 'default' on the page background. */
  tone?: 'accent' | 'default';
  class?: string;
}
const { lang, tone = 'accent', class: className } = Astro.props;
const { storeLinks } = getSiteData(lang);
const stores = [storeLinks.appStore, storeLinks.googlePlay];
---

<div class:list={['store-buttons', className]}>
  {stores.map((store) => (
    store.badge ? (
      <a href={store.href} class="store-badge" aria-label={store.label}>
        <img src={store.badge} alt={store.label} height="48" loading="lazy" />
      </a>
    ) : (
      <a
        href={store.href}
        class:list={['btn', 'btn-ghost', tone === 'accent' ? 'btn-on-accent' : 'btn-store']}
      >{store.label}</a>
    )
  ))}
</div>
