---
/** The home page's what / when / where / price pill. It hands the choices
 *  to the calendar (/happening-today/?activity=…&date=…&district=…&price=…),
 *  whose own
 *  filter pills read them — see the end of DayPicker.astro. Without
 *  scripting the form still lands on the calendar, unfiltered. Styled in
 *  home-discover.css. */
import { homeDiscoverCopy } from '../data/homeDiscover.ts';
import { getHomeData } from '../data/homeData.ts';
import { priceFilterCopy } from '../data/priceFilter.ts';
import type { Lang } from '../lib/url.ts';

interface Props { lang: Lang; class?: string }
const { lang, class: extra } = Astro.props;
const d = homeDiscoverCopy[lang];
const p = priceFilterCopy[lang];
const { calendarHref, whatOptions, whenOptions, whereOptions, priceOptions } = getHomeData(lang);
---

<form class:list={['hd-search', extra]} action={calendarHref} method="get" role="search" aria-label={d.searchLabel} data-hd-search>
  <label class="hd-field">
    <span>{d.what}</span>
    <select name="activity">
      <option value="">{d.whatAny}</option>
      {whatOptions.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
  </label>
  <label class="hd-field">
    <span>{d.when}</span>
    <select name="date">
      <option value="">{d.whenAny}</option>
      {whenOptions.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
  </label>
  <label class="hd-field">
    <span>{d.where}</span>
    <select name="district">
      <option value="">{d.whereAny}</option>
      {whereOptions.map((w) => <option value={w}>{w}</option>)}
    </select>
  </label>
  {/* Per person, on the price the tiles show (priceFilter.ts). */}
  {priceOptions.length > 0 && (
    <label class="hd-field hd-field-price">
      <span>{p.ask}</span>
      <select name="price">
        <option value="">{p.any}</option>
        {priceOptions.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    </label>
  )}
  <button type="submit" class="hd-search-btn">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
    <span>{d.search}</span>
  </button>
</form>

<script>
  // Only the fields that were set go into the address, so "Any day" does
  // not arrive at the calendar as an empty date.
  // Each select as wide as the option it shows, so its chevron sits right
  // after the words (home-discover.css). Natively a select is as wide as
  // its longest option, which left a wide gap after "Jederzeit".
  const ctx = document.createElement('canvas').getContext('2d');
  // On a phone the fields sit two by two in half the screen, where a long
  // choice ("Marzahn-Hellersdorf") would be cut off: the type steps down
  // until it fits, to 12.5px at the least.
  const phone = matchMedia('(max-width: 720px)');
  const fit = (select: HTMLSelectElement) => {
    if (!ctx) return;
    select.style.fontSize = '';
    const cs = getComputedStyle(select);
    const text = select.options[select.selectedIndex]?.text ?? '';
    const pad = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
    let size = parseFloat(cs.fontSize);
    const measure = () => {
      ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${size}px ${cs.fontFamily}`;
      return Math.ceil(ctx.measureText(text).width + pad) + 2;
    };
    let width = measure();
    const field = select.parentElement;
    if (phone.matches && field) {
      const fs = getComputedStyle(field);
      const room = field.clientWidth - parseFloat(fs.paddingLeft) - parseFloat(fs.paddingRight);
      if (width > room) {
        size = Math.max(12.5, Math.floor(size * (room - pad - 2) / (width - pad - 2) * 10) / 10);
        select.style.fontSize = `${size}px`;
        width = Math.min(measure(), room);
      }
    }
    select.style.width = `${width}px`;
  };
  const fitAll = () => document.querySelectorAll<HTMLSelectElement>('[data-hd-search] select').forEach(fit);

  document.querySelectorAll<HTMLFormElement>('[data-hd-search]').forEach((form) => {
    form.querySelectorAll('select').forEach((select) => select.addEventListener('change', () => fit(select)));
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const params = new URLSearchParams();
      new FormData(form).forEach((value, key) => { if (value) params.set(key, String(value)); });
      const query = params.toString();
      location.href = form.action + (query ? `?${query}` : '');
    });
  });
  fitAll();
  // Again once the web font is in (it measures wider than the fallback),
  // when the phone layout switches font size, and after a back-navigation
  // restores a choice.
  document.fonts?.ready.then(fitAll);
  phone.addEventListener('change', fitAll);
  addEventListener('pageshow', fitAll);
</script>
