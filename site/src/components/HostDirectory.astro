---
import type { Host } from '../data/content.ts';
import { getHostPriceRanges } from '../data/sessions.ts';
import { filterCopy } from '../data/content.ts';
import { DEFAULT_LANG, href, type Lang } from '../lib/url.ts';
import HostMonogram from './HostMonogram.astro';

/**
 * The full maker directory: one card per host, with the brochure photo strip
 * as a banner and the practical details a team lead needs before enquiring.
 * Hosts with a reel play it in place of the still.
 *
 * Each card carries its facets as data attributes so HostFilters can match
 * on them without re-deriving anything client-side.
 */
interface Props {
  hosts: Host[];
  lang?: Lang;
}
const { hosts, lang = DEFAULT_LANG } = Astro.props;

/* What a seat at this host's own public sessions costs, so the price filter
   has something real to match on and the card can say so. A private group
   is quoted separately — hence "per person" on the row rather than a figure
   presented as the price of the booking. */
const priceRanges = getHostPriceRanges();
const priceCopy = filterCopy[lang];
const money = (n: number) => `€${Math.round(n)}`;
const priceText = (range: [number, number] | undefined) =>
  !range ? priceCopy.priceUnknown
    // A host whose only public sessions are free: "€0 · per person" is a
    // sentence about nothing. Say the word instead.
    : range[0] === 0 && range[1] === 0 ? priceCopy.priceFree
    : range[0] === range[1] ? `${money(range[0])} · ${priceCopy.priceMeta}`
    : `${money(range[0])}–${money(range[1])} · ${priceCopy.priceMeta}`;

const labels = {
  en: { studio: 'Studio', group: 'Group', duration: 'Length', place: 'Where', languages: 'Languages', price: 'Price', play: 'Play reel', request: 'Request event' },
  de: { studio: 'Studio', group: 'Gruppe', duration: 'Dauer', place: 'Wo', languages: 'Sprachen', price: 'Preis', play: 'Reel abspielen', request: 'Event anfragen' },
}[lang];
---

<div class="maker-grid">
  {hosts.map((host) => (
    <article
      class="maker"
      id={host.slug}
      data-activity={host.activity}
      data-group-min={host.groupRange[0]}
      data-group-max={host.groupRange[1]}
      data-hours-min={host.hourRange[0]}
      data-hours-max={host.hourRange[1]}
      data-price-min={priceRanges.get(host.slug)?.[0]}
      data-price-max={priceRanges.get(host.slug)?.[1]}
    >
      {/* No play button: the reels announce themselves by playing as the page
          scrolls past them. The tile itself takes the focus and the keyboard
          in the button's place, so a reel is still reachable without a
          pointer. */}
      <div
        class="maker-media"
        tabindex={host.video ? 0 : undefined}
        role={host.video ? 'button' : undefined}
        aria-label={host.video ? `${host.name} — ${labels.play}` : undefined}
      >
        {host.video ? (
          <video
            class="maker-video"
            src={host.video}
            poster={host.poster}
            muted
            loop
            playsinline
            preload="none"
          ></video>
        ) : host.wide ? (
          <img src={host.wide} alt={`${host.name} — ${host.specialty}`} loading="lazy" decoding="async" />
        ) : (
          <HostMonogram name={host.name} />
        )}
      </div>

      <h2 class="maker-name">{host.name}</h2>
      <p class="maker-specialty">{host.specialty}</p>
      <p class="maker-blurb">{host.blurb}</p>

      <dl class="maker-meta">
        {host.studio && <div><dt>{labels.studio}</dt><dd>{host.studio}</dd></div>}
        <div><dt>{labels.group}</dt><dd>{host.group}</dd></div>
        <div><dt>{labels.duration}</dt><dd>{host.duration}</dd></div>
        <div><dt>{labels.place}</dt><dd>{host.place}</dd></div>
        <div><dt>{labels.languages}</dt><dd>{host.languages}</dd></div>
        <div><dt>{labels.price}</dt><dd>{priceText(priceRanges.get(host.slug))}</dd></div>
      </dl>

      {/* Lands on the contact form with this host in the query string, so
          the form can pre-fill the enquiry. */}
      <a class="maker-request" href={`${href(lang, '/contact/')}?host=${encodeURIComponent(host.name)}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2 11 13" /><path d="M22 2 15 22l-4-9-9-4Z" /></svg>
        {labels.request}
      </a>
    </article>
  ))}
</div>

<script>
  // Reels on the directory start by themselves as you scroll past them, so a
  // page of tiles reads as video rather than as stills — but at most one per
  // row, and only while that row is on screen. Pointing at any tile plays
  // that one too; clicking a playing tile stops it until the pointer leaves
  // and comes back. Touch has no hover, so there a tap toggles.
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.maker'));
  const videoOf = (c: HTMLElement) => c.querySelector<HTMLVideoElement>('.maker-video');
  const reels = cards.filter((c) => videoOf(c));
  if (reels.length) {
    const hoverable = window.matchMedia('(hover: hover)').matches;
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Chosen to play unattended; on screen right now; stopped by hand.
    const auto = new Set<HTMLElement>();
    const onScreen = new Set<HTMLElement>();
    const stopped = new Set<HTMLElement>();
    let hovered: HTMLElement | null = null;

    const play = (card: HTMLElement) => {
      const v = videoOf(card);
      if (!v || !v.paused) return;
      card.classList.add('is-playing');
      // These load nothing until something asks them to. play() on an empty
      // buffer is refused often enough to need the second attempt once there
      // are frames to show.
      v.preload = 'auto';
      const attempt = () => { v.play().catch(() => {}); };
      attempt();
      if (v.readyState < 3) {
        v.addEventListener('canplay', () => {
          if (card.classList.contains('is-playing')) attempt();
        }, { once: true });
      }
    };
    const halt = (card: HTMLElement) => {
      const v = videoOf(card);
      if (!v) return;
      if (!v.paused) v.pause();
      card.classList.remove('is-playing');
    };

    // One per row, and a different column each row down the page, so the
    // tiles that start on their own zig-zag instead of running down one edge.
    // Cards in a grid row share an offsetTop, which is also how the row count
    // follows the column count when the window changes width.
    const chooseAuto = () => {
      auto.clear();
      if (calm) return;
      const rows = new Map<number, HTMLElement[]>();
      for (const card of reels) {
        const top = Math.round(card.offsetTop);
        const row = rows.get(top);
        if (row) row.push(card);
        else rows.set(top, [card]);
      }
      let n = 0;
      for (const top of [...rows.keys()].sort((a, b) => a - b)) {
        const row = rows.get(top)!;
        auto.add(row[n % row.length]);
        n++;
      }
    };

    const sync = () => {
      for (const card of reels) {
        const wanted = !stopped.has(card) && (card === hovered || (auto.has(card) && onScreen.has(card)));
        if (wanted) play(card);
        else halt(card);
      }
    };

    // Watch the tile, not the card. A card runs to a thousand pixels with its
    // blurb and its details, so half of one is a poor proxy for "you can see
    // the video" — it can be satisfied while the tile is off the top of the
    // screen, and on a short window a tall card can never reach half at all.
    // The tile is the thing that has to be visible, so the tile is what is
    // measured, and the bottom margin starts it just before it arrives.
    const mediaOwner = new WeakMap<Element, HTMLElement>();
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const card = mediaOwner.get(entry.target);
        if (!card) continue;
        if (entry.isIntersecting) onScreen.add(card);
        else onScreen.delete(card);
      }
      sync();
    }, { threshold: 0.4, rootMargin: '0px 0px -10% 0px' });
    reels.forEach((card) => {
      const media = card.querySelector('.maker-media');
      if (!media) return;
      mediaOwner.set(media, card);
      io.observe(media);
    });

    reels.forEach((card) => {
      const media = card.querySelector<HTMLElement>('.maker-media');
      if (!media) return;
      if (hoverable) {
        media.addEventListener('mouseenter', () => { hovered = card; sync(); });
        media.addEventListener('mouseleave', () => {
          if (hovered === card) hovered = null;
          stopped.delete(card);
          sync();
        });
        media.addEventListener('click', () => { stopped.add(card); sync(); });
      } else {
        media.addEventListener('click', () => {
          if (stopped.has(card)) stopped.delete(card);
          else if (videoOf(card)!.paused) stopped.delete(card);
          else stopped.add(card);
          hovered = videoOf(card)!.paused ? card : null;
          sync();
        });
      }
      // The tile is the keyboard's way in now that the button is gone.
      media.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        if (videoOf(card)!.paused) { stopped.delete(card); hovered = card; }
        else { stopped.add(card); hovered = null; }
        sync();
      });
      videoOf(card)!.addEventListener('pause', () => card.classList.remove('is-playing'));
    });

    chooseAuto();
    sync();
    let redo = 0;
    window.addEventListener('resize', () => {
      clearTimeout(redo);
      redo = window.setTimeout(() => { chooseAuto(); sync(); }, 150);
    });
  }
</script>
