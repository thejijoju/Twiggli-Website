---
import type { Host } from '../data/content.ts';
import { getHostPriceRanges } from '../data/sessions.ts';
import { filterCopy } from '../data/content.ts';
import { DEFAULT_LANG, href, type Lang } from '../lib/url.ts';
import { ui } from '../data/i18n.ts';
import { hostHref } from '../data/seo.ts';
import HostMonogram from './HostMonogram.astro';

/**
 * The full maker directory: one card per host, with the brochure photo strip
 * as a banner and the practical details a team lead needs before enquiring.
 * Hosts with a reel play it in place of the still.
 *
 * Each card carries its facets as data attributes so HostFilters can match
 * on them without re-deriving anything client-side.
 */
interface Props {
  hosts: Host[];
  lang?: Lang;
}
const { hosts, lang = DEFAULT_LANG } = Astro.props;

/* What a seat at this host's own public sessions costs, so the price filter
   has something real to match on and the card can say so. A private group
   is quoted separately — hence "per person" on the row rather than a figure
   presented as the price of the booking. */
const priceRanges = getHostPriceRanges();
const priceCopy = filterCopy[lang];
const money = (n: number) => `€${Math.round(n)}`;
const priceText = (range: [number, number] | undefined) =>
  !range ? priceCopy.priceUnknown
    // A host whose only public sessions are free: "€0 · per person" is a
    // sentence about nothing. Say the word instead.
    : range[0] === 0 && range[1] === 0 ? priceCopy.priceFree
    : range[0] === range[1] ? `${money(range[0])} · ${priceCopy.priceMeta}`
    : `${money(range[0])}–${money(range[1])} · ${priceCopy.priceMeta}`;

const labels = ui(lang).directory;
---

<div class="maker-grid">
  {hosts.map((host, i) => (
    <article
      class="maker"
      id={host.slug}
      data-activity={host.activity}
      data-group-min={host.groupRange[0]}
      data-group-max={host.groupRange[1]}
      data-hours-min={host.hourRange[0]}
      data-hours-max={host.hourRange[1]}
      data-price-min={priceRanges.get(host.slug)?.[0]}
      data-price-max={priceRanges.get(host.slug)?.[1]}
    >
      {/* No play button: the reels announce themselves by playing as the page
          scrolls past them. The tile itself takes the focus and the keyboard
          in the button's place, so a reel is still reachable without a
          pointer. */}
      <div
        class="maker-media"
        tabindex={host.video ? 0 : undefined}
        role={host.video ? 'button' : undefined}
        aria-label={host.video ? `${host.name} — ${labels.play}` : undefined}
      >
        {/* The poster is the one thing a reel loads before its turn, and a
            directory of thirty-six of them fetched two and a half megabytes
            of stills the moment the page opened — on a phone that lands
            while the reader is trying to scroll. Only the top few carry
            theirs in the markup; the rest are attached as they come within
            a screen of view (see the script). */}
        {host.video ? (
          <>
            {/* The still sits under the reel rather than riding on it as a
                poster: Safari drops a poster the moment play() starts
                fetching, and the tile went pale between the still and the
                first frame. */}
            <img
              class="maker-still"
              src={i < 3 ? host.poster : undefined}
              data-src={i < 3 ? undefined : host.poster}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <video
              class="maker-video"
              src={host.video}
              muted
              loop
              playsinline
              preload="none"
            ></video>
          </>
        ) : host.wide ? (
          <img src={host.wide} alt={`${host.name} — ${host.specialty}`} loading="lazy" decoding="async" />
        ) : (
          <HostMonogram name={host.name} />
        )}
      </div>

      <h2 class="maker-name"><a href={hostHref(lang, host)}>{host.name}</a></h2>
      <p class="maker-specialty">{host.specialty}</p>
      {/* Four lines, then the rest on request: the blurbs run long enough
          that a page of them buries the details row a team lead is looking
          for. The button appears only where there is something under the
          fold — see the script. */}
      <p class="maker-blurb" id={`blurb-${host.slug}`}>{host.blurb}</p>
      <button
        class="maker-more"
        type="button"
        hidden
        aria-expanded="false"
        aria-controls={`blurb-${host.slug}`}
        data-more={labels.more}
        data-less={labels.less}
      >{labels.more}</button>

      <dl class="maker-meta">
        {host.studio && <div><dt>{labels.studio}</dt><dd>{host.studio}</dd></div>}
        <div><dt>{labels.group}</dt><dd>{host.group}</dd></div>
        <div><dt>{labels.duration}</dt><dd>{host.duration}</dd></div>
        <div><dt>{labels.place}</dt><dd>{host.place}</dd></div>
        <div><dt>{labels.languages}</dt><dd>{host.languages}</dd></div>
        <div><dt>{labels.price}</dt><dd>{priceText(priceRanges.get(host.slug))}</dd></div>
      </dl>

      {/* Lands on the contact form with this host in the query string, so
          the form can pre-fill the enquiry. */}
      <a class="maker-request" href={`${href(lang, '/contact/')}?host=${encodeURIComponent(host.name)}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2 11 13" /><path d="M22 2 15 22l-4-9-9-4Z" /></svg>
        {labels.request}
      </a>
    </article>
  ))}
</div>

<script>
  import { startReelWalk } from '../lib/reelwalk.ts';

  // Reels on the directory play themselves, one after the other: whichever
  // tiles are on screen take a turn each, two and a half seconds apiece, so
  // a page of stills reads as video wherever the reader happens to be. The
  // mechanism lives in lib/reelwalk.ts, which the calendar uses too.
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.maker'));
  const reels = cards
    .map((card) => ({
      card,
      tile: card.querySelector<HTMLElement>('.maker-media'),
      video: card.querySelector<HTMLVideoElement>('.maker-video'),
    }))
    .filter((r): r is { card: HTMLElement; tile: HTMLElement; video: HTMLVideoElement } =>
      !!r.tile && !!r.video);

  const walk = startReelWalk(reels, {
    playingClass: 'is-playing',
    threshold: 0.35,
    startAt: 0,
    // Straight down the line rather than skipping a tile: every reel on
    // screen gets its turn, in the order they are read.
    step: 1,
    holdMs: 2500,
  });
  // The filters hide cards, which changes which reels are in the walk.
  document.addEventListener('twiggli:filtered', () => walk.resync());

  // Each still is attached a screen before it is needed, so a phone fetches
  // the two or three it is about to show rather than all thirty-six at once.
  const waiting = document.querySelectorAll<HTMLImageElement>('.maker-still[data-src]');
  if (waiting.length) {
    const posters = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const img = entry.target as HTMLImageElement;
        if (img.dataset.src) img.src = img.dataset.src;
        delete img.dataset.src;
        posters.unobserve(img);
      }
    }, { rootMargin: '600px 0px' });
    for (const img of waiting) posters.observe(img);
  }

  // The blurb is clamped to four lines in CSS. A card only gets the toggle
  // where the text actually runs past that — measured rather than guessed
  // from a character count, since the same sentence wraps differently in
  // eight languages and at every width. Measuring waits for the webfont:
  // laid out in the fallback face, a blurb that fits can look as though it
  // overflows, and the button would appear for nothing.
  // The clamp itself waits for this class, so the four-line cut and the
  // button that undoes it arrive together or not at all.
  document.documentElement.classList.add('js-clamp');
  const clamped = Array.from(document.querySelectorAll<HTMLElement>('.maker-blurb'));
  const sync = () => {
    for (const blurb of clamped) {
      const card = blurb.closest('.maker');
      const button = card?.querySelector<HTMLButtonElement>('.maker-more');
      if (!button) continue;
      // An open card stays open through a resize; only a closed one is
      // measured, since an expanded blurb never overflows.
      if (button.getAttribute('aria-expanded') === 'true') continue;
      button.hidden = blurb.scrollHeight <= blurb.clientHeight + 1;
    }
  };
  const ready = (document as Document & { fonts?: FontFaceSet }).fonts?.ready;
  if (ready) ready.then(sync);
  else sync();
  sync();

  // Width only. A phone fires resize every time its address bar slides away
  // during a scroll, and re-measuring fifty-seven paragraphs against the
  // layout on each of those is felt as the scroll stuttering — while the
  // wrapping it would measure has not changed at all.
  let resizeTimer = 0;
  let lastWidth = window.innerWidth;
  window.addEventListener('resize', () => {
    if (window.innerWidth === lastWidth) return;
    lastWidth = window.innerWidth;
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(sync, 150);
  });

  for (const button of document.querySelectorAll<HTMLButtonElement>('.maker-more')) {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      button.closest('.maker')?.classList.toggle('is-open', !open);
      button.textContent = (open ? button.dataset.more : button.dataset.less) ?? '';
    });
  }
</script>
