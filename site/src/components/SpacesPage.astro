---
/** Studios our hosts rent out when they are not teaching in them — one
 *  card per space, the host's own reel playing on it, and an enquiry that
 *  lands as a mail like every other request on the site. */
import Base from '../layouts/Base.astro';
import HostMonogram from './HostMonogram.astro';
import SideMap from './SideMap.astro';
import { mapCopy } from '../data/mapCopy.ts';
import { getHosts } from '../data/content.ts';
import { spaces } from '../data/spaces.ts';
import { ui } from '../data/i18n.ts';
import { hostHref } from '../data/seo.ts';
import { href, type Lang } from '../lib/url.ts';
import { slugify } from '../data/sessions.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang).spaces;
const hosts = getHosts(lang);

const cards = spaces.map((space) => {
  const host = space.slug ? hosts.find((h) => h.slug === space.slug) : undefined;
  const photos = space.photos ?? [];
  // A host's reel leads where there is one and the room's own photos sit in
  // a row beneath; with no reel the first photo leads and the rest follow.
  const lead = host?.video ? undefined : photos[0];
  const strip = host?.video ? photos : photos.slice(1);
  return { space, host, lead, strip };
});
const nums = ['01', '02', '03'];

/* The map beside the cards, as on the calendar: a pin on each studio's
   door (the address is on the card), labelled with its hourly rate — "from"
   the cheapest room where a space lets more than one. */
const m = mapCopy[lang];
const idFor = (name: string) => slugify(name);
const rateFor = (price?: Record<Lang, string>) => {
  const figures = [...(price?.en ?? '').matchAll(/€\s?(\d+(?:[.,]\d+)?)/g)].map((x) => Number(x[1].replace(',', '.')));
  if (!figures.length) return t.priceOnRequest;
  const low = `€${Math.min(...figures)}/h`;
  return figures.length > 1 ? m.from.replace('{p}', low) : low;
};
const marks = spaces.map((space) => ({
  id: idFor(space.name),
  at: space.at,
  label: rateFor(space.price),
  title: `${space.name} · ${space.district}`,
}));
---

<Base title={t.title} description={t.description} lang={lang}>
  <div class="container">
    <section class="page-head">
      <span class="kicker">{t.kicker}</span>
      <h1 class="page-title">{t.h1}</h1>
      <p class="page-lede">{t.lede}</p>
      <div class="hero-actions">
        <a href={href(lang, '/contact/')} class="btn btn-primary">{t.cta}</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="section has-sidemap" data-spacemap data-map="open">
      {/* Brings the map back once closed, and is how a phone opens it. */}
      <div class="sidemap-bar">
        <button class="view-btn map-btn" type="button" data-map-open aria-label={m.map} title={m.map}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4 3 6.5v13.5l6-2.5 6 2.5 6-2.5V4l-6 2.5z"/><path d="M9 4v13.5M15 6.5V20"/></svg>
          <span>{m.map}</span>
        </button>
      </div>
      <div class="sidemap-results">
      <div class="space-grid sidemap-list">
        {cards.map(({ space, host, lead, strip }) => (
          <article class="space-card" id={`space-${idFor(space.name)}`} data-space={idFor(space.name)}>
            <div class="space-visuals">
            <div class="space-media">
              {/* Which part of town, on the picture rather than in the
                  details: it is the first thing anyone looking for a room
                  checks, and it reads before the copy does. */}
              <span class="space-district">{space.district}</span>
              {host?.video ? (
                <video
                  class="space-video"
                  src={host.video}
                  poster={host.poster}
                  muted
                  loop
                  playsinline
                  preload="none"
                ></video>
              ) : lead ? (
                <img src={lead} alt={`${space.name}, ${space.district}`} loading="lazy" decoding="async" />
              ) : host?.wide || host?.photo ? (
                <img src={host.wide ?? host.photo} alt="" loading="lazy" decoding="async" />
              ) : (
                <HostMonogram name={space.name} />
              )}
            </div>
            {/* The room itself, a tap from full size — for a space, the
                question is what the room looks like before what happens
                in it. */}
            {strip.length > 0 && (
              <div class="space-photos">
                {strip.map((src) => (
                  <a href={src} target="_blank" rel="noopener">
                    <img src={src} alt={`${space.name}, ${space.district}`} loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
            )}
            </div>
            <div class="space-body">
              <h2 class="space-name">{space.name}</h2>
              {space.badge && <p class="space-badge">{space.badge[lang]}</p>}
              <p class="space-where">{space.address}</p>
              <p class="space-copy">{space.copy[lang]}</p>
              <dl class="space-meta">
                <div><dt>{t.labelSuits}</dt><dd>{space.suits[lang]}</dd></div>
                <div>
                  <dt>{t.labelHost}</dt>
                  <dd>{host ? <a href={hostHref(lang, host)}>{host.firstName ?? host.name}</a> : space.manager ?? space.name}</dd>
                </div>
                {space.size && <div><dt>{t.labelSize}</dt><dd>{typeof space.size === 'string' ? space.size : space.size[lang]}</dd></div>}
                <div><dt>{t.labelPrice}</dt><dd>{space.price?.[lang] ?? t.priceOnRequest}</dd></div>
                {space.included && <div><dt>{t.labelIncluded}</dt><dd>{space.included[lang]}</dd></div>}
                {space.access && <div><dt>{t.labelAccess}</dt><dd>{space.access[lang]}</dd></div>}
              </dl>
              {space.terms && <p class="space-terms">{space.terms[lang]}</p>}
              {/* Lands on the contact form with the space already named, the
                  same route the directory's "Request event" takes. */}
              <a class="btn btn-primary space-ask" href={`${href(lang, '/contact/')}?space=${encodeURIComponent(space.name)}`}>
                {t.askAbout} {space.name}
              </a>
            </div>
          </article>
        ))}
      </div>
      <SideMap lang={lang} data-spaces={JSON.stringify(marks)} />
      </div>
      <p class="form-note space-note">{t.note}</p>
    </section>

    <hr class="rule" />

    <section class="section">
      {t.points.map((point, i) => (
        <div class="step">
          <p class="step-num">{nums[i]}</p>
          <h3 class="step-title">{point.title}</h3>
          <p class="step-copy">{point.copy}</p>
        </div>
      ))}
    </section>

    <hr class="rule" />

    <section class="split split-text-first">
      <div>
        <span class="kicker kicker-tight">{t.moreKicker}</span>
        <p class="split-copy">{t.more}</p>
        <div class="split-actions">
          <a href={href(lang, '/contact/')} class="btn btn-primary">{t.cta}</a>
        </div>
      </div>
      <div></div>
    </section>
  </div>
</Base>

<script>
  import { startSideMap, type Mark } from '../lib/sidemap.ts';

  // Picking a pin brings its studio's card into view and marks it; a card
  // under the pointer lights its pin.
  const root = document.querySelector<HTMLElement>('[data-spacemap]');
  const pane = root?.querySelector<HTMLElement>('[data-sidemap]');
  if (root && pane) {
    const marks: Mark[] = JSON.parse(pane.dataset.spaces || '[]');
    let picked = '';
    const draw = () => {
      side?.setMarks(marks.map((mark) => ({ ...mark, active: mark.id === picked })));
      side?.frame(marks.map((mark) => mark.at), 'all');
    };
    const side = startSideMap(root, {
      onShow: draw,
      onPick: (id) => {
        picked = picked === id ? '' : id;
        draw();
        if (!picked) return;
        // On a phone the map covers the list; it steps aside first.
        if (!side?.isWide()) side?.setState('closed');
        const card = document.getElementById(`space-${id}`);
        card?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        card?.classList.remove('is-picked');
        void card?.offsetWidth;
        card?.classList.add('is-picked');
      },
    });
    for (const card of root.querySelectorAll<HTMLElement>('[data-space]')) {
      card.addEventListener('mouseenter', () => side?.light(card.dataset.space ?? ''));
      card.addEventListener('mouseleave', () => side?.light(''));
    }
  }
</script>
