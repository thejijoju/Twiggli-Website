---
/** Studios our hosts rent out when they are not teaching in them — one
 *  card per space, the host's own reel playing on it, and an enquiry that
 *  lands as a mail like every other request on the site. */
import Base from '../layouts/Base.astro';
import HostMonogram from './HostMonogram.astro';
import { getHosts } from '../data/content.ts';
import { spaces } from '../data/spaces.ts';
import { ui } from '../data/i18n.ts';
import { hostHref } from '../data/seo.ts';
import { href, type Lang } from '../lib/url.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang).spaces;
const hosts = getHosts(lang);

const cards = spaces.map((space) => {
  const host = space.slug ? hosts.find((h) => h.slug === space.slug) : undefined;
  const photos = space.photos ?? [];
  // A host's reel leads where there is one and the room's own photos sit in
  // a row beneath; with no reel the first photo leads and the rest follow.
  const lead = host?.video ? undefined : photos[0];
  const strip = host?.video ? photos : photos.slice(1);
  return { space, host, lead, strip };
});
const nums = ['01', '02', '03'];
---

<Base title={t.title} description={t.description} lang={lang}>
  <div class="container">
    <section class="page-head">
      <span class="kicker">{t.kicker}</span>
      <h1 class="page-title">{t.h1}</h1>
      <p class="page-lede">{t.lede}</p>
      <div class="hero-actions">
        <a href={href(lang, '/contact/')} class="btn btn-primary">{t.cta}</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="section">
      <div class="space-grid">
        {cards.map(({ space, host, lead, strip }) => (
          <article class="space-card">
            <div class="space-visuals">
            <div class="space-media">
              {/* Which part of town, on the picture rather than in the
                  details: it is the first thing anyone looking for a room
                  checks, and it reads before the copy does. */}
              <span class="space-district">{space.district}</span>
              {host?.video ? (
                <video
                  class="space-video"
                  src={host.video}
                  poster={host.poster}
                  muted
                  loop
                  playsinline
                  preload="none"
                ></video>
              ) : lead ? (
                <img src={lead} alt={`${space.name}, ${space.district}`} loading="lazy" decoding="async" />
              ) : host?.wide || host?.photo ? (
                <img src={host.wide ?? host.photo} alt="" loading="lazy" decoding="async" />
              ) : (
                <HostMonogram name={space.name} />
              )}
            </div>
            {/* The room itself, a tap from full size — for a space, the
                question is what the room looks like before what happens
                in it. */}
            {strip.length > 0 && (
              <div class="space-photos">
                {strip.map((src) => (
                  <a href={src} target="_blank" rel="noopener">
                    <img src={src} alt={`${space.name}, ${space.district}`} loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
            )}
            </div>
            <div class="space-body">
              <h2 class="space-name">{space.name}</h2>
              <p class="space-where">{space.address}</p>
              <p class="space-copy">{space.copy[lang]}</p>
              <dl class="space-meta">
                <div><dt>{t.labelSuits}</dt><dd>{space.suits[lang]}</dd></div>
                <div>
                  <dt>{t.labelHost}</dt>
                  <dd>{host ? <a href={hostHref(lang, host)}>{host.firstName ?? host.name}</a> : space.manager ?? space.name}</dd>
                </div>
                {space.size && <div><dt>{t.labelSize}</dt><dd>{space.size}</dd></div>}
                <div><dt>{t.labelPrice}</dt><dd>{space.price?.[lang] ?? t.priceOnRequest}</dd></div>
                {space.included && <div><dt>{t.labelIncluded}</dt><dd>{space.included[lang]}</dd></div>}
                {space.access && <div><dt>{t.labelAccess}</dt><dd>{space.access[lang]}</dd></div>}
              </dl>
              {space.terms && <p class="space-terms">{space.terms[lang]}</p>}
              {/* Lands on the contact form with the space already named, the
                  same route the directory's "Request event" takes. */}
              <a class="btn btn-primary space-ask" href={`${href(lang, '/contact/')}?space=${encodeURIComponent(space.name)}`}>
                {t.askAbout} {space.name}
              </a>
            </div>
          </article>
        ))}
      </div>
      <p class="form-note space-note">{t.note}</p>
    </section>

    <hr class="rule" />

    <section class="section">
      {t.points.map((point, i) => (
        <div class="step">
          <p class="step-num">{nums[i]}</p>
          <h3 class="step-title">{point.title}</h3>
          <p class="step-copy">{point.copy}</p>
        </div>
      ))}
    </section>

    <hr class="rule" />

    <section class="split split-text-first">
      <div>
        <span class="kicker kicker-tight">{t.moreKicker}</span>
        <p class="split-copy">{t.more}</p>
        <div class="split-actions">
          <a href={href(lang, '/contact/')} class="btn btn-primary">{t.cta}</a>
        </div>
      </div>
      <div></div>
    </section>
  </div>
</Base>
