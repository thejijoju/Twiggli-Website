---
import { href, type Lang } from '../lib/url.ts';
import { ui } from '../data/i18n.ts';
import { getSiteData } from '../data/site.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
/* The privacy policy exists in English and German only; other languages
   link to the English one. */
const { docLang } = getSiteData(lang);

/** Storage key checked by the no-flash script in Base.astro's <head> —
 *  keep the two in sync if this ever changes. */
const STORAGE_KEY = 'twiggli-cookie-consent';

const copy = ui(lang).cookie;
---

<div class="cookie-banner" id="cookie-banner" role="region" aria-label={copy.label}>
  <div class="cookie-banner-inner">
    <p class="cookie-banner-text">
      {copy.text}
      {' '}<a href={`${href(docLang, '/privacy-policy/')}#cookies`}>{copy.privacyLink}</a> {copy.suffix}
    </p>
    <div class="cookie-banner-actions">
      <button type="button" class="btn btn-secondary" data-cookie-choice="necessary">
        {copy.necessary}
      </button>
      <button type="button" class="btn btn-primary" data-cookie-choice="all">{copy.acceptAll}</button>
    </div>
  </div>
</div>

<script define:vars={{ STORAGE_KEY }}>
  // The banner goes away the moment a button is pressed, whatever else
  // happens: it is hidden first, and the choice is remembered second, inside
  // a try — a browser that blocks storage (Safari in private browsing, "block
  // all cookies", some Android browsers) throws on setItem, and the old
  // order left the banner standing on every tap. Remembering it is a
  // courtesy for the next visit; dismissing it is the visitor's decision.
  const banner = document.getElementById('cookie-banner');
  const dismiss = (choice) => {
    document.documentElement.classList.add('cookie-consent-set');
    if (banner) banner.hidden = true;
    try {
      localStorage.setItem(STORAGE_KEY, choice);
    } catch (e) {}
  };
  banner?.querySelectorAll('[data-cookie-choice]').forEach((button) => {
    button.addEventListener('click', () => dismiss(button.dataset.cookieChoice));
  });
</script>
