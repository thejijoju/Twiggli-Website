---
/** The home page, in any language: the copy comes from i18n.ts and the
 *  page under src/pages/ is a one-line wrapper that names the language. */
import Base from '../layouts/Base.astro';
import PhoneMockup from './PhoneMockup.astro';
import HostGrid from './HostGrid.astro';
import StoreButtons from './StoreButtons.astro';
import Newsletter from './Newsletter.astro';
import TodayTeaser from './TodayTeaser.astro';
import ActivityLinks from './ActivityLinks.astro';
import HomeSplits from './HomeSplits.astro';
import HostCommunity from './HostCommunity.astro';
import SiteSchema from './SiteSchema.astro';
import { getHosts } from '../data/content.ts';
import { ui } from '../data/i18n.ts';
import { href, type Lang } from '../lib/url.ts';
import Doodled from './Doodled.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang).home;
const hosts = getHosts(lang);
---

<Base title={t.title} description={t.description} lang={lang}>
  <div class="container">
    <section class="hero">
      <div class="hero-panel">
        <Doodled variant="a">
          <h1 class="hero-title">
            <span>{t.h1a}</span>
            <span>{t.h1b}</span>
          </h1>
        </Doodled>
        <div class="hero-quote">
          <div class="hero-copy">
            <p><strong>{t.p1a}<span class="mark">{t.p1mark}</span>{t.p1b}</strong></p>
            <p>{t.p2}</p>
            <p>{t.p3a}<span class="mark">{t.p3mark}</span>{t.p3b}</p>
            <p>{t.p4a}<strong>{t.p4strong}</strong>{t.p4b}</p>
          </div>
          <StoreButtons lang={lang} tone="default" class="hero-stores" />
        </div>
      </div>
      <PhoneMockup lang={lang} />
    </section>

  </div>

  <section class="section hosts-band band-seam" id="hosts">
    <div class="container">
      <span class="kicker">{t.hostsKicker}</span>
    </div>
    {/* Outside .container on purpose: five cards side by side need more
        room than the 1200px measure, and the track fades at both edges. */}
    <HostGrid hosts={hosts} layout="carousel" lang={lang} />
    <div class="container hosts-band-actions">
      <a href={href(lang, '/corporatebookings/')} class="btn btn-primary">{t.meetAll(hosts.length)}</a>
    </div>
  </section>

  <TodayTeaser lang={lang} />

  <ActivityLinks lang={lang} />

  <div class="container">
    <HomeSplits lang={lang} />
    <HostCommunity lang={lang} to="host" />

    <Newsletter lang={lang} />
  </div>
  <SiteSchema lang={lang} />
</Base>
