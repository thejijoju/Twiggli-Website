---
/** The home page, in any language: the copy comes from i18n.ts and the
 *  data files named below, and the page under src/pages/ is a one-line
 *  wrapper that names the language.
 *
 *  A discover page (Luma's "this week", Etsy's round category pictures and
 *  maker photos) in the colours of the polaroid mail banner: cream into
 *  lavender, ink #2b2118, the brand purple, Fraunces for the headings and
 *  Caveat for the handwritten bits. Every card is a real upcoming date or a
 *  real host. Picked by Jirel from three drafts ("Etsy warm"), 23.10.26.
 *
 *  The search pill hands what / when / where to the calendar
 *  (/happening-today/?activity=…&date=…&district=…&price=…), whose own filter
 *  pills read them — see the end of DayPicker.astro. Without scripting the
 *  form still lands on the calendar, unfiltered. */
import Base from '../layouts/Base.astro';
import Newsletter from './Newsletter.astro';
import HostCommunity from './HostCommunity.astro';
import SiteSchema from './SiteSchema.astro';
import HostMonogram from './HostMonogram.astro';
import PhotoFade from './PhotoFade.astro';
import HomeSearch from './HomeSearch.astro';
import HeroSparkles from './HeroSparkles.astro';
import Voucher from './Voucher.astro';
import { voucherCopy, VOUCHERS_ON } from '../data/vouchers.ts';
import { filterCopy } from '../data/content.ts';
import { ACTIVITY_ORDER, activityCopy, activityHref, formatWhen, hostHref, hubHref, pageCopy, workshopHref } from '../data/seo.ts';
import { ui } from '../data/i18n.ts';
import { homeDiscoverCopy } from '../data/homeDiscover.ts';
import { homeFindCopy } from '../data/homeFind.ts';
import { homeSplits } from '../data/homeSplits.ts';
import { bookingCopy } from '../data/bookingCopy.ts';
import { clubCopy } from '../data/club.ts';
import { activityThumb as thumb, getHomeData, mailPic as mail, makerPic } from '../data/homeData.ts';
import { href, type Lang } from '../lib/url.ts';
import { lqipStyle } from '../lib/lqip.ts';
import '../styles/home-discover.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang).home;
const d = homeDiscoverCopy[lang];
const find = homeFindCopy[lang];
const split = homeSplits[lang];
const f = filterCopy[lang];
const { rows, calendarHref, chips, counts, activityFace, makers, listed, cardMedia } = getHomeData(lang);

/* Polaroids beside the headline on a wide screen, captioned by hand; a
   small strip of them above it on anything narrower. */
const heroPics = (['ceramics', 'food', 'craft', 'art'] as const).map((a) => ({ src: thumb(a), label: f.activities[a] }));
---

<Base title={t.title} description={t.description} lang={lang} pageClass="page-home hd">
  <Fragment slot="head">
    {/* The headings' display serif, loaded on this page only. */}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,800;1,9..144,500&family=Caveat:wght@600;700&display=swap" />
  </Fragment>

  <section class="hd-hero">
    <HeroSparkles layout="home" />
    <div class="hd-hero-pics" aria-hidden="true">
      {heroPics.map((p, i) => (
        <figure class={`hd-polaroid hd-hero-pic is-${i + 1}`}>
          <img src={p.src} alt="" width="240" height="240" decoding="async" />
          <figcaption>{p.label}</figcaption>
        </figure>
      ))}
    </div>
    <div class="container hd-hero-inner">
      <span class="hd-eyebrow">{d.eyebrow}</span>
      <h1 class="hd-h1">{d.h1a} <span class="hd-hand">{d.h1b}</span></h1>
      <p class="hd-lede">{d.lede}</p>

      <HomeSearch lang={lang} />

      <ul class="hd-chips">
        {chips.map((c) => (
          <li><a href={c.href} style={`--tint:${c.tint}`}><span aria-hidden="true">{c.icon}</span> {c.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

  {rows.map((row, ri) => (
    <section class="hd-row" id={row.id}>
      <div class="container">
        <div class="hd-row-head">
          <div>
            <h2 class="hd-h2">{row.title}{row.hand && <> <em>{row.hand}</em></>}</h2>
            {row.sub && <p class="hd-sub">{row.sub}</p>}
          </div>
          <a class="hd-more" href={row.link}>{row.linkText} →</a>
        </div>
        <ul class="hd-track">
          {row.list.map((s) => (
            <li>
              {/* The group-bookings directory's tile (HostDirectory .maker), a
                  square reel over its still, in an even white frame; the
                  lines sit under the frame on the page. */}
              <a class="maker hd-tile" href={workshopHref(lang, s.host, s.workshopKey)} data-seen={`s:${s.id}`}>
                <span class="hd-frame">
                <span class="maker-media" style={lqipStyle(cardMedia(s).poster)}>
                  {cardMedia(s).video ? (
                    <>
                      <img class="maker-still" src={cardMedia(s).poster} alt="" loading={ri === 0 ? undefined : 'lazy'} decoding="async" />
                      <video class="maker-video" src={cardMedia(s).video} muted loop playsinline preload="none" aria-hidden="true"></video>
                    </>
                  ) : (cardMedia(s).stills?.length ?? 0) > 1 ? (
                    <PhotoFade photos={cardMedia(s).stills!} alt="" />
                  ) : cardMedia(s).still ? (
                    <img src={cardMedia(s).still} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <HostMonogram name={s.host.name} />
                  )}
                </span>
                <Voucher kind="badge" host={s.host} lang={lang} />
                </span>
                <span class="hd-card-when">{formatWhen(s, lang)}</span>
                <span class="maker-line"><span class="maker-title">{s.title}</span></span>
                <span class="maker-sub">{s.host.firstName ?? s.host.name} · {s.district}</span>
                {s.price && <span class="maker-price"><strong>{s.price}</strong><span>{f.priceMeta}</span></span>}
              </a>
              <Voucher kind="tile" host={s.host} lang={lang} title={s.title} workshopKey={s.workshopKey} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  {/* Gift vouchers, with Christmas coming (VoucherPage.astro). */}
  {VOUCHERS_ON && (  <div class="container">
    <a class="vc-teaser" href={href(lang, '/voucher/')}>
      <span class="vc-teaser-gift" aria-hidden="true">🎁</span>
      <span>
        <span class="vc-teaser-kicker">{voucherCopy[lang].teaserKicker}</span>
        <span class="vc-teaser-title">{voucherCopy[lang].teaserTitle} <em>{voucherCopy[lang].teaserEm}</em></span>
        <span class="vc-teaser-copy">{voucherCopy[lang].teaserCopy}</span>
      </span>
      <span class="vc-teaser-cta">{voucherCopy[lang].teaserCta} →</span>
    </a>
  </div>
  )}

  <section class="hd-cats" id="workshops">
    <div class="container">
      <div class="hd-row-head">
        <h2 class="hd-h2">{d.catsTitle} <em>{d.catsHand}</em></h2>
        <a class="hd-more" href={hubHref(lang)}>{t.activitiesAll} →</a>
      </div>
      <ul class="hd-cat-list">
        {ACTIVITY_ORDER.map((a) => {
          const face = activityFace(a);
          const n = counts.get(a) ?? 0;
          return (
            <li>
              <a href={activityHref(lang, a)} aria-label={activityCopy[lang][a].h1}>
                <span class="hd-cat-pic">
                  <img src={(face && makerPic(face)) || thumb(a)} alt="" width="240" height="240" loading="lazy" decoding="async" />
                </span>
                <span class="hd-cat-text">
                  <span class="hd-cat-name">{activityCopy[lang][a].short}</span>
                  <span class="hd-cat-count">{face ? d.faceMore(face.firstName ?? face.name, n - 1) : pageCopy[lang].hosts(n)}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <div class="container">
    <a class="find-solo hd-solo" href={calendarHref}>
      <span class="find-solo-faces" aria-hidden="true">
        {['craftkai', 'smell-lab', 'pausify'].map((p) => <img src={mail(p)} alt="" loading="lazy" decoding="async" />)}
      </span>
      <span class="find-solo-text">
        <strong>{find.soloTitle}</strong>
        <span>{find.soloCopy}</span>
      </span>
      <span class="find-solo-cta">{find.soloCta} →</span>
    </a>
  </div>

  <section class="hd-makers" id="hosts">
    <div class="container">
      <div class="hd-row-head hd-row-head-center">
        <div>
          <h2 class="hd-h2">{d.makersTitle} <em>{d.makersHand}</em></h2>
          <p class="hd-sub">{d.makersSub}</p>
        </div>
      </div>
      <ul class="hd-wall">
        {makers.map((h) => (
          <li>
            <a class="hd-maker" href={hostHref(lang, h)}>
              <img src={makerPic(h)} alt="" width="400" height="400" loading="lazy" decoding="async" />
              <span class="hd-maker-name">{h.firstName ?? h.name}</span>
              <span class="hd-maker-craft">{h.specialty}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="hd-center">
        <a href={href(lang, '/corporatebookings/')} class="hd-btn hd-btn-ink">{t.meetAll(listed)}</a>
      </div>
    </div>
  </section>

  <section class="container hd-blocks" aria-label={`${split.teams.kicker} · ${split.makers.kicker}`}>
    <div class="hd-block is-teams">
      <div class="hd-block-text">
        <span class="hd-block-kicker">{split.teams.kicker}</span>
        <h2 class="hd-block-title">{split.teams.title} <em>{split.teams.hand}</em></h2>
        <p>{split.teams.copy}</p>
        <ul class="hd-ticks">{split.teams.ticks.map((x) => <li>{x}</li>)}</ul>
        <div class="hd-block-actions">
          <a href={href(lang, '/corporatebookings/')} class="hd-btn hd-btn-light" data-book="group" data-book-title={bookingCopy[lang].anyHost}>{split.teams.cta}</a>
          <a href={href(lang, '/corporatebookings/')} class="hd-block-link">{split.teams.more} →</a>
        </div>
      </div>
      <div class="hd-block-pics" aria-hidden="true">
        <figure class="hd-polaroid"><img src={mail('jem-kimchi')} alt="" loading="lazy" decoding="async" /><figcaption>{split.teams.pics[0]}</figcaption></figure>
        <figure class="hd-polaroid"><img src={mail('smell-lab')} alt="" loading="lazy" decoding="async" /><figcaption>{split.teams.pics[1]}</figcaption></figure>
      </div>
    </div>
    <div class="hd-block is-makers">
      <div class="hd-block-text">
        <span class="hd-block-kicker">{split.makers.kicker}</span>
        <h2 class="hd-block-title">{split.makers.title} <em>{split.makers.hand}</em></h2>
        <p>{split.makers.copy}</p>
        <ul class="hd-ticks">{split.makers.ticks.map((x) => <li>{x}</li>)}</ul>
        <div class="hd-block-actions">
          <a href={href(lang, '/host/')} class="hd-btn hd-btn-ink">{split.makers.cta}</a>
        </div>
      </div>
      <div class="hd-block-pics" aria-hidden="true">
        <figure class="hd-polaroid"><img src={mail('tufttuft')} alt="" loading="lazy" decoding="async" /><figcaption>{split.makers.pics[0]}</figcaption></figure>
        <figure class="hd-polaroid"><img src={mail('ceramic-kingdom')} alt="" loading="lazy" decoding="async" /><figcaption>{split.makers.pics[1]}</figcaption></figure>
      </div>
    </div>
  </section>

  <div class="container hd-tail">
    <HostCommunity lang={lang} to="host" />

    {/* The club's waitlist, in the two languages its page exists in. */}
    {(lang === 'en' || lang === 'de') && (
      <a class="club-teaser" href={href(lang, '/club/')}>
        <span>{clubCopy[lang].teaser}</span>
        <b>{clubCopy[lang].teaserLink} →</b>
      </a>
    )}

    <Newsletter lang={lang} />
  </div>
  <SiteSchema lang={lang} />
</Base>


<script>
  import { startReelWalk } from '../lib/reelwalk.ts';

  // Each row of dates plays one reel at a time, walking along the tiles on
  // screen, as the directory and the calendar do (lib/reelwalk.ts).
  document.querySelectorAll<HTMLElement>('.hd-row').forEach((row) => {
    const reels = Array.from(row.querySelectorAll<HTMLElement>('.hd-tile'))
      .map((card) => ({
        card,
        tile: card.querySelector<HTMLElement>('.maker-media'),
        video: card.querySelector<HTMLVideoElement>('.maker-video'),
      }))
      .filter((r): r is { card: HTMLElement; tile: HTMLElement; video: HTMLVideoElement } => !!r.tile && !!r.video);
    startReelWalk(reels, { playingClass: 'is-playing', threshold: 0.5, startAt: 0, step: 1, holdMs: 3000 });
  });
</script>
