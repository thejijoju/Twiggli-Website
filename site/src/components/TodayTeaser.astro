---
import { getSessions, berlinTodayMs } from '../data/sessions.ts';
import { href, DEFAULT_LANG, LANG_META, type Lang } from '../lib/url.ts';
import { ui } from '../data/i18n.ts';
import HostMonogram from './HostMonogram.astro';

/** The homepage's taste of the live calendar: the next few real sessions —
 *  one card per host, reels playing — with the full calendar one tap away.
 *  Labels bake in at build time; the deploy workflow rebuilds daily, so
 *  "Today" stays true. */
interface Props { lang?: Lang }
const { lang = DEFAULT_LANG } = Astro.props;

const t = ui(lang).teaser;
const locale = LANG_META[lang].locale;

// The next sessions, one per host, five hosts at most — variety sells the
// calendar better than five cards from the same maker.
const picks: ReturnType<typeof getSessions> = [];
const seenHosts = new Set<string>();
for (const s of getSessions(lang)) {
  if (seenHosts.has(s.host.slug)) continue;
  seenHosts.add(s.host.slug);
  picks.push(s);
  if (picks.length === 5) break;
}

const base = berlinTodayMs();
const dayLabel = (offset: number) =>
  offset === 0
    ? t.today
    : offset === 1
      ? t.tomorrow
      : new Date(base + offset * 86400000).toLocaleDateString(locale, {
          weekday: 'short', day: 'numeric', month: 'short',
        });

const calendarHref = href(lang, '/happening-today/');
---

<section class="section today-band band-seam" id="happening-today">
  <div class="container">
    <span class="kicker">{t.kicker}</span>
    <p class="today-lede">{t.copy}</p>

    <div class="today-grid">
      {picks.map((s) => (
        <a class="today-card" href={calendarHref}>
          <span class="today-media">
            {s.host.video ? (
              <video
                class="today-video"
                src={s.host.video}
                poster={s.host.poster}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
              ></video>
            ) : s.host.photo ? (
              <img src={s.host.photo} alt="" loading="lazy" decoding="async" />
            ) : (
              <HostMonogram name={s.host.name} />
            )}
            <span class="today-when">{s.time ? `${dayLabel(s.dayOffset)} · ${s.time}` : dayLabel(s.dayOffset)}</span>
            {s.price && <span class="today-price">{s.price}</span>}
          </span>
          <span class="today-title">{s.title}</span>
          <span class="today-host">{s.host.name} · {s.district}</span>
          {/* The workshop's selling line, where it has one — same badge the
              calendar cards wear, so the two surfaces agree. */}
          {s.usp && <span class="session-usp">{s.usp}</span>}
        </a>
      ))}
    </div>

    <div class="today-actions">
      <a href={calendarHref} class="btn btn-primary">{t.cta}</a>
    </div>
  </div>
</section>

<script>
  // The teaser's reels wait for the pointer: hovering a card plays its clip
  // straight away, leaving stops it — same manners as the schedule feed, so
  // only the card being looked at ever loads. Touch has no hover, so there
  // exactly one plays: whichever is most in view. Scrolling hands the turn
  // down the stack — the card leaving stops as the next one takes over,
  // rather than every card on screen running at once.
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.today-video'));
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hoverable = window.matchMedia('(hover: hover)').matches;
  if (videos.length && !hoverable && !still) {
    const seen = new Map<HTMLVideoElement, number>();
    let current: HTMLVideoElement | null = null;
    const pick = () => {
      // The most visible, as long as a fair part of it is on screen; ties
      // (two cards wholly in view on a tall phone) go to the upper one,
      // which is the one being read.
      let best: HTMLVideoElement | null = null;
      let bestRatio = 0.35;
      for (const video of videos) {
        const ratio = seen.get(video) ?? 0;
        if (ratio > bestRatio + 0.01) { best = video; bestRatio = ratio; }
      }
      if (best === current) return;
      current?.pause();
      current = best;
      current?.play().catch(() => {});
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          seen.set(entry.target as HTMLVideoElement, entry.isIntersecting ? entry.intersectionRatio : 0);
        }
        pick();
      },
      // Fine steps, so the ratios stay current while a card slides through
      // rather than updating only as it crosses a single line.
      { threshold: Array.from({ length: 21 }, (_, i) => i / 20) },
    );
    videos.forEach((video) => observer.observe(video));
  } else if (videos.length) {
    // Nothing would stop a clip the pointer never left — scrolling past
    // with the cursor parked on a card, say.
    const offscreen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) (entry.target as HTMLVideoElement).pause();
        }
      },
      { threshold: 0.1 },
    );
    for (const video of videos) {
      offscreen.observe(video);
      const card = video.closest('.today-card');
      if (!card) continue;
      card.addEventListener('mouseenter', () => video.play().catch(() => {}));
      card.addEventListener('mouseleave', () => video.pause());
    }
  }
</script>
