---
import { getSessions, berlinTodayMs, type Session } from '../data/sessions.ts';
import { filterCopy } from '../data/content.ts';
import { occasionCopy } from '../data/seo.ts';
import { href, DEFAULT_LANG, LANG_META, type Lang } from '../lib/url.ts';
import { ui } from '../data/i18n.ts';
import { lqipStyle } from '../lib/lqip.ts';
import HostMonogram from './HostMonogram.astro';

/** The homepage's taste of the live calendar, in the same cards as the
 *  team directory: a square reel, the class and its start time, the host
 *  and district, the price. Three tabs — today, tomorrow, the coming
 *  weekend — four classes each, one per host. The reels play one at a
 *  time as on the directory (lib/reelwalk.ts). Labels bake in at build
 *  time; the deploy workflow rebuilds daily, so "Today" stays true. */
interface Props { lang?: Lang }
const { lang = DEFAULT_LANG } = Astro.props;

const t = ui(lang).teaser;
const perPerson = filterCopy[lang].priceMeta;
const locale = LANG_META[lang].locale;
const base = berlinTodayMs();
const weekday = (s: Session) => new Date(base + s.dayOffset * 86400000).getUTCDay();
const dayShort = (offset: number) =>
  new Date(base + offset * 86400000).toLocaleDateString(locale, { weekday: 'short', timeZone: 'UTC' });

/* Studio rentals ride along in some hosts' feeds; they are not classes. */
const notAClass = /hot ?desk|cowork/i;
const sessions = getSessions(lang).filter((s) => !notAClass.test(s.title));

/* Four per tab, one per host — variety sells the calendar better than four
   dates from the same maker. */
const pick = (list: Session[]) => {
  const out: Session[] = [];
  const seen = new Set<string>();
  for (const s of list) {
    if (seen.has(s.host.slug)) continue;
    seen.add(s.host.slug);
    out.push(s);
    if (out.length === 4) break;
  }
  return out;
};
const tabs = [
  { key: 'today', label: t.today, list: pick(sessions.filter((s) => s.dayOffset === 0)), withDay: false },
  { key: 'tomorrow', label: t.tomorrow, list: pick(sessions.filter((s) => s.dayOffset === 1)), withDay: false },
  {
    key: 'weekend',
    label: occasionCopy[lang].weekend.short,
    list: pick(sessions.filter((s) => s.dayOffset < 8 && (weekday(s) === 0 || weekday(s) === 6))),
    withDay: true,
  },
].filter((tab) => tab.list.length);
const first = tabs[0]?.key;

const calendarHref = href(lang, '/happening-today/');
const when = (s: Session, withDay: boolean) =>
  [withDay ? dayShort(s.dayOffset) : '', s.time ?? ''].filter(Boolean).join(' · ');
---

{tabs.length > 0 && (
<section class="section today-band band-seam" id="happening-today">
  <div class="container">
    <div class="tt-head">
      <div>
        <span class="tt-kicker">{t.kicker}</span>
        <p class="today-lede">{t.copy}</p>
      </div>
      {tabs.length > 1 && (
        <div class="tt-tabs" role="tablist">
          {tabs.map((tab) => (
            <button type="button" role="tab" class="tt-tab" data-tt-tab={tab.key} aria-selected={tab.key === first ? 'true' : 'false'}>{tab.label}</button>
          ))}
        </div>
      )}
    </div>

    {tabs.map((tab) => (
      <ul class="tt-grid" data-tt-panel={tab.key} hidden={tab.key !== first}>
        {tab.list.map((s) => (
          <li>
            <a class="tt-card" href={calendarHref} data-seen={`s:${s.id}`}>
              <span class="tt-media" style={lqipStyle(s.host.poster)}>
                {s.host.video ? (
                  <>
                    <img class="tt-still" src={s.host.poster} alt="" loading="lazy" decoding="async" />
                    <video class="tt-video" src={s.host.video} muted loop playsinline preload="none" aria-hidden="true"></video>
                  </>
                ) : s.host.photo ? (
                  <img class="tt-still" src={s.host.photo} alt="" loading="lazy" decoding="async" />
                ) : (
                  <HostMonogram name={s.host.name} />
                )}
              </span>
              <span class="tt-line">
                <span class="tt-title">{s.title}</span>
                {when(s, tab.withDay) && (
                  <span class="tt-time">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
                    {when(s, tab.withDay)}
                  </span>
                )}
              </span>
              <span class="tt-sub">{s.host.name} · {s.district}</span>
              {s.price && <span class="tt-price"><strong>{s.price}</strong> {perPerson}</span>}
            </a>
          </li>
        ))}
      </ul>
    ))}

    <div class="today-actions">
      <a href={calendarHref} class="btn btn-primary">{t.cta}</a>
    </div>
  </div>
</section>
)}

<script>
  import { startReelWalk } from '../lib/reelwalk.ts';

  // The reels play one at a time, walking along whatever is on screen, as
  // on the team directory.
  const reels = Array.from(document.querySelectorAll<HTMLElement>('.tt-card'))
    .map((card) => ({
      card,
      tile: card.querySelector<HTMLElement>('.tt-media'),
      video: card.querySelector<HTMLVideoElement>('.tt-video'),
    }))
    .filter((r): r is { card: HTMLElement; tile: HTMLElement; video: HTMLVideoElement } => !!r.tile && !!r.video);
  const walk = startReelWalk(reels, { playingClass: 'is-playing', threshold: 0.5, startAt: 0, step: 1, holdMs: 3000 });

  // The tabs swap which four are shown; the walk then picks up the new ones.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tt-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-tt-panel]'));
  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      for (const t of tabs) t.setAttribute('aria-selected', String(t === tab));
      for (const p of panels) p.hidden = p.dataset.ttPanel !== tab.dataset.ttTab;
      walk.resync();
    });
  }
</script>
