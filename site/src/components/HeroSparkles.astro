---
/**
 * A one-time intro for a hero: hand-painted gold stars (the same brush
 * strokes as Doodled.astro's) and a few small dots in the brand colours,
 * around the pictures and the headline. About two and a half seconds:
 *
 *   1. half of them (the "a" set) are drawn in, stroke by stroke, as if by
 *      hand: each centre line is dashed in (stroke-dashoffset),
 *   2. those fade away again,
 *   3. all of them are drawn in together, a little staggered,
 *   4. the brush shape fills in over each line, a single soft twinkle, and
 *      they stay, resting. On the home page they then keep slowly fading
 *      out and back in, each on its own offset; elsewhere nothing loops.
 *
 * Pure CSS (keyframes, fill-mode both) over inline SVG, so it plays once per
 * page load, on a phone as on a wide screen. A reader who asks for reduced
 * motion sees the resting state straight away.
 *
 * Place it inside a positioned hero; it covers the hero and takes no
 * pointer events. `layout` picks where the sparkles sit: 'home' around the
 * home page's polaroids and headline, 'title' around a centred heading.
 */
import { brushStars, brushLines, brushId, type BrushStar } from '../lib/brush.ts';

interface Props { layout?: 'home' | 'title' }
const { layout = 'home' } = Astro.props;

type Spark = { shape: BrushStar; x: number; y: number; s: number; d: number; mx: number; my: number; ms: number; rot?: number };
type Dot = { c: string; x: number; y: number; s: number; d: number; mx: number; my: number };
/* x / y in % of the hero (desktop, then mx / my on a phone), s in px, d the
   delay in seconds. */
const sets: Record<NonNullable<Props['layout']>, { stars: Spark[]; dots: Dot[] }> = {
  home: {
    stars: [
      { shape: 'burst', x: 15.5, y: 9, s: 44, d: 0.15, mx: 8, my: 7, ms: 24 },
      { shape: 'twinkle', x: 3.5, y: 76, s: 28, d: 0.5, mx: 90, my: 5, ms: 20 },
      { shape: 'cross', x: 21.5, y: 50, s: 18, d: 0.8, mx: 4, my: 22, ms: 13 },
      { shape: 'twinkle', x: 83, y: 9, s: 34, d: 0.3, mx: 94, my: 24, ms: 15 },
      { shape: 'burst', x: 86, y: 70, s: 36, d: 0.65, mx: 86, my: 31, ms: 17 },
      { shape: 'cross', x: 76, y: 31, s: 16, d: 1.0, mx: 95, my: 36, ms: 11 },
      { shape: 'twinkle', x: 29, y: 21, s: 15, d: 1.15, mx: 70, my: 2, ms: 10 },
    ],
    dots: [
      { c: '#6a3eec', x: 20, y: 36, s: 7, d: 0.55, mx: 18, my: 3, },
      { c: '#ffd84d', x: 9, y: 30, s: 9, d: 0.85, mx: 80, my: 9 },
      { c: '#ffb59a', x: 27, y: 12, s: 6, d: 1.05, mx: 2, my: 15 },
      { c: '#6a3eec', x: 88, y: 28, s: 6, d: 0.7, mx: 97, my: 14 },
      { c: '#ffb59a', x: 96, y: 18, s: 8, d: 1.0, mx: 28, my: 1 },
      { c: '#ffd84d', x: 83, y: 54, s: 7, d: 1.2, mx: 60, my: 33 },
    ],
  },
  title: {
    stars: [
      { shape: 'twinkle', x: 27, y: 8, s: 24, d: 0.15, mx: 6, my: 6, ms: 16 },
      { shape: 'cross', x: 71, y: 4, s: 15, d: 0.45, mx: 94, my: 10, ms: 12 },
      { shape: 'burst', x: 3, y: 70, s: 28, d: 0.3, mx: 4, my: 88, ms: 16 },
      { shape: 'cross', x: 97, y: 86, s: 15, d: 0.75, mx: 96, my: 90, ms: 11 },
      { shape: 'twinkle', x: 80, y: 20, s: 14, d: 1.0, mx: 80, my: 3, ms: 10 },
    ],
    dots: [
      { c: '#6a3eec', x: 13, y: 16, s: 7, d: 0.5, mx: 10, my: 12 },
      { c: '#ffd84d', x: 94, y: 48, s: 8, d: 0.7, mx: 96, my: 44 },
      { c: '#ffb59a', x: 78, y: 6, s: 6, d: 0.95, mx: 76, my: 4 },
      { c: '#ffb59a', x: 5, y: 62, s: 6, d: 1.1, mx: 2, my: 60 },
    ],
  },
};
const { stars, dots } = sets[layout];
const id = brushId();
---

<span class:list={['sparkles', `sparkles-${layout}`]} aria-hidden="true">
  <svg class="sparkles-defs" width="0" height="0" focusable="false">
    <defs>
      <filter id={`${id}-f`} x="-15%" y="-15%" width="130%" height="130%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="5" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.2" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <linearGradient id={`${id}-g`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f2cf5b" />
        <stop offset="0.5" stop-color="#d9ac35" />
        <stop offset="1" stop-color="#c39b33" />
      </linearGradient>
    </defs>
  </svg>
  <span class="sparkles-sweep"></span>
  {stars.map((st, i) => (
    <svg class:list={['sparkle', i % 2 ? 'is-b' : 'is-a']} viewBox="0 0 100 100" focusable="false"
      style={`--x:${st.x}%;--y:${st.y}%;--s:${st.s}px;--d:${st.d}s;--mx:${st.mx}%;--my:${st.my}%;--ms:${st.ms}px`}>
      <g filter={`url(#${id}-f)`}>
        <g class="sparkle-ink" fill="none" stroke="#d9ac35" stroke-linecap="round">
          {brushLines[st.shape].map((l, k) => <path d={l.d} stroke-width={l.w} pathLength="1" style={`--k:${k}`} />)}
        </g>
        <g class="sparkle-fill" fill={`url(#${id}-g)`}>
          {brushStars[st.shape].map((d) => <path d={d} />)}
        </g>
      </g>
    </svg>
  ))}
  {dots.map((dt, i) => (
    <i class:list={['sparkle-dot', i % 2 ? 'is-a' : 'is-b']} style={`--x:${dt.x}%;--y:${dt.y}%;--s:${dt.s}px;--d:${dt.d}s;--mx:${dt.mx}%;--my:${dt.my}%;--c:${dt.c}`}></i>
  ))}
</span>

<style>
  .sparkles { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .sparkles-defs { position: absolute; }
  /* The home hero runs up under the nav; the sparkles start below it. */
  .sparkles-home { top: var(--header-h); }
  /* The clock: one run of --t, each sparkle starting on its own small
     delay (its --d pressed into the first ~0.4 s), so the movements ripple
     rather than blink. Every step eases in and out. */
  .sparkle, .sparkle-dot {
    --rest: 0.85;
    --t: 2.4s;
    --delay: calc(var(--d) * 0.35);
    position: absolute; left: var(--x); top: var(--y);
    width: calc(var(--s) * 0.8); height: calc(var(--s) * 0.8);
    translate: -50% -50%;
    opacity: var(--rest);
  }
  .sparkle { overflow: visible; filter: drop-shadow(0 0 4px rgba(255, 216, 77, 0.4)); }
  .sparkle-dot {
    --rest: 0.7;
    width: calc(var(--s) * 0.85); height: calc(var(--s) * 0.85);
    border-radius: 50%; background: var(--c);
    box-shadow: 0 0 6px color-mix(in srgb, var(--c) 50%, transparent);
  }

  /* The star as a whole: "a" shows for the first drawing, fades, and comes
     back for the second; "b" waits for the second. Both twinkle once as the
     fill lands, then rest. */
  .sparkle { animation: spark-wrap-a var(--t) ease-in-out var(--delay) both; }
  .sparkle.is-b { animation-name: spark-wrap-b; }
  @keyframes spark-wrap-a {
    0%   { opacity: 0.95; transform: none; }
    30%  { opacity: 0.95; transform: scale(1.04); }
    40%  { opacity: 0; transform: scale(0.85) rotate(-6deg); }
    43%  { opacity: 0; transform: scale(0.95); }
    44%  { opacity: 0.95; transform: none; }
    82%  { opacity: 0.95; transform: none; }
    90%  { opacity: 1; transform: scale(1.14) rotate(5deg); }
    100% { opacity: var(--rest); transform: none; }
  }
  @keyframes spark-wrap-b {
    0%, 82% { opacity: 0.95; transform: none; }
    90%  { opacity: 1; transform: scale(1.14) rotate(5deg); }
    100% { opacity: var(--rest); transform: none; }
  }

  /* The drawing: each stroke's centre line dashes in from its start, the
     strokes of one star a beat apart (--k). The dash pattern is "1 2" over a
     path length of 1, so at an offset of 1.05 nothing at all is drawn, not
     even a round cap. */
  .sparkle-ink path {
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1.05;
    animation: spark-ink-a var(--t) ease-in-out calc(var(--delay) + var(--k) * 0.07s) both;
  }
  .sparkle.is-b .sparkle-ink path { animation-name: spark-ink-b; }
  @keyframes spark-ink-a {
    0%   { stroke-dashoffset: 1.05; opacity: 1; }
    22%  { stroke-dashoffset: 0; opacity: 1; }
    42%  { stroke-dashoffset: 0; opacity: 1; }
    43%  { stroke-dashoffset: 1.05; opacity: 1; }
    68%  { stroke-dashoffset: 0; opacity: 1; }
    74%  { stroke-dashoffset: 0; opacity: 1; }
    86%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes spark-ink-b {
    0%, 43% { stroke-dashoffset: 1.05; opacity: 1; }
    68%  { stroke-dashoffset: 0; opacity: 1; }
    74%  { stroke-dashoffset: 0; opacity: 1; }
    86%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }
  /* The brush shape fills in over the drawn line, and stays. */
  .sparkle-fill { animation: spark-fill var(--t) ease-in-out var(--delay) both; }
  @keyframes spark-fill {
    0%, 66% { opacity: 0; }
    86%, 100% { opacity: 1; }
  }

  /* The dots pop with the stars: "a" in, out, and back; "b" only for the
     second, settling with everything else. */
  .sparkle-dot { animation: spark-dot-a var(--t) ease-in-out var(--delay) both; }
  .sparkle-dot.is-b { animation-name: spark-dot-b; }
  @keyframes spark-dot-a {
    0%   { opacity: 0; transform: scale(0.3); }
    16%  { opacity: 0.9; transform: scale(1); }
    30%  { opacity: 0.9; transform: scale(1); }
    40%  { opacity: 0; transform: scale(0.5); }
    50%  { opacity: 0; transform: scale(0.4); }
    66%  { opacity: 0.9; transform: scale(1.1); }
    86%, 100% { opacity: var(--rest); transform: scale(1); }
  }
  @keyframes spark-dot-b {
    0%, 50% { opacity: 0; transform: scale(0.3); }
    68%  { opacity: 0.9; transform: scale(1.1); }
    86%, 100% { opacity: var(--rest); transform: scale(1); }
  }
  /* On the home page, once the intro has settled, each star and dot keeps
     slowly fading out and back in, on its own offset (--d) so they never
     blink together. */
  .sparkles-home .sparkle, .sparkles-home .sparkle-dot {
    --breathe: 7s;
    animation:
      var(--intro, spark-wrap-a) var(--t) ease-in-out var(--delay) both,
      spark-breathe var(--breathe) ease-in-out calc(var(--t) + var(--delay) + var(--d) * 2.6) infinite;
  }
  .sparkles-home .sparkle.is-b { --intro: spark-wrap-b; }
  .sparkles-home .sparkle-dot { --intro: spark-dot-a; }
  .sparkles-home .sparkle-dot.is-b { --intro: spark-dot-b; }
  @keyframes spark-breathe {
    0%, 100% { opacity: var(--rest); transform: none; }
    40%      { opacity: 0; transform: scale(0.7) rotate(-8deg); }
    55%      { opacity: 0; transform: scale(0.7) rotate(-8deg); }
  }

  /* The shimmer: a faint rainbow band that crosses once, as they settle. */
  .sparkles-sweep {
    position: absolute; top: -20%; bottom: -20%; left: 0; width: 45%;
    background: linear-gradient(100deg,
      transparent 0%, rgba(255, 216, 77, 0.0) 15%, rgba(255, 216, 77, 0.16) 35%,
      rgba(255, 181, 154, 0.16) 50%, rgba(106, 62, 236, 0.11) 65%, transparent 85%);
    filter: blur(18px);
    transform: translateX(-120%) skewX(-12deg);
    opacity: 0;
    animation: sweep 1.1s ease-in-out 1.7s forwards;
  }
  @keyframes sweep {
    0% { opacity: 0; transform: translateX(-120%) skewX(-12deg); }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { opacity: 0; transform: translateX(260%) skewX(-12deg); }
  }
  @media (max-width: 720px) {
    .sparkle, .sparkle-dot { left: var(--mx); top: var(--my); }
    /* A touch larger than before, so the drawing reads on a phone. */
    .sparkle { width: calc(var(--ms) * 1.2); height: calc(var(--ms) * 1.2); }
    .sparkle-dot { width: calc(var(--s) * 0.7); height: calc(var(--s) * 0.7); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sparkle, .sparkle-dot, .sparkle-fill,
    .sparkles-home .sparkle, .sparkles-home .sparkle-dot { animation: none; transform: none; }
    .sparkle, .sparkle-dot { opacity: var(--rest); }
    .sparkle-fill { opacity: 1; }
    .sparkle-ink { display: none; }
    .sparkles-sweep { display: none; }
  }
</style>
