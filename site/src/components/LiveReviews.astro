---
/** Guest reviews Jirel published from her review emails (functions
 *  publicReviews), fetched in the browser, so a review shows on the host's
 *  page and on each of their workshop pages the moment she clicks Publish. */
import { functionsBase } from '../data/firebase.ts';
import type { Lang } from '../lib/url.ts';

interface Props { slug: string; lang: Lang; title?: boolean }
const { slug, lang, title = true } = Astro.props;
const heading = title ? (lang === 'de' ? 'Was Gäste sagen' : 'What guests say') : '';
---

<div class="host-reviews-live" data-live-reviews={slug} data-endpoint={`${functionsBase}/publicReviews`} data-lang={lang} data-title={heading} hidden></div>

<script is:inline>
  (() => {
    const box = document.querySelector('[data-live-reviews]');
    if (!box) return;
    const esc = (v) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    const de = box.dataset.lang === 'de';
    fetch(`${box.dataset.endpoint}?h=${encodeURIComponent(box.dataset.liveReviews)}`)
      .then((r) => (r.ok ? r.json() : { items: [] }))
      .then(({ items }) => {
        if (!items || !items.length) return;
        const month = (ym) => new Date(`${ym}-01T12:00:00Z`).toLocaleDateString(de ? 'de-DE' : 'en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
        const guest = de ? 'Twiggli-Gast' : 'Twiggli guest';
        box.innerHTML = (box.dataset.title ? `<p class="host-about-title">${esc(box.dataset.title)}</p>` : '') + items.map((r) => `
          <blockquote class="host-review-card">
            <div class="hr-stars" aria-label="${r.stars} / 5">${'★'.repeat(r.stars)}${'☆'.repeat(5 - r.stars)}</div>
            <p>“${esc(r.text)}”</p>
            <div class="hr-meta">${[r.name || guest, r.workshop, r.month && month(r.month)].filter(Boolean).map(esc).join(' · ')}</div>
          </blockquote>`).join('');
        box.hidden = false;
      })
      .catch(() => {});
  })();
</script>
