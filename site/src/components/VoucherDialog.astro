---
/**
 * The voucher request form (data/vouchers.ts). Every voucher button, badge
 * link and gift box on the site opens it: a host's voucher (data-voucher=
 * "host", with -host, -title, -price per person and -people) or a general
 * Twiggli voucher (data-voucher="general", with -amount). There is no
 * payment system yet, so — like the booking form (BookingDialog.astro) — it
 * lands in our inbox through FormSubmit, as "Voucher request", and Jirel
 * sends the payment link and the PDF by hand.
 *
 * Every trigger is a real link to the voucher page, so without scripts it
 * still goes somewhere useful.
 */
import { voucherCopy, voucherAmounts, VOUCHER_MIN, VOUCHER_MAX_PEOPLE, VOUCHER_YEARS, GENERAL_VOUCHER_HOST, stripeVoucherLink, voucherCheckout, voucherPayment, checkoutPath } from '../data/vouchers.ts';
import { contactEmail, requestEmail } from '../data/site.ts';
import type { Lang } from '../lib/url.ts';
import '../styles/vouchers.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = voucherCopy[lang];
const people = Array.from({ length: VOUCHER_MAX_PEOPLE }, (_, i) => i + 1);
---

<dialog
  class="book-dialog vc-dialog"
  data-voucher-dialog
  data-inbox={requestEmail}
  data-contact={contactEmail}
  data-lang={lang}
  data-years={VOUCHER_YEARS}
  data-general-host={GENERAL_VOUCHER_HOST}
  data-stripe-live={JSON.stringify(stripeVoucherLink.live)}
  data-stripe-test={JSON.stringify(stripeVoucherLink.test)}
  data-checkout={JSON.stringify(voucherCheckout)}
  data-payment={JSON.stringify({ url: voucherPayment.url, live: voucherPayment.live, page: checkoutPath(lang) })}
  data-copy={JSON.stringify(c)}
>
  <button type="button" class="book-close" data-vc-close aria-label={c.close}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
  </button>
  <div class="book-scroll">
  <form class="book-form" data-vc-form novalidate>
    <h2 class="book-title" data-vc-heading>{c.formTitle} <span aria-hidden="true">🎁</span></h2>
    <div class="book-summary vc-summary">
      <p class="book-workshop" data-vc-what></p>
      <p class="book-when" data-vc-valid></p>
    </div>
    <p class="book-lede" data-vc-lede>{c.formLede}</p>
    <div class="book-fields">
      {/* A host's voucher: how many places; the amount follows. */}
      <label class="book-field" data-vc-people-field>
        <span>{c.people}</span>
        <select name="people" class="vc-select">
          {people.map((n) => <option value={n}>{n === 1 ? c.onePerson : c.nPeople.replace('{n}', String(n))}</option>)}
        </select>
      </label>
      <div class="book-field vc-amount-field" data-vc-total-field>
        <span>{c.amount}</span>
        <output class="vc-total" data-vc-total aria-live="polite"></output>
      </div>
      {/* A general voucher: one of the fixed amounts, or one of their own. */}
      <fieldset class="book-field book-field-wide book-often" data-vc-amounts hidden>
        <legend>{c.pick}</legend>
        <div class="book-often-chips">
          {voucherAmounts.map((a) => (
            <label><input type="radio" name="pick" value={a} /><span>€{a}</span></label>
          ))}
          <label><input type="radio" name="pick" value="wish" /><span>{c.wish}</span></label>
        </div>
      </fieldset>
      <label class="book-field book-field-wide" data-vc-wish hidden>
        <span>{c.wish} (€)</span>
        <input name="wish" type="number" min={VOUCHER_MIN} max="2000" step="1" inputmode="numeric" placeholder={c.wishHint} />
      </label>
      <label class="book-field book-field-wide" data-vc-buyer>
        <span>{c.buyerName}</span>
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label class="book-field book-field-wide" data-vc-buyer>
        <span>{c.buyerEmail}</span>
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label class="book-field book-field-wide" data-vc-buyer>
        <span>{c.recipient} <em>({c.optional})</em></span>
        <input name="recipient" type="text" autocomplete="off" />
      </label>
      <label class="book-field book-field-wide" data-vc-buyer>
        <span>{c.message} <em>({c.optional})</em></span>
        <textarea name="message" rows="3" placeholder={c.messagePh}></textarea>
      </label>
      <fieldset class="book-field book-field-wide book-often" data-vc-buyer>
        <legend>{c.delivery}</legend>
        <div class="book-often-chips">
          <label><input type="radio" name="delivery" value="me" checked /><span>{c.toMe}</span></label>
          <label><input type="radio" name="delivery" value="them" /><span>{c.toThem}</span></label>
        </div>
      </fieldset>
      <label class="book-field book-field-wide" data-vc-their-email hidden>
        <span>{c.recipientEmail}</span>
        <input name="recipientEmail" type="email" autocomplete="off" />
      </label>
      <input class="book-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
    </div>
    <p class="book-error" data-vc-error hidden></p>
    <button type="submit" class="btn btn-primary book-send vc-send" data-vc-send>{c.send}</button>
  </form>
  <div class="book-sent" data-vc-sent hidden>
    <h2 class="book-title" data-vc-sent-title>{c.sentTitle} <span aria-hidden="true">🎁</span></h2>
    <p class="book-lede" data-vc-sent-body>{c.sentBody}</p>
    {/* Stripe step (data/vouchers.ts stripeVoucherLink): shown when a link is on. */}
    <a class="btn btn-primary vc-pay" data-vc-pay href="#" hidden></a>
    <button type="button" class="btn btn-primary" data-vc-close data-vc-done>{c.close}</button>
  </div>
  </div>
</dialog>

<script>
  import { looksLikeBot } from '../lib/honey.ts';
  import { track } from '../lib/track.ts';

  // The gift box's chips (VoucherBox.astro): picking 1 or 2 people sets
  // how many places its "Buy a voucher" button asks for.
  document.addEventListener('click', (event) => {
    const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-vc-chip]');
    if (!chip) return;
    const box = chip.closest<HTMLElement>('[data-vc-box]');
    box?.querySelectorAll<HTMLButtonElement>('[data-vc-chip]').forEach((b) => b.setAttribute('aria-pressed', String(b === chip)));
    const buy = box?.querySelector<HTMLElement>('[data-vc-buy]');
    if (buy) buy.dataset.voucherPeople = chip.dataset.vcChip;
  });

  const dialog = document.querySelector<HTMLDialogElement>('[data-voucher-dialog]');
  const form = dialog?.querySelector<HTMLFormElement>('[data-vc-form]');
  if (dialog && form) {
    const copy = JSON.parse(dialog.dataset.copy || '{}');
    const inbox = dialog.dataset.inbox ?? '';
    const $ = <T extends HTMLElement>(sel: string) => dialog.querySelector<T>(sel);
    const heading = $('[data-vc-heading]');
    const what = $('[data-vc-what]');
    const valid = $('[data-vc-valid]');
    const lede = $('[data-vc-lede]');
    const peopleField = $('[data-vc-people-field]');
    const totalField = $('[data-vc-total-field]');
    const total = $<HTMLOutputElement>('[data-vc-total]');
    const amounts = $('[data-vc-amounts]');
    const wishField = $('[data-vc-wish]');
    const theirEmail = $('[data-vc-their-email]');
    const error = $('[data-vc-error]');
    const send = $<HTMLButtonElement>('[data-vc-send]');
    const sent = $('[data-vc-sent]');
    const people = form.querySelector<HTMLSelectElement>('select[name="people"]')!;
    const wish = form.querySelector<HTMLInputElement>('input[name="wish"]')!;
    const theirEmailInput = form.querySelector<HTMLInputElement>('input[name="recipientEmail"]')!;
    const picks = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="pick"]'));
    const deliveries = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="delivery"]'));
    let picked: DOMStringMap = {};

    // Stripe: the live link for everyone once it is set; until then the
    // test link only for a visit that came in with ?stripetest=1.
    const params = new URLSearchParams(location.search);
    try { if (params.get('stripetest') === '1') sessionStorage.setItem('twiggli-stripe-test', '1'); } catch { /* blocked */ }
    let testing = params.get('stripetest') === '1';
    try { testing = testing || sessionStorage.getItem('twiggli-stripe-test') === '1'; } catch { /* blocked */ }
    type Links = { custom: string; fixed: Record<string, string> };
    const parse = (v?: string): Links => { try { return JSON.parse(v || '{}'); } catch { return { custom: '', fixed: {} }; } };
    const live = parse(dialog.dataset.stripeLive);
    // Our own checkout wins over the Payment Links once it is configured.
    let checkout = { url: '', anonKey: '', live: false };
    try { checkout = { ...checkout, ...JSON.parse(dialog.dataset.checkout || '{}') }; } catch { /* keep off */ }
    const useCheckout = !!checkout.url && (checkout.live || testing);
    const links = useCheckout ? { custom: checkout.url, fixed: {} as Record<string, string> }
      : live.custom ? live : testing ? parse(dialog.dataset.stripeTest) : { custom: '', fixed: {} };
    const stripeUrl = links.custom || '';
    // Our own payment page (CheckoutPage.astro) wins over both: every
    // voucher button goes there, and this form stays the fallback.
    let payment = { url: '', live: false, page: '' };
    try { payment = { ...payment, ...JSON.parse(dialog.dataset.payment || '{}') }; } catch { /* keep off */ }
    const usePaymentPage = !!payment.url && !!payment.page && (payment.live || testing);
    /** The payment page for what a button stands for. */
    const paymentPageUrl = (el: HTMLElement) => {
      const u = new URL(payment.page, location.origin);
      if (el.dataset.voucher === 'host' && el.dataset.voucherSlug) {
        u.searchParams.set('host', el.dataset.voucherSlug);
        u.searchParams.set('people', String(Math.min(10, Math.max(1, Number(el.dataset.voucherPeople) || 1))));
        if (el.dataset.voucherWorkshop) u.searchParams.set('w', el.dataset.voucherWorkshop);
      } else {
        const a = Number(el.dataset.voucherAmount);
        u.searchParams.set('amount', a ? String(a) : 'wish');
      }
      return u.toString();
    };
    const toPaymentPage = (el: HTMLElement, replace = false) => {
      track('voucher-to-checkout', { host: el.dataset.voucherHost ?? 'general', amount: el.dataset.voucherAmount ?? '' });
      if (replace) location.replace(paymentPageUrl(el)); else location.href = paymentPageUrl(el);
    };
    const buyerFields = Array.from(dialog.querySelectorAll<HTMLElement>('[data-vc-buyer]'));
    /** Hands over to Stripe: the amount's own link if it has one, else the
     *  "customers choose" link. The reference ties it to the inbox note. */
    const goToStripe = async (value: number, ref: string, note: Record<string, string>) => {
      if (useCheckout) {
        if (send) { send.disabled = true; send.textContent = copy.sending; }
        try {
          const res = await fetch(checkout.url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...(checkout.anonKey ? { apikey: checkout.anonKey, Authorization: `Bearer ${checkout.anonKey}` } : {}) },
            body: JSON.stringify({
              amount: value, ref, lang: dialog.dataset.lang ?? 'de',
              host: note.Host === dialog.dataset.generalHost ? '' : note.Host,
              hostSlug: note['Host slug'] ?? '', title: note['Host slug'] ? note.Workshop ?? '' : '', people: Number(note.People) || 1,
            }),
          });
          const out = await res.json();
          if (!res.ok || !out.url) throw new Error(out.error || String(res.status));
          track('voucher-to-stripe', { host: note.Host, amount: String(value) });
          location.href = out.url;
        } catch (err) {
          if (error) { error.textContent = String(copy.error).replace('{email}', dialog.dataset.contact ?? ''); error.hidden = false; }
          if (send) { send.disabled = false; update(); }
          if (!dialog.open) dialog.showModal();
        }
        return;
      }
      const url = new URL(links.fixed?.[String(value)] || links.custom);
      url.searchParams.set('client_reference_id', ref);
      // A background note, so the inbox knows what is coming.
      try {
        fetch(`https://formsubmit.co/ajax/${inbox}`, {
          method: 'POST', keepalive: true,
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...note, 'Payment ref': ref, _subject: `Voucher checkout started: ${note.Host} — €${value}`, _template: 'table', _captcha: 'false' }),
        }).catch(() => {});
      } catch { /* no fetch */ }
      track('voucher-to-stripe', { host: note.Host, amount: String(value) });
      location.href = url.toString();
    };
    const pay = $<HTMLAnchorElement>('[data-vc-pay]');
    const sentTitle = $('[data-vc-sent-title]');
    const sentBody = $('[data-vc-sent-body]');
    const done = $<HTMLButtonElement>('[data-vc-done]');

    const general = () => picked.voucher === 'general';
    const price = () => Number(picked.voucherPrice) || 0;
    /** The voucher's value in euros, or 0 where it is not known yet. */
    const amount = () => {
      if (!general()) return price() * Number(people.value || 1);
      const p = picks.find((r) => r.checked)?.value;
      return p === 'wish' ? Math.round(Number(wish.value) || 0) : Number(p) || 0;
    };
    const update = () => {
      if (total) total.textContent = amount() ? `€${amount()}` : '—';
      if (wishField) wishField.hidden = !(general() && picks.find((r) => r.checked)?.value === 'wish');
      wish.required = !!wishField && !wishField.hidden;
      const them = deliveries.find((r) => r.checked)?.value === 'them';
      if (theirEmail) theirEmail.hidden = !them;
      theirEmailInput.required = them;
      if (stripeUrl && send && !send.disabled) send.textContent = amount() ? String(copy.payNow).replace('{amount}', `€${amount()}`) : copy.send;
      // On the "customers choose" link the buyer types the amount at Stripe.
      if (stripeUrl && lede) lede.textContent = amount() && !links.fixed?.[String(amount())]
        ? String(copy.payHint).replace('{amount}', `€${amount()}`) : copy.payLede;
    };
    people.addEventListener('change', update);
    wish.addEventListener('input', update);
    picks.forEach((r) => r.addEventListener('change', () => { update(); if (r.value === 'wish' && r.checked) wish.focus(); }));
    deliveries.forEach((r) => r.addEventListener('change', update));

    const open = (el: HTMLElement) => {
      picked = { ...el.dataset };
      const g = general();
      if (heading) heading.firstChild!.textContent = `${g ? copy.generalTitle : copy.formTitle} `;
      if (lede) lede.textContent = stripeUrl ? copy.payLede : g ? copy.generalLede : copy.formLede;
      if (what) what.textContent = g ? copy.generalTitle : [picked.voucherTitle, picked.voucherHost].filter(Boolean).join(' · ');
      if (valid) valid.textContent = g ? copy.validAny : String(copy.validAt).replace('{host}', picked.voucherHost ?? '');
      if (peopleField) peopleField.hidden = g;
      if (amounts) amounts.hidden = !g;
      // A general voucher always shows its amount; a host's only where
      // the host's price is known.
      if (totalField) totalField.hidden = !g && !price();
      if (totalField) totalField.classList.toggle('book-field-wide', g);
      people.value = String(Math.min(10, Math.max(1, Number(picked.voucherPeople) || 1)));
      picks.forEach((r) => { r.checked = r.value === (picked.voucherAmount || '50'); r.required = g; });
      if (!g) picks.forEach((r) => { r.checked = false; });
      wish.value = '';
      if (error) error.hidden = true;
      form.hidden = false;
      if (sent) sent.hidden = true;
      if (send) { send.disabled = false; send.textContent = copy.send; }
      buyerFields.forEach((f) => {
        f.hidden = !!stripeUrl;
        f.querySelectorAll<HTMLInputElement>('input, textarea').forEach((i) => { if (i.name === 'name' || i.name === 'email') i.required = !stripeUrl; });
      });
      update();
      // A button inside another panel (the group page's quick view) hands
      // over to this form rather than stacking it on top.
      document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => { if (d !== dialog) d.close(); });
      dialog.showModal();
      (g ? form.querySelector<HTMLInputElement>('input[name="pick"]:checked') : people)?.focus();
      track('voucher-open', { host: picked.voucherHost ?? 'general', lang: dialog.dataset.lang ?? '' });
    };

    document.addEventListener('click', (event) => {
      const el = (event.target as HTMLElement).closest<HTMLElement>('[data-voucher]');
      if (!el) return;
      event.preventDefault();
      event.stopPropagation();
      if (usePaymentPage) { toPaymentPage(el); return; }
      // One click to Stripe: a general voucher at an amount with its own link.
      const fixedAmount = Number(el.dataset.voucherAmount);
      if (el.dataset.voucher === 'general' && fixedAmount && (useCheckout || links.fixed?.[String(fixedAmount)])) {
        goToStripe(fixedAmount, `vc-${Date.now().toString(36)}`, {
          Type: 'Voucher checkout', Host: dialog.dataset.generalHost ?? '', Amount: `€${fixedAmount}`,
          'Sent from': location.href, Language: dialog.dataset.lang ?? '',
        });
        return;
      }
      open(el);
    }, true);
    dialog.querySelectorAll('[data-vc-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });

    // The voucher page's own amount cards open the form at that amount;
    // a ?host= or ?amount= link (the no-script fallback) opens it too.
    const q = new URLSearchParams(location.search);
    const linked = q.get('host') ? document.querySelector<HTMLElement>(`[data-voucher-slug="${CSS.escape(q.get('host')!)}"]`)
      : q.get('amount') ? document.querySelector<HTMLElement>(`[data-voucher="general"][data-voucher-amount="${CSS.escape(q.get('amount')!)}"]`)
      : null;
    if (linked) { if (usePaymentPage) toPaymentPage(linked, true); else open(linked); }

    // Back from Stripe (its "after payment" redirect adds ?danke=1).
    if (q.get('danke') === '1' && sent && sentTitle && sentBody) {
      form.hidden = true;
      sent.hidden = false;
      sentTitle.textContent = copy.paidTitle;
      sentBody.textContent = copy.paidBody;
      if (pay) pay.hidden = true;
      if (done) done.hidden = false;
      dialog.showModal();
      track('voucher-paid-return', {});
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      if (looksLikeBot(data)) return;
      const g = general();
      const value = amount();
      if (g && value < Number(wish.min || 20)) { wish.focus(); wish.reportValidity(); return; }
      const them = data.get('delivery') === 'them';
      let cameFrom = 'unknown';
      try { cameFrom = sessionStorage.getItem('twiggli-came-from') || 'unknown'; } catch { /* blocked */ }
      const host = g ? (dialog.dataset.generalHost ?? '') : (picked.voucherHost ?? '');
      const fields: Record<string, string> = {
        Type: 'Voucher request',
        Host: host,
        Workshop: g ? 'Any workshop at a host taking vouchers' : (picked.voucherTitle ?? ''),
        ...(g ? {} : { People: people.value, 'Price per person': price() ? `€${price()}` : 'not listed', 'Host slug': picked.voucherSlug ?? '' }),
        Amount: value ? `€${value}` : 'to be quoted',
        Name: String(data.get('name') ?? ''),
        Email: String(data.get('email') ?? ''),
        Recipient: String(data.get('recipient') ?? ''),
        'Personal message': String(data.get('message') ?? ''),
        Delivery: them ? 'Directly to the recipient' : 'PDF by email to the buyer',
        ...(them ? { 'Recipient email': String(data.get('recipientEmail') ?? '') } : {}),
        Valid: `${dialog.dataset.years} years`,
        'Sent from': location.href,
        'Came from': cameFrom,
        Language: dialog.dataset.lang ?? '',
      };
      // Matches this request to its Stripe payment (client_reference_id).
      const ref = `vc-${Date.now().toString(36)}`;
      if (stripeUrl) fields['Payment ref'] = ref;
      const subject = `Voucher request: ${host}${g ? '' : ` · ${picked.voucherTitle ?? ''} (${people.value})`} — ${fields.Amount}`;
      if (send) { send.disabled = true; send.textContent = copy.sending; }
      const post = () => {
        // FormSubmit can hang for a long time; give up after 12 s.
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 12000);
        return fetch(`https://formsubmit.co/ajax/${inbox}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          // "email" (lower case) is the field FormSubmit replies to.
          body: JSON.stringify({
            ...Object.fromEntries(Object.entries(fields).filter(([k]) => k !== 'Email')),
            email: fields.Email, _subject: subject, _template: 'table', _captcha: 'false',
          }),
          signal: ctrl.signal,
          keepalive: true,
        }).then((res) => { if (!res.ok) throw new Error(String(res.status)); }).finally(() => clearTimeout(timer));
      };
      const showSent = () => {
        form.hidden = true;
        if (sent) sent.hidden = false;
        if (pay) pay.hidden = true;
        if (done) done.hidden = false;
      };

      // With Stripe on, the form only settled the amount: off to Stripe,
      // which asks name, email, card and the recipient itself.
      if (stripeUrl && value) {
        goToStripe(value, ref, Object.fromEntries(Object.entries(fields).filter(([, v]) => v)));
        return;
      }

      try {
        await post();
        track('voucher-sent', { host, amount: String(value), lang: dialog.dataset.lang ?? '' });
        showSent();
        form.reset();
      } catch {
        if (error) {
          error.textContent = String(copy.error).replace('{email}', dialog.dataset.contact ?? '');
          error.hidden = false;
        }
        if (send) { send.disabled = false; send.textContent = copy.send; }
        const body = Object.entries(fields).filter(([, v]) => v).map(([k, v]) => `${k}: ${v}`).join('\n');
        location.href = `mailto:${dialog.dataset.contact}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      }
    });
  }
</script>
