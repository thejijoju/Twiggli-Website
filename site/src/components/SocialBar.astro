---
import SocialIcon from './SocialIcon.astro';
import { getSiteData } from '../data/site.ts';
import { DEFAULT_LANG, type Lang } from '../lib/url.ts';

/** The dark social strip. Sits above the nav, at the very top of the page. */
interface Props {
  lang?: Lang;
}
const { lang = DEFAULT_LANG } = Astro.props;
const { socialLinks } = getSiteData(lang);
---

<div class="social-bar">
  <div class="social-bar-icons">
    {/* Live accounts open in a new tab; the '#' placeholders must not. */}
    {socialLinks.map((s) => (
      <a
        href={s.href}
        aria-label={s.label}
        target={s.href.startsWith('http') ? '_blank' : undefined}
        rel={s.href.startsWith('http') ? 'noopener' : undefined}
      ><SocialIcon name={s.icon} /></a>
    ))}
  </div>
</div>
