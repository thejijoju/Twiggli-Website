---
import SocialIcon from './SocialIcon.astro';
import { getSiteData } from '../data/site.ts';
import { voucherCopy, VOUCHERS_ON } from '../data/vouchers.ts';
import { authCopy } from '../data/auth.ts';
import { DEFAULT_LANG, href, type Lang } from '../lib/url.ts';

/** The dark social strip. Sits above the nav, at the very top of the page. */
interface Props {
  lang?: Lang;
}
const { lang = DEFAULT_LANG } = Astro.props;
const { socialLinks } = getSiteData(lang);
---

<div class="social-bar">
  <div class="social-bar-icons">
    {/* Live accounts open in a new tab; the '#' placeholders must not. */}
    {socialLinks.map((s) => (
      <a
        href={s.href}
        aria-label={s.label}
        target={s.href.startsWith('http') ? '_blank' : undefined}
        rel={s.href.startsWith('http') ? 'noopener' : undefined}
      ><SocialIcon name={s.icon} /></a>
    ))}
    {/* Gift vouchers (VoucherPage.astro), on every page and every screen. */}
    {VOUCHERS_ON && <a class="social-bar-gift" href={href(lang, '/voucher/')}>{voucherCopy[lang].nav}</a>}
    {/* The strip's right edge: "Get app", then Sign in (SignInDialog.astro),
        Luma-style. On a phone both join the row as round icons after the
        voucher pill (.social-bar-end turns into display: contents); the
        labels stay for screen readers through aria-label.
        Get app goes nowhere yet: a plain button with no action, and
        data-get-app is the hook to wire it to the stores later.
        data-signin-pill is where the signed-in initial will go
        (lib/auth.ts getUser). */}
    <div class="social-bar-end">
      <button type="button" class="social-bar-getapp" data-get-app aria-label={authCopy[lang].getAppAria}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="2.75" width="11" height="18.5" rx="2.5" /><path d="M10.5 18h3" /></svg>
        <span class="social-bar-getapp-label">{authCopy[lang].getApp}</span>
      </button>
      <button type="button" class="social-bar-signin" data-signin data-signin-pill aria-haspopup="dialog" aria-label={authCopy[lang].signInAria}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.6" /><path d="M5 20c.6-3.6 3.4-5.8 7-5.8s6.4 2.2 7 5.8" /></svg>
        <span class="social-bar-signin-label" data-signin-label>{authCopy[lang].signIn}</span>
      </button>
    </div>
  </div>
</div>
