---
import Base from '../layouts/Base.astro';
import HostDirectory from './HostDirectory.astro';
import HostFilters from './HostFilters.astro';
import { getHosts, sameHostAs } from '../data/content.ts';
import { seasonOf } from '../data/occasions.ts';
import { ui } from '../data/i18n.ts';
import { href, withBase, type Lang } from '../lib/url.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const c = t.corporate;
// One card per person: a host listed twice shows once, under the card
// that carries the team events.
const hosts = getHosts(lang).filter((h) => !sameHostAs[h.slug]);
// The headline follows the season of the build; the site rebuilds daily.
const season = seasonOf();
---

<Base title={c.title} description={c.description} lang={lang} pageClass="page-flush">
  {/* The headline's display serif, loaded here only — no other page pays
      for it. */}
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500&display=swap" />
  </Fragment>
  <div class="container container-directory">
    {/* Laid out like a shop's collection page: search first, the season's
        headline, occasion tags and filter pills, then the grid. */}
    <section class="dir-top">
      <HostFilters lang={lang} season={season} cta={c.cta} ctaHref={href(lang, '/contact/')} />
      <HostDirectory hosts={hosts} lang={lang} />
    </section>

    <hr class="rule" />

    {/* What the page used to open with, now after the grid: the plain
        account of how a group booking works, for the reader who scrolled
        past every host — and for search engines. */}
    <section class="page-head dir-about">
      <span class="kicker">{c.kicker}</span>
      <h2 class="page-title">{c.h1}</h2>
      <p class="page-lede">{c.lede}</p>
      <div class="hero-actions">
        <a href={href(lang, '/contact/')} class="btn btn-primary">{c.cta}</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="split split-text-first">
      <div>
        <span class="kicker kicker-tight">{t.home.hostEarnKicker}</span>
        <h2 class="split-title">{t.home.hostEarnTitle}</h2>
        <p class="split-copy">{c.hostEarnCopy}</p>
        <div class="split-actions">
          <a href={href(lang, '/host/')} class="btn btn-primary">{t.home.becomeHost}</a>
        </div>
      </div>
      <div class="media-4x3 grayscale">
        <img src={withBase('/img/hosts/dominik-wide.jpg')} alt="" loading="lazy"
             style="width:100%;height:100%;object-fit:cover" />
      </div>
    </section>
  </div>
</Base>
