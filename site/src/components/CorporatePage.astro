---
import Base from '../layouts/Base.astro';
import HostDirectory from './HostDirectory.astro';
import HostFilters from './HostFilters.astro';
import Newsletter from './Newsletter.astro';
import { bookingCopy } from '../data/bookingCopy.ts';
import { getHosts, hasMedia, sameHostAs } from '../data/content.ts';
import { seasonOf } from '../data/occasions.ts';
import { ui } from '../data/i18n.ts';
import { href, withBase, type Lang } from '../lib/url.ts';
import { christmasCopy } from '../data/christmasParty.ts';
import { bigEventsCopy } from '../data/bigEvents.ts';
import { COMPANY_KINDS, companyCopy, companyHref } from '../data/companyAnswers.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const c = t.corporate;
// One card per person: a host listed twice shows once, under the card
// that carries the team events.
// Only hosts we can show: a card with nothing but a monogram sells nobody.
const hosts = getHosts(lang).filter((h) => !sameHostAs[h.slug] && hasMedia(h));
// The headline follows the season of the build; the site rebuilds daily.
const season = seasonOf();
// In the Christmas season the page points to the Christmas-party page,
// which exists in English and German.
const xmas = season === 'christmas' ? christmasCopy[lang === 'de' ? 'de' : 'en'] : undefined;
const xmasHref = href(lang === 'de' ? 'de' : 'en', '/weihnachtsfeier/');
// A big event with several hosts, and a request for anything not listed:
// both open the booking form with every host on the page to pick from.
const big = bigEventsCopy[lang];
const pickable = JSON.stringify(hosts.map((h) => `${h.firstName ?? h.name} · ${h.specialty}`));

// Team vouchers (Jirel 20.11.26): a Christmas gift for employees, up to 50 € tax-free.
const VC = {
  de: { kicker: 'Für euer Team', title: 'Twiggli-Gutscheine als Weihnachtsgeschenk', copy: 'Ein Workshop, den sich jede*r selbst aussucht: Töpfern, Kerzen gießen, Siebdruck, Kochen und vieles mehr bei Berliner Hosts. Gutscheine bis 50 € pro Mitarbeitende*r und Monat sind steuerfrei.', points: ['Eine Rechnung auf eure Firma', 'Gutschein als PDF, auf Wunsch mit Namen und Gruß', '3 Jahre gültig, einlösbar bei allen teilnehmenden Hosts'], cta: 'Gutscheine anfragen', cta2: 'Zur Gutscheinseite', note: 'Keine Steuerberatung: Bitte stimmt die steuerliche Behandlung mit eurer Steuerberatung ab.' },
  en: { kicker: 'For your team', title: 'Twiggli vouchers as a Christmas gift', copy: 'A workshop everyone picks for themselves: pottery, candle making, screen printing, cooking and much more with Berlin hosts. Vouchers up to €50 per employee per month are tax-free.', points: ['One invoice to your company', 'Voucher as a PDF, with a name and message if you like', 'Valid for 3 years, redeemable at all participating hosts'], cta: 'Request vouchers', cta2: 'See vouchers', note: 'Not tax advice: please check the tax treatment with your tax advisor.' },
  fr: { kicker: 'Pour votre équipe', title: 'Des bons Twiggli comme cadeau de Noël', copy: 'Un atelier que chacun choisit soi-même : poterie, bougies, sérigraphie, cuisine et bien plus avec des hôtes berlinois. Les bons jusqu’à 50 € par salarié et par mois sont exonérés d’impôt (en Allemagne).', points: ['Une facture au nom de votre entreprise', 'Bon en PDF, avec un nom et un message si vous voulez', 'Valable 3 ans, chez tous les hôtes participants'], cta: 'Demander des bons', cta2: 'Voir les bons', note: 'Pas un conseil fiscal : merci de vérifier avec votre conseiller fiscal.' },
};
const vc = VC[lang as 'de' | 'en' | 'fr'] ?? VC.en;---

<Base title={c.title} description={c.description} lang={lang} pageClass="page-flush">
  {/* The headline's display serif, loaded here only — no other page pays
      for it. */}
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500&display=swap" />
  </Fragment>
  <div class="container container-directory">
    {/* Laid out like a shop's collection page: search first, the season's
        headline, occasion tags and filter pills, then the grid. */}
    {xmas && (
      <div class="xmas-banner">
        <p><span>{xmas.kicker}</span>{xmas.banner}</p>
        <a class="btn btn-primary" href={xmasHref}>{xmas.bannerCta}</a>
      </div>
    )}
    <section class="dir-top">
      <HostFilters lang={lang} season={season} cta={c.cta} ctaHref={href(lang, '/contact/')} ctaTitle={bookingCopy[lang].anyHost} />
      {/* Before the grid, so nobody scrolls fifty hosts to learn it: one
          host is not the limit, and neither is the list. */}
      <div class="big-strip">
        <p><strong>{big.title}.</strong> {big.points[1]}</p>
        <div class="big-strip-actions">
          <a class="btn btn-primary" href={href(lang, '/contact/')} data-book="event" data-book-title={big.title} data-book-hosts={pickable}>{big.cta}</a>
          <a class="btn btn-secondary" href={href(lang, '/contact/')} data-book="special" data-book-title={big.specialKicker} data-book-hosts={pickable}>{big.specialCta}</a>
        </div>
      </div>
      <HostDirectory hosts={hosts} lang={lang} />
    </section>

    {/* Several hosts in one evening, for the big events a single studio
        cannot take, and the open request for whatever is not listed. */}
    <section class="big-events" id="big-events">
      <div class="big-events-main">
        <span class="kicker">{big.kicker}</span>
        <h2 class="split-title">{big.title}</h2>
        <p class="split-copy">{big.copy}</p>
        <ul class="big-points">
          {big.points.map((point) => <li>{point}</li>)}
        </ul>
        <p class="big-occasions-label">{big.occasionsLabel}</p>
        <ul class="big-occasions">
          {big.occasions.map((o) => <li>{o}</li>)}
        </ul>
        <a class="btn btn-primary" href={href(lang, '/contact/')} data-book="event" data-book-title={big.title} data-book-hosts={pickable}>{big.cta}</a>
      </div>
      <div class="big-special">
        <h3>{big.specialKicker}</h3>
        <p>{big.specialCopy}</p>
        <a class="btn btn-secondary" href={href(lang, '/contact/')} data-book="special" data-book-title={big.specialKicker} data-book-hosts={pickable}>{big.specialCta}</a>
      </div>
    </section>

    {/* The two questions a company planning something big asks first,
        answered in the open and handed to search engines as an FAQ. */}
    <section class="big-faq">
      {big.faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: big.faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
    })} />

    {/* Vouchers as a Christmas gift for the team (Jirel 20.11.26: up to 50 € per employee tax-free). */}
    <section class="team-vouchers" id="gutscheine">
      <div>
        <span class="kicker">{vc.kicker}</span>
        <h2 class="split-title">{vc.title}</h2>
        <p class="split-copy">{vc.copy}</p>
        <ul class="big-points">{vc.points.map((x) => <li>{x}</li>)}</ul>
        <div class="split-actions">
          <a class="btn btn-primary" href={href(lang, '/contact/')} data-book="special" data-book-title={vc.title} data-book-hosts={pickable}>{vc.cta}</a>
          <a class="btn btn-secondary" href={href(lang, lang === 'de' ? '/gutschein/' : '/voucher/')}>{vc.cta2}</a>
        </div>
        <p class="team-vouchers-note">{vc.note}</p>
      </div>
      <img class="team-vouchers-img" src={lang === 'de' ? '/img/team-voucher-de.jpg' : '/img/team-voucher-en.jpg'} alt={vc.title} width="662" height="936" loading="lazy" decoding="async" />
    </section>

    {(lang === 'en' || lang === 'de') && (
      <ul class="activity-links">
        {COMPANY_KINDS.map((k) => <li><a href={companyHref(lang, k)}>{companyCopy(k, lang).h1}</a></li>)}
      </ul>
    )}

    <hr class="rule" />

    {/* What the page used to open with, now after the grid: the plain
        account of how a group booking works, for the reader who scrolled
        past every host — and for search engines. */}
    <section class="page-head dir-about">
      <span class="kicker">{c.kicker}</span>
      <h2 class="page-title">{c.h1}</h2>
      <p class="page-lede">{c.lede}</p>
      <div class="hero-actions">
        <a href={href(lang, '/contact/')} class="btn btn-primary" data-book="group" data-book-title={bookingCopy[lang].anyHost}>{c.cta}</a>
      </div>
    </section>

    {/* News for companies and groups, on its own list. */}
    <Newsletter lang={lang} audience="teams" />

    <section class="split split-text-first">
      <div>
        <span class="kicker kicker-tight">{t.home.hostEarnKicker}</span>
        <h2 class="split-title">{t.home.hostEarnTitle}</h2>
        <p class="split-copy">{c.hostEarnCopy}</p>
        <div class="split-actions">
          <a href={href(lang, '/host/')} class="btn btn-primary">{t.home.becomeHost}</a>
        </div>
      </div>
      <div class="media-4x3 grayscale">
        <img src={withBase('/img/hosts/dominik-wide.jpg')} alt="" loading="lazy"
             style="width:100%;height:100%;object-fit:cover" />
      </div>
    </section>
  </div>
</Base>
