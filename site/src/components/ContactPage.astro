---
import Base from '../layouts/Base.astro';
import SocialIcon from './SocialIcon.astro';
import { contactEmail, getSiteData, requestEmail } from '../data/site.ts';
import { formEndpoint } from '../data/firebase.ts';
import { ui } from '../data/i18n.ts';
import type { Lang } from '../lib/url.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang).contact;
const { socialLinks } = getSiteData(lang);

/* The message goes straight to our inbox through FormSubmit, like the
   booking form (BookingDialog.astro); only if that service cannot be
   reached is it handed to the visitor's mail app instead. The wording of
   the mail travels with the form as data attributes, so the script below
   is the same in every language. */
const formCopy: Record<Lang, { note: string; sent: string; sending: string; error: string }> = {
  en: { note: 'We reply by email, usually within a day.', sent: 'Thank you! Your message is on its way, and we’ll reply by email soon.', sending: 'Sending…', error: 'That didn’t go through, so we’ve opened it in your mail app instead.' },
  de: { note: 'Wir antworten per E-Mail, meist innerhalb eines Tages.', sent: 'Danke! Deine Nachricht ist unterwegs, wir melden uns bald per E-Mail.', sending: 'Wird gesendet…', error: 'Das hat nicht geklappt, deshalb haben wir sie in deinem Mailprogramm geöffnet.' },
  fr: { note: 'Nous répondons par e-mail, en général sous 24 heures.', sent: 'Merci ! Votre message est parti, nous vous répondrons bientôt par e-mail.', sending: 'Envoi…', error: 'L’envoi a échoué, nous l’avons donc ouvert dans votre messagerie.' },
  es: { note: 'Respondemos por e-mail, normalmente en un día.', sent: '¡Gracias! Tu mensaje está en camino y te responderemos pronto por e-mail.', sending: 'Enviando…', error: 'No se ha podido enviar, así que lo hemos abierto en tu app de correo.' },
  it: { note: 'Rispondiamo via e-mail, di solito entro un giorno.', sent: 'Grazie! Il tuo messaggio è partito, ti risponderemo presto via e-mail.', sending: 'Invio…', error: 'Non è andato a buon fine, quindi l’abbiamo aperto nella tua app di posta.' },
  nl: { note: 'We antwoorden per e-mail, meestal binnen een dag.', sent: 'Bedankt! Je bericht is onderweg, we mailen je snel terug.', sending: 'Versturen…', error: 'Dat is niet gelukt, dus we hebben het in je mailapp geopend.' },
  pl: { note: 'Odpowiadamy mailowo, zwykle w ciągu doby.', sent: 'Dziękujemy! Wiadomość została wysłana, wkrótce odpiszemy mailowo.', sending: 'Wysyłanie…', error: 'Nie udało się wysłać, więc otworzyliśmy ją w twojej aplikacji pocztowej.' },
  tr: { note: 'E-postayla, genellikle bir gün içinde yanıt veriyoruz.', sent: 'Teşekkürler! Mesajın yola çıktı, yakında e-postayla yanıt vereceğiz.', sending: 'Gönderiliyor…', error: 'Gönderilemedi, bu yüzden e-posta uygulamanda açtık.' },
};
const f = formCopy[lang];
const mailCopy = {
  corporateTopic: t.topics[1],
  subjectCorporate: t.subjectCorporate,
  subjectGeneral: t.subjectGeneral,
  ...t.bodyLabels,
};
---

<Base title={t.title} description={t.description} lang={lang}>
  <div class="container">
    <section class="page-head">
      <span class="kicker">{t.kicker}</span>
      <h1 class="page-title">{t.h1}</h1>
      <p class="page-lede">{t.lede}</p>
    </section>

    <hr class="rule" />

    <section class="section">
      <div class="form-grid">
        <form
          class="form-rows"
          method="post"
          action="#"
          data-request-form
          data-request-email={contactEmail}
          data-inbox={requestEmail} data-endpoint={formEndpoint}
          data-sending={f.sending}
          data-error={f.error}
          data-mail-copy={JSON.stringify(mailCopy)}
          data-prefill={t.prefill('{host}')}
          data-prefill-space={t.prefillSpace('{host}')}
          data-prefill-retreat={t.prefillRetreat('{host}')}
        >
          <div class="field">
            <label for="name">{t.name}</label>
            <input class="input" type="text" id="name" name="name" required />
          </div>
          <div class="field">
            <label for="email">{t.email}</label>
            <input class="input" type="email" id="email" name="email" required />
          </div>
          <div class="field">
            <label for="topic">{t.topic}</label>
            <select class="input" id="topic" name="topic">
              {t.topics.map((topic, i) => <option data-corporate={i === 1 ? 'true' : undefined}>{topic}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="message">{t.message}</label>
            <textarea class="input" id="message" name="message" rows="5" required></textarea>
          </div>
          <div>
            <button type="submit" class="btn btn-primary">{t.send}</button>
            <p class="form-note" data-request-note>{f.note}</p>
            <p class="form-note form-note-sent" data-request-sent hidden>{f.sent}</p>
            <p class="form-note" data-request-error hidden>{f.error}</p>
          </div>
        </form>

        <div class="form-aside">
          <span class="kicker kicker-tight">{t.elsewhereKicker}</span>
          <p>{t.elsewhere}</p>
          <div class="nav-social" style="margin-left:0">
            {socialLinks.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'noopener' : undefined}
              ><SocialIcon name={s.icon} size={20} /></a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>

  {/* "Request event" buttons on /corporatebookings/ land here with ?host=<name>: pick
      the corporate topic and start the message for the visitor. is:inline
      because it's plain DOM glue — no imports, nothing to bundle. */}
  <script is:inline>
    (() => {
      const form = document.querySelector('[data-request-form]');
      if (!form) return;
      const copy = JSON.parse(form.dataset.mailCopy || '{}');
      const params = new URLSearchParams(location.search);
      // A space enquiry (from /studio-rental/) asks about renting the room;
      // a host enquiry (from the directory) asks about an event.
      const space = params.get('space');
      // A retreat enquiry (from /retreats/) asks for a place on it.
      const retreat = params.get('retreat');
      const host = params.get('host') || space || retreat;
      if (host) {
        const topic = document.getElementById('topic');
        if (topic) topic.value = copy.corporateTopic;
        const message = document.getElementById('message');
        if (message && !message.value)
          message.value = ((retreat ? form.dataset.prefillRetreat : space ? form.dataset.prefillSpace : form.dataset.prefill) || '').replace('{host}', host);
      }

      // Submit composes the mail and opens it in the visitor's mail app. The
      // composed link is also written onto the form, so it can be checked.
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const v = (id) => (document.getElementById(id) || {}).value || '';
        const topicEl = document.getElementById('topic');
        const topic = v('topic');
        const corporate = !!host || !!(topicEl && topicEl.selectedOptions[0] && topicEl.selectedOptions[0].dataset.corporate);
        const subject = corporate
          ? `${copy.subjectCorporate}: ${host || topic} — ${v('name')}`
          : `${copy.subjectGeneral}: ${topic} — ${v('name')}`;
        const body = [`${copy.name}: ${v('name')}`, `${copy.email}: ${v('email')}`, `${copy.topic}: ${topic}`, host ? `${copy.host}: ${host}` : '', '', `${copy.message}:`, v('message')]
          .filter((line, i) => line !== '' || i === 4).join('\n');
        const mailto = `mailto:${form.dataset.requestEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        form.dataset.mailto = mailto;
        const button = form.querySelector('button[type="submit"]');
        const label = button ? button.textContent : '';
        if (button) { button.disabled = true; button.textContent = form.dataset.sending || label; }
        const show = (sel) => { const el = form.querySelector(sel); if (el) el.hidden = false; };
        fetch(form.dataset.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            Name: v('name'), email: v('email'), Topic: topic, ...(host ? { Host: host } : {}),
            Message: v('message'), 'Sent from': location.href, _subject: subject, _template: 'table', _captcha: 'false',
          }),
        }).then(async (res) => {
          // FormSubmit can answer 200 and still refuse (success: "false").
          if (!res.ok || String((await res.json().catch(() => ({}))).success) !== 'true') throw new Error(String(res.status));
          form.querySelectorAll('.field').forEach((el) => { el.hidden = true; });
          if (button) button.hidden = true;
          const note = form.querySelector('[data-request-note]');
          if (note) note.hidden = true;
          show('[data-request-sent]');
          if (window.umami) window.umami.track('request-sent', { kind: 'contact', host: host || '' });
        }).catch(() => {
          // The service is unreachable: hand the same message to the
          // visitor's mail app, so it still reaches us.
          if (button) { button.disabled = false; button.textContent = label; }
          show('[data-request-error]');
          location.href = mailto;
        });
      });
    })();
  </script>
</Base>
