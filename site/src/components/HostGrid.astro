---
import ImageSlot from './ImageSlot.astro';
import type { Host } from '../data/content.ts';
import { DEFAULT_LANG, type Lang } from '../lib/url.ts';

interface Props {
  hosts: Host[];
  /** 'grid' is the static wrapping layout (the /hosts/ directory).
   *  'carousel' is a center-focused "coverflow" reel — the active card sits
   *  large and sharp in the middle, neighbours shrink and fade toward the
   *  edges. Click a side card to bring it to centre; click the centred card
   *  to play its preview (PLACEHOLDER — no host video assets exist yet, so
   *  this just reveals a "video coming soon" state). */
  layout?: 'grid' | 'carousel';
  lang?: Lang;
}
const { hosts, layout = 'grid', lang = DEFAULT_LANG } = Astro.props;

const videoPlaceholder = {
  en: 'Video preview coming soon',
  de: 'Video-Vorschau folgt in Kürze',
}[lang];
---

{layout === 'carousel' ? (
  <div class="host-coverflow" data-host-coverflow>
    <div class="host-coverflow-spacer" aria-hidden="true"></div>
    {hosts.map((host) => (
      <div class="host-coverflow-card" tabindex="0" role="button" aria-label={`${host.name}, ${host.specialty}`}>
        <div class="host-coverflow-media">
          <ImageSlot
            src={host.photo}
            shape="rect"
            placeholder="Host reel"
            alt=""
          />
          <span class="host-coverflow-play" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
          </span>
          <div class="host-coverflow-video-placeholder">{videoPlaceholder}</div>
        </div>
        <p class="host-name">{host.name}</p>
        <p class="host-specialty">{host.specialty}</p>
      </div>
    ))}
    <div class="host-coverflow-spacer" aria-hidden="true"></div>
  </div>
) : (
  <div class="hosts-grid">
    {hosts.map((host) => (
      <div class="host">
        <div class="host-avatar grayscale">
          <ImageSlot
            src={host.photo}
            shape="circle"
            placeholder="Host photo"
            alt={host.photo ? `${host.name}, ${host.specialty}` : ''}
          />
        </div>
        <div>
          <p class="host-name">{host.name}</p>
          <p class="host-specialty">{host.specialty}</p>
        </div>
      </div>
    ))}
  </div>
)}

<script>
  // Center-focused "coverflow" carousel: on scroll, scale/fade each card by
  // its distance from the track's centre. Click a side card to snap-scroll
  // it to centre; click the already-centred card to reveal the (placeholder)
  // video state. Runs once per `.host-coverflow` instance on the page.
  function initCoverflow(track: HTMLElement) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.host-coverflow-card'));
    if (!cards.length) return;

    let raf = 0;
    const update = () => {
      const trackRect = track.getBoundingClientRect();
      const center = trackRect.left + trackRect.width / 2;
      cards.forEach((card) => {
        const r = card.getBoundingClientRect();
        const dist = Math.abs(r.left + r.width / 2 - center);
        const norm = Math.min(dist / (trackRect.width / 2 || 1), 1);
        card.style.transform = `scale(${1 - norm * 0.32})`;
        card.style.opacity = String(1 - norm * 0.7);
        card.classList.toggle('is-active', norm < 0.12);
        if (norm >= 0.12) card.classList.remove('is-playing');
      });
    };
    const onScroll = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    };
    track.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    cards.forEach((card) => {
      const activate = () => {
        if (card.classList.contains('is-active')) {
          card.classList.toggle('is-playing');
        } else {
          card.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', inline: 'center', block: 'nearest' });
        }
      };
      card.addEventListener('click', activate);
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activate();
        }
      });
    });

    update();
  }

  document.querySelectorAll<HTMLElement>('[data-host-coverflow]').forEach(initCoverflow);
</script>
