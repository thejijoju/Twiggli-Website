---
import ImageSlot from './ImageSlot.astro';
import type { Host } from '../data/content.ts';
import { getSessions } from '../data/sessions.ts';
import HostMonogram from './HostMonogram.astro';
import { DEFAULT_LANG, href, type Lang } from '../lib/url.ts';

interface Props {
  hosts: Host[];
  /** 'grid' is the static wrapping layout (the /hosts/ directory).
   *  'carousel' is a center-focused "coverflow" reel — the active card sits
   *  large and sharp in the middle, neighbours shrink and fade toward the
   *  edges. Click a side card to bring it to centre; click the centred card
   *  to play its reel. Cards without a reel yet keep the placeholder slot
   *  and a "coming soon" state. */
  layout?: 'grid' | 'carousel';
  lang?: Lang;
}
const { hosts, layout = 'grid', lang = DEFAULT_LANG } = Astro.props;

/* The carousel is a reel of reels — five of them on screen at once — so it
   only carries hosts whose footage has actually landed. A card with a still
   (or worse, a monogram) in that row reads as a gap, and the directory grid
   below is where every host belongs anyway. */
const carouselHosts = hosts.filter((host) => host.video);

/* A card's name and specialty lead to that host's next session on the
   calendar. getSessions comes back in calendar order, so the first one a
   slug appears in is the next one they teach. A host with nothing on the
   calendar — corporate-only, or between programmes — leads to their entry
   in the directory instead, which is the page that can actually answer
   "when?" for them. */
const nextSession = new Map<string, { id: string; title: string }>();
for (const s of getSessions(lang)) {
  if (!nextSession.has(s.host.slug)) nextSession.set(s.host.slug, s);
}
const hostHref = (slug: string) => {
  const next = nextSession.get(slug);
  return next
    ? `${href(lang, '/happening-today/')}#${next.id}`
    : `${href(lang, '/corporatebookings/')}#${slug}`;
};

const videoPlaceholder = {
  en: 'Video preview coming soon',
  de: 'Video-Vorschau folgt in Kürze',
}[lang];
---

{layout === 'carousel' ? (
  <div class="host-coverflow" data-host-coverflow>
    <div class="host-coverflow-spacer" aria-hidden="true"></div>
    {carouselHosts.map((host) => (
      <div
        class="host-coverflow-card"
        tabindex="0"
        role="button"
        data-has-video={host.video ? 'true' : undefined}
        aria-label={`${host.name}, ${host.specialty}`}
      >
        <div class="host-coverflow-media">
          {host.video ? (
            <video
              class="host-coverflow-video"
              src={host.video}
              poster={host.poster}
              muted
              loop
              playsinline
              preload="none"
            ></video>
          ) : host.photo ? (
            <img class="host-coverflow-still" src={host.photo} alt="" loading="lazy" decoding="async" />
          ) : (
            <HostMonogram name={host.name} />
          )}
          <span class="host-coverflow-play" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
          </span>
          {!host.video && <div class="host-coverflow-video-placeholder">{videoPlaceholder}</div>}
        </div>
        <a
          class="host-coverflow-link"
          href={hostHref(host.slug)}
          title={nextSession.get(host.slug)?.title}
        >
          <span class="host-name">{host.name}</span>
          <span class="host-specialty">{host.specialty}</span>
        </a>
      </div>
    ))}
    <div class="host-coverflow-spacer" aria-hidden="true"></div>
  </div>
) : (
  <div class="hosts-grid">
    {hosts.map((host) => (
      <div class="host">
        <div class="host-avatar grayscale">
          <ImageSlot
            src={host.photo}
            shape="circle"
            placeholder="Host photo"
            alt={host.photo ? `${host.name}, ${host.specialty}` : ''}
          />
        </div>
        <div>
          <p class="host-name">{host.name}</p>
          <p class="host-specialty">{host.specialty}</p>
        </div>
      </div>
    ))}
  </div>
)}

<script>
  // Center-focused "coverflow" carousel: on scroll, scale/fade each card by
  // its distance from the track's centre. Click a side card to snap-scroll
  // it to centre; click the already-centred card to play its reel (or reveal
  // the "coming soon" state where there is no reel yet). A card scrolled away
  // from the centre stops and rewinds, so only one reel ever plays at a time.
  // Runs once per `.host-coverflow` instance on the page.
  function initCoverflow(track: HTMLElement) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.host-coverflow-card'));
    if (!cards.length) return;

    const videoOf = (card: HTMLElement) =>
      card.querySelector<HTMLVideoElement>('.host-coverflow-video');

    const stop = (card: HTMLElement) => {
      card.classList.remove('is-playing');
      const v = videoOf(card);
      if (v) { v.pause(); v.currentTime = 0; }
    };

    // One card-plus-gap. Distance from the centre is measured in these, so a
    // card's place in the row (centre, neighbour, edge) is the same number
    // however wide the viewport is.
    const step = () =>
      cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : 1;

    let raf = 0;
    const update = () => {
      const trackRect = track.getBoundingClientRect();
      const center = trackRect.left + trackRect.width / 2;
      const s = step() || 1;
      cards.forEach((card) => {
        const r = card.getBoundingClientRect();
        const dist = Math.abs(r.left + r.width / 2 - center);
        const norm = dist / s;
        card.classList.toggle('is-active', norm < 0.5);
        // Every card is the same size now, so being off-centre no longer
        // means being too small to watch: a reel only stops once its card
        // has scrolled out of the five on screen.
        if (norm > 2.5 && card.classList.contains('is-playing')) stop(card);
      });
    };
    const onScroll = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    };
    track.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hoverable = window.matchMedia('(hover: hover)').matches;

    const play = (card: HTMLElement) => {
      const v = videoOf(card);
      if (!v || card.classList.contains('is-playing')) return;
      cards.forEach((other) => { if (other !== card) stop(other); });
      card.classList.add('is-playing');
      // Muted + playsinline, so autoplay policies allow this; the promise
      // still rejects on some browsers, and an un-played card should not
      // sit there claiming to be playing.
      v.play().catch(() => card.classList.remove('is-playing'));
    };

    cards.forEach((card) => {
      // All five on screen are full-size and watchable, so a click plays the
      // card it landed on rather than first dragging it to the middle. Only
      // a card sitting outside the row still centres itself first.
      const activate = () => {
        if (card.classList.contains('is-playing')) {
          stop(card);
          return;
        }
        play(card);
        card.scrollIntoView({
          behavior: reduceMotion ? 'auto' : 'smooth',
          inline: 'nearest',
          block: 'nearest',
        });
      };
      card.addEventListener('click', activate);
      // The name below the reel is a link out to the calendar; without this
      // the card's own click would swallow it and just recentre the card.
      card.querySelector('.host-coverflow-link')?.addEventListener('click', (e) => e.stopPropagation());
      // With a mouse, the reel starts the moment the pointer is over the
      // card — no need to centre it first — and stops when the pointer
      // leaves, the same way scrolling the card off centre stops it.
      if (hoverable) {
        card.addEventListener('mouseenter', () => play(card));
        card.addEventListener('mouseleave', () => stop(card));
      }
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activate();
        }
      });
    });

    // Open on the third card, so the default view is the full row of five
    // rather than the first card centred with nothing to the left of it.
    const openOn = Math.min(2, cards.length - 1);
    const settle = () => {
      track.scrollLeft = openOn * (step() || 0);
      update();
    };
    settle();
    // Re-run once the reel posters have decoded; their height can shift the
    // layout and leave the opening position slightly off.
    window.addEventListener('load', settle, { once: true });

    update();
  }

  document.querySelectorAll<HTMLElement>('[data-host-coverflow]').forEach(initCoverflow);
</script>
