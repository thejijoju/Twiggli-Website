---
import Nav from '../components/Nav.astro';
import SocialBar from '../components/SocialBar.astro';
import Footer from '../components/Footer.astro';
import MobileTabs from '../components/MobileTabs.astro';
import CookieBanner from '../components/CookieBanner.astro';
import BookingDialog from '../components/BookingDialog.astro';
import VoucherDialog from '../components/VoucherDialog.astro';
import SignInDialog from '../components/SignInDialog.astro';
import ClubPopup from '../components/ClubPopup.astro';
import { getSiteData } from '../data/site.ts';
import { href, splitLang, DEFAULT_LANG, LANGS, LANG_META, type Lang } from '../lib/url.ts';
import '../styles/modernist.css';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  /** An extra class on the page wrapper, for a page that wants its own
   *  ground or its own edges — see `page-flush` in site.css. */
  pageClass?: string;
  lang?: Lang;
  /** Keep the page out of search results — for transactional landing pages
   *  (payment return URLs) that are meaningless without their flow. */
  noindex?: boolean;
  /** The picture a share of this page shows — absolute or site-relative.
   *  The logo stands in where a page has nothing better. */
  image?: string;
  /** Which languages this page exists in. Everything but the legal pages
   *  and the blog exists in all of them; those two pass ['en', 'de'] so the
   *  hreflang set, the switcher and the redirect only ever name a page
   *  that is really there. */
  translations?: Lang[];
  /** A page with nothing around it: no social strip, nav, footer, tab bar,
   *  cookie note, dialogs or club popup — just the page itself, for a flow
   *  that wants all the attention (the voucher checkout). Head, meta and
   *  analytics stay as they are. */
  bare?: boolean;
}

import { umamiWebsiteId, umamiScript, analyticsOn } from '../data/analytics.ts';

const { title, description, pageClass, lang = DEFAULT_LANG, noindex = false, image, translations = LANGS, bare: chromeless = false } = Astro.props;
const { brand } = getSiteData(lang);
const pageDescription = description ?? brand.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const shareImage = new URL(image ?? brand.logo, Astro.site ?? Astro.url.origin);

// The same page in every language it exists in, for the hreflang
// alternates below — same logic LangSwitch.astro uses to build its menu.
const base = import.meta.env.BASE_URL;
const { bare } = splitLang(Astro.url.pathname);
const origin = Astro.site ?? Astro.url.origin;
const alternates = LANGS.filter((l) => translations.includes(l)).map((l) => ({
  lang: l,
  url: new URL(href(l, bare), origin).href,
}));
const defaultUrl = new URL(href(DEFAULT_LANG, bare), origin).href;
const available = alternates.map((a) => a.lang);
// The Twiggli Club invitation (ClubPopup.astro) shows everywhere except on
// the club page itself, the legal pages, the newsletter and payment
// landing pages, and anything kept out of search.
const clubPopup = !chromeless && !noindex && !/^\/(club|impressum|privacy-policy|terms-of-service|paymentcanceled|stripe-connect-setup-completed|newsletter|404)(\/|$)/.test(bare);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ deployBase: base, langs: available, current: lang, defaultLang: DEFAULT_LANG }}>
      try {
        // Says that scripts run here, before anything paints. The header is
        // see-through only under this marker, so where scripts are blocked
        // it keeps the frosted pane instead of sitting invisible over the
        // page's own content — which is what an in-app browser that never
        // ran the scroll listener below used to get.
        document.documentElement.dataset.headerLive = '';
        if (localStorage.getItem('twiggli-cookie-consent')) {
          document.documentElement.classList.add('cookie-consent-set');
        }
        // Language on the home entry. Only the English root (`/`) ever
        // redirects, client-side, with location.replace: deep links and
        // every other page stay exactly where they were linked (so a shared
        // /fr/… link, or a crawler's fetch of /de/…, is never bounced), and
        // since no prefixed page redirects, it cannot loop. The language is
        // the one the visitor picked in the switcher (LangSwitch.astro
        // stores it as 'twiggli-lang'), else the first of the browser's
        // preferred languages that the site has, else English — which is
        // the root itself, so nothing happens. A visitor who is already
        // browsing (a same-site referrer: they clicked through to the
        // English home on purpose) and crawlers are left alone.
        var rel = location.pathname.indexOf(deployBase) === 0 ? location.pathname.slice(deployBase.length) : null;
        var bot = /bot|crawl|spider|slurp|lighthouse|headless|preview|facebookexternalhit|embedly|whatsapp|telegram/i.test(navigator.userAgent || '');
        var internal = false;
        try { internal = !!document.referrer && new URL(document.referrer).origin === location.origin; } catch (e) {}
        if ((rel === '' || rel === 'index.html') && current === defaultLang && !bot && !internal) {
          var storedLang = localStorage.getItem('twiggli-lang');
          var wanted = null;
          if (storedLang && langs.indexOf(storedLang) !== -1) {
            wanted = storedLang;
          } else {
            var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
            for (var i = 0; i < prefs.length && !wanted; i++) {
              var code = String(prefs[i] || '').toLowerCase().slice(0, 2);
              if (langs.indexOf(code) !== -1) wanted = code;
            }
          }
          if (wanted && wanted !== defaultLang) {
            location.replace(deployBase + wanted + '/' + location.search + location.hash);
          }
        }
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical.href} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.url} />)}
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    <link rel="icon" href={brand.logo} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={LANG_META[lang].og} />
    {alternates.filter((a) => a.lang !== lang).map((a) => (
      <meta property="og:locale:alternate" content={LANG_META[a.lang].og} />
    ))}
    <meta property="og:image" content={shareImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Source+Sans+Pro:wght@700&family=Caveat:wght@600&display=swap"
    />
    {/* Anything a page needs in the head of its own — the retreats load a
        display serif no other page pays for. */}
    <slot name="head" />
    {/* Cookie-free, so the consent banner does not change. It counts the
        clicks that hand a visitor to a host and nothing about the visitor;
        see lib/track.ts. Absent until a website id is configured. */}
    {analyticsOn && (
      <script is:inline defer src={umamiScript} data-website-id={umamiWebsiteId}></script>
    )}
  </head>
  <body class:list={[chromeless && 'is-bare']}>
    {chromeless ? (
      <div class:list={['page', 'page-bare', pageClass]}>
        <main>
          <slot />
        </main>
      </div>
    ) : (
    <>
    <div class:list={['page', pageClass]}>
      <SocialBar lang={lang} />
      {/* The nav is pinned; the dark social strip above it is not, so it
          scrolls away and leaves the transparent nav at the top edge. */}
      <header class="site-header" data-site-header>
        <Nav lang={lang} />
      </header>
      <main>
        <slot />
      </main>
      <Footer lang={lang} translations={available} />
    </div>
    <MobileTabs lang={lang} translations={available} />
    <CookieBanner lang={lang} />
    {/* Every Book / Request / Notify button opens this, on the page. */}
    <BookingDialog lang={lang} />
    <VoucherDialog lang={lang} />
    <SignInDialog lang={lang} />
    </>
    )}
    {clubPopup && <ClubPopup lang={lang} />}
    <script>
      // Every outbound click, labelled with the card it came from. Runs
      // whether or not the analytics script loaded — track() is a no-op
      // until it does, and stays one if an ad blocker takes it.
      import { startOutboundTracking } from '../lib/track.ts';
      startOutboundTracking();
    </script>
    <script>
      // Descriptions that fade out and open on a tap (lib/fadetext.ts).
      import { startFadeText } from '../lib/fadetext.ts';
      startFadeText();
    </script>
    <script>
      // Cards already opened read fainter (lib/seen.ts).
      import { startSeen } from '../lib/seen.ts';
      startSeen();
    </script>

    <script>
      // The header paints nothing at rest — the page shows through it. Once
      // the page has scrolled at all, content starts passing underneath, so
      // a frosted layer fades in behind the links to keep them readable.
      // Class toggle only; the appearance itself lives in site.css, which
      // also decides what a browser that never gets here is shown.
      const header = document.querySelector('[data-site-header]');
      if (header) {
        let raf = 0;
        const sync = () => {
          raf = 0;
          header.classList.toggle('is-stuck', window.scrollY > 4);
        };
        const onScroll = () => {
          if (!raf) raf = requestAnimationFrame(sync);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        sync();
      }
    </script>
  </body>
</html>
