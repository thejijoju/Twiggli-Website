---
import Nav from '../components/Nav.astro';
import SocialBar from '../components/SocialBar.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { getSiteData } from '../data/site.ts';
import { href, splitLang, DEFAULT_LANG, LANGS, LANG_META, type Lang } from '../lib/url.ts';
import '../styles/modernist.css';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  /** An extra class on the page wrapper, for a page that wants its own
   *  ground or its own edges — see `page-flush` in site.css. */
  pageClass?: string;
  lang?: Lang;
  /** Keep the page out of search results — for transactional landing pages
   *  (payment return URLs) that are meaningless without their flow. */
  noindex?: boolean;
  /** The picture a share of this page shows — absolute or site-relative.
   *  The logo stands in where a page has nothing better. */
  image?: string;
  /** Which languages this page exists in. Everything but the legal pages
   *  and the blog exists in all of them; those two pass ['en', 'de'] so the
   *  hreflang set, the switcher and the redirect only ever name a page
   *  that is really there. */
  translations?: Lang[];
}

const { title, description, pageClass, lang = DEFAULT_LANG, noindex = false, image, translations = LANGS } = Astro.props;
const { brand } = getSiteData(lang);
const pageDescription = description ?? brand.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const shareImage = new URL(image ?? brand.logo, Astro.site ?? Astro.url.origin);

// The same page in every language it exists in, for the hreflang
// alternates below — same logic LangSwitch.astro uses to build its menu.
const base = import.meta.env.BASE_URL;
const { bare } = splitLang(Astro.url.pathname);
const origin = Astro.site ?? Astro.url.origin;
const alternates = LANGS.filter((l) => translations.includes(l)).map((l) => ({
  lang: l,
  url: new URL(href(l, bare), origin).href,
}));
const defaultUrl = new URL(href(DEFAULT_LANG, bare), origin).href;
const available = alternates.map((a) => a.lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ deployBase: base, langs: available, current: lang, defaultLang: DEFAULT_LANG }}>
      try {
        if (localStorage.getItem('twiggli-cookie-consent')) {
          document.documentElement.classList.add('cookie-consent-set');
        }
        // First-visit language detection: if the visitor has not picked a
        // language before (LangSwitch.astro records that choice), walk the
        // browser's preferred languages and send them to the first one this
        // page exists in — unless that is the language they are already
        // reading. Runs once per page, never fights a stored preference, and
        // only ever names a language in `langs`, which is the list of
        // versions this page really has. deployBase comes from BASE_URL
        // rather than a literal, so it cannot drift from astro.config.mjs.
        var storedLang = localStorage.getItem('twiggli-lang');
        if (!storedLang) {
          var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          var wanted = null;
          for (var i = 0; i < prefs.length && !wanted; i++) {
            var code = String(prefs[i] || '').toLowerCase().slice(0, 2);
            if (langs.indexOf(code) !== -1) wanted = code;
          }
          if (wanted && wanted !== current) {
            var path = location.pathname;
            var rel = path.indexOf(deployBase) === 0 ? path.slice(deployBase.length) : path.replace(/^\//, '');
            var m = rel.match(/^([a-z]{2})(\/|$)/);
            if (m && langs.indexOf(m[1]) !== -1) rel = rel.slice(m[0].length);
            var target = deployBase + (wanted === defaultLang ? '' : wanted + '/') + rel;
            if (target !== path) location.replace(target + location.search + location.hash);
          }
        }
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical.href} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.url} />)}
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    <link rel="icon" href={brand.logo} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={LANG_META[lang].og} />
    {alternates.filter((a) => a.lang !== lang).map((a) => (
      <meta property="og:locale:alternate" content={LANG_META[a.lang].og} />
    ))}
    <meta property="og:image" content={shareImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&family=Source+Sans+Pro:wght@700&display=swap"
    />
  </head>
  <body>
    <div class:list={['page', pageClass]}>
      <SocialBar lang={lang} />
      {/* The nav is pinned; the dark social strip above it is not, so it
          scrolls away and leaves the transparent nav at the top edge. */}
      <header class="site-header" data-site-header>
        <Nav lang={lang} translations={available} />
      </header>
      <main>
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
    <CookieBanner lang={lang} />
    <script>
      // The header paints nothing at rest — the page shows through it. Once
      // the page has scrolled at all, content starts passing underneath, so
      // a frosted layer fades in behind the links to keep them readable.
      // Class toggle only; the appearance itself lives in site.css.
      const header = document.querySelector('[data-site-header]');
      if (header) {
        let raf = 0;
        const sync = () => {
          raf = 0;
          header.classList.toggle('is-stuck', window.scrollY > 4);
        };
        const onScroll = () => {
          if (!raf) raf = requestAnimationFrame(sync);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        sync();
      }
    </script>
  </body>
</html>
