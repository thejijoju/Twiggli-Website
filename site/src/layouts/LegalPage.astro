---
import Base from './Base.astro';
import { getSiteData } from '../data/site.ts';
import { DEFAULT_LANG, LEGAL_LANGS, type Lang } from '../lib/url.ts';

interface Props {
  title: string;
  kicker: string;
  heading: string;
  description?: string;
  lede?: string;
  /** Section headings, in order, rendered as the table of contents. Each
   *  entry's `id` must match the <h2 id> in the page body. */
  toc?: { id: string; label: string }[];
  updated?: string;
  lang?: Lang;
  /** The languages this page exists in — the legal pages by default, the
   *  single German-only Impressum passes just its own. */
  translations?: Lang[];
}

const {
  title, kicker, heading, description, lede, toc = [], updated, lang = DEFAULT_LANG,
  translations = LEGAL_LANGS,
} = Astro.props;
const { legalUpdated } = getSiteData(lang);
/* The legal pages exist in English and German only (LEGAL_LANGS), so
   their labels do too, and Base is told which versions there are. */
const lastUpdatedLabel = lang === 'de' ? 'Zuletzt aktualisiert:' : 'Last updated:';
const onThisPageLabel = lang === 'de' ? 'Auf dieser Seite' : 'On this page';
---

<Base title={title} description={description} lang={lang} translations={translations}>
  <div class="container">
    <section class="page-head">
      <span class="kicker">{kicker}</span>
      <h1 class="page-title">{heading}</h1>
      {lede && <p class="page-lede">{lede}</p>}
      <p class="legal-meta">{lastUpdatedLabel} {updated ?? legalUpdated}</p>
    </section>

    <hr class="rule" />

    <div class="section prose">
      <slot name="notice" />

      {toc.length > 0 && (
        <nav class="legal-toc" aria-label={onThisPageLabel}>
          <ol>
            {toc.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
          </ol>
        </nav>
      )}

      <slot />
    </div>
  </div>
</Base>
