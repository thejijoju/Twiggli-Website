---
import Base from '../../layouts/Base.astro';
import DayPicker from '../../components/DayPicker.astro';
import { DAYS_AHEAD } from '../../data/sessions.ts';

const lang = 'en';
---

<Base
  title="Happening today — Twiggli"
  description="Every workshop running in Berlin today and over the next three weeks. Pick a day and see what is on."
  lang={lang}
>
  <div class="container">
    <section class="page-head">
      <span class="kicker">Happening today</span>
      <h1 class="page-title">What is on in Berlin</h1>
      <p class="page-lede">
        Today and the next {DAYS_AHEAD - 1} days, hosted by independent Berlin makers. Pick a day to
        see what is running.
      </p>
    </section>

    <section class="section">
      <DayPicker lang={lang} />
    </section>

  </div>
</Base>
