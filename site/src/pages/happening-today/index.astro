---
import Base from '../../layouts/Base.astro';
import DayPicker from '../../components/DayPicker.astro';
import EventSchema from '../../components/EventSchema.astro';

const lang = 'en';
---

<Base
  title="Happening today — Twiggli"
  description="Every workshop running in Berlin today and over the next three weeks. Pick a day and see what is on."
  lang={lang}
>
  <div class="container">
    <section class="page-head">
      <span class="kicker" data-happening-title>Happening today</span>
      <h1 class="page-title">What is on in Berlin</h1>
    </section>

    <section class="section section-flush">
      <DayPicker lang={lang} />
    </section>

  </div>
  <EventSchema lang={lang} pageUrl="https://www.twiggli.com/happening-today/" />
</Base>
