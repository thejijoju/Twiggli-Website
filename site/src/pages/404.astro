---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url.ts';

const lang = 'en';
---

<Base title="Page not found — Twiggli" description="That page does not exist." lang={lang}>
  <div class="container">
    <section class="page-head">
      <span class="kicker">404</span>
      <h1 class="page-title">That page does not exist</h1>
      <p class="page-lede">
        The link may be old, or the workshop may have wrapped up. Head back to the start.
      </p>
      <div class="hero-actions">
        <a href={withBase('/')} class="btn btn-primary">Back to home</a>
        <a href={withBase('/corporatebookings/')} class="btn btn-ghost">See our hosts</a>
      </div>
    </section>
  </div>
</Base>
