---
import Base from '../layouts/Base.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { getSiteData, requestEmail } from '../data/site.ts';

const lang = 'en';
const { socialLinks } = getSiteData(lang);

/* The form used to post to "#" — nowhere — so every enquiry sent through
   it was lost. The site is static, so on submit the fields are composed into
   an email to requestEmail and handed to the visitor's mail app, the same way
   the calendar's "Request to book" works; the address is printed under the
   form as well, for anyone whose device has no mail app wired up. */
---

<Base
  title="Contact — Twiggli"
  description="Get in touch about hosting, corporate events, or anything else."
  lang={lang}
>
  <div class="container">
    <section class="page-head">
      <span class="kicker">Contact</span>
      <h1 class="page-title">Talk to us</h1>
      <p class="page-lede">
        Hosting a workshop, booking something for your team, or just curious — send us a note and we
        will come back to you.
      </p>
    </section>

    <hr class="rule" />

    <section class="section">
      <div class="form-grid">
        <form class="form-rows" method="post" action="#" data-request-form data-request-email={requestEmail}>
          <div class="field">
            <label for="name">Name</label>
            <input class="input" type="text" id="name" name="name" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input class="input" type="email" id="email" name="email" required />
          </div>
          <div class="field">
            <label for="topic">What is this about?</label>
            <select class="input" id="topic" name="topic">
              <option>Hosting a workshop</option>
              <option>Corporate events</option>
              <option>Something else</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea class="input" id="message" name="message" rows="5" required></textarea>
          </div>
          <div>
            <button type="submit" class="btn btn-primary">Send message</button>
            <p class="form-note">
              Opens the message in your mail app — just hit send. Or write to us directly at
              <a href={`mailto:${requestEmail}`}>{requestEmail}</a>.
            </p>
            <p class="form-note form-note-sent" data-request-sent hidden>
              Your mail app should have opened with the message ready. If nothing happened, send it to
              <a href={`mailto:${requestEmail}`}>{requestEmail}</a>.
            </p>
          </div>
        </form>

        <div class="form-aside">
          <span class="kicker kicker-tight">Elsewhere</span>
          <p>
            We are on all the usual places, and we read our messages there too.
          </p>
          <div class="nav-social" style="margin-left:0">
            {socialLinks.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'noopener' : undefined}
              ><SocialIcon name={s.icon} size={20} /></a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>

  {/* "Request event" buttons on /corporatebookings/ land here with ?host=<name>: pick
      the corporate topic and start the message for the visitor. is:inline
      because it's plain DOM glue — no imports, nothing to bundle. */}
  <script is:inline>
    (() => {
      const host = new URLSearchParams(location.search).get('host');
      if (!host) return;
      const topic = document.getElementById('topic');
      if (topic) topic.value = 'Corporate events';
      const message = document.getElementById('message');
      if (message && !message.value)
        message.value = `Hi! I'd like to request an event with ${host}.`;
    })();

    // Submit composes the mail and opens it in the visitor's mail app. The
    // composed link is also written onto the form, so it can be checked.
    (() => {
      const form = document.querySelector('[data-request-form]');
      if (!form) return;
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const v = (id) => (document.getElementById(id) || {}).value || '';
        const host = new URLSearchParams(location.search).get('host');
        const topic = v('topic');
        const corporate = /corporate|firmen/i.test(topic) || !!host;
        const subject = corporate
          ? `Corporate request: ${host || topic} — ${v('name')}`
          : `Message from twiggli.com: ${topic} — ${v('name')}`;
        const body = [`Name: ${v('name')}`, `Email: ${v('email')}`, `Topic: ${topic}`, host ? `Host: ${host}` : '', '', `Message:`, v('message')]
          .filter((line, i) => line !== '' || i === 4).join('\n');
        const mailto = `mailto:${form.dataset.requestEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        form.dataset.mailto = mailto;
        const sent = form.querySelector('[data-request-sent]');
        if (sent) sent.hidden = false;
        location.href = mailto;
      });
    })();
  </script>
</Base>
