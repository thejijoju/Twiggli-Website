---
import Base from '../layouts/Base.astro';
import HostDirectory from '../components/HostDirectory.astro';
import HostFilters from '../components/HostFilters.astro';
import { getHosts } from '../data/content.ts';
import { withBase } from '../lib/url.ts';

const lang = 'en';
const hosts = getHosts(lang);
---

<Base
  title="Corporate events — Twiggli"
  description="Private team-building workshops for companies, run by independent Berlin makers — ceramics, printmaking, food, photography and more."
  lang={lang}
>
  <div class="container">
    <section class="page-head">
      <span class="kicker">Corporate events</span>
      <h1 class="page-title">Team-building workshops for companies</h1>
      <p class="page-lede">
        Book a private workshop for your team — cooking, climbing, dance and more, run by our vetted
        hosts at your office or a venue nearby. We handle the logistics for groups of any size.
      </p>
      <div class="hero-actions">
        <a href={withBase('/contact/')} class="btn btn-primary">Get a corporate quote</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="section">
      <HostFilters lang={lang} />
      <HostDirectory hosts={hosts} lang={lang} />
    </section>

    <hr class="rule" />

    <section class="split split-text-first">
      <div>
        <span class="kicker kicker-tight">Host &amp; earn</span>
        <h2 class="split-title">Host workshops for free — and start earning</h2>
        <p class="split-copy">
          Turn your skill into income. List a class, a cooking session or a walk, set your price —
          or make it free — and Twiggli brings the people. No listing fees, no equipment to buy.
        </p>
        <div class="split-actions">
          <a href={withBase('/host/')} class="btn btn-primary">Become a host</a>
        </div>
      </div>
      <div class="media-4x3 grayscale">
        <img src={withBase('/img/hosts/dominik-wide.jpg')} alt="" loading="lazy"
             style="width:100%;height:100%;object-fit:cover" />
      </div>
    </section>
  </div>
</Base>
