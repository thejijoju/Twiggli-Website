---
import Base from '../layouts/Base.astro';
import HostDirectory from '../components/HostDirectory.astro';
import { getHosts } from '../data/content.ts';
import { withBase } from '../lib/url.ts';

const lang = 'en';
const hosts = getHosts(lang);
---

<Base
  title="Our hosts — Twiggli"
  description="The independent Berlin makers running workshops on Twiggli — ceramics, printmaking, food, photography, graffiti and more."
  lang={lang}
>
  <div class="container">
    <section class="page-head">
      <span class="kicker">Our hosts</span>
      <h1 class="page-title">Made by hand, across the city</h1>
      <p class="page-lede">
        Every workshop on Twiggli is run by an independent Berlin maker — in their own atelier, at
        your office, or outdoors. {hosts.length} of them, all in Berlin. Browse the makers below,
        then tell us who you would like to spend a day with.
      </p>
      <div class="hero-actions">
        <a href={withBase('/contact/')} class="btn btn-primary">Book a day for your team</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="section">
      <nav class="maker-index" aria-label="Jump to a host">
        {hosts.map((host) => <a href={`#${host.slug}`}>{host.name}</a>)}
      </nav>
    </section>

    <section class="section" style="padding-top:0">
      <HostDirectory hosts={hosts} lang={lang} />
    </section>

    <hr class="rule" />

    <section class="split split-text-first">
      <div>
        <span class="kicker kicker-tight">Host &amp; earn</span>
        <h2 class="split-title">Host workshops for free — and start earning</h2>
        <p class="split-copy">
          Turn your skill into income. List a class, a cooking session or a walk, set your price —
          or make it free — and Twiggli brings the people. No listing fees, no equipment to buy.
        </p>
        <div class="split-actions">
          <a href={withBase('/host/')} class="btn btn-primary">Become a host</a>
        </div>
      </div>
      <div class="media-4x3 grayscale">
        <img src={withBase('/img/hosts/dominik-wide.jpg')} alt="" loading="lazy"
             style="width:100%;height:100%;object-fit:cover" />
      </div>
    </section>
  </div>
</Base>
