---
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import HostGrid from '../components/HostGrid.astro';
import { getHosts } from '../data/content.ts';
import { withBase } from '../lib/url.ts';

const lang = 'en';
const hosts = getHosts(lang);

/* The "Corporate events" section copy is verbatim from the export. The
   three points are PLACEHOLDER — replace with the real corporate pitch. */
const points = [
  {
    num: '01',
    title: 'Tell us the brief',
    copy: 'Team size, date, budget, and whether you want it at your office or somewhere in the city.',
  },
  {
    num: '02',
    title: 'We match a host',
    copy: 'We pick from our vetted hosts and come back with options that fit the group and the room.',
  },
  {
    num: '03',
    title: 'We run the logistics',
    copy: 'Materials, venue and scheduling are handled. Your team just shows up.',
  },
];
---

<Base
  title="Corporate events — Twiggli"
  description="Private team-building workshops for companies, run by vetted hosts across Berlin."
  lang={lang}
>
  <div class="container">
    <section class="page-head">
      <span class="kicker">Corporate events</span>
      <h1 class="page-title">Team-building workshops for companies</h1>
      <p class="page-lede">
        Book a private workshop for your team — cooking, climbing, dance and more, run by our vetted
        hosts at your office or a venue nearby. We handle the logistics for groups of any size.
      </p>
      <div class="hero-actions">
        <a href={withBase('/contact/')} class="btn btn-primary">Get a corporate quote</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="section">
      {points.map((point) => (
        <div class="step">
          <p class="step-num">{point.num}</p>
          <h3 class="step-title">{point.title}</h3>
          <p class="step-copy">{point.copy}</p>
        </div>
      ))}
    </section>

    <hr class="rule" />

    <section class="section" id="hosts">
      <span class="kicker">Meet the hosts</span>
      <p class="section-lede">
        Browse our vetted hosts and get a feel for who could run your team's session.
      </p>
      <HostGrid hosts={hosts} layout="carousel" lang={lang} />
      <div class="hosts-band-actions">
        <a href={withBase('/hosts/')} class="btn btn-primary">Meet all {hosts.length} hosts</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="split split-media-first">
      <div class="media-4x3 grayscale">
        <ImageSlot shape="rect" placeholder="Drop a corporate event photo" alt="" />
      </div>
      <div>
        <span class="kicker kicker-tight">Any size</span>
        <h2 class="split-title">From a team of six to a company offsite</h2>
        <p class="split-copy">
          One session or a series, one room or several running in parallel. Tell us the group and we
          will tell you what fits.
        </p>
        <div class="split-actions">
          <a href={withBase('/contact/')} class="btn btn-primary">Get a corporate quote</a>
        </div>
      </div>
    </section>
  </div>
</Base>
