---
import DistrictPage from '../../../../components/DistrictPage.astro';
import { districtsFor } from '../../../../data/seo.ts';

export function getStaticPaths() {
  return districtsFor('fr').map((d) => ({ params: { district: d.slug } }));
}
const { district } = Astro.params;
---

<DistrictPage lang="fr" district={district!} />
