---
import Base from '../../layouts/Base.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import { getSiteData } from '../../data/site.ts';

const lang = 'de';
const { socialLinks } = getSiteData(lang);

/* PLACEHOLDER page. The form posts nowhere yet — wire `action` to your form
   handler (Formspree, a serverless function, your own API) before launch. */
---

<Base
  title="Kontakt — Twiggli"
  description="Melde dich bei uns — für Gastgeber-Anfragen, Firmenevents oder alles andere."
  lang={lang}
>
  <div class="container">
    <section class="page-head">
      <span class="kicker">Kontakt</span>
      <h1 class="page-title">Sprich mit uns</h1>
      <p class="page-lede">
        Du willst einen Workshop anbieten, etwas für dein Team buchen, oder bist einfach neugierig
        — schick uns eine Nachricht und wir melden uns bei dir.
      </p>
    </section>

    <hr class="rule" />

    <section class="section">
      <div class="form-grid">
        <form class="form-rows" method="post" action="#">
          <div class="field">
            <label for="name">Name</label>
            <input class="input" type="text" id="name" name="name" required />
          </div>
          <div class="field">
            <label for="email">E-Mail</label>
            <input class="input" type="email" id="email" name="email" required />
          </div>
          <div class="field">
            <label for="topic">Worum geht es?</label>
            <select class="input" id="topic" name="topic">
              <option>Workshop anbieten</option>
              <option>Firmenevents</option>
              <option>Etwas anderes</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Nachricht</label>
            <textarea class="input" id="message" name="message" rows="5" required></textarea>
          </div>
          <div>
            <button type="submit" class="btn btn-primary">Nachricht senden</button>
          </div>
        </form>

        <div class="form-aside">
          <span class="kicker kicker-tight">Anderswo</span>
          <p>
            Wir sind auf allen gängigen Kanälen vertreten, und wir lesen unsere Nachrichten auch
            dort.
          </p>
          <div class="nav-social" style="margin-left:0">
            {socialLinks.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'noopener' : undefined}
              ><SocialIcon name={s.icon} size={20} /></a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>
