---
import Base from '../../layouts/Base.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import { getSiteData, requestEmail } from '../../data/site.ts';

const lang = 'de';
const { socialLinks } = getSiteData(lang);

/* The form used to post to "#" — nowhere — so every enquiry sent through
   it was lost. The site is static, so on submit the fields are composed into
   an email to requestEmail and handed to the visitor's mail app, the same way
   the calendar's "Request to book" works; the address is printed under the
   form as well, for anyone whose device has no mail app wired up. */
---

<Base
  title="Kontakt — Twiggli"
  description="Melde dich bei uns — für Gastgeber-Anfragen, Firmenevents oder alles andere."
  lang={lang}
>
  <div class="container">
    <section class="page-head">
      <span class="kicker">Kontakt</span>
      <h1 class="page-title">Sprich mit uns</h1>
      <p class="page-lede">
        Du willst einen Workshop anbieten, etwas für dein Team buchen, oder bist einfach neugierig
        — schick uns eine Nachricht und wir melden uns bei dir.
      </p>
    </section>

    <hr class="rule" />

    <section class="section">
      <div class="form-grid">
        <form class="form-rows" method="post" action="#" data-request-form data-request-email={requestEmail}>
          <div class="field">
            <label for="name">Name</label>
            <input class="input" type="text" id="name" name="name" required />
          </div>
          <div class="field">
            <label for="email">E-Mail</label>
            <input class="input" type="email" id="email" name="email" required />
          </div>
          <div class="field">
            <label for="topic">Worum geht es?</label>
            <select class="input" id="topic" name="topic">
              <option>Workshop anbieten</option>
              <option>Firmenevents</option>
              <option>Etwas anderes</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Nachricht</label>
            <textarea class="input" id="message" name="message" rows="5" required></textarea>
          </div>
          <div>
            <button type="submit" class="btn btn-primary">Nachricht senden</button>
            <p class="form-note">
              Öffnet die Nachricht in deinem Mailprogramm — einfach absenden. Oder schreib uns direkt an
              <a href={`mailto:${requestEmail}`}>{requestEmail}</a>.
            </p>
            <p class="form-note form-note-sent" data-request-sent hidden>
              Dein Mailprogramm sollte sich mit der fertigen Nachricht geöffnet haben. Falls nichts passiert ist, schick sie an
              <a href={`mailto:${requestEmail}`}>{requestEmail}</a>.
            </p>
          </div>
        </form>

        <div class="form-aside">
          <span class="kicker kicker-tight">Anderswo</span>
          <p>
            Wir sind auf allen gängigen Kanälen vertreten, und wir lesen unsere Nachrichten auch
            dort.
          </p>
          <div class="nav-social" style="margin-left:0">
            {socialLinks.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'noopener' : undefined}
              ><SocialIcon name={s.icon} size={20} /></a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>

  {/* "Event anfragen"-Buttons auf /de/corporatebookings/ landen hier mit ?host=<name>:
      Thema vorwählen und die Nachricht für den Besucher beginnen. is:inline,
      weil es reines DOM-Glue ist — keine Imports, nichts zu bundeln. */}
  <script is:inline>
    (() => {
      const host = new URLSearchParams(location.search).get('host');
      if (!host) return;
      const topic = document.getElementById('topic');
      if (topic) topic.value = 'Firmenevents';
      const message = document.getElementById('message');
      if (message && !message.value)
        message.value = `Hallo! Ich möchte ein Event mit ${host} anfragen.`;
    })();

    // Submit composes the mail and opens it in the visitor's mail app. The
    // composed link is also written onto the form, so it can be checked.
    (() => {
      const form = document.querySelector('[data-request-form]');
      if (!form) return;
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const v = (id) => (document.getElementById(id) || {}).value || '';
        const host = new URLSearchParams(location.search).get('host');
        const topic = v('topic');
        const corporate = /corporate|firmen/i.test(topic) || !!host;
        const subject = corporate
          ? `Firmenanfrage: ${host || topic} — ${v('name')}`
          : `Nachricht über twiggli.com: ${topic} — ${v('name')}`;
        const body = [`Name: ${v('name')}`, `E-Mail: ${v('email')}`, `Thema: ${topic}`, host ? `Host: ${host}` : '', '', `Nachricht:`, v('message')]
          .filter((line, i) => line !== '' || i === 4).join('\n');
        const mailto = `mailto:${form.dataset.requestEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        form.dataset.mailto = mailto;
        const sent = form.querySelector('[data-request-sent]');
        if (sent) sent.hidden = false;
        location.href = mailto;
      });
    })();
  </script>
</Base>
