---
import Base from '../../layouts/Base.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { withBase } from '../../lib/url.ts';

const lang = 'de';

/* The "Host & earn" section copy is verbatim from the export. The three
   points below it are PLACEHOLDER — replace with the real host pitch. */
const points = [
  {
    num: '01',
    title: 'In wenigen Minuten online',
    copy: 'Filme ein kurzes Video, lege Termin und Preis fest — oder biete es kostenlos an — und veröffentliche. Keine Gebühren.',
  },
  {
    num: '02',
    title: 'Wir bringen die Leute',
    copy: 'Dein Workshop erscheint im Feed für Leute in deiner Nähe, die genau danach suchen.',
  },
  {
    num: '03',
    title: 'Geld erhalten',
    copy: 'Buchungen und Zahlungen laufen über die App, damit du dich auf den Workshop konzentrieren kannst.',
  },
];
---

<Base
  title="Gastgeber bei Twiggli werden — Workshops kostenlos anbieten und Geld verdienen"
  description="Verwandle dein Können in Einkommen. Biete einen Workshop kostenlos an und Twiggli bringt die Leute."
  lang={lang}
>
  <div class="container">
    <section class="page-head">
      <span class="kicker">Gastgeber &amp; verdienen</span>
      <h1 class="page-title">Workshops kostenlos anbieten — und Geld verdienen</h1>
      <p class="page-lede">
        Verwandle dein Können in Einkommen. Biete einen Tanzkurs, eine Kochsession oder eine
        Wanderung an, lege deinen Preis fest — oder mach es kostenlos — und Twiggli bringt die
        Leute. Keine Gebühren, keine Ausrüstung nötig.
      </p>
      <div class="hero-actions">
        <a href={withBase('/de/contact/')} class="btn btn-primary">Gastgeber werden</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="section">
      {points.map((point) => (
        <div class="step">
          <p class="step-num">{point.num}</p>
          <h3 class="step-title">{point.title}</h3>
          <p class="step-copy">{point.copy}</p>
        </div>
      ))}
    </section>

    <hr class="rule" />

    <section class="split split-media-first">
      <div class="media-4x3 grayscale">
        <ImageSlot shape="rect" placeholder="Gastgeber-/Workshop-Foto hier einfügen" alt="" />
      </div>
      <div>
        <span class="kicker kicker-tight">Wer Gastgeber wird</span>
        <h2 class="split-title">Alles, was du unterrichten kannst, will jemand lernen</h2>
        <p class="split-copy">
          Tänzer, Kletterer, Köchinnen, Keramikerinnen, Fotografen, Radfahrerinnen. Wenn es als
          Stunde oder Nachmittag mit einer Gruppe funktioniert, funktioniert es auf Twiggli.
        </p>
        <div class="split-actions">
          <a href={withBase('/de/corporatebookings/')} class="btn btn-primary">Unsere Gastgeber ansehen</a>
        </div>
      </div>
    </section>
  </div>
</Base>
