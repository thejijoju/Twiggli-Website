---
import Base from '../../../layouts/Base.astro';
import DayPicker from '../../../components/DayPicker.astro';
import { DAYS_AHEAD } from '../../../data/sessions.ts';
import { withBase } from '../../../lib/url.ts';

const lang = 'de';
---

<Base
  title="Heute los — Twiggli"
  description="Alle Workshops, die heute und in den nächsten drei Wochen in Berlin stattfinden. Tag wählen und loslegen."
  lang={lang}
>
  <div class="container">
    <section class="page-head">
      <span class="kicker">Heute los</span>
      <h1 class="page-title">Was in Berlin läuft</h1>
      <p class="page-lede">
        Heute und die nächsten {DAYS_AHEAD - 1} Tage, angeboten von unabhängigen Berliner
        Gastgeberinnen und Gastgebern. Wähle einen Tag und sieh, was läuft.
      </p>
    </section>

    <hr class="rule" />

    <section class="section">
      <DayPicker lang={lang} />
    </section>

    <hr class="rule" />

    <section class="split split-text-first">
      <div>
        <span class="kicker kicker-tight">Platz sichern</span>
        <h2 class="split-title">Gebucht wird in der App</h2>
        <p class="split-copy">
          Die Plätze sind schnell weg, und dein Platz ist reserviert, sobald du buchst. Hol dir die
          App, um zu reservieren, dem Gastgeber zu schreiben und alles in deiner Nähe zu sehen.
        </p>
        <div class="split-actions">
          <a href={withBase('/de/hosts/')} class="btn btn-primary">Gastgeber entdecken</a>
        </div>
      </div>
      <div class="media-4x3 grayscale">
        <img src={withBase('/img/hosts/qian-wide.jpg')} alt="" loading="lazy"
             style="width:100%;height:100%;object-fit:cover" />
      </div>
    </section>
  </div>
</Base>
