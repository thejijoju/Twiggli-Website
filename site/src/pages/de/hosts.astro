---
import Base from '../../layouts/Base.astro';
import HostDirectory from '../../components/HostDirectory.astro';
import HostFilters from '../../components/HostFilters.astro';
import { getHosts } from '../../data/content.ts';
import { withBase } from '../../lib/url.ts';

const lang = 'de';
const hosts = getHosts(lang);
---

<Base
  title="Firmenevents — Twiggli"
  description="Private Team-Workshops für Unternehmen, geleitet von unabhängigen Berliner Makern — Keramik, Druck, Food, Fotografie und mehr."
  lang={lang}
>
  <div class="container">
    <section class="page-head">
      <span class="kicker">Firmenevents</span>
      <h1 class="page-title">Team-Workshops für Unternehmen</h1>
      <p class="page-lede">
        Buche einen privaten Workshop für dein Team — Kochen, Klettern, Tanzen und mehr, geleitet
        von unseren geprüften Gastgebern in eurem Büro oder an einem Ort in deiner Nähe. Wir
        kümmern uns um die Logistik, egal wie groß die Gruppe ist.
      </p>
      <div class="hero-actions">
        <a href={withBase('/de/contact/')} class="btn btn-primary">Firmenangebot anfragen</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="section">
      <HostFilters lang={lang} />
      <HostDirectory hosts={hosts} lang={lang} />
    </section>

    <hr class="rule" />

    <section class="split split-text-first">
      <div>
        <span class="kicker kicker-tight">Gastgeber &amp; verdienen</span>
        <h2 class="split-title">Workshops kostenlos anbieten — und Geld verdienen</h2>
        <p class="split-copy">
          Verwandle dein Können in Einkommen. Biete einen Kurs, eine Kochsession oder einen
          Spaziergang an, lege deinen Preis fest — oder mach es kostenlos — und Twiggli bringt die
          Leute. Keine Gebühren, keine Ausrüstung nötig.
        </p>
        <div class="split-actions">
          <a href={withBase('/de/host/')} class="btn btn-primary">Gastgeber werden</a>
        </div>
      </div>
      <div class="media-4x3 grayscale">
        <img src={withBase('/img/hosts/dominik-wide.jpg')} alt="" loading="lazy"
             style="width:100%;height:100%;object-fit:cover" />
      </div>
    </section>
  </div>
</Base>
