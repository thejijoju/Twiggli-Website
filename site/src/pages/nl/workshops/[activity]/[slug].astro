---
import HostPage from '../../../../components/HostPage.astro';
import { getHosts } from '../../../../data/content.ts';

/* One page per host, filed under their activity: /workshops/ceramics/haki/.
   The slug list is language-neutral, so English is the source for every
   language. */
export function getStaticPaths() {
  // Preview hosts (hosts/preview.ts) get their page too, reachable by
  // direct link only: noindex, and in no listing or sitemap.
  return getHosts('en', { withPreview: true }).map((h) => ({ params: { activity: h.activity, slug: h.slug } }));
}
const { slug } = Astro.params;
---

<HostPage lang="nl" slug={slug!} />
