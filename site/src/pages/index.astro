---
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import HostGrid from '../components/HostGrid.astro';
import AppDownloadCta from '../components/AppDownloadCta.astro';
import { steps, hosts } from '../data/content.ts';
import { brand, appUrl } from '../data/site.ts';
import { withBase } from '../lib/url.ts';
---

<Base title={`${brand.name} — ${brand.tagline}`}>
  <div class="container">
    <section class="hero">
      <div>
        <h1 class="hero-title">
          <span>Discover Berlin's most unique experiences —</span>
          <span>through video</span>
        </h1>
        <div class="hero-copy">
          <p><strong>🎉 Find Workshops. Host Workshops for free.</strong></p>
          <p>Discover exciting activities nearby or create your own and start earning 🎉.</p>
          <p>Whether you want to join the fun or monetize your passion, Twiggli makes it easy.</p>
          <p>📱 <strong>Ready to dive in?</strong> Download now on Apple Store and Google Play!</p>
        </div>
        <div class="hero-actions">
          <a href={appUrl} class="btn btn-primary" target="_blank" rel="noopener">Get Started</a>
          <a href="#how-it-works" class="btn btn-ghost">See how it works</a>
        </div>
      </div>

      <PhoneMockup layout="overlap" screen="listing" />
    </section>

    <hr class="rule" />

    <section class="section" id="how-it-works">
      <span class="kicker">How it works</span>
      {steps.map((step) => (
        <div class="step">
          <p class="step-num">{step.num}</p>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-copy">{step.copy}</p>
        </div>
      ))}
    </section>

    <hr class="rule" />

    <section class="split split-media-first" id="host">
      <div class="media-4x3 grayscale">
        <ImageSlot shape="rect" placeholder="Drop a host/workshop photo" alt="" />
      </div>
      <div>
        <span class="kicker kicker-tight">Host &amp; earn</span>
        <h2 class="split-title">Host workshops for free — and start earning</h2>
        <p class="split-copy">
          Turn your skill into income. List a dance class, a cooking session or a hike, set your
          price — or make it free — and Twiggli brings the people. No listing fees, no equipment to
          buy.
        </p>
        <div class="split-actions">
          <a href={withBase('/host/')} class="btn btn-primary">Become a host</a>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="section" id="hosts">
      <span class="kicker">Our hosts</span>
      <HostGrid hosts={hosts} />
    </section>

    <hr class="rule" />

    <section class="split split-text-first" id="corporate">
      <div>
        <span class="kicker kicker-tight">Corporate events</span>
        <h2 class="split-title">Team-building workshops for companies</h2>
        <p class="split-copy">
          Book a private workshop for your team — cooking, climbing, dance and more, run by our
          vetted hosts at your office or a venue nearby. We handle the logistics for groups of any
          size.
        </p>
        <div class="split-actions">
          <a href={withBase('/corporate/')} class="btn btn-primary">Get a corporate quote</a>
        </div>
      </div>
      <div class="media-4x3 grayscale">
        <ImageSlot shape="rect" placeholder="Drop a corporate event photo" alt="" />
      </div>
    </section>
  </div>

  <AppDownloadCta />
</Base>
