---
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import HeroVideoGrid from '../components/HeroVideoGrid.astro';
import HostGrid from '../components/HostGrid.astro';
import StoreButtons from '../components/StoreButtons.astro';
import Newsletter from '../components/Newsletter.astro';
import { getSteps, getHosts } from '../data/content.ts';
import { getSiteData, appUrl } from '../data/site.ts';
import { withBase } from '../lib/url.ts';

const lang = 'en';
const { brand } = getSiteData(lang);
const steps = getSteps(lang);
const hosts = getHosts(lang);
---

<Base title={`${brand.name} — ${brand.tagline}`} lang={lang}>
  <div class="container">
    <section class="hero">
        <h1 class="hero-title">
          <span>Discover Berlin's most unique experiences —</span>
          <span>through video</span>
        </h1>
      <div class="hero-panel">
        <div class="hero-quote">
          <div class="hero-copy">
            <p><strong>🎉 Find Workshops. Host Workshops <span class="mark">for free</span>.</strong></p>
            <p>Discover exciting activities nearby or create your own and start earning 🎉.</p>
            <p>Whether you want to join the fun or monetize your passion, <span class="mark">Twiggli</span> makes it easy.</p>
            <p>📱 <strong>Ready to dive in?</strong> Download now on Apple Store and Google Play!</p>
          </div>
          <StoreButtons lang={lang} tone="default" class="hero-stores" />
        </div>
      </div>
      <HeroVideoGrid hosts={hosts} lang={lang} />
    </section>

  </div>

  <section class="section hosts-band" id="hosts">
    <div class="container">
      <span class="kicker">Our hosts</span>
    </div>
    <div class="container">
      <HostGrid hosts={hosts} layout="carousel" lang={lang} />
    </div>
    <div class="container hosts-band-actions">
      <a href={withBase('/hosts/')} class="btn btn-primary">Meet all {hosts.length} hosts</a>
    </div>
  </section>

  <section class="section steps-band" id="how-it-works">
    <div class="container">
      <span class="kicker">How it works</span>
      {steps.map((step) => (
        <div class="step">
          <p class="step-num">{step.num}</p>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-copy">{step.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="container">

    <section class="split split-media-first" id="host">
      <div class="media-4x3 grayscale">
        <ImageSlot
          src={withBase('/img/hero/hiking.jpg')}
          shape="rect"
          placeholder="Drop a host/workshop photo"
          alt=""
        />
      </div>
      <div>
        <span class="kicker kicker-tight">Host &amp; earn</span>
        <h2 class="split-title">Host workshops for free — and start earning</h2>
        <p class="split-copy">
          Turn your skill into income. List a dance class, a cooking session or a hike, set your
          price — or make it free — and Twiggli brings the people. No listing fees, no equipment to
          buy.
        </p>
        <div class="split-actions">
          <a href={withBase('/host/')} class="btn btn-primary">Become a host</a>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="split split-text-first" id="corporate">
      <div>
        <span class="kicker kicker-tight">Corporate events</span>
        <h2 class="split-title">Team-building workshops for companies</h2>
        <p class="split-copy">
          Book a private workshop for your team — cooking, climbing, dance and more, run by our
          vetted hosts at your office or a venue nearby. We handle the logistics for groups of any
          size.
        </p>
        <div class="split-actions">
          <a href={withBase('/corporate/')} class="btn btn-primary">Get a corporate quote</a>
        </div>
      </div>
      <div class="media-4x3 grayscale">
        <ImageSlot
          src={withBase('/img/hero/cooking.jpg')}
          shape="rect"
          placeholder="Drop a corporate event photo"
          alt=""
        />
      </div>
    </section>

    <hr class="rule" />

    <Newsletter lang={lang} />
  </div>
</Base>
